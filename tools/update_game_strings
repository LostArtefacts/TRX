#!/usr/bin/env python3
import argparse
import json
import re
from pathlib import Path

from shared.json_utils import (
    JSONPointers,
    load_json5,
    load_json5_from_string,
    write_json_to_string,
)
from shared.paths import DATA_DIR, PROJECT_PATHS, CommonPaths
from shared.translation_utils import (
    REVIEW_MARKER,
    format_strings_file,
    is_mod_file,
    is_translation_file,
    should_skip_object_name,
)
from shared.vfs import VirtualFilesystem


def get_objects_map(paths: list[Path]) -> dict[str, list[str]]:
    """
    Parse object-name definitions from names.def-like files.
    Supports:
      X_OBJ_NAME_DEFINE(..., "key", X_OBJ_NAMES("Name1", "Name2", ...))
    """
    result: dict[str, list[str]] = {}
    for path in paths:
        for line in path.read_text().splitlines():
            text = line.strip()
            match = re.match(
                r'^X_OBJ_NAME_DEFINE\(\s*\w+\s*,\s*"([^"]+)"\s*,\s*X_OBJ_NAMES\(\s*(.+?)\s*\)\s*\)$',
                text,
            )
            if match:
                key = match.group(1)
                names_list = re.findall(r'"([^"]+)"', match.group(2))
                result.setdefault(key, []).extend(names_list)
    return result


def get_strings_map(paths: list[Path]) -> dict[str, str]:
    result: dict[str, str] = {}
    for path in paths:
        for line in path.read_text().splitlines():
            if match := re.match(
                r'^\w+DEFINE\((\w+),\s*"([^"]+)"\)$', line.strip()
            ):
                result[match.group(1)] = (
                    match.group(2).replace("\\n", "\n").replace("\\\\", "\\")
                )
    return result


def postprocess_object_strings(
    content: str,
    object_names_map: dict[str, list[str]],
) -> str:
    content_dict = load_json5_from_string(content)
    content_dict["objects"] = {
        key: {"name": names[0]} if len(names) == 1 else {"names": names}
        for key, names in object_names_map.items()
    }
    return write_json_to_string(content_dict) + "\n"


def postprocess_game_strings(
    content: str,
    game_strings_map: dict[str, str],
) -> str:
    content_dict = load_json5_from_string(content)
    content_dict["game_strings"] = dict(
        sorted(game_strings_map.items(), key=lambda kv: kv[0])
    )
    return write_json_to_string(content_dict) + "\n"


class ReviewTracker:
    def __init__(self, vfs: VirtualFilesystem) -> None:
        self.vfs = vfs
        self.changed_ptrs: dict[Path, list[str]] = {}

    def track_change(
        self, eng_path: Path, old_content: str, new_content: str
    ) -> None:
        """Determine which entries changed for later marking in translations."""
        old_data = load_json5_from_string(old_content)
        new_data = load_json5_from_string(new_content)
        old_ptr = JSONPointers(old_data)
        new_ptr = JSONPointers(new_data)
        self.changed_ptrs[eng_path] = [
            ptr
            for ptr in new_ptr
            if new_ptr.get(ptr) != old_ptr.get(ptr)
            and not should_skip_object_name(ptr, new_data)
        ]

    def mark_for_review(self) -> None:
        """Mark changed entries in translation files with REVIEW_MARKER."""
        for eng_path, ptrs in self.changed_ptrs.items():
            for trans_path in eng_path.parent.glob(f"{eng_path.stem}-*.json5"):
                if not is_translation_file(trans_path):
                    continue
                trans_data = load_json5_from_string(self.vfs.get(trans_path))
                trans_ptr = JSONPointers(trans_data)
                for ptr in ptrs:
                    if "extends" in trans_data and ptr not in trans_ptr:
                        continue
                    trans_ptr[ptr] = REVIEW_MARKER
                self.vfs.put(
                    trans_path, write_json_to_string(trans_data) + "\n"
                )


def process_game_strings(
    vfs: VirtualFilesystem,
    review_tracker: ReviewTracker,
    game_strings_def_path: Path,
    target_dir: Path,
) -> None:
    game_strings_map = get_strings_map([game_strings_def_path])

    # Update English base files
    for path in target_dir.rglob("*strings.json*"):
        # Skip translation files; handle only base (English) files here
        if is_translation_file(path):
            continue
        if is_mod_file(path):
            continue

        old_content = path.read_text()
        new_content = old_content
        new_content = postprocess_game_strings(new_content, game_strings_map)
        if new_content != old_content:
            # Write updated English file
            vfs.put(path, new_content)
            review_tracker.track_change(path, old_content, new_content)


def process_object_names(
    vfs: VirtualFilesystem,
    review_tracker: ReviewTracker,
    object_names_def_path: Path,
    target_dir: Path,
) -> None:
    object_names_map = get_objects_map([object_names_def_path])
    assert object_names_map

    # Update English base files
    changed_ptrs: dict[Path, list[str]] = {}
    for path in target_dir.rglob("*strings.json*"):
        # Skip translation files; handle only base (English) files here
        if is_translation_file(path):
            continue
        if is_mod_file(path):
            continue
        old_content = vfs.get(path)
        new_content = old_content
        new_content = postprocess_object_strings(new_content, object_names_map)
        if new_content != old_content:
            # Write updated English file
            vfs.put(path, new_content)
            review_tracker.track_change(path, old_content, new_content)


def update_formatting(vfs: VirtualFilesystem, path: Path) -> None:
    vfs.put(path, format_strings_file(load_json5_from_string(vfs.get(path))))


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Update game strings JSON files to reflect GS_DEFINE() macros."
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="Perform a dry run: show unified diffs instead of writing files.",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    vfs = VirtualFilesystem()
    review_tracker = ReviewTracker(vfs)

    process_game_strings(
        vfs,
        review_tracker,
        CommonPaths.include_dir / "game/game_string.def",
        CommonPaths.shipped_data_dir,
    )
    for game, project_paths in PROJECT_PATHS.items():
        process_game_strings(
            vfs,
            review_tracker,
            project_paths.src_dir / "game/game_string.def",
            project_paths.shipped_data_dir,
        )
        process_object_names(
            vfs,
            review_tracker,
            CommonPaths.include_dir / f"game/objects/names_tr{game}.def",
            project_paths.shipped_data_dir,
        )

    review_tracker.mark_for_review()

    for path in DATA_DIR.rglob("**/*strings*.json5"):
        update_formatting(vfs, path)

    if args.dry_run:
        vfs.show_diff()
    else:
        vfs.commit()


if __name__ == "__main__":
    main()
