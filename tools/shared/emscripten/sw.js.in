// Service worker for __APP_NAME__ (WebGL PWA)
// Generated by build_webgl.sh — do not edit by hand.

var CACHE_NAME = '__SHORT_NAME__-__CACHE_BUST__';

var PRECACHE_URLS = [
    'TRX.html',
    'TRX.js',
    'TRX.wasm',
    'shell.css',
    'gamedata.js',
    'vendor/fflate.min.js',
    'manifest.webmanifest',
    'icon-192.png',
    'icon-512.png'
];

// Assets that are streamed and should not be intercepted.
function shouldSkip(url) {
    return url.pathname.indexOf('/fmv/') !== -1;
}

self.addEventListener('install', function(event) {
    event.waitUntil(
        caches.open(CACHE_NAME).then(function(cache) {
            return cache.addAll(PRECACHE_URLS);
        }).then(function() {
            return self.skipWaiting();
        })
    );
});

self.addEventListener('activate', function(event) {
    // Purge old caches from previous builds.
    event.waitUntil(
        caches.keys().then(function(names) {
            return Promise.all(
                names.filter(function(name) {
                    return name !== CACHE_NAME;
                }).map(function(name) {
                    return caches.delete(name);
                })
            );
        }).then(function() {
            return self.clients.claim();
        })
    );
});

self.addEventListener('fetch', function(event) {
    var url = new URL(event.request.url);

    // Ignore cross-origin requests (e.g. Font Awesome CDN).
    if (url.origin !== self.location.origin) {
        return;
    }

    // Never cache or intercept FMV streaming requests.
    if (shouldSkip(url)) {
        return;
    }

    // Pass through range requests (needed for FMV video streaming).
    if (event.request.headers.get('Range')) {
        return;
    }

    // Large binary assets: cache-first (these are big and only change
    // between builds, which get a fresh CACHE_NAME via precache).
    var path = url.pathname;
    if (path.endsWith('.wasm') || path.endsWith('.data')
        || path.endsWith('.png') || path.endsWith('.webmanifest')) {
        event.respondWith(
            caches.match(event.request, { ignoreSearch: true }).then(function(cached) {
                if (cached) return cached;
                return fetch(event.request).then(function(response) {
                    if (response.ok) {
                        var clone = response.clone();
                        caches.open(CACHE_NAME).then(function(cache) {
                            cache.put(event.request, clone);
                        });
                    }
                    return response;
                });
            })
        );
        return;
    }

    // Everything else (HTML, JS, CSS): network-first so updates are
    // picked up on a normal refresh, with cache fallback for offline.
    // Use cache: 'no-cache' to bypass the browser HTTP cache (sends a
    // conditional request so unchanged files still return 304).
    event.respondWith(
        fetch(event.request, { cache: 'no-cache' }).then(function(response) {
            if (response.ok) {
                var clone = response.clone();
                caches.open(CACHE_NAME).then(function(cache) {
                    cache.put(event.request, clone);
                });
            }
            return response;
        }).catch(function() {
            return caches.match(event.request, { ignoreSearch: true }).then(
                function(cached) {
                    // For navigation requests, fall back to the app shell
                    // if the exact URL isn't cached (e.g. "/" vs "TRX.html").
                    if (cached) return cached;
                    if (event.request.mode === 'navigate') {
                        return caches.match('TRX.html', { ignoreSearch: true });
                    }
                    return cached;
                }
            );
        })
    );
});
