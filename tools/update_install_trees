def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Update game strings JSON files to reflect GS_DEFINE() macros."
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="Perform a dry run: show unified diffs instead of writing files.",
    )
    return parser.parse_args()


def collect(root_dir: Path) -> Iterable[Path]:
    paths = [
        path.relative_to(root_dir)
        for path in root_dir.rglob("*", recurse_symlinks=True)
        if path.is_file() and path.name not in IGNORED_FILES
    ]
    return sorted(paths)


def remap_og_path(path: Path, game: str) -> Path | None:
    override = OG_FILE_OVERRIDES.get(game, {}).get(path)
    if override is not None:
        return override
    if path.parts[0] in OG_PREFIX_TARGETS[game]:
        return OG_PREFIX_TARGETS[game][path.parts[0]] / path.relative_to(
            path.parts[0]
        )
    return None


def remap_og_paths(paths: Iterable[Path], game: str) -> Iterable[Path]:
    for path in paths:
        mapped = remap_og_path(path, game)
        if mapped is not None:
            yield mapped


def collect_many(root_dirs: Iterable[Path]) -> Iterable[Path]:
    for root_dir in root_dirs:
        yield from collect(root_dir)


def iter_og_groups(group_names: Iterable[str]) -> Iterable[Path]:
    for group_name in group_names:
        yield from OG_FILE_GROUPS[group_name]


def iter_trx_image_paths() -> Iterable[Path]:
    for game, root_dir in TRX_IMAGE_ROOTS.items():
        for path in collect(root_dir):
            yield Path("games") / game / "images" / path


def build_legacy_win_paths(config: dict[str, Any]) -> Iterable[Path]:
    yield Path("TRX.exe")
    yield Path(f"cfg/{config['config']}.json5*")
    yield from iter_og_groups(config["og_groups"])
    yield from collect_many(config["ship_roots"])


def build_legacy_mac_paths(config: dict[str, Any]) -> Iterable[Path]:
    yield Path("Contents/_CodeSignature")
    yield Path("Contents/Frameworks")
    yield Path("Contents/info.plist")
    yield Path("Contents/MacOS")
    yield from (
        Path("Contents/Resources") / sub
        for sub in collect_many(config["ship_roots"])
    )
    yield from (
        Path("Contents/Resources") / sub
        for sub in iter_og_groups(config["og_groups"])
    )
    yield Path("Contents/Resources/icon.icns")


def build_trx_win_paths() -> Iterable[Path]:
    yield Path("TRX.exe")
    yield Path("cfg/shell.json5*")
    yield Path("cfg/TR1X.json5*")
    yield Path("cfg/TR2X.json5*")
    yield Path("cfg/TR3X.json5*")
    yield from collect(DATA_DIR / "trx/ship")
    yield from iter_trx_image_paths()
    for group_name in OG_FILE_GROUPS:
        yield from remap_og_paths(OG_FILE_GROUPS[group_name], group_name)


def build_doc_trees() -> Iterable[tuple[Path, str, list[Path]]]:
    for config in LEGACY_DOC_CONFIGS:
        yield (
            config["doc"],
            "win",
            list(build_legacy_win_paths(config)),
        )
        yield (
            config["doc"],
            "mac",
            list(build_legacy_mac_paths(config)),
        )
    yield (DOCS_DIR / "trx/INSTALLING.md", "win", list(build_trx_win_paths()))




def make_tree_string(paths: list[Path]) -> str:
    type Node = defaultdict[Any, Any]

    # build nested dict
    def tree() -> Node:
        return defaultdict(tree)

    root = tree()
    for path in paths:
        node = root
        for part in str(path).split("/"):
            node = node[part]

    def natural_sort_key(s: str) -> list[str | int]:
        return [
            int(text) if text.isdigit() else text.lower()
            for text in re.split("([0-9]+)", s)
        ]

    # recursive render
    def render(node: Node, prefix: str = "") -> list[str]:
        entries = sorted(
            node.keys(),
            key=lambda name: (0 if node[name] else 1, natural_sort_key(name)),
        )
        lines = []
        for i, name in enumerate(entries):
            last = i == len(entries) - 1
            branch = "└── " if last else "├── "
            subprefix = "    " if last else "│   "
            lines.append(prefix + branch + name)
            if node[name]:
                lines.extend(render(node[name], prefix + subprefix))
        return lines

    return ".\n" + "\n".join(render(root))


def process_install_doc(content: str, platform: str, paths: list[Path]) -> str:
    result: list[str] = []
    lines = content.splitlines()
    while lines:
        line = lines.pop(0)
        if line == f'<details data-id="file-tree-{platform}">':
            result.append(line)
            while lines:
                line = lines.pop(0)
                if not line:
                    break
            result.append(
                "<pre><code>" + make_tree_string(paths) + "</code></pre>"
            )
            result.append("</details>")
            if lines:
                result.append(line)
        else:
            result.append(line)
    return "\n".join(result) + "\n"


def main() -> None:
    args = parse_args()
    vfs = VirtualFilesystem()

    for path, platform, paths in build_doc_trees():
        vfs.put(
            path, process_install_doc(vfs.get(path), platform, paths)
        )

    if args.dry_run:
        vfs.show_diff()
    else:
        vfs.commit()


if __name__ == "__main__":
    main()
