#!/usr/bin/env python3
"""Fill translation JSON5 files from base language JSON5 files.

Shared utilities are loaded from tools/shared/translation_utils.py."""
import argparse
import difflib
import json
import os
import sys
from copy import deepcopy
from pathlib import Path
from typing import Any

try:
    import openai
except ImportError:
    openai = None

from shared.json_utils import JSONPointers, load_json5
from shared.paths import PROJECT_PATHS, CommonPaths
from shared.translation_utils import (
    REVIEW_MARKER,
    chunks,
    clean,
    find_base_file,
    format_strings_file,
    is_translation_file,
    should_skip_object_name,
)


def parse_args():
    parser = argparse.ArgumentParser(
        description="Fill translation JSON5 files based on base files."
    )
    parser.add_argument(
        "--ai",
        action="store_true",
        help="Use OpenAI to translate missing strings.",
    )
    parser.add_argument(
        "--model",
        default=os.getenv("OPENAI_MODEL", "gpt-4o-mini"),
        help="OpenAI model to use for translation (default: %(default)s).",
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="Perform a dry run: show unified diffs instead of writing files.",
    )
    return parser.parse_args()


class BaseResolver:
    def __init__(self, base_data: Any, trans_data: Any) -> None:
        self.base_ptr = JSONPointers(base_data)
        self.trans_ptr = JSONPointers(deepcopy(trans_data))

    def fill(self) -> None:
        # Compute missing pointers, skipping redundant object-name indexes
        missing = [
            ptr
            for ptr in self.base_ptr
            if not clean(self.trans_ptr.get(ptr))
            and not should_skip_object_name(ptr, self.trans_ptr.data)
        ]

        processed = 0
        total = len(missing)

        missing_chunks = list(chunks(missing, n=50))

        # Translate in chunks of up to 20 entries at a time
        for chunk in missing_chunks:
            print(
                f"Processing entries {processed + 1}-"
                f"{processed + len(chunk)} of {total}...",
                file=sys.stderr,
                flush=True,
            )
            self.fill_chunk(chunk)
            processed += len(chunk)

        return self.trans_ptr.data


class AIResolver(BaseResolver):
    def __init__(
        self, base_data: Any, trans_data: Any, target_lang: str, model: str
    ) -> None:
        super().__init__(base_data, trans_data)
        self.target_lang = target_lang
        self.model = model

        if not openai:
            sys.exit("Error: openai library is required for --ai")
        if not openai.api_key and not os.getenv("OPENAI_API_KEY"):
            sys.exit("Error: OPENAI_API_KEY env var must be set for --ai")
        if os.getenv("OPENAI_API_KEY"):
            openai.api_key = os.getenv("OPENAI_API_KEY")

    def fill_chunk(self, chunk: list[str]) -> None:
        entries = [self.base_ptr[path] for path in chunk]
        prompt = entries
        messages = [
            {
                "role": "system",
                "content": (
                    "You are a translation assistant translating text to "
                    f"{self.target_lang} for a classic Tomb Raider game. "
                    "Given JSON ['text 1', 'text 2'], translate all items. "
                    "Do not modify the JSON structure. Return only valid JSON "
                    "with the same schema."
                ),
            },
            {
                "role": "user",
                "content": json.dumps(prompt, ensure_ascii=False),
            },
        ]

        buf = ""
        response = openai.chat.completions.create(
            model=self.model, messages=messages, temperature=0, stream=True
        )
        for chunk_resp in response:
            delta = chunk_resp.choices[0].delta.content
            if delta:
                print(delta, end="", file=sys.stderr, flush=True)
                buf += delta
        print(file=sys.stderr)

        try:
            parsed = json.loads(buf)
        except Exception as e:
            print(
                f"Error: failed to parse JSON from OpenAI response: {e}\n{buf}",
                file=sys.stderr,
            )
        else:
            for path, translated in zip(chunk, parsed):
                self.trans_ptr[path] = REVIEW_MARKER + (translated or "")


class BlankResolver(BaseResolver):
    def fill_chunk(self, chunk: list[str]) -> None:
        for path in chunk:
            self.trans_ptr[path] = REVIEW_MARKER


def process_file(path: Path, args: argparse.Namespace) -> None:
    if not is_translation_file(path):
        print(
            f"Skipping {path}: not a translation JSON5 file",
            file=sys.stderr,
        )
        return

    base_file = find_base_file(path)
    if not base_file.exists():
        print(
            f"Error: base file not found for {path}: expected {base_file}",
            file=sys.stderr,
        )
        return

    base_data = load_json5(base_file)
    trans_data = load_json5(path) if path.exists() else {}
    if isinstance(trans_data, dict) and "extends" in trans_data:
        return

    if args.ai:
        _, lang = path.stem.rsplit("-", 1)
        resolver = AIResolver(
            base_data, trans_data, target_lang=lang, model=args.model
        )
    else:
        resolver = BlankResolver(base_data, trans_data)

    merged = resolver.fill()
    new_text = format_strings_file(merged)
    if args.dry_run:
        old_text = path.read_text(encoding="utf-8") if path.exists() else ""
        diff = difflib.unified_diff(
            old_text.splitlines(keepends=True),
            new_text.splitlines(keepends=True),
            fromfile=str(path),
            tofile=str(path) + " (new)",
        )
        sys.stdout.writelines(diff)
    else:
        path.write_text(new_text)
        print(f"Wrote {path}")


def main() -> None:
    args = parse_args()
    # Discover all translation JSON5 files under each project's shipped_data_dir
    files: list[Path] = []

    source_dirs = [
        CommonPaths.shipped_data_dir,
        *(project.shipped_data_dir for project in PROJECT_PATHS.values()),
    ]

    files = [
        path
        for source_dir in source_dirs
        for path in source_dir.rglob("*strings*.json5")
        if is_translation_file(path)
    ]

    for path in files:
        process_file(path, args=args)


if __name__ == "__main__":
    main()
