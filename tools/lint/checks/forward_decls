#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from harness import LintWarning, file_check
from shared.cforwards import unneeded


def check(path, text):
    for forward in unneeded(text):
        yield LintWarning(
            path,
            f"{forward.name} is declared ahead of its definition with no use "
            "in between; define it before its first use instead",
            line=forward.line,
        )


file_check(check)
