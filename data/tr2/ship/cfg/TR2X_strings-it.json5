    "game_strings": {
        "ACTION_EXAMINE_ITEM": "Esamina",
        "ACTION_RESET_DEFAULTS": "Ripristina",
        "ACTION_UNBIND": "Dissocia",
        "ACTION_USE_ITEM": "Usa",
        "COMMON_SETTINGS_FROZEN_OPTION_DISCLAIMER": "Questa impostazione è applicata dal generatore di livelli e non può essere modificata.",
        "COMMON_SETTINGS_RESTORE_DEFAULT": "Ripristina predefiniti",
        "COMMON_SETTINGS_TOGGLE_HELP": "Visualizza guida",
        "CONSOLE_CMD_HELP_LIST": "Comandi disponibili:",
        "CONSOLE_HELP_BRAID": "Attiva/disattiva la treccia di Lara.",
        "CONSOLE_HELP_CHEATS": "Attiva/disattiva i trucchi di gioco.",
        "CONSOLE_HELP_DEBUG": "Attiva/disattiva le informazioni di debug.",
        "CONSOLE_HELP_DRAIN": "Drena la stanza corrente, rimuovendo l'acqua.",
        "CONSOLE_HELP_END_LEVEL": "Termina il livello attuale.",
        "CONSOLE_HELP_EXIT": "Termina il gioco.",
        "CONSOLE_HELP_FLIPMAP": "Attiva/disattiva mappa capovolta.",
        "CONSOLE_HELP_FLOOD": "Immerge la stanza corrente nell'acqua.",
        "CONSOLE_HELP_FLY": "Attiva/disattiva il trucco Volo.",
        "CONSOLE_HELP_FPS": "Modifica il valore degli FPS.",
        "CONSOLE_HELP_GIVE": "Aggiunge un determinato oggetto all'inventario di Lara.",
        "CONSOLE_HELP_HEAL": "Riporta Lara in piena salute.",
        "CONSOLE_HELP_HELP": "Mostra la guida per tutti i comandi o la guida dettagliata per uno solo.",
        "CONSOLE_HELP_HP": "Imposta la salute di Lara al valore specificato.",
        "CONSOLE_HELP_KILL": "Uccide i nemici vicini.",
        "CONSOLE_HELP_LOAD": "Carica la partita dallo slot di salvataggio specificato.",
        "CONSOLE_HELP_MUSIC": "Riproduce la traccia musicale con l'ID specificato.",
        "CONSOLE_HELP_PLAY_CUTSCENE": "Riproduce la scena di intermezzo con il numero specificato.",
        "CONSOLE_HELP_PLAY_DEMO": "Riproduce la demo con il numero specificato.",
        "CONSOLE_HELP_PLAY_GYM": "Gioca al livello Palestra.",
        "CONSOLE_HELP_PLAY_LEVEL": "Gioca un livello con il nome o il numero specificato.",
        "CONSOLE_HELP_POS": "Mostra la posizione di Lara.",
        "CONSOLE_HELP_SAVE": "Salva la partita nello slot di salvataggio specificato.",
        "CONSOLE_HELP_SET": "Visualizza o aggiorna l'impostazione di configurazione specificata.",
        "CONSOLE_HELP_SFX": "Riproduce un effetto sonoro con l'ID specificato.",
        "CONSOLE_HELP_SPEED": "Modifica la velocità di gioco.",
        "CONSOLE_HELP_TITLE": "Ritorna al menu principale.",
        "CONSOLE_HELP_TP": "Teletrasporta Lara in una posizione o in un numero di stanza specifici.",
        "CONSOLE_HELP_WIREFRAME": "Attiva/disattiva la renderizzazione in modalità reticolo.",
        "CONTROLS_BACKEND_CONTROLLER": "Controller",
        "CONTROLS_BACKEND_KEYBOARD": "Tastiera",
        "CONTROLS_CUSTOMIZE": "Personalizza comandi",
        "CONTROLS_CUSTOM_1": "Tasti utente 1",
        "CONTROLS_CUSTOM_2": "Tasti utente 2",
        "CONTROLS_CUSTOM_3": "Tasti utente 3",
        "CONTROLS_DEFAULT_KEYS": "Tasti predefiniti",
        "CONTROLS_SECTION_BASICS": "Movimento",
        "CONTROLS_SECTION_ITEMS": "Oggetti",
        "CONTROLS_SECTION_MISC": "Vari",
        "CONTROLS_SECTION_SYSTEM": "Sistema",
        "GAMEPLAY_SETTINGS_CAMERA_SPEED": "Velocità telecamera",
        "GAMEPLAY_SETTINGS_CAMERA_SPEED_DESCRIPTION": "Modifica la velocità di movimento della telecamera manuale.",
        "GAMEPLAY_SETTINGS_CHANGE_PIERRE_SPAWN": "Modifica generazione Pierre",
        "GAMEPLAY_SETTINGS_CHANGE_PIERRE_SPAWN_DESCRIPTION": "Fa in modo che, alla sua generazione, un Pierre (in fuga) sostituisca un altro Pierre (in fuga) già esistente.",
        "GAMEPLAY_SETTINGS_CONTROLS_TAB": "Comandi",
        "GAMEPLAY_SETTINGS_DISABLE_HEALING_BETWEEN_LEVELS": "Danni persistenti",
        "GAMEPLAY_SETTINGS_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Lara non guarisce quando inizia un nuovo livello (per le sfide).",
        "GAMEPLAY_SETTINGS_DISABLE_MAGNUMS": "Rimuovi le magnum",
        "GAMEPLAY_SETTINGS_DISABLE_MAGNUMS_DESCRIPTION": "Rimuove tutte le magnum e le munizioni magnum dal gioco.",
        "GAMEPLAY_SETTINGS_DISABLE_MEDPACKS": "Rimuovi i kit medici",
        "GAMEPLAY_SETTINGS_DISABLE_MEDPACKS_DESCRIPTION": "Rimuove tutti i kit medici dal gioco (per le sfide).",
        "GAMEPLAY_SETTINGS_DISABLE_SHOTGUN": "Rimuovi i fucili",
        "GAMEPLAY_SETTINGS_DISABLE_SHOTGUN_DESCRIPTION": "Rimuove tutti i fucili a pompa e le cartucce per fucile dal gioco.",
        "GAMEPLAY_SETTINGS_DISABLE_TREX_COLLISION": "Rimuovi collisione T-Rex morto",
        "GAMEPLAY_SETTINGS_DISABLE_TREX_COLLISION_DESCRIPTION": "Rimuove tutte le collisioni con il T-Rex dopo la sua dipartita. Utile quando il corpo del T-Rex blocca il passaggio.",
        "GAMEPLAY_SETTINGS_DISABLE_UZIS": "Rimuovi le uzi",
        "GAMEPLAY_SETTINGS_DISABLE_UZIS_DESCRIPTION": "Rimuove tutte le uzi e le munizioni uzi dal gioco.",
        "GAMEPLAY_SETTINGS_ENABLE_ALLY_TARGETING": "Consenti fuoco amico",
        "GAMEPLAY_SETTINGS_ENABLE_ALLY_TARGETING_DESCRIPTION": "Permette a Lara di colpire gli alleati, come i monaci. Se disabilitato, gli alleati saranno immuni alle munizioni di Lara.",
        "GAMEPLAY_SETTINGS_ENABLE_AUTO_ITEM_SELECTION": "Preselezione oggetti chiave",
        "GAMEPLAY_SETTINGS_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "Quando Lara preme azione contro un buco della serratura o un altro ricettacolo e ha l'oggetto corrispondente nell'inventario, quell'oggetto verrà preselezionato.",
        "GAMEPLAY_SETTINGS_ENABLE_BUFFERING": "Buffering comandi",
        "GAMEPLAY_SETTINGS_ENABLE_BUFFERING_DESCRIPTION": "Abilita il buffering dei tasti funzione (1 fotogramma) e dell'inventario (2 fotogrammi) per ottenere un controllo preciso dei movimenti di Lara.",
        "GAMEPLAY_SETTINGS_ENABLE_CHEATS": "Trucchi",
        "GAMEPLAY_SETTINGS_ENABLE_CHEATS_DESCRIPTION": "Abilita vari trucchi:\n\n- L: termina immediatamente il livello.\n- I: dà a Lara tutte le armi; maggior quantità di munizioni e kit medici; tutti gli oggetti necessari per superare il livello.\n- O: abilita il trucco DOZY (nuotare a mezz'aria).\n     - tasto CAMMINA: disabilita il trucco DOZY.\n     - tasto ESTRAI ARMA: apre la porta più vicina (non funziona in certi casi).",
        "GAMEPLAY_SETTINGS_ENABLE_COMPASS_STATS": "Statistiche livello bussola",
        "GAMEPLAY_SETTINGS_ENABLE_COMPASS_STATS_DESCRIPTION": "Abilita la visualizzazione delle statistiche del livello quando è selezionata la bussola.",
        "GAMEPLAY_SETTINGS_ENABLE_CONSOLE": "Console",
        "GAMEPLAY_SETTINGS_ENABLE_CONSOLE_DESCRIPTION": "Abilita la console per sviluppatori.",
        "GAMEPLAY_SETTINGS_ENABLE_CUTSCENES": "Scene di intermezzo",
        "GAMEPLAY_SETTINGS_ENABLE_CUTSCENES_DESCRIPTION": "Abilita la riproduzione delle scene di intermezzo.",
        "GAMEPLAY_SETTINGS_ENABLE_DEATHS_COUNTER": "Conta morti di Lara",
        "GAMEPLAY_SETTINGS_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Permette di mostrare il conteggio delle morti nella bussola e nelle statistiche del livello. Il conteggio delle morti viene aggiornato nel salvataggio attualmente caricato ogni volta che Lara muore.",
        "GAMEPLAY_SETTINGS_ENABLE_DEMO": "Modalità demo",
        "GAMEPLAY_SETTINGS_ENABLE_DEMO_DESCRIPTION": "Abilita la riproduzione delle demo nel menu principale.",
        "GAMEPLAY_SETTINGS_ENABLE_ENEMY_ROTATION": "Rotazione nemici casuale",
        "GAMEPLAY_SETTINGS_ENABLE_ENEMY_ROTATION_DESCRIPTION": "Applica una rotazione casuale aggiuntiva ad alcuni nemici quando vengono inizializzati.",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_LOOK": "Muovi la visuale mentre corri",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_LOOK_DESCRIPTION": "Permette a Lara di guardarsi intorno mentre corre, salta, si appende, ecc. - in stile TR2.",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_SAVES": "Salva gli effetti",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Migliora il sistema di salvataggio in modo che gli effetti grafici, la foschia delle cascate, gli emettitori di fiamme e altro vengano salvati invece di scomparire dopo il caricamento della partita.",
        "GAMEPLAY_SETTINGS_ENABLE_FMV": "FMV",
        "GAMEPLAY_SETTINGS_ENABLE_FMV_DESCRIPTION": "Abilita la riproduzione dei filmati.",
        "GAMEPLAY_SETTINGS_ENABLE_GAME_MODES": "Selezione modalità di gioco",
        "GAMEPLAY_SETTINGS_ENABLE_GAME_MODES_DESCRIPTION": "Consente di selezionare delle modalità di gioco aggiuntive dal menu passaporto.\n\n- Nuova Partita+: sblocca tutte le armi con munizioni infinite; i nemici hanno punti vita doppi.\n- NP giapponese: le armi causano il doppio dei danni; le scatole di bengala contengono 8 razzi di segnalazione anziché 6.\n- NP giapponese+: combinazione di Nuova Partita+ e NP giapponese.",
        "GAMEPLAY_SETTINGS_ENABLE_INVERTED_LOOK": "Visuale invertita",
        "GAMEPLAY_SETTINGS_ENABLE_INVERTED_LOOK_DESCRIPTION": "Inverte i controlli dell'asse Y quando Lara si guarda intorno.",
        "GAMEPLAY_SETTINGS_ENABLE_ITEM_EXAMINING": "Esame degli oggetti",
        "GAMEPLAY_SETTINGS_ENABLE_ITEM_EXAMINING_DESCRIPTION": "Per livelli personalizzati: consente di visualizzare le descrizioni degli oggetti nell'inventario quando fornite dall'autore del livello.",
        "GAMEPLAY_SETTINGS_ENABLE_JUMP_TWISTS": "Capriole a mezz’aria",
        "GAMEPLAY_SETTINGS_ENABLE_JUMP_TWISTS_DESCRIPTION": "Abilita i salti mortali e le capriole a mezz'aria in stile TR2+, ovvero premendo Rotola durante le animazioni del salto e del tuffo ad angelo.",
        "GAMEPLAY_SETTINGS_ENABLE_LEAN_JUMPING": "Salti inclinati",
        "GAMEPLAY_SETTINGS_ENABLE_LEAN_JUMPING_DESCRIPTION": "Permette a Lara di spostarsi ulteriormente in avanti o indietro quando esegue salti sul posto, premendo il relativo tasto.",
        "GAMEPLAY_SETTINGS_ENABLE_LEGAL": "Contenuto legale",
        "GAMEPLAY_SETTINGS_ENABLE_LEGAL_DESCRIPTION": "Abilita la schermata di introduzione e il video Core Design all'avvio del gioco.",
        "GAMEPLAY_SETTINGS_ENABLE_LOADING_SCREENS": "Schermate di caricamento",
        "GAMEPLAY_SETTINGS_ENABLE_LOADING_SCREENS_DESCRIPTION": "Abilita le schermate di caricamento in stile PS1 prima di ogni livello.",
        "GAMEPLAY_SETTINGS_ENABLE_NUMERIC_KEYS": "Scorciatoie oggetti",
        "GAMEPLAY_SETTINGS_ENABLE_NUMERIC_KEYS_DESCRIPTION": "Permette di equipaggiare armi e usare kit medici in modo rapido.\n\n- 1: Equipaggia pistole\n- 2: Equipaggia fucile a pompa\n- 3: Equipaggia magnum\n- 4: Equipaggia uzi\n- 8: Usa kit medico piccolo\n- 9: Usa kit medico grande",
        "GAMEPLAY_SETTINGS_ENABLE_RESPONSIVE_PASSPORT": "Passaporto reattivo",
        "GAMEPLAY_SETTINGS_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Disabilita il blocco dell'input dell'utente quando scorrono le pagine del passaporto, programmando invece le pagine da sfogliare.",
        "GAMEPLAY_SETTINGS_ENABLE_SAVE_CRYSTALS": "Cristalli di salvataggio",
        "GAMEPLAY_SETTINGS_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Permette di salvare all'inizio di ogni livello o utilizzando i cristalli. I livelli hanno un numero limitato di cristalli di salvataggio che possono essere utilizzati una sola volta, come nella versione PS1. La modifica di questa opzione richiederà il riavvio del livello.",
        "GAMEPLAY_SETTINGS_ENABLE_SMOOTH_WALL_DEFLECT": "Deflessione fluida muro",
        "GAMEPLAY_SETTINGS_ENABLE_SMOOTH_WALL_DEFLECT_DESCRIPTION": "Permette a Lara di riprendersi più velocemente dopo aver urtato un muro e un tasto direzionale viene premuto insieme con il tasto Corri.",
        "GAMEPLAY_SETTINGS_ENABLE_STEP_ROLL_BOOST": "Spinta su gradino",
        "GAMEPLAY_SETTINGS_ENABLE_STEP_ROLL_BOOST_DESCRIPTION": "Permette a Lara di essere spinta giù da un gradino se si preme il tasto Rotola vicino al bordo.",
        "GAMEPLAY_SETTINGS_ENABLE_SWING_CANCEL": "Annulla oscillazione",
        "GAMEPLAY_SETTINGS_ENABLE_SWING_CANCEL_DESCRIPTION": "Consente di annullare l'animazione di oscillazione di Lara dalle sporgenze, lasciandole andare e afferrandole di nuovo rapidamente",
        "GAMEPLAY_SETTINGS_ENABLE_TARGET_CHANGE": "Cambio bersaglio",
        "GAMEPLAY_SETTINGS_ENABLE_TARGET_CHANGE_DESCRIPTION": "Abilita il cambio di bersaglio in stile TR4+ mentre si punta l'arma. Premi Guarda mentre miri per cambiare bersaglio.",
        "GAMEPLAY_SETTINGS_ENABLE_TIMER_IN_INVENTORY": "Cronometro nell'inventario",
        "GAMEPLAY_SETTINGS_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION": "Fa in modo che il tempo di gioco scorra anche nel menu dell'inventario.",
        "GAMEPLAY_SETTINGS_ENABLE_TOTAL_STATS": "Schermata statistiche finali",
        "GAMEPLAY_SETTINGS_ENABLE_TOTAL_STATS_DESCRIPTION": "Abilita la schermata delle statistiche totali di gioco che viene visualizzata dopo i titoli di coda.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_JUMPING": "Salti reattivi",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_JUMPING_DESCRIPTION": "Permette a Lara di saltare in qualsiasi momento mentre corre, in modo simile a TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIMMING": "Nuoto naturale",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIMMING_DESCRIPTION": "Fornisce alla velocità di virata subacquea di Lara una curva di accelerazione per movimenti più fluidi, simile a TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIM_CANCEL": "Annullamento reattivo nuoto",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION": "Permette a Lara di fermarsi in modo più istantaneo sott'acqua quando viene rilasciato il tasto per nuotare, simile a TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR3_SIDESTEPS": "Passi laterali migliorati",
        "GAMEPLAY_SETTINGS_ENABLE_TR3_SIDESTEPS_DESCRIPTION": "Abilita i passi laterali in stile TR3+, ad es. MAIUSC+frecce direzionali. I pulsanti dedicati per i passi laterali continueranno a funzionare.",
        "GAMEPLAY_SETTINGS_ENABLE_UW_ROLL": "Capriola sott'acqua",
        "GAMEPLAY_SETTINGS_ENABLE_UW_ROLL_DESCRIPTION": "Permette a Lara di fare capriole sott'acqua, in modo simile a TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_WADING": "Guadare",
        "GAMEPLAY_SETTINGS_ENABLE_WADING_DESCRIPTION": "Permette a Lara di guadare acque poco profonde, simile a TR2+, invece di rimanere bloccata sulla superficie dell'acqua.",
        "GAMEPLAY_SETTINGS_ENABLE_WALK_TO_ITEMS": "Interazioni animate",
        "GAMEPLAY_SETTINGS_ENABLE_WALK_TO_ITEMS_DESCRIPTION": "Fa in modo che Lara si avvicini agli oggetti, alle leve e agli interruttori quando questi sono nelle vicinanze, invece di teletrasportarsi su di loro.",
        "GAMEPLAY_SETTINGS_FIXES_TAB": "Correzioni",
        "GAMEPLAY_SETTINGS_FIX_ALLIGATOR_AI": "Correggi IA degli alligatori",
        "GAMEPLAY_SETTINGS_FIX_ALLIGATOR_AI_DESCRIPTION": "Risolve il problema degli alligatori che non infliggono danni se Lara rimane ferma nell'acqua.",
        "GAMEPLAY_SETTINGS_FIX_ANIMATED_SPRITES": "Correggi animazioni sprite",
        "GAMEPLAY_SETTINGS_FIX_ANIMATED_SPRITES_DESCRIPTION": "Risolve i problemi preesistenti nella Cisterna e nella Tomba di Tihocan per cui gli sprite delle piante nelle aree acquatiche non si animano.",
        "GAMEPLAY_SETTINGS_FIX_BEAR_AI": "Correggi IA degli orsi",
        "GAMEPLAY_SETTINGS_FIX_BEAR_AI_DESCRIPTION": "Risolve il problema in The Golden Mask per cui gli attacchi con la zampa degli orsi non colpiscono Lara.",
        "GAMEPLAY_SETTINGS_FIX_BRIDGE_COLLISION": "Correggi collisione ponti",
        "GAMEPLAY_SETTINGS_FIX_BRIDGE_COLLISION_DESCRIPTION": "Risolve il problema per cui Lara non è in grado di afferrare parti di alcuni ponti e muri invisibili ai bordi. Corregge anche i problemi di collisione con ponti levatoi, botole e ponti quando sono impilati l'uno sull'altro, su pendii o vicino al suolo.",
        "GAMEPLAY_SETTINGS_FIX_DESCENDING_GLITCH": "Correggi cadute da pavimenti",
        "GAMEPLAY_SETTINGS_FIX_DESCENDING_GLITCH_DESCRIPTION": "Risolve il problema per cui i passi laterali e il camminare all'indietro su pavimenti fragili fanno sì che Lara scenda immediatamente sul pavimento sottostante.",
        "GAMEPLAY_SETTINGS_FIX_FLARE_THROW_PRIORITY": "Correggi priorità lancio bengala",
        "GAMEPLAY_SETTINGS_FIX_FLARE_THROW_PRIORITY_DESCRIPTION": "Risolve il problema per cui Lara dà priorità al lancio di un bengala esaurito mentre è a mezz'aria, il che può impedirle di afferrare le sporgenze.",
        "GAMEPLAY_SETTINGS_FIX_FLOOR_DATA_ISSUES": "Correggi dati livelli",
        "GAMEPLAY_SETTINGS_FIX_FLOOR_DATA_ISSUES_DESCRIPTION": "Risolve i problemi dei livelli originali relativi a dati/eventi.",
        "GAMEPLAY_SETTINGS_FIX_FREE_FLARE_GLITCH": "Correggi errore dei bengala",
        "GAMEPLAY_SETTINGS_FIX_FREE_FLARE_GLITCH_DESCRIPTION": "Risolve il problema in cui, quando si preme il tasto del bengala mentre si raccoglie un qualsiasi oggetto, ne verrà creato uno dal nulla.",
        "GAMEPLAY_SETTINGS_FIX_GLIDE_CAMERAS": "Correggi telecamere a scorrimento",
        "GAMEPLAY_SETTINGS_FIX_GLIDE_CAMERAS_DESCRIPTION": "Corregge le telecamere a scorrimento affinché rispettino il tempo impostato negli eventi di livello invece di tornare alla velocità predefinita dopo il primo fotogramma.",
        "GAMEPLAY_SETTINGS_FIX_ITEM_DUPLICATION_GLITCH": "Correggi duplicazione oggetti",
        "GAMEPLAY_SETTINGS_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION": "Risolve il problema per cui è possibile duplicare l'utilizzo degli oggetti chiave nell'inventario.",
        "GAMEPLAY_SETTINGS_FIX_ITEM_ROTS": "Correggi rotazione oggetti",
        "GAMEPLAY_SETTINGS_FIX_ITEM_ROTS_DESCRIPTION": "Risolve i problemi relativi all'orientamento errato di alcuni oggetti quando viene utilizzata l'opzione Oggetti 3D nei livelli originali.",
        "GAMEPLAY_SETTINGS_FIX_M16_ACCURACY": "Correggi precisione M16",
        "GAMEPLAY_SETTINGS_FIX_M16_ACCURACY_DESCRIPTION": "Corregge la precisione della mira dell'M16 mentre Lara corre.",
        "GAMEPLAY_SETTINGS_FIX_PICKUP_DRIFT_GLITCH": "Correggi oggetti sott'acqua",
        "GAMEPLAY_SETTINGS_FIX_PICKUP_DRIFT_GLITCH_DESCRIPTION": "Risolve il problema per cui Lara a volte viene spostata quando raccoglie oggetti sott'acqua, il che può farla collidere contro i muri.",
        "GAMEPLAY_SETTINGS_FIX_QWOP_GLITCH": "Correggi errore QWOP",
        "GAMEPLAY_SETTINGS_FIX_QWOP_GLITCH_DESCRIPTION": "Risolve il problema per cui a volte Lara, saltando da piccoli gradini, provoca una strana animazione di corsa nota come stato QWOP.",
        "GAMEPLAY_SETTINGS_FIX_SHOTGUN_TARGETING": "Mira fucile migliorata",
        "GAMEPLAY_SETTINGS_FIX_SHOTGUN_TARGETING_DESCRIPTION": "Risolve il problema del fucile a pompa che a volte, quando si spara, non produce un lampo o un suono.",
        "GAMEPLAY_SETTINGS_FIX_STEP_GLITCH": "Correggi errore gradini",
        "GAMEPLAY_SETTINGS_FIX_STEP_GLITCH_DESCRIPTION": "Risolve il problema per cui Lara a volte viene spinta contro i muri adiacenti ai gradini quando corre su di loro in un certo modo.",
        "GAMEPLAY_SETTINGS_FIX_TEXTURE_ISSUES": "Correggi problemi texture",
        "GAMEPLAY_SETTINGS_FIX_TEXTURE_ISSUES_DESCRIPTION": "Risolve i problemi riguardanti texture o maglie poligonali mancanti o errate nei livelli originali.",
        "GAMEPLAY_SETTINGS_FIX_TIHOCAN_SECRET_SOUND": "Correggi suono dei segreti",
        "GAMEPLAY_SETTINGS_FIX_TIHOCAN_SECRET_SOUND_DESCRIPTION": "Impedisce la riproduzione errata del suono dei segreti quando si utilizza la chiave d'oro nella Tomba di Tihocan.",
        "GAMEPLAY_SETTINGS_FIX_WADE_WALL_HIT": "Correggi impatto muro",
        "GAMEPLAY_SETTINGS_FIX_WADE_WALL_HIT_DESCRIPTION": "Risolve il problema per cui Lara non reagisce quando urta un muro mentre guada.",
        "GAMEPLAY_SETTINGS_FIX_WALK_RUN_JUMP": "Correggi cammina corsa salto",
        "GAMEPLAY_SETTINGS_FIX_WALK_RUN_JUMP_DESCRIPTION": "Risolve il problema per cui a volte Lara non riesce a saltare immediatamente dopo essere passata dall'animazione di camminata a quella di corsa.",
        "GAMEPLAY_SETTINGS_FIX_WATER_EXIT": "Correggi uscita dall'acqua",
        "GAMEPLAY_SETTINGS_FIX_WATER_EXIT_DESCRIPTION": "Risolve il problema che permette a Lara di passare direttamente da una stanza con acqua ad una senza acqua adiacente o sottostante. Inoltre, questo impedirà a Lara di uscire dall'acqua su pendii non calpestabili.",
        "GAMEPLAY_SETTINGS_GENERAL_TAB": "Generale",
        "GAMEPLAY_SETTINGS_HARPOON_RECOIL": "Ricarica arpione",
        "GAMEPLAY_SETTINGS_HARPOON_RECOIL_DESCRIPTION": "Imposta la frequenza con cui Lara deve ricaricare il fucile ad arpione, in base al numero attuale di munizioni. Ad esempio, se impostato a 3, dovrà ricaricare dopo ogni terzo colpo. Impostare a 0 per disabilitare completamente la ricarica.",
        "GAMEPLAY_SETTINGS_LOAD_MUSIC_TRIGGERS": "Ricorda musica riprodotta",
        "GAMEPLAY_SETTINGS_LOAD_MUSIC_TRIGGERS_DESCRIPTION": "Contrassegna le tracce musicali riprodotte nel file di salvataggio, in modo che le tracce legate ad eventi non vengano rieseguite dopo il caricamento della partita.",
        "GAMEPLAY_SETTINGS_MAXIMUM_SAVE_SLOTS": "Numero slot di salvataggio",
        "GAMEPLAY_SETTINGS_MAXIMUM_SAVE_SLOTS_DESCRIPTION": "Modifica il numero di slot di salvataggio disponibili.",
        "GAMEPLAY_SETTINGS_MODS_TAB": "Modifiche",
        "GAMEPLAY_SETTINGS_REMEMBER_GUNS_BETWEEN_LEVELS": "Ricorda armi tra livelli",
        "GAMEPLAY_SETTINGS_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION": "Fa sì che Lara ricordi quale arma ha usato per ultima nel livello precedente quando inizia un nuovo livello. Se disabilitato, Lara tornerà a usare le pistole.",
        "GAMEPLAY_SETTINGS_RESTORE_PS1_ENEMIES": "Ripristina nemici PS1",
        "GAMEPLAY_SETTINGS_RESTORE_PS1_ENEMIES_DESCRIPTION": "Aggiunge la mummia che appare nella versione PlayStation della Città di Khamoon, stanza 25.\nLa modifica di questa opzione richiederà il riavvio del livello.",
        "GAMEPLAY_SETTINGS_START_LARA_HITPOINTS": "Salute iniziale di Lara",
        "GAMEPLAY_SETTINGS_START_LARA_HITPOINTS_DESCRIPTION": "Imposta il valore di salute di Lara all'inizio di ogni livello.",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE": "Dettagli statistiche",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_DESCRIPTION": "Consente di scegliere tra vari livelli di dettaglio per la visualizzazione delle statistiche.\n\n- Minimo: mostra le uccisioni, gli oggetti raccolti, i segreti e il tempo impiegato per completare il livello.\n- Dettagliato: mostra tutte le statistiche della modalità 'Minimo' e, in aggiunta, il numero massimo di uccisioni e di oggetti recuperabili di ogni livello.\n- Completo: mostra tutte le statistiche della modalità 'Dettagliato' e, in aggiunta, i colpi andati a segno, le munizioni utilizzate, i kit medici adoperati e la distanza percorsa.",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_DETAILED": "Dettagliato",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_FULL": "Completo",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_MINIMAL": "Minimo",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_FULL": "Completo",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_NONE": "Nessuno",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_SEMI": "Parziale",
        "GAMEPLAY_SETTINGS_TARGET_MODE": "Modalità aggancio bersaglio",
        "GAMEPLAY_SETTINGS_TARGET_MODE_DESCRIPTION": "Modifica il comportamento con cui le armi agganciano i bersagli.\n\n- Completo: mantieni sempre il bersaglio agganciato anche se il nemico esce dal campo visivo o muore (TR1).\n- Parziale: mantieni il bersaglio agganciato anche se il nemico esce dal campo visivo, ma lo perdi se muore.\n- Nessuno: perdi il bersaglio agganciato se il nemico esce dal campo visivo o muore (TR4+).",
        "GAMEPLAY_SETTINGS_TITLE": "Opzioni di gioco",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_FIXED": "Corretto",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_MODE": "Modalità errore muro",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_MODE_DESCRIPTION": "Consente di utilizzare il comportamento TR1 dell'errore del muro in TR2 e viceversa; consente inoltre di correggere tutti i tipi di errore del muro.",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_TR1": "TR1",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_TR2": "TR2",
        "GRAPHIC_SETTINGS_AIRBAR_COLOR": "Colore barra ossigeno",
        "GRAPHIC_SETTINGS_AIRBAR_COLOR_DESCRIPTION": "Colore utilizzato per la barra dell'ossigeno.",
        "GRAPHIC_SETTINGS_AIRBAR_LOCATION": "Posizione barra ossigeno",
        "GRAPHIC_SETTINGS_AIRBAR_LOCATION_DESCRIPTION": "Posizione in cui viene visualizzata la barra dell'ossigeno.",
        "GRAPHIC_SETTINGS_AIRBAR_SHOW_MODE": "Modalità barra ossigeno",
        "GRAPHIC_SETTINGS_AIRBAR_SHOW_MODE_DESCRIPTION": "Modifica la modalità di visualizzazione della barra dell'ossigeno.\n\n- Predefinito: mostra la barra dell'ossigeno solo in acqua e lampeggia quando l'ossigeno di Lara è pari o inferiore al 20%.\n- Predefinito, non lampeggiante: uguale all'impostazione predefinita, ma disabilita la barra lampeggiante.\n- Solo lampeggiante: mostra la barra dell'ossigeno *solo* quando l'ossigeno di Lara è pari o inferiore al 20% (per le sfide).\n- Mai: non visualizza mai la barra dell'ossigeno (per le sfide).",
        "GRAPHIC_SETTINGS_ANISOTROPY_FILTER": "Filtro anisotropico",
        "GRAPHIC_SETTINGS_ANISOTROPY_FILTER_DESCRIPTION": "Migliora il filtraggio delle texture a distanza.",
