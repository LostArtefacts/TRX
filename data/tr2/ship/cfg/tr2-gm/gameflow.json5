{
    // NOTE: bad changes to this file may result in crashes.
    // Lines starting with double slashes are comments and are ignored.

    "main_menu_picture": "data/images/title_eu_gm.webp",
    "savegame_fmt_legacy": "savegame_gm.%d",
    "savegame_fmt_bson": "save_trgm_%02d.dat",

    "demo_version": false,
    "enable_tr2_item_drops": true,
    "convert_dropped_guns": true,

    "title": {
        "path": "data/title_gm.tr2",
        "music_track": 60,
        "sequence": [
            {"type": "display_picture", "path": "data/images/legal_eu_gm.webp", "legal": true},
            {"type": "exit_to_title"},
        ],
        "inherit_injections": false,
        "injections": [
            "data/injections/font.bin",
            "data/injections/inv_background.bin",
            "data/injections/pda_model.bin",
            "data/injections/title_textures.bin",
            "data/injections/misc_sprites.bin",
        ]
    },

    "sfx_path": "data/main_gm.sfx",
    "injections": [
        "data/injections/font.bin",
        "data/injections/lara_animations.bin",
        "data/injections/pda_model.bin",
        "data/injections/pickup_aid.bin",
        "data/injections/lara_extra.bin",
        "data/injections/lara_rifle_sfx.bin",
        "data/injections/secret_models_gm.bin",
        "data/injections/misc_sprites.bin",
    ],

    "levels": [
        // 0. Legacy savegame placeholder
        {"type": "dummy"},

        // 1. The Cold War
        {
            "path": "data/level1.tr2",
            "script": "data/scripts/level1.lua",
            "music_track": 29,
            "sequence": [
                {"type": "loading_screen", "path": "data/images/gm_level1.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "give_item", "object_id": "shotgun"},
                {"type": "give_item", "object_id": "small_medipack"},
                {"type": "give_item", "object_id": "large_medipack"},
                {"type": "give_item", "object_id": "flare", "quantity": 2},
                {"type": "loop_game"},
                {"type": "play_music", "music_track": 37},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/coldwar_fd.bin",
                "data/injections/coldwar_itemrots.bin",
                "data/injections/coldwar_music_tracks.bin",
                "data/injections/coldwar_objects.bin",
                "data/injections/coldwar_textures.bin",
                "data/injections/common_pickup_meshes_gm.bin",
                "data/injections/lara_guns.bin",
                "data/injections/shark_sfx.bin",
                "data/injections/winston_model.bin",
            ],
        },

        // 2. Fool's Gold
        {
            "path": "data/level2.tr2",
            "music_track": 54,
            "sequence": [
                {"type": "loading_screen", "path": "data/images/gm_level2.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "loop_game"},
                {"type": "play_music", "music_track": 37},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/door107_sfx.bin",
                "data/injections/door108_sfx.bin",
                "data/injections/fools_itemrots.bin",
                "data/injections/fools_music_tracks.bin",
                "data/injections/fools_pickup_meshes.bin",
                "data/injections/fools_textures.bin",
                "data/injections/lara_guns.bin",
                "data/injections/winston_model.bin",
            ],
        },

        // 3. Furnace of the Gods
        {
            "path": "data/level3.tr2",
            "script": "data/scripts/level3.lua",
            "music_track": 55,
            "sequence": [
                {"type": "loading_screen", "path": "data/images/gm_level3.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "loop_game"},
                {"type": "play_music", "music_track": 37},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/furnace_itemrots.bin",
                "data/injections/lara_guns.bin",
                "data/injections/furnace_music_tracks.bin",
                "data/injections/furnace_objects.bin",
                "data/injections/furnace_pickup_meshes.bin",
                "data/injections/furnace_textures.bin",
                "data/injections/winston_model.bin",
            ],
        },

        // 4. Kingdom
        {
            "path": "data/level4.tr2",
            "script": "data/scripts/level4.lua",
            "music_track": 27,
            "sequence": [
                {"type": "loading_screen", "path": "data/images/gm_level4.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "give_item", "object_id": "puzzle_1"},
                {"type": "loop_game"},
                {"type": "play_music", "music_track": 48},
                {"type": "level_stats"},
                {"type": "display_picture", "credit": true, "path": "data/images/credit00_gm.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit01.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit02.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit03.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit04.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit05.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit06.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit07_gm.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "display_picture", "credit": true, "path": "data/images/credit08.webp", "display_time": 15, "fade_in_time": 0.5, "fade_out_time": 0.5},
                {"type": "total_stats", "background_path": "data/images/end.webp"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/common_pickup_meshes_gm.bin",
                "data/injections/door108_sfx.bin",
                "data/injections/guardian_death_commands.bin",
                "data/injections/lara_guns.bin",
                "data/injections/kingdom_cameras.bin",
                "data/injections/kingdom_itemrots.bin",
                "data/injections/kingdom_music_tracks.bin",
                "data/injections/kingdom_textures.bin",
                "data/injections/winston_model.bin",
            ],
        },

        // 5. Nightmare in Vegas
        {
            "path": "data/level5.tr2",
            "type": "bonus",
            "music_track": 30,
            "sequence": [
                {"type": "loading_screen", "path": "data/images/gm_level5.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "remove_weapons"},
                {"type": "remove_ammo"},
                {"type": "remove_flares"},
                {"type": "remove_medipacks"},
                {"type": "give_item", "object_id": "pistols"},
                {"type": "loop_game"},
                {"type": "play_music", "music_track": 37},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/common_pickup_meshes_gm.bin",
                "data/injections/door108_sfx.bin",
                "data/injections/guardian_death_commands.bin",
                "data/injections/lara_vegas_guns.bin",
                "data/injections/vegas_fd.bin",
                "data/injections/vegas_itemrots.bin",
                "data/injections/vegas_music_tracks.bin",
                "data/injections/vegas_textures.bin",
            ],
        },
    ],

    "demos": [
    ],

    "cutscenes": [
    ],

    "fmvs": [
    ],

    "hidden_config": [
        "enable_cutscenes",       // TR2G has no cutscenes
        "enable_demo",            // TR2G has no demos
        "enable_fmv",             // TR2G has no FMVs
        "enable_item_examining",  // TR2G has no special item descriptions
        "disable_trex_collision", // TR2G has no T-Rexes
        "fix_alligator_ai",       // TR2G has no alligators
        "fix_animated_sprites",
        "healthbar_poison_color",
        "healthbar_poison_color_ps1",
        "exposurebar_color",
        "exposurebar_color_ps1",
        "exposurebar_location",
        "exposurebar_show_mode",
        "change_pierre_spawn",
        "enable_save_crystals",
        "enable_ps1_crystals",
        "enable_reflections",
        "fix_chainblock_secret_sound",
        "enable_compass_stats",
        "enable_wading",
        "restore_ps1_enemies",
        "load_music_triggers",
        "fix_secrets_killing_music",
        "fix_speeches_killing_music",
        "enable_weather",
        "enable_footprints",
        "fix_monkey_pickup_priority",
    ],
}
