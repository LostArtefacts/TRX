        "GAMEPLAY_SETTINGS_DISABLE_HEALING_BETWEEN_LEVELS": "Persistent damage",
        "GAMEPLAY_SETTINGS_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Stops Lara from healing when starting a new level (for no Heal challenge runs).",
        "GAMEPLAY_SETTINGS_DISABLE_MAGNUMS": "Remove magnums",
        "GAMEPLAY_SETTINGS_DISABLE_MAGNUMS_DESCRIPTION": "Removes all magnum guns and magnum ammo pickups from the game.",
        "GAMEPLAY_SETTINGS_DISABLE_MEDPACKS": "Remove medipacks",
        "GAMEPLAY_SETTINGS_DISABLE_MEDPACKS_DESCRIPTION": "Removes all medipacks from the game (for No Meds challenge runs).",
        "GAMEPLAY_SETTINGS_DISABLE_SHOTGUN": "Remove shotgun",
        "GAMEPLAY_SETTINGS_DISABLE_SHOTGUN_DESCRIPTION": "Removes all shotgun and shotgun shell pickups from the game.",
        "GAMEPLAY_SETTINGS_DISABLE_TREX_COLLISION": "Remove dead T-Rex collision",
        "GAMEPLAY_SETTINGS_DISABLE_TREX_COLLISION_DESCRIPTION": "Removes all collision with T-Rex upon death. This helps when the T-Rex's body blocks the passage out.",
        "GAMEPLAY_SETTINGS_DISABLE_UZIS": "Remove uzis",
        "GAMEPLAY_SETTINGS_DISABLE_UZIS_DESCRIPTION": "Removes all uzi guns and uzi ammo pickups from the game.",
        "GAMEPLAY_SETTINGS_ENABLE_AUTO_ITEM_SELECTION": "Key item pre-selection",
        "GAMEPLAY_SETTINGS_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "When Lara presses action against a keyhole or puzzle slot, and she has the corresponding item in the inventory, that item will be pre-selected.",
        "GAMEPLAY_SETTINGS_ENABLE_BUFFERING": "Input buffering",
        "GAMEPLAY_SETTINGS_ENABLE_BUFFERING_DESCRIPTION": "Enables F-key (1-frame) and inventory (2-frame) buffering to achieve precise control of Lara's movement.",
        "GAMEPLAY_SETTINGS_ENABLE_CHEATS": "Cheats",
        "GAMEPLAY_SETTINGS_ENABLE_CHEATS_DESCRIPTION": "Enables various cheats:\n\n- L: immediately end the level.\n- I: give Lara all weapons; a boost of ammo and medipacks; and all plot items for the current level.\n- O: enable DOZY cheat (swimming midair).\n     - WALK key: exit DOZY.\n     - GUN key: open the closest door (doesn't work in certain places).",
        "GAMEPLAY_SETTINGS_ENABLE_COMPASS_STATS": "Level statistics in compass",
        "GAMEPLAY_SETTINGS_ENABLE_COMPASS_STATS_DESCRIPTION": "Enables showing level statistics when the compass is selected.",
        "GAMEPLAY_SETTINGS_ENABLE_CONSOLE": "Console",
        "GAMEPLAY_SETTINGS_ENABLE_CONSOLE_DESCRIPTION": "Enables the developer console.",
        "GAMEPLAY_SETTINGS_ENABLE_CUTSCENES": "Cutscenes",
        "GAMEPLAY_SETTINGS_ENABLE_CUTSCENES_DESCRIPTION": "Enables cutscenes playing.",
        "GAMEPLAY_SETTINGS_ENABLE_DEATHS_COUNTER": "Count Lara's deaths",
        "GAMEPLAY_SETTINGS_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Enables showing a deaths counter in the compass and in the level statistics. Death count is updated in the currently loaded save as soon as Lara dies.",
        "GAMEPLAY_SETTINGS_ENABLE_DEMO": "Demo mode",
        "GAMEPLAY_SETTINGS_ENABLE_DEMO_DESCRIPTION": "Enables demos showing in the main menu.",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_LOOK": "Look while running",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_LOOK_DESCRIPTION": "Allows Lara to look while running, jumping, hanging, etc. - similar to TR2 style.",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_SAVES": "Save effects",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Enhances savegames so that graphic effects, waterfall mist, flame emitters, and more are saved instead of disappearing on load.",
        "GAMEPLAY_SETTINGS_ENABLE_FMV": "FMVs",
        "GAMEPLAY_SETTINGS_ENABLE_FMV_DESCRIPTION": "Enables FMVs playing.",
        "GAMEPLAY_SETTINGS_ENABLE_GAME_MODES": "Game mode selection",
        "GAMEPLAY_SETTINGS_ENABLE_GAME_MODES_DESCRIPTION": "Allows new game plus options to be selected from the new game passport menu.\n\n- New Game+: unlocks all weapons with infinite ammo; enemies have double the HP.\n- Japanese NG: weapons do double damage and flare pickups contain 8 rather than 6.\n- Japanese NG+: combination of New Game+ and Japanese NG.",
        "GAMEPLAY_SETTINGS_ENABLE_INVERTED_LOOK": "Inverted look",
        "GAMEPLAY_SETTINGS_ENABLE_INVERTED_LOOK_DESCRIPTION": "Inverts the Y axis controls when Lara looks.",
        "GAMEPLAY_SETTINGS_ENABLE_ITEM_EXAMINING": "Item examination",
        "GAMEPLAY_SETTINGS_ENABLE_ITEM_EXAMINING_DESCRIPTION": "For custom levels - allows item descriptions to be displayed in the inventory where the level author has provided suitable data.",
        "GAMEPLAY_SETTINGS_ENABLE_JUMP_TWISTS": "Jump twists",
        "GAMEPLAY_SETTINGS_ENABLE_JUMP_TWISTS_DESCRIPTION": "Enables TR2+ style jump twists and somersaults i.e. press roll during jump and swan dive animations.",
        "GAMEPLAY_SETTINGS_ENABLE_LEAN_JUMPING": "Lean jumping",
        "GAMEPLAY_SETTINGS_ENABLE_LEAN_JUMPING_DESCRIPTION": "Allows Lara to creep forwards or backwards further when performing neutral jumps with the relevant input key pressed, similar to TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_LEGAL": "Legal screens",
        "GAMEPLAY_SETTINGS_ENABLE_LEGAL_DESCRIPTION": "Enables legal screen and Core Design FMV at the game start.",
        "GAMEPLAY_SETTINGS_ENABLE_LOADING_SCREENS": "Loading screens",
        "GAMEPLAY_SETTINGS_ENABLE_LOADING_SCREENS_DESCRIPTION": "Enables PS1 style loading screens before each level.",
        "GAMEPLAY_SETTINGS_ENABLE_NUMERIC_KEYS": "Hotkey item use",
        "GAMEPLAY_SETTINGS_ENABLE_NUMERIC_KEYS_DESCRIPTION": "Enables quick weapon draws and medipack usage.\n\n- 1: Draw pistols\n- 2: Draw shotgun\n- 3: Draw magnums\n- 4: Draw uzis\n- 8: Use small medipack\n- 9: Use large medipack",
        "GAMEPLAY_SETTINGS_ENABLE_RESPONSIVE_PASSPORT": "Responsive passport",
        "GAMEPLAY_SETTINGS_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Disables blocking user input when passport flips pages, scheduling the page flips instead.",
        "GAMEPLAY_SETTINGS_ENABLE_SAVE_CRYSTALS": "Save crystals",
        "GAMEPLAY_SETTINGS_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Limits saving to the beginning of levels and save crystals. Levels have limited, single use save crystals like the PS1 version. Changing this option will require restarting the level.",
        "GAMEPLAY_SETTINGS_ENABLE_SWING_CANCEL": "Swing cancels",
        "GAMEPLAY_SETTINGS_ENABLE_SWING_CANCEL_DESCRIPTION": "Allows Lara's ledge-swinging animation to be cancelled by letting go and quickly grabbing again, similar to TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TARGET_CHANGE": "Target change",
        "GAMEPLAY_SETTINGS_ENABLE_TARGET_CHANGE_DESCRIPTION": "Enables TR4+ target changing while aiming weapons. Press look while aiming to change targets.",
        "GAMEPLAY_SETTINGS_ENABLE_TIMER_IN_INVENTORY": "Timer counts in inventory",
        "GAMEPLAY_SETTINGS_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION": "Makes the in-game timer work even while the game is showing the inventory.",
        "GAMEPLAY_SETTINGS_ENABLE_TOTAL_STATS": "Final statistics screen",
        "GAMEPLAY_SETTINGS_ENABLE_TOTAL_STATS_DESCRIPTION": "Enables a total game statistics screen that plays after the credits.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_JUMPING": "Responsive jumping",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_JUMPING_DESCRIPTION": "Allows Lara to jump at any point while running, similar to TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIMMING": "Smooth swimming",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIMMING_DESCRIPTION": "Gives Lara's underwater turn rate an acceleration curve for smoother movement, similar to TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIM_CANCEL": "Responsive swim cancel",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION": "Allows Lara to stop more responsively underwater when the swim key is released, similar to TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR3_SIDESTEPS": "Enhanced sidesteps",
        "GAMEPLAY_SETTINGS_ENABLE_TR3_SIDESTEPS_DESCRIPTION": "Enables TR3+ style sidesteps, e.g. shift+directional arrows. Dedicated sidestep buttons will still work.",
        "GAMEPLAY_SETTINGS_ENABLE_UW_ROLL": "Underwater roll",
        "GAMEPLAY_SETTINGS_ENABLE_UW_ROLL_DESCRIPTION": "Allows Lara to roll while underwater, similar to TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_WADING": "Wading",
        "GAMEPLAY_SETTINGS_ENABLE_WADING_DESCRIPTION": "Allows Lara to wade through shallow water, similar to TR2+, rather than becoming stuck on the water surface.",
        "GAMEPLAY_SETTINGS_ENABLE_WALK_TO_ITEMS": "Animated interactions",
        "GAMEPLAY_SETTINGS_ENABLE_WALK_TO_ITEMS_DESCRIPTION": "Makes Lara walk to pickups and switches when nearby instead of teleporting to them.",
        "GAMEPLAY_SETTINGS_FIXES_TAB": "Fixes",
        "GAMEPLAY_SETTINGS_FIX_ALLIGATOR_AI": "Fix alligator AI",
        "GAMEPLAY_SETTINGS_FIX_ALLIGATOR_AI_DESCRIPTION": "Fixes alligators dealing no damage if Lara remains still in the water.",
        "GAMEPLAY_SETTINGS_FIX_ANIMATED_SPRITES": "Fix sprite animations",
        "GAMEPLAY_SETTINGS_FIX_ANIMATED_SPRITES_DESCRIPTION": "Fixes original issues in The Cistern and Tomb of Tihocan where plant sprites in water areas do not animate.",
        "GAMEPLAY_SETTINGS_FIX_BEAR_AI": "Fix bear AI",
        "GAMEPLAY_SETTINGS_FIX_BEAR_AI_DESCRIPTION": "Fixes the bear pat attack in The Golden Mask so it does not miss Lara.",
        "GAMEPLAY_SETTINGS_FIX_BRIDGE_COLLISION": "Fix bridge collision",
        "GAMEPLAY_SETTINGS_FIX_BRIDGE_COLLISION_DESCRIPTION": "Fixes Lara not being able to grab parts of some bridges and invisible walls at the edge. Also fixes collision issues with drawbridges, trapdoors, and bridges when stacked over each other, over slopes, and near the ground.",
        "GAMEPLAY_SETTINGS_FIX_DESCENDING_GLITCH": "Fix breakable floor falls",
        "GAMEPLAY_SETTINGS_FIX_DESCENDING_GLITCH_DESCRIPTION": "Fixes sidestepping and walking backwards on breakable tiles causing Lara to immediately descend to the tile underneath.",
        "GAMEPLAY_SETTINGS_FIX_FLARE_THROW_PRIORITY": "Fix flare throw priority",
        "GAMEPLAY_SETTINGS_FIX_FLARE_THROW_PRIORITY_DESCRIPTION": "Fixes Lara prioritising throwing a spent flare while in mid-air, which can lead to being unable to grab ledges.",
        "GAMEPLAY_SETTINGS_FIX_FLOOR_DATA_ISSUES": "Fix floor data issues",
        "GAMEPLAY_SETTINGS_FIX_FLOOR_DATA_ISSUES_DESCRIPTION": "Fixes original issues with floor data/triggers.",
        "GAMEPLAY_SETTINGS_FIX_FREE_FLARE_GLITCH": "Fix free flare glitch",
        "GAMEPLAY_SETTINGS_FIX_FREE_FLARE_GLITCH_DESCRIPTION": "Fixes the ability to spawn a free flare when pressing the flare input while picking up any item.",
        "GAMEPLAY_SETTINGS_FIX_GLIDE_CAMERAS": "Fix glide cameras",
        "GAMEPLAY_SETTINGS_FIX_GLIDE_CAMERAS_DESCRIPTION": "Fixes glide cameras to respect the timer set in level triggers rather than defaulting the speed after the first frame.",
        "GAMEPLAY_SETTINGS_FIX_ITEM_DUPLICATION_GLITCH": "Fix item duplication glitch",
        "GAMEPLAY_SETTINGS_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION": "Fixes the ability to duplicate usage of key items in the inventory.",
        "GAMEPLAY_SETTINGS_FIX_ITEM_ROTS": "Fix item rotation issues",
        "GAMEPLAY_SETTINGS_FIX_ITEM_ROTS_DESCRIPTION": "Fixes original issues with some incorrectly rotated pickups when using the 3D pickups option.",
        "GAMEPLAY_SETTINGS_FIX_M16_ACCURACY": "Fix M16 accuracy",
        "GAMEPLAY_SETTINGS_FIX_M16_ACCURACY_DESCRIPTION": "Fixes the accuracy of the M16 while Lara is running.",
        "GAMEPLAY_SETTINGS_FIX_PICKUP_DRIFT_GLITCH": "Fix pickup drift glitch",
        "GAMEPLAY_SETTINGS_FIX_PICKUP_DRIFT_GLITCH_DESCRIPTION": "Fixes Lara sometimes drifting when collecting underwater items, which can push her into walls.",
        "GAMEPLAY_SETTINGS_FIX_QWOP_GLITCH": "Fix QWOP glitch",
        "GAMEPLAY_SETTINGS_FIX_QWOP_GLITCH_DESCRIPTION": "Fixes Lara jumping on small steps sometimes resulting in a weird running animation, known as a QWOP state.",
        "GAMEPLAY_SETTINGS_FIX_SHOTGUN_TARGETING": "Enhanced shotgun targeting",
        "GAMEPLAY_SETTINGS_FIX_SHOTGUN_TARGETING_DESCRIPTION": "Fixes the shotgun firing when drawn that occasionally fails to produce a flash or sound.",
        "GAMEPLAY_SETTINGS_FIX_STEP_GLITCH": "Fix step glitch",
        "GAMEPLAY_SETTINGS_FIX_STEP_GLITCH_DESCRIPTION": "Fixes Lara sometimes being pushed into walls adjacent to steps when running up them in a specific way.",
        "GAMEPLAY_SETTINGS_FIX_TEXTURE_ISSUES": "Fix texture issues",
        "GAMEPLAY_SETTINGS_FIX_TEXTURE_ISSUES_DESCRIPTION": "Fixes original issues with missing or incorrect textures/meshes.",
        "GAMEPLAY_SETTINGS_FIX_TIHOCAN_SECRET_SOUND": "Fix chain block sound",
        "GAMEPLAY_SETTINGS_FIX_TIHOCAN_SECRET_SOUND_DESCRIPTION": "Prevents the secret sound from incorrectly playing when using the golden key in Tomb of Tihocan.",
        "GAMEPLAY_SETTINGS_FIX_WALK_RUN_JUMP": "Fix walk run jump",
        "GAMEPLAY_SETTINGS_FIX_WALK_RUN_JUMP_DESCRIPTION": "Fixes Lara at times not being able to jump immediately after going from her walking to running animation.",
        "GAMEPLAY_SETTINGS_FIX_WALL_JUMP_GLITCH": "Fix wall jump glitch",
        "GAMEPLAY_SETTINGS_FIX_WALL_JUMP_GLITCH_DESCRIPTION": "Fixes Lara jumping through objects and moving up certain slopes.",
        "GAMEPLAY_SETTINGS_GENERAL_TAB": "General",
        "GAMEPLAY_SETTINGS_LOAD_MUSIC_TRIGGERS": "Fix one-shot music triggers",
        "GAMEPLAY_SETTINGS_LOAD_MUSIC_TRIGGERS_DESCRIPTION": "Loads previously triggered, one shot music so one shot music tracks do not replay.",
        "GAMEPLAY_SETTINGS_MAXIMUM_SAVE_SLOTS": "Number of save slots",
        "GAMEPLAY_SETTINGS_MAXIMUM_SAVE_SLOTS_DESCRIPTION": "Changes the number of available save slots.",
        "GAMEPLAY_SETTINGS_MODS_TAB": "Mods",
        "GAMEPLAY_SETTINGS_REMEMBER_GUNS_BETWEEN_LEVELS": "Remember guns between levels",
        "GAMEPLAY_SETTINGS_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION": "Makes Lara remember which gun she was using last in the previous level when starting a new level. If disabled, Lara will revert to pistols.",
        "GAMEPLAY_SETTINGS_RESTORE_PS1_ENEMIES": "Restore PS1 enemies",
        "GAMEPLAY_SETTINGS_RESTORE_PS1_ENEMIES_DESCRIPTION": "Adds the mummy that appears in the PlayStation version of City of Khamoon, room 25.\nChanging this option will require restarting the level.",
        "GAMEPLAY_SETTINGS_START_LARA_HITPOINTS": "Lara's starting health",
        "GAMEPLAY_SETTINGS_START_LARA_HITPOINTS_DESCRIPTION": "Sets Lara's health value for the beginning of each level.",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE": "Statistics details",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_DESCRIPTION": "Allows various levels of stat detail.\n\n- Minimal: shows kills, pickups, secrets, and time taken.\n- Detailed: shows all stats from minimal as well as the maximum pickup count and kill count of each level.\n- Full: shows all stats from detailed as well as ammo hits, ammo used, health packs used, and distance travelled.",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_DETAILED": "Detailed",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_FULL": "Full",
        "GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_MINIMAL": "Minimal",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_FULL": "Full lock",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_NONE": "No lock",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_SEMI": "Semi lock",
        "GAMEPLAY_SETTINGS_TARGET_MODE": "Weapon lock mode",
        "GAMEPLAY_SETTINGS_TARGET_MODE_DESCRIPTION": "Changes the behavior of how weapons lock onto targets.\n\n- Full lock: always keep target lock even if the enemy moves out of sight or dies (OG TR1).\n- Semi lock: keep target lock if the enemy moves out of sight but lose target lock if the enemy dies.\n- No lock: lose target lock if the enemy goes out of sight or dies (TR4+).",
        "GAMEPLAY_SETTINGS_TITLE": "Gameplay Options",
        "GRAPHIC_SETTINGS_AIRBAR_COLOR": "Airbar color",
        "GRAPHIC_SETTINGS_AIRBAR_COLOR_DESCRIPTION": "Color of the airbar.",
        "GRAPHIC_SETTINGS_AIRBAR_LOCATION": "Airbar location",
        "GRAPHIC_SETTINGS_AIRBAR_LOCATION_DESCRIPTION": "Location where the airbar is displayed.",
        "GRAPHIC_SETTINGS_AIRBAR_SHOW_MODE": "Airbar mode",
        "GRAPHIC_SETTINGS_AIRBAR_SHOW_MODE_DESCRIPTION": "Changes how the airbar is displayed.\n\n- Default: show the airbar only in the water and flash the airbar when Lara's oxygen is 20% or below.\n- Default, no flashing: same as default, but disable flashing.\n- Flashing only: show the airbar *only* when Lara's oxygen is 20% or below (for challenge runs).\n- Never: never display the airbar (for challenge runs).",
        "GRAPHIC_SETTINGS_ANISOTROPY_FILTER": "Anisotropy filter",
        "GRAPHIC_SETTINGS_ANISOTROPY_FILTER_DESCRIPTION": "Enhances texture filtering at distances.",
        "GRAPHIC_SETTINGS_ASPECT_MODE": "Aspect mode",
        "GRAPHIC_SETTINGS_ASPECT_MODE_16_9": "16:9",
        "GRAPHIC_SETTINGS_ASPECT_MODE_4_3": "4:3",
        "GRAPHIC_SETTINGS_ASPECT_MODE_ANY": "Any",
        "GRAPHIC_SETTINGS_ASPECT_MODE_DESCRIPTION": "Forces certain game aspect ratios with letterbox.",
        "GRAPHIC_SETTINGS_BAR_COLOR_BLUE": "Blue",
        "GRAPHIC_SETTINGS_BAR_COLOR_BLUE2": "Blue 2",
        "GRAPHIC_SETTINGS_BAR_COLOR_GOLD": "Gold",
        "GRAPHIC_SETTINGS_BAR_COLOR_GOLD2": "Gold 2",
        "GRAPHIC_SETTINGS_BAR_COLOR_GREEN": "Green",
        "GRAPHIC_SETTINGS_BAR_COLOR_GREY": "Grey",
        "GRAPHIC_SETTINGS_BAR_COLOR_PINK": "Pink",
        "GRAPHIC_SETTINGS_BAR_COLOR_PURPLE": "Purple",
        "GRAPHIC_SETTINGS_BAR_COLOR_RED": "Red",
        "GRAPHIC_SETTINGS_BAR_COLOR_SILVER": "Silver",
        "GRAPHIC_SETTINGS_BAR_LOCATION_BOTTOM_CENTER": "Bottom center",
        "GRAPHIC_SETTINGS_BAR_LOCATION_BOTTOM_LEFT": "Bottom left",
        "GRAPHIC_SETTINGS_BAR_LOCATION_BOTTOM_RIGHT": "Bottom right",
        "GRAPHIC_SETTINGS_BAR_LOCATION_TOP_CENTER": "Top center",
        "GRAPHIC_SETTINGS_BAR_LOCATION_TOP_LEFT": "Top left",
        "GRAPHIC_SETTINGS_BAR_LOCATION_TOP_RIGHT": "Top right",
        "GRAPHIC_SETTINGS_BAR_MODE_ALWAYS": "Always",
        "GRAPHIC_SETTINGS_BAR_MODE_BOSS_ONLY": "Boss only",
        "GRAPHIC_SETTINGS_BAR_MODE_DEFAULT": "Default",
        "GRAPHIC_SETTINGS_BAR_MODE_FLASHING_ONLY": "Flashing only",
        "GRAPHIC_SETTINGS_BAR_MODE_FLASHING_OR_DEFAULT": "Default or flashing",
        "GRAPHIC_SETTINGS_BAR_MODE_NEVER": "Never",
        "GRAPHIC_SETTINGS_BAR_MODE_PS1": "Default, no flashing",
        "GRAPHIC_SETTINGS_BILINEAR": "Bilinear",
        "GRAPHIC_SETTINGS_BRIGHTNESS": "Brightness",
        "GRAPHIC_SETTINGS_BRIGHTNESS_DESCRIPTION": "Changes game brightness.",
        "GRAPHIC_SETTINGS_CAMERA_MODE": "Camera mode",
        "GRAPHIC_SETTINGS_CAMERA_MODE_DESCRIPTION": "Adjusts how camera behaves during actions like using keys.",
        "GRAPHIC_SETTINGS_CAMERA_MODE_TR1": "TR1",
        "GRAPHIC_SETTINGS_CAMERA_MODE_TR2": "TR2",
        "GRAPHIC_SETTINGS_DEPTH_BUFFER": "Z-Buffer",
        "GRAPHIC_SETTINGS_DEPTH_BUFFER_DESCRIPTION": "Turns the depth buffer on or off. Best kept on.",
        "GRAPHIC_SETTINGS_ENABLE_3D_PICKUPS": "3D pickups",
        "GRAPHIC_SETTINGS_ENABLE_3D_PICKUPS_DESCRIPTION": "Enables 3D models to be rendered in place of the sprites for pickup items.",
        "GRAPHIC_SETTINGS_ENABLE_BRAID": "Lara's braid",
        "GRAPHIC_SETTINGS_ENABLE_BRAID_DESCRIPTION": "Enables Lara's braid.",
        "GRAPHIC_SETTINGS_ENABLE_BREEZE": "Breeze",
        "GRAPHIC_SETTINGS_ENABLE_BREEZE_DESCRIPTION": "Enables the breeze effect on Lara's braid in appropriate rooms.",
        "GRAPHIC_SETTINGS_ENABLE_EXIT_FADE_EFFECTS": "Fade on game exit",
        "GRAPHIC_SETTINGS_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION": "Enables the fade effects when exiting the game to desktop.",
        "GRAPHIC_SETTINGS_ENABLE_FADE_EFFECTS": "Fade effects",
        "GRAPHIC_SETTINGS_ENABLE_FADE_EFFECTS_DESCRIPTION": "Enable fade transitions, for example between credit graphics or for inventory and pause screen transitions.",
        "GRAPHIC_SETTINGS_ENABLE_GUN_LIGHTING": "Gun lighting",
        "GRAPHIC_SETTINGS_ENABLE_GUN_LIGHTING_DESCRIPTION": "Enables dynamic lighting to be generated for gunshots and explosions.",
        "GRAPHIC_SETTINGS_ENABLE_PICKUP_AIDS": "Pickup aids",
        "GRAPHIC_SETTINGS_ENABLE_PICKUP_AIDS_DESCRIPTION": "Enables an intermittent twinkling effect near pickup items to highlight their presence.",
        "GRAPHIC_SETTINGS_ENABLE_PS1_CRYSTALS": "PS1 crystal tint",
        "GRAPHIC_SETTINGS_ENABLE_PS1_CRYSTALS_DESCRIPTION": "Save crystals will be drawn with a purple tint, more similar to the PS1 type.",
        "GRAPHIC_SETTINGS_ENABLE_ROUND_SHADOW": "Round shadows",
        "GRAPHIC_SETTINGS_ENABLE_ROUND_SHADOW_DESCRIPTION": "Enables round shadows instead of the default octagonal ones.",
        "GRAPHIC_SETTINGS_ENABLE_SHOTGUN_FLASH": "Shotgun flash",
        "GRAPHIC_SETTINGS_ENABLE_SHOTGUN_FLASH_DESCRIPTION": "Draws flames when firing the shotgun, like for other guns.",
        "GRAPHIC_SETTINGS_ENABLE_SKYBOX": "Skyboxes",
        "GRAPHIC_SETTINGS_ENABLE_SKYBOX_DESCRIPTION": "Enables the skybox in supported levels.",
        "GRAPHIC_SETTINGS_ENABLE_SMOOTH_BARS": "Smooth bars",
        "GRAPHIC_SETTINGS_ENABLE_SMOOTH_BARS_DESCRIPTION": "Makes the health, air and enemy bars use smooth color transitions.",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_COLOR": "Enemy bar color",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_COLOR_DESCRIPTION": "Color of the enemy healthbar.",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_LOCATION": "Enemy bar location",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION": "Location where the enemy healthbar is displayed.",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_SHOW_MODE": "Enemy bar mode",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Enables showing a healthbar for the active enemy.",
        "GRAPHIC_SETTINGS_FBO_FILTER": "FBO filter",
        "GRAPHIC_SETTINGS_FBO_FILTER_DESCRIPTION": "Switches smooth or pixel look for the whole screen.",
        "GRAPHIC_SETTINGS_FOG_END": "Fog end",
        "GRAPHIC_SETTINGS_FOG_END_DESCRIPTION": "Sets distance in tiles where fog makes everything fully obscured.",
        "GRAPHIC_SETTINGS_FOG_START": "Fog start",
        "GRAPHIC_SETTINGS_FOG_START_DESCRIPTION": "Sets distance in tiles where fog begins to appear.",
        "GRAPHIC_SETTINGS_FOV": "Field of view",
        "GRAPHIC_SETTINGS_FOV_DESCRIPTION": "The desired field of view in degrees, which overrides the hardcoded default. The default values are 80 (horizontal) and 65 (vertical).",
        "GRAPHIC_SETTINGS_FOV_VERTICAL": "Vertical FOV",
        "GRAPHIC_SETTINGS_FOV_VERTICAL_DESCRIPTION": "Interprets the field of view as vertical instead of horizontal. May be advantageous for widescreen resolutions, especially for multi-screen setups, since it distorts the left and right side instead of cropping away the top and bottom part of the screen.",
        "GRAPHIC_SETTINGS_FPS": "FPS",
        "GRAPHIC_SETTINGS_FPS_DESCRIPTION": "Sets game frames per second.",
        "GRAPHIC_SETTINGS_HEALTHBAR_COLOR": "Healthbar color",
        "GRAPHIC_SETTINGS_HEALTHBAR_COLOR_DESCRIPTION": "Color of the healthbar.",
        "GRAPHIC_SETTINGS_HEALTHBAR_LOCATION": "Healthbar location",
        "GRAPHIC_SETTINGS_HEALTHBAR_LOCATION_DESCRIPTION": "Location where the healthbar is displayed.",
        "GRAPHIC_SETTINGS_HEALTHBAR_SHOW_MODE": "Healthbar mode",
        "GRAPHIC_SETTINGS_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Changes how the healthbar is displayed.\n\n- Default: show the healthbar at the start of a level, when hit, or when weapons are equipped; flash if 20% or below.\n- Default, no flashing: same as default, but disable flashing.\n- Default or flashing: same as default, except show it even if it's flashing.\n- Flashing only: show the healthbar *only* when Lara's health is 20% or below (for challenge runs).\n- Always: always show the healthbar.\n- Never: never display the healthbar (for challenge runs).",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST": "Lighting contrast",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_DESCRIPTION": "Boosts contrast for dynamic light sources such as flares and gun flashes.",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_HIGH": "High",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_LOW": "Low",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_MEDIUM": "Medium",
        "GRAPHIC_SETTINGS_MENU_STYLE": "Menu style",
        "GRAPHIC_SETTINGS_MENU_STYLE_DESCRIPTION": "Changes how menus are displayed.\n\n - PC: UI style matches the PC version.\n - PS1: UI style matches the PS1 version.",
        "GRAPHIC_SETTINGS_REFLECTIONS": "Reflections",
        "GRAPHIC_SETTINGS_REFLECTIONS_DESCRIPTION": "Enables reflections on certain objects.",
        "GRAPHIC_SETTINGS_RENDERING_TAB": "Rendering",
        "GRAPHIC_SETTINGS_RENDER_MODE": "Render mode",
        "GRAPHIC_SETTINGS_RENDER_MODE_DESCRIPTION": "Chooses rendering with CPU (slower, more oldschool) or GPU (faster and better).",
        "GRAPHIC_SETTINGS_RENDER_MODE_FBO": "Framebuffer",
        "GRAPHIC_SETTINGS_RENDER_MODE_HARDWARE": "Hardware",
        "GRAPHIC_SETTINGS_RENDER_MODE_LEGACY": "Window size",
        "GRAPHIC_SETTINGS_RENDER_MODE_SOFTWARE": "Software",
        "GRAPHIC_SETTINGS_RESOLUTION": "Resolution",
        "GRAPHIC_SETTINGS_RESOLUTION_DESCRIPTION": "Overrides game resolution.",
        "GRAPHIC_SETTINGS_SCALER": "Scaler",
        "GRAPHIC_SETTINGS_SCALER_DESCRIPTION": "Upscales game by a set factor, maintaining pixellated look.",
        "GRAPHIC_SETTINGS_SCREENSHOT_FORMAT": "Screeenshot format",
        "GRAPHIC_SETTINGS_SCREENSHOT_FORMAT_DESCRIPTION": "Screenshot file format.",
