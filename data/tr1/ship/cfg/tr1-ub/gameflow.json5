{
    // NOTE: bad changes to this file may result in crashes.
    // Lines starting with double slashes are comments and are ignored.

    "main_menu_picture": "data/images/title_ub.webp",
    "savegame_file_fmt": "save_trub_%02d.dat",

    "injections": [
        "data/injections/braid.bin",
        "data/injections/bubbles.bin",
        "data/injections/gun_glow.bin",
        "data/injections/lara_animations.bin",
        "data/injections/lara_guns.bin",
        "data/injections/uzi_sfx.bin",
        "data/injections/explosion.bin",
        "data/injections/pickup_aid.bin",
        "data/injections/sprite_alignment.bin",
        "data/injections/pda_model.bin",
        "data/injections/font.bin",
        "data/injections/winston_model.bin",
        "data/injections/misc_sprites.bin",
        "data/injections/lara_outfits.bin",
    ],

    "enable_tr2_item_drops": false,
    "convert_dropped_guns": false,

    "enforced_config": {
        "enable_save_crystals": false,
        "fix_water_exit": false,
    },

    "title": {
        "path": "data/title.phd",
        "music_track": 2,
        "inherit_injections": false,
        "injections": [
            "data/injections/pda_model.bin",
            "data/injections/font.bin",
            "data/injections/title_textures.bin",
            "data/injections/misc_sprites.bin",
        ],
        "sequence": [
            {"type": "display_picture", "path": "data/images/eidos.webp", "legal": true, "display_time": 1, "fade_in_time": 1.0, "fade_out_time": 1.0},
            {"type": "play_fmv", "fmv_id": 0},
            {"type": "play_fmv", "fmv_id": 1},
            {"type": "exit_to_title"},
        ],
    },

    "levels": [
        // Level 1: Return to Egypt
        {
            "path": "data/egypt.phd",
            "music_track": 59,
            "lara_skin_type": "skin_type_02",
            "sequence": [
                {"type": "loading_screen", "path": "data/images/ub_loading1.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "loop_game"},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/egypt_cameras.bin",
                "data/injections/egypt_fd.bin",
                "data/injections/egypt_itemrots.bin",
                "data/injections/egypt_meshfixes.bin",
                "data/injections/egypt_textures.bin",
                "data/injections/panther_sfx.bin",
            ],
            "unobtainable_kills": 1,
        },

        // Level 2: Temple of the Cat
        {
            "path": "data/cat.phd",
            "music_track": 59,
            "lara_skin_type": "skin_type_02",
            "sequence": [
                {"type": "loading_screen", "path": "data/images/ub_loading1.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "loop_game"},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/cat_cameras.bin",
                "data/injections/cat_fd.bin",
                "data/injections/cat_itemrots.bin",
                "data/injections/cat_meshfixes.bin",
                "data/injections/cat_textures.bin",
                "data/injections/panther_sfx.bin",
            ],
            "unobtainable_pickups": 1,
        },

        // Level 3: Atlantean Stronghold
        {
            "path": "data/end.phd",
            "music_track": 60,
            "lara_skin_type": "skin_type_02",
            "sequence": [
                {"type": "loading_screen", "path": "data/images/ub_loading2.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "loop_game"},
                {"type": "level_stats"},
                {"type": "level_complete"},
            ],
            "injections": [
                "data/injections/door61_sfx.bin",
                "data/injections/stronghold_fd.bin",
                "data/injections/stronghold_itemrots.bin",
                "data/injections/stronghold_textures.bin",
            ],
            "unobtainable_kills": 1,
        },

        // Level 4: The Hive
        {
            "path": "data/end2.phd",
            "music_track": 60,
            "lara_skin_type": "skin_type_02",
            "sequence": [
                {"type": "loading_screen", "path": "data/images/ub_loading2.webp", "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "loop_game"},
                {"type": "level_stats"},
                {"type": "play_music", "music_track": 19},
                {"type": "display_picture", "credit": true, "path": "data/images/end.webp", "display_time": 7.5, "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "display_picture", "credit": true, "path": "data/images/credits_ub.webp", "display_time": 7.5, "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "display_picture", "credit": true, "path": "data/images/credits_1.webp", "display_time": 7.5, "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "display_picture", "credit": true, "path": "data/images/credits_2.webp", "display_time": 7.5, "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "display_picture", "credit": true, "path": "data/images/credits_3.webp", "display_time": 7.5, "fade_in_time": 1.0, "fade_out_time": 1.0},
                {"type": "total_stats", "background_path": "data/images/install.webp"},
                {"type": "exit_to_title"},
            ],
            "injections": [
                "data/injections/hive_fd.bin",
                "data/injections/hive_itemrots.bin",
                "data/injections/hive_textures.bin",
            ],
        },

        {"type": "dummy"},

        // Level 6: Current Position
        // This level is necessary to read TombATI's save files.
        {
            "path": "data/current.phd",
            "type": "current",
            "music_track": 0,
            "inherit_injections": false,
            "sequence": [{"type": "exit_to_title"}],
        },
    ],

    "fmvs": [
        {"path": "fmv/core.avi", "legal": true},
        {"path": "fmv/escape.avi", "legal": true},
    ],

    "hidden_config": [
        "enable_cutscenes",       // UB has no cutscenes
        "enable_demo",            // UB has no demos
        "enable_save_crystals",   // UB has no save crystals
        "enable_ps1_crystals",    // UB has no save crystals
        "enable_item_examining",  // UB has no special item descriptions
        "enable_reflections",     // UB has no reflective objects
        "healthbar_poison_color",
        "healthbar_poison_color_ps1",
        "enemy_healthbar_color_allies",
        "enemy_healthbar_color_allies_ps1",
        "exposurebar_color",
        "exposurebar_color_ps1",
        "exposurebar_location",
        "exposurebar_show_mode",
        "fix_water_exit",
        "change_pierre_spawn",
        "fix_bear_ai",
        "fix_monkey_pickup_priority",
        "restore_ps1_enemies",
        "disable_trex_collision",
        "fix_tihocan_secret_sound",
        "fix_animated_sprites",
        "fix_glide_cameras",
        "enable_ally_targeting",
        "enable_weather",
        "enable_footprints",
        "ally_hostility_policy",
    ],
}
