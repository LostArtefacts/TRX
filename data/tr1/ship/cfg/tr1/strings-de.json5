    "game_strings": {
        "ENUM_INPUT_ROLE_EQUIP_MAGNUMS": "Equip Magnums",
        "MISC_EMPTY_SLOT_FMT": "- Leerer SLOT %d -",
        "PASSPORT_RESTART_LEVEL": "Level Neu starten",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Erlaubt  die Auswahl der 'Neues Spiel Plus'-Optionen 'im Neues Spiel'-Ausweis-Menü.\n\n- Neues Spiel+: schaltet alle Waffen mit unendlich Munition frei; Feinde haben verdoppelte Lebensenergie.\n- Japanisch NS: Waffen verursachen doppelten Schaden und Fackel-Pickups enhalten 8 statt 6 Fackeln.\n- Japanisch NS+: eine Kombination aus Neus Spiel+ und Japanisch NS.",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Aktiviert die Verwendung von dynamischer Beleuchtung für Schüsse und Explosionen., ähnlich wie in TR2+.",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "Fixt originale Fehler in Die Zisterne und Grab des Tihocan, bei denen Pflanzen-Sprites in Wassergebieten nicht animiert sind.",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Fixt, dass die aufrecht stehend ausgeführten Prankenhiebe von Bären Lara nicht mehr verfehlen.",
        "SETTING_FIX_SHOTGUN_TARGETING_DESCRIPTION": "Sorgt dafür, dass die Schrotflinte nicht mehr schiesst, wenn anvisierte Ziele sich aus dem Sichtfeld von Lara bewegen, ähnlich wie bei anderen Waffen.",
        "STATS_AMMO": "Munition Treffer/Verbraucht",
        "STATS_DEATHS": "Tode",
        "STATS_DISTANCE_TRAVELLED": "Zurückgelegte Distanz",
        "STATS_KILLS": "Besiegte Gegner",
        "STATS_LEVEL": "Level",
        "STATS_MEDIPACKS_USED": "Benötigte Medi-Packs",
