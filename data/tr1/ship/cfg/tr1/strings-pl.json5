    "game_strings": {
        "ENUM_INPUT_ROLE_EQUIP_MAGNUMS": "Wyposaż magnumy",
        "MISC_EMPTY_SLOT_FMT": "- PUSTY SLOT %d -",
        "PASSPORT_RESTART_LEVEL": "Restartuj poziom",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Pozwala na wybór opcji trybu przy rozpoczynaniu nowej gry.\n\n- Nowa Gra+: odblokowuje wszystkie bronie z nieskończoną amunicją; przeciwnicy mają podwójne zdrowie.\n- Japońska NG: bronie zadają podwójne obrażenia.\n- Japońska NG+: połączenie Nowej Gry+ i Japońskiej NG.",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Włącza dynamiczne oświetlenie przy strzelaniu z broni i eksplozjach, podobnie jak w TR2+.",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "Naprawia błędy oryginalnej gry w Rezerwuarze i Grobowcu Tihocana, gdzie glony w wodnych obszarach nie są animowane.",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Naprawia atak niedźwiedzia, aby nie chybiał Lary.",
        "SETTING_FIX_SHOTGUN_TARGETING_DESCRIPTION": "Sprawia, że Lara już nie strzela ze strzelby, gdy aktywny cel wychodzi z jej pola widzenia, co przybliża zachowanie strzelby do pozostałych broni.",
        "STATS_AMMO": "AMUNICJA/TRAFIENIA",
        "STATS_DEATHS": "ŚMIERCI",
        "STATS_DISTANCE_TRAVELLED": "PRZEBYTA ODLEGŁOŚĆ",
        "STATS_KILLS": "ZABÓJSTWA",
        "STATS_LEVEL": "POZIOM",
        "STATS_MEDIPACKS_USED": "UŻYTE APTECZKI",
        "STATS_PICKUPS": "PRZEDMIOTY",
        "STATS_SECRETS": "SEKRETY",
        "STATS_TIME_TAKEN": "SPĘDZONY CZAS",
    }
