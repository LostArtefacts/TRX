    "game_strings": {
        "ENUM_INPUT_ROLE_EQUIP_MAGNUMS": "Equip Magnums",
        "MISC_EMPTY_SLOT_FMT": "- EMPTY SLOT %d -",
        "PASSPORT_RESTART_LEVEL": "Restart Level",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Allows new game plus options to be selected from the new game passport menu.\n\n- New Game+: unlocks all weapons with infinite ammo; enemies have double the HP.\n- Japanese NG: weapons do double damage.\n- Japanese NG+: combination of New Game+ and Japanese NG.",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Enables dynamic lighting to be generated for gunshots and explosions, similar to TR2+.",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "Fixes original issues in The Cistern and Tomb of Tihocan where plant sprites in water areas do not animate.",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Fixes the bear pat attack so it does not miss Lara.",
        "SETTING_FIX_SHOTGUN_TARGETING_DESCRIPTION": "Makes the shotgun no longer fire when a locked target moves out of Lara's sight, similar to other guns.",
        "STATS_AMMO": "AMMO HITS/USED",
        "STATS_DEATHS": "DEATHS",
        "STATS_DISTANCE_TRAVELLED": "DISTANCE TRAVELED",
        "STATS_KILLS": "KILLS",
        "STATS_LEVEL": "LEVEL",
        "STATS_MEDIPACKS_USED": "HEALTH PACKS USED",
