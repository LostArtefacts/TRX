    "game_strings": {
        "ENUM_INPUT_ROLE_EQUIP_MAGNUMS": "Магнумы",
        "MISC_EMPTY_SLOT_FMT": "- ПУСТОЙ СЛОТ %d -",
        "PASSPORT_RESTART_LEVEL": "Перезапустить уровень",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Позволяет выбирать дополнительные режимы игры в меню паспорта новой игры.\n\n- Новая игра+: разблокирует всё оружие с бесконечным боезапасом; у врагов вдвое больше здоровья.\n- Японская новая игра: оружие наносит двойной урон и сигнальных ракет 8, а не 6.\n- Японская новая игра+: комбинация Новой игры+ и Японской новой игры.",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Позволяет генерировать динамическое освещение для выстрелов и взрывов, аналогично TR2+.",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "Исправляет изначальные проблемы в Цистерне и Гробнице Тихокана, из-за которых спрайты растений в водных зонах не анимировались.",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Исправляет медвежью атаку, чтобы она не промахивалась по Ларе.",
        "SETTING_FIX_SHOTGUN_TARGETING_DESCRIPTION": "Дробовик больше не стреляет, если захваченная цель выходит из поля зрения Лары, как и в случае с другим оружием.",
        "STATS_AMMO": "Попадания/выстрелы",
