        "SETTING_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Cuiridh seo bàr-shlàinte an nàmhaid gnìomhaich an comas.",
        "SETTING_EXPOSUREBAR_COLOR": "Dath bàr-fuachd",
        "SETTING_EXPOSUREBAR_COLOR_DESCRIPTION": "Dath a' bhàir ann an uisge fuair.",
        "SETTING_EXPOSUREBAR_LOCATION": "Suidheachadh bàr-fuachd",
        "SETTING_EXPOSUREBAR_LOCATION_DESCRIPTION": "Far a nochdas am bàr-fuachd air an sgrion.",
        "SETTING_FIX_ALLIGATOR_AI": "Càraich AI ailigeutair",
        "SETTING_FIX_ALLIGATOR_AI_DESCRIPTION": "Càradh far nach dèan ailigeutairean milleadh ma dh'fhanas Lara fhathast anns an uisge.",
        "SETTING_FIX_ANIMATED_SPRITES": "Càraich beòthachaidhean spraidean",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "Ceartachaidh nan sprìodan lusan fo uisge tùsail gus an gluasad gu ceart ann an raointean uisge.",
        "SETTING_FIX_BEAR_AI": "Càraich AI mathain",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Càraichidh seo ionnsaigh a' mhathain gus nach caill e Lara.",
        "SETTING_FIX_BRIDGE_COLLISION": "Càraich buaidh dhrochaidean",
        "SETTING_FIX_BRIDGE_COLLISION_DESCRIPTION": "Càradh far nach urrainn do Lara grèim fhaighinn air cuid de dhrochaidean, agus bugan le ballachan neo-fhaicsinneach. Càraidh seo cuideachd duilgheadasan le drochaidean, dorsan-trapa is làr-lùbte nuair a tha iad air an cur thairis air chèile neo ri talamh claon.",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND": "Càraich fuaim bloca slabhraidh",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND_DESCRIPTION": "Cuiridh seo casg air fuaim dìomhaireachd a chluich gu ceàrr nuair a thèid an iuchair òir a chleachdadh ann an Uaigh Tihocan.",
        "SETTING_FIX_DESCENDING_GLITCH": "Càraich tuiteam air leacan bristeach",
        "SETTING_FIX_DESCENDING_GLITCH_DESCRIPTION": "Càradh far am bi Lara a' tuiteam gu sgiobalta tro leacan briste nuair a dhèanas i ceum-taoibh neo coiseachd air ais orra.",
        "SETTING_FIX_FLARE_THROW_PRIORITY": "Càraich prìomhachas tilgeadh lòchran",
        "SETTING_FIX_FLARE_THROW_PRIORITY_DESCRIPTION": "Càradh far am bi Lara a' feuchainn ri lòchran a thilgeil ann am meadhan leum, a' cur casg air grèim air iomallan.",
        "SETTING_FIX_FLOOR_DATA_ISSUES": "Càraich duilgheadasan dàta-làir",
        "SETTING_FIX_FLOOR_DATA_ISSUES_DESCRIPTION": "Càradh bugan tùsail le dàta-làir - trigearan 's a leithid.",
        "SETTING_FIX_FREE_FLARE_GLITCH": "Càraich glitch lòchran an-asgaidh",
        "SETTING_FIX_FREE_FLARE_GLITCH_DESCRIPTION": "Càradh far am faighear lòchran gun chosgais le bhith a' brùthadh am putan fhad 's a thogas Lara rud sam bith an àrd.",
        "SETTING_FIX_GLIDE_CAMERAS": "Càraich camarathan sleamhnachaidh",
        "SETTING_FIX_GLIDE_CAMERAS_DESCRIPTION": "Càradh camarathan sleamhnachaidh gus a chumas iad ri dàta-làir an ìre, seach a bhith a' luathachadh gu bunaiteach às dèidh a' chiad fhrèam.",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH": "Càraich glitch dùblachaidh nì",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION": "Càradh far an gabh nithean prìomhach a chleachdadh dà thuras neo barrachd san t-seilbh.",
        "SETTING_FIX_ITEM_ROTS": "Càraich cuairteachadh nithean",
        "SETTING_FIX_ITEM_ROTS_DESCRIPTION": "Càradh bugan far a bheil cuid de thogailtean air an tionndadh gu ceàrr le togailtean 3D air a chomasachadh.",
        "SETTING_FIX_LARA_PICKUP_EMBED": "Càraich cath-thogail",
        "SETTING_FIX_LARA_PICKUP_EMBED_DESCRIPTION": "Càradh far am bi Lara uaireannan a' gluasad a-steach gu ballachan nuair a tha i a' togail rudeigin fon uisge, agus os cionn uisge fo mhullaichean cas leathann.",
        "SETTING_FIX_M16_ACCURACY": "Càraich cruinneas M16/MP5",
        "SETTING_FIX_M16_ACCURACY_DESCRIPTION": "Càradh cruinneas M16/MP5 fhad 's a tha Lara a' ruith.",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY": "\\{review}Cuir prìomhachas air togail moncaidh ceart",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY_DESCRIPTION": "\\{review}Bidh moncaidhean air an ionnsaigh a’ cur prìomhachas air freagairt air ais seach a bhith a’ cruinneachadh pacaidean Medi agus iuchraichean.",
        "SETTING_FIX_QWOP_GLITCH": "Càraich glitch QWOP",
        "SETTING_FIX_QWOP_GLITCH_DESCRIPTION": "Càradh glitch - ris an canar QWOP - far am bi Lara a' leum air ceumannan beaga agus a' toiseachadh gluasad gu neònach tron làr.",
        "SETTING_FIX_SECRETS_KILLING_MUSIC": "Ceòl dìomhaireachd ioma-fhilleadh",
        "SETTING_FIX_SECRETS_KILLING_MUSIC_DESCRIPTION": "Cuiridh seo ceartachadh air far a bheil ceòl dìomhaireachd a' stad an slighe-ciùil a tha a' cluich.",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC": "Labhairt nàmhaid ioma-fhilleadh",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC_DESCRIPTION": "Cuiridh seo ceartachadh air far a bheil nàimhdean a' stad ciùil gnìomhach nuair a bhruidhneas iad.",
        "SETTING_FIX_STEP_GLITCH": "Càraich glitch ceumannan",
        "SETTING_FIX_STEP_GLITCH_DESCRIPTION": "Càradh far am bi Lara uaireannan air a putadh tro bhalla ri taobh ceuman nuair a ruitheas i suas orra.",
        "SETTING_FIX_TEXTURE_ISSUES": "Càraich duilgheadasan inneach",
        "SETTING_FIX_TEXTURE_ISSUES_DESCRIPTION": "Càradh bugan tùsail le inneach neo modalan a tha ceàrr neo a dhìth.",
        "SETTING_FIX_WADE_WALL_HIT": "Càraich buille tro uisge eu-dhomhain",
        "SETTING_FIX_WADE_WALL_HIT_DESCRIPTION": "Cuiridh seo ceartachadh air freagairt Lara nuair a bhuail i balla fhad 's a tha i a' coiseachd tro uisge eu-dhomhain.",
        "SETTING_FIX_WALK_RUN_JUMP": "Càraich leum às dèidh ruith",
        "SETTING_FIX_WALK_RUN_JUMP_DESCRIPTION": "Cuiridh seo ceartachadh air cùis far nach urrainn do Lara leum dìreach às dèidh gluasad bho choiseachd gu ruith.",
        "SETTING_FIX_WATER_EXIT": "Càraich fàgail à seòmar uisge",
        "SETTING_FIX_WATER_EXIT_DESCRIPTION": "Cuiridh seo casg air Lara a bhith comasach air a dhol gu seòmraichean tioram fodha neo ri taobh an seomair làithreach. Cuiridh seo cuideachd casg oirre a sreap air sleamhnagan nach gabh seasamh orra.",
        "SETTING_FMV_VOLUME": "Tomhas FMV",
        "SETTING_FMV_VOLUME_DESCRIPTION": "Atharraichidh tomhas nam filmichean.",
        "SETTING_FOG_COLOR_B": "Dath ceò (G)",
        "SETTING_FOG_COLOR_B_DESCRIPTION": "A' phàirt ghorm de dhath a' cheòth",
        "SETTING_FOG_COLOR_G": "Dath ceò (U)",
        "SETTING_FOG_COLOR_G_DESCRIPTION": "A' phàirt uaine de dhath a' cheòth",
        "SETTING_FOG_COLOR_R": "Dath ceò (D)",
        "SETTING_FOG_COLOR_R_DESCRIPTION": "A' phàirt dhearg de dhath a' cheòth.",
        "SETTING_FOG_END": "Deireadh ceò",
        "SETTING_FOG_END_DESCRIPTION": "Suidhichidh seo an astar (ann an leacan) bhon chamara far a dhùnas ceò air a h-uile càil.",
        "SETTING_FOG_START": "Tòiseachadh ceò",
        "SETTING_FOG_START_DESCRIPTION": "Suidhichidh seo an astar (ann an leacan) bhon chamara far a thoisicheas ceò.",
        "SETTING_FOG_TRANSPARENCY": "Follaiseachd a' cheòth",
        "SETTING_FOG_TRANSPARENCY_DESCRIPTION": "Leigidh seo le sealladh geoimeatraidh a tha fada air falbh bhon a' chamara a bhith follaiseachd gu h-iomlan.",
        "SETTING_FOV": "Raonadh seallaidh",
        "SETTING_FOV_DESCRIPTION": "Ceàrn seallaidh ann an ceumannan. Bidh luachan nas motha a' leudachadh raon seallaidh, agus bidh luachan nas lugha ga chuingealachadh.",
        "SETTING_FPS": "FPS",
        "SETTING_FPS_DESCRIPTION": "Suidhichidh an àireamh de frèamaichean a chluicheas gach diog 's a' gheama.",
        "SETTING_GAMMA": "\\{review}Gamma",
        "SETTING_GAMMA_DESCRIPTION": "\\{review}A’ cur às dèidh an lùb gamma. Tha luachan nas àirde a’ ciallachadh solas nas soilleire. Tha luach 2.5 a’ ciallachadh dathan àbhaisteach.",
        "SETTING_HARPOON_RECOIL": "Ath-luchdadh harpùn",
        "SETTING_HARPOON_RECOIL_DESCRIPTION": "Suidhichidh seo dè cho tric 's a dh'fheumas Lara an harpùn ath-luchdadh, stèidhichte air an lòin a th'aice. M.e. 3 = ath-luchdaich às dèidh a chleachdadh trì tursan. 0 = na bi ag ath-luchdachadh a-riamh.",
        "SETTING_HEALTHBAR_COLOR": "Dath bàr-shlàinte",
        "SETTING_HEALTHBAR_COLOR_DESCRIPTION": "Dath a' bhàr-shlàinte.",
        "SETTING_HEALTHBAR_LOCATION": "Suidheachadh bàr-shlàinte",
        "SETTING_HEALTHBAR_LOCATION_DESCRIPTION": "Far a nochdas am bàr-shlàinte air an sgrion.",
        "SETTING_HEALTHBAR_POISON_COLOR": "\\{review}Dath bàr-slàinte puinnseanta",
        "SETTING_HEALTHBAR_POISON_COLOR_DESCRIPTION": "\\{review}Dath a’ bhàr-slàinte nuair a tha Lara air a puinnseanachadh.",
        "SETTING_IDLE_POSE_TIMEOUT": "Dàil seasaimh",
        "SETTING_IDLE_POSE_TIMEOUT_DESCRIPTION": "Leigidh seo le Lara beòthalachd shònraichte a thòiseachadh às dèidh dhi dad a dhèanamh fad an àireamh de dhiogan suidhichte. Suidhich gu 0 gus a chur à comas.",
        "SETTING_INVENTORY_AMBIENT_VOLUME": "Tomhas fuaim àrainneachd (stòradh)",
        "SETTING_INVENTORY_AMBIENT_VOLUME_DESCRIPTION": "Atharraichidh tomhas àrainneachd air scrion stòrais.",
        "SETTING_INVENTORY_BACKGROUND_STYLE": "Dealbh-cùil sa chlàr-seilbhe",
        "SETTING_INVENTORY_BACKGROUND_STYLE_DESCRIPTION": "Atharraichidh an doigh anns a bhitheas an dealbh-cùil air a shealltainn sa chlàr-seilbhe.\n\n- Dorcha: TR1 (PC).\n- Fìor dhorcha: TR1 (PS1).\n- Statach: TR2 (PC).\n- Crathadh: TR2 (PS1).\n- Aon-dhathach: TR3.",
        "SETTING_INVENTORY_FADE_EFFECTS": "\\{review}Buaidhean falamh clàr-innealan",
        "SETTING_INVENTORY_FADE_EFFECTS_DESCRIPTION": "\\{review}A’ rèiteachadh gu mionaideach na buaidhean falamh airson an cleachdadh no an cur dheth anns a’ chruinneachadh clàr-innealan sa gheama. Feumaidh an roghainn Buaidhean Falamh a bhith air a ghnìomhachadh airson seo obrachadh.",
        "SETTING_INVENTORY_MUSIC_VOLUME": "Tomhas ciùil (stòradh)",
        "SETTING_INVENTORY_MUSIC_VOLUME_DESCRIPTION": "Atharraichidh tomhas ciùil air scrion stòrais.",
        "SETTING_JUMP_LOCK_MODE": "Modh glasadh leum",
        "SETTING_JUMP_LOCK_MODE_DESCRIPTION": "Airson leum freagairteach, leigidh seo leat smachd a chumail air cuin a bhios Lara comasach air leum às dèidh tòiseachadh ruith.\n\n- Dualchasach: a rèir àm TR2 tùsail.\n- Fìnealta: tha leum comasach 2 fhrèam nas tràithe.\n- Dheth: tha leum comasach sa bhad às dèidh an beòthalachd tòiseachaidh.",
        "SETTING_LIGHTING_CONTRAST": "Iomsgaradh solais",
        "SETTING_LIGHTING_CONTRAST_DESCRIPTION": "Cuiridh seo atharrachadh air iomsgaradh solais fiùghantach, airson m.e. lasraichean neo losgadh armachd.",
        "SETTING_LOAD_MUSIC_TRIGGERS": "Càraich ciùil aon-ùine",
        "SETTING_LOAD_MUSIC_TRIGGERS_DESCRIPTION": "Cuiridh seo an luchdachadh air ais de chriomagan ciùil aon-ùine gus nach cluich iad a-rithist gu mearachdach.",
        "SETTING_LOOK_MODE": "Modh seallaidh",
        "SETTING_LOOK_MODE_DESCRIPTION": "Leigidh seo leat smachd a chumail air cuin as urrainn do Lara sealladh a chleachdadh.\n\n- Cuibhrichte: chan eil sealladh comasach ach nuair a tha Lara na stad, agus a-riamh fon uisge.\n- Leasaichte: tha sealladh comasach rè a' mhòr-chuid de bheòthalachd, ach chan ann rè gluasadan mar putadh bloca.\n- Neo-chuibhrichte: tha sealladh comasach aig àm sam bith fo smachd Lara àbhaisteach.",
        "SETTING_MASTER_VOLUME": "\\{icon music} Tomhas prìomh",
        "SETTING_MASTER_VOLUME_DESCRIPTION": "Atharraichidh tomhas fuaim a' gheama gu lèir. Tha na tomhasan eile co-cheangailte ris an fhearr seo",
        "SETTING_MAXIMUM_SAVE_SLOTS": "Àireamh de shloinn sàbhalaidh",
        "SETTING_MAXIMUM_SAVE_SLOTS_DESCRIPTION": "Cuiridh seo atharrachadh air an àireamh de shloinnean sàbhalaidh a tha rim faotainn.",
        "SETTING_MENU_STYLE": "Stoidhle clàir",
        "SETTING_MENU_STYLE_DESCRIPTION": "Cuiridh seo stoidhle a' chlàir an comas:\n\n- PC: stoidhle eadar-aghaidh PC.\n- PS1: stoidhle eadar-aghaidh a' PhS1.",
        "SETTING_MUSIC_LOAD_CONDITION": "Aisig ceòl aig luchdadh",
        "SETTING_MUSIC_LOAD_CONDITION_DESCRIPTION": "Cuiridh seo an slighe-ciùil a bha a' cluich nuair a chaidh an geama a shàbhaladh air ais an sàs aig àm luchdaidh.\n\n- A-riamh: na bi ag ath-chluich ciùil idir.\n- Neo-àrainneachd: ath-chluich ceòl neo-àrainneachdail a-mhàin.\n- An-còmhnaidh: ath-chluich ceòl sam bith.",
        "SETTING_MUSIC_VOLUME": "Tomhas ciùil",
        "SETTING_MUSIC_VOLUME_DESCRIPTION": "Atharraichidh tomhas ciùil.",
        "SETTING_MUTE_OUT_OF_FOCUS": "Balbhaich fuaim gun fòcas",
        "SETTING_MUTE_OUT_OF_FOCUS_DESCRIPTION": "Balbhaichidh seo a h-uile phìos ciùil is buaidh-fuaim nuair nach eil uinneag a' gheama ann am fòcas.",
        "SETTING_PAUSE_BACKGROUND_STYLE": "Dealbh-cùil sgrion-stad",
        "SETTING_PAUSE_BACKGROUND_STYLE_DESCRIPTION": "Atharraichidh an doigh anns a bhitheas an dealbh-cùil air a shealltainn san sgrion-stad.\n\n- Dorcha: TR1 (PC).\n- Fìor dhorcha: TR1 (PS1).\n- Statach: TR2 (PC).\n- Crathadh: TR2 (PS1).\n- Aon-dhathach: TR3.",
        "SETTING_PAUSE_FADE_EFFECTS": "\\{review}Buaidhean falamh stad",
        "SETTING_PAUSE_FADE_EFFECTS_DESCRIPTION": "\\{review}A’ rèiteachadh gu mionaideach na buaidhean falamh airson an cleachdadh no an cur dheth air scrion stad. Feumaidh an roghainn Buaidhean Falamh a bhith air a ghnìomhachadh airson seo obrachadh.",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY": "Stad ceòl sa chlàr-seilbhe",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY_DESCRIPTION": "Cuiridh seo ceòl is fuaimean àrainneachdail 'nan stad san sgrion chlàr-seilbhe.",
        "SETTING_QUICK_GUNS_MODE": "Iuchraichean luatha armachd",
        "SETTING_QUICK_GUNS_MODE_DESCRIPTION": "Smachd air mar a dh'èireas na h-iuchraichean uidheamachaidh armachd luatha.\n\n- Tarraing a-mhàin: bheir iuchair teth air Lara an arm ainmichte a tharraing.\n- Tarraing/falach: mar roimhe, ach bheir seo cuideachd air Lara an arm a chur air falach ma tha i ga ghiùlan.",
        "SETTING_REFLECTIONS": "Meòrachadh",
        "SETTING_REFLECTIONS_DESCRIPTION": "Cuiridh seo meòrachadh air nithean sònraichte an comas.",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS": "Cuimhnich armachd eadar ìrean",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION": "Cuiridh seo air Lara cuimhne dè an armachd a bh'aice mu dheireadh nuair a thòisicheas i ìre ùr. Mur tèid seo a chomasachadh, tillidh i gu piostalan nan dìollaid.",
        "SETTING_RESTORE_PS1_ENEMIES": "Aisig nàimhdean PS1",
        "SETTING_RESTORE_PS1_ENEMIES_DESCRIPTION": "Cuiridh seo spaoileadan ann an City of Khamoon (PS1), seòmar 25. Feumaidh ath-thòiseachadh a' gheama gu lèir gus obraicheas seo.",
        "SETTING_SCREENSHOT_FORMAT": "Fòrmat glacadh-sgrìn",
        "SETTING_SCREENSHOT_FORMAT_DESCRIPTION": "Fòrmat fhaidhle airson glacadh-sgrìn.",
        "SETTING_SHADOW_TYPE": "\\{review}Cruth nan sgàilean",
        "SETTING_SHADOW_TYPE_DESCRIPTION": "\\{review}Tagh mar a thèid sgàilean nan nithean a tharraing.\n\n- Ochd-cheàrnach: sgàilean seann TR1 agus TR2\n- Cearcall: sgàilean cruinn\n- Spraide: sgàilean stèidhichte air teacsa TR3",
        "SETTING_SHOW_BARS": "Cleachd bàraichean",
        "SETTING_SHOW_BARS_DESCRIPTION": "Cuiridh seo dheth gach bàr sa gheama, a' falach fiosrachadh mu shlàinte Lara agus goireasan eile (airson ruith dhùbhlanach).",
        "SETTING_SOUND_VOLUME": "\\{icon sound} Meud fuaime",
        "SETTING_SOUND_VOLUME_DESCRIPTION": "Cuiridh seo atharrachadh air meud nam buaidhean fuaime.",
        "SETTING_SPRINTBAR_COLOR": "Dath bàr ruith luath",
        "SETTING_SPRINTBAR_COLOR_DESCRIPTION": "Dath a' bhàr ruith luath.",
        "SETTING_SPRINTBAR_LOCATION": "Suidheachadh bàr ruith luath",
        "SETTING_SPRINTBAR_LOCATION_DESCRIPTION": "Far a nochdas am bàr ruith luath air an sgrion.",
        "SETTING_SPRITE_LOCK_MODE": "Glasadh sprìde",
        "SETTING_SPRITE_LOCK_MODE_DESCRIPTION": "Bheir seo buaidh air na h-aisealean a tha glaiste nuair a thathar a' coimhead air sprìdean air an sgrion.\n\n- Gin sam bith: seall air na sprìdean gu àbhaisteach.\n- Rothladh: glasaich an aiseal rothlaidh – gu feumail a-mhàin ann am modh dealbh.\n- Rothladh is claonadh: bidh na sprìdean nan seasamh dìreach agus cha bhith iad nan laighe air an talamh nuair a thathar gan choimhead bho shuas.\n- Sealladh: glasaich na h-aisealean rothlaidh agus claonadh, 's a bharrachd air sin, rothlaich na sprìdean beagan a dh'ionnsaigh meadhan an sgrion.",
        "SETTING_START_LARA_HITPOINTS": "Slàinte tòiseachaidh Lara",
        "SETTING_START_LARA_HITPOINTS_DESCRIPTION": "Suidhichidh seo luach slàinte Lara aig toiseach gach ìre.",
        "SETTING_STATS_BACKGROUND_STYLE": "Dealbh-cùil staitistig",
        "SETTING_STATS_BACKGROUND_STYLE_DESCRIPTION": "Atharraichidh an doigh anns a bhitheas an dealbh-cùil air a shealltainn san sgrion-staitistig.\n\n- Dorcha: TR1 (PC).\n- Fìor dhorcha: TR1 (PS1).\n- Statach: TR2 (PC).\n- Crathadh: TR2 (PS1).\n- Aon-dhathach: TR3.",
        "SETTING_STATS_FADE_EFFECTS": "\\{review}Buaidhean falamh staitistig",
        "SETTING_STATS_FADE_EFFECTS_DESCRIPTION": "\\{review}A’ rèiteachadh gu mionaideach na buaidhean falamh airson an cleachdadh no an cur dheth air scrion staitistig deireadh ìre. Feumaidh an roghainn Buaidhean Falamh a bhith air a ghnìomhachadh airson seo obrachadh.",
        "SETTING_STATS_LEVEL_HEADER": "Àireamh-ìre",
        "SETTING_STATS_LEVEL_HEADER_DESCRIPTION": "Seallaidh seo àireamh na h-ìre làithreach aig mullach staitistig na h-ìre.",
        "SETTING_STAT_DETAIL_MODE": "Fiosrachadh staitistig",
        "SETTING_STAT_DETAIL_MODE_DESCRIPTION": "Leigeas le diofar ìrean de mion-fhiosrachadh staitistige.\n\n- As ìsle: seallas an còmhradh staitistige tùsail.\n- Mion-fhiosraichte: seallas gach stait bho as ìsle a bharrachd air na cunntasan as àirde ri taobh gach raon.\n- Làn: seallas gach stait bho mion-fhiosraichte a bharrachd air sreathan ùra nach robh rim faighinn anns an còmhradh tùsail.",
        "SETTING_TARGET_MODE": "Modh glas armachd",
        "SETTING_TARGET_MODE_DESCRIPTION": "Cuiridh seo atharrachadh air mar a bhios armachd a' glasadh air targaidean:\n\n- Glas làn: cùm glasadh fiù 's ma thèideas an nàmhaid a-mach à sealladh (TR1-3).\n- Leth-ghlas: cùm glasadh nuair a tha an nàmhaid a-mach à sealladh, ach caill e ma bhàsaicheas e.\n- Gun ghlas: caill glasadh ma thèideas an nàmhaid a-mach à sealladh neo nuair a bhàsaicheas e (TR4+).",
        "SETTING_TEXTURE_FILTER": "Criathradh inneach",
        "SETTING_TEXTURE_FILTER_DESCRIPTION": "Cuiridh seo atharrachadh eadar inneach rèidh agus piogsaileach.",
        "SETTING_TRAPEZOID_FILTER": "Criathradh trapeasoid",
        "SETTING_TRAPEZOID_FILTER_DESCRIPTION": "Cuiridh seo ceartachadh air trapeasoidean (ceàrnan neo-chothromach) airson reandaradh nas fhearr.",
        "SETTING_UI_BAR_SCALE": "Meud bàr",
        "SETTING_UI_BAR_SCALE_DESCRIPTION": "Atharraicheas meud nam bàraichean.",
        "SETTING_UI_FILTER": "Criathradh EA",
        "SETTING_UI_FILTER_DESCRIPTION": "Tionndaidh eadar inneach an eadar-aghaidh rèidh neo piogsaileach.",
        "SETTING_UI_LANGUAGE": "Cànan",
        "SETTING_UI_LANGUAGE_DESCRIPTION": "Atharraicheas cànan an eadar-aghaidh.",
        "SETTING_UI_PICKUP_SCALE": "Meud togailtean",
        "SETTING_UI_PICKUP_SCALE_DESCRIPTION": "Atharraicheas meud nan togailtean beòthail san EA nuair a thogas Lara an àird iad.",
        "SETTING_UI_SCROLL_WRAPAROUND": "Sgrolaich timcheall",
        "SETTING_UI_SCROLL_WRAPAROUND_DESCRIPTION": "Leigidh seòladh stiùiridh ann an clàran-bìdh lùbadh timcheall.",
        "SETTING_UI_TEXT_SCALE": "Meud teacsa",
        "SETTING_UI_TEXT_SCALE_DESCRIPTION": "Atharraicheas meud an teacsa.",
        "SETTING_UNDERWATER_AMBIENT_VOLUME": "Tomhas àrainneachd (fo uisge)",
        "SETTING_UNDERWATER_AMBIENT_VOLUME_DESCRIPTION": "Atharraichidh tomhas àrainneachd fo uisge.",
        "SETTING_UNDERWATER_MUSIC_VOLUME": "Tomhas ciùil (fo uisge)",
        "SETTING_UNDERWATER_MUSIC_VOLUME_DESCRIPTION": "Atharraichidh tomhas ciùil fo uisge.",
        "SETTING_UPSCALING_FACTOR": "Factar sgèileachaidh",
        "SETTING_UPSCALING_FACTOR_DESCRIPTION": "Àrdaichidh seo an geama le factar stèidhichte, aig an aon àm a' cumail coltas piogsaileach.",
        "SETTING_UPSCALING_FILTER": "Criathradh sgèileachaidh",
        "SETTING_UPSCALING_FILTER_DESCRIPTION": "Tionndaidh eadar coltas rèidh neo piogsaileach airson na sgrìn air fad.",
        "SETTING_VSYNC": "V-Sionc",
        "SETTING_VSYNC_DESCRIPTION": "Tionndaidheas sioncronachadh-inghearach air neo dheth.",
        "SETTING_WALL_GLITCH_MODE": "Modh glitch bhalla",
        "SETTING_WALL_GLITCH_MODE_DESCRIPTION": "Cuiridh seo modh glitch bhalla TR1 ann an TR2 agus a chaochladh an comas. Leigidh seo cuideachd le càradh iomlan air na glitchan uile.",
        "SETTING_WATER_COLOR_B": "Dath an uisge (G)",
        "SETTING_WATER_COLOR_B_DESCRIPTION": "A' phàirt ghorm de dhath an uisge.",
        "SETTING_WATER_COLOR_G": "Dath an uisge (U)",
