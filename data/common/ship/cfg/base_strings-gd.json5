        "SETTING_ENABLE_UNDERWATER_ANIM_SFX": "SFX beòthalachd fon uisge",
        "SETTING_ENABLE_UNDERWATER_ANIM_SFX_DESCRIPTION": "Leigidh seo leat smachd a chumail air buaidhean-fuaim beòthalachd shònraichte - airson nithean mar dorsan is trapaichean - nuair a tha a' chamara fon uisge.",
        "SETTING_ENABLE_UW_ROLL": "Rolla fon uisge",
        "SETTING_ENABLE_UW_ROLL_DESCRIPTION": "Leigidh le Lara rolla a dhèanamh fon uisge.",
        "SETTING_ENABLE_WADING": "Coiseachd tro uisge",
        "SETTING_ENABLE_WADING_DESCRIPTION": "Leigidh le Lara coiseachd tro uisge eu-dhomhain seach a bhith air a stad aig uachdar na h-aibhne.",
        "SETTING_ENABLE_WALK_TO_ITEMS": "Eadar-obrachadh beòthail",
        "SETTING_ENABLE_WALK_TO_ITEMS_DESCRIPTION": "Nì Lara coiseachd gu togailtean is suidsichean nuair a tha i faisg orra, an àite leum dìreach thuca.",
        "SETTING_ENABLE_WEATHER": "\\{review}Sìde",
        "SETTING_ENABLE_WEATHER_DESCRIPTION": "\\{review}Cumasach a bhith a’ taisbeanadh buaidhean sìde anns na h-ìrean a tha a’ toirt taic dha.",
        "SETTING_ENEMY_HEALTHBAR_COLOR": "Dath bàr-nàmhaid",
        "SETTING_ENEMY_HEALTHBAR_COLOR_DESCRIPTION": "Dath bàr-shlàinte an nàmhaid.",
        "SETTING_ENEMY_HEALTHBAR_LOCATION": "Suidheachadh bàr-nàmhaid",
        "SETTING_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION": "Far a nochdas bàr-shlàinte an nàmhaid air an sgrion.",
