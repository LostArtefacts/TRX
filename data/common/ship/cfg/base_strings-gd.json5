        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT": "Ath-bheòthachadh bhalla rèidh",
        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT_DESCRIPTION": "Cuidichidh Lara le tilleadh nas luaithe às dèidh buille ri balla ma thèid stiùireadh is 'air adhart' a chumail.",
        "SETTING_ENABLE_SOFT_STATICS": "Bualadh mogal bog",
        "SETTING_ENABLE_SOFT_STATICS_DESCRIPTION": "Leigidh le Lara gluasad gu rèidh air aghaidh mogalan statach – coltach ri TR4+ – seach stad chruaidh a dhèanamh.",
        "SETTING_ENABLE_SPRINT": "Ruith gu luath",
