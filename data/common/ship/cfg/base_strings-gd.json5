        "SETTING_ANISOTROPY_FILTER_DESCRIPTION": "Leasaichidh seo criathradh inneach aig astaran fada.",
        "SETTING_ASPECT_MODE": "Modh co-mheas sgrion",
        "SETTING_ASPECT_MODE_DESCRIPTION": "Èigneachadh cuid de cho-mheudan le bàr-dubh (bogsa-litreach).",
        "SETTING_BAR_LOOK": "Coltas nam bàraichean",
        "SETTING_BAR_LOOK_DESCRIPTION": "Atharraichidh seo coltas nam bàraichean EA.",
        "SETTING_BORDERS": "Iomallan",
        "SETTING_BORDERS_DESCRIPTION": "Cuiridh seo iomallan dubha timcheall air uinneag a' gheama.",
        "SETTING_BRIGHTNESS": "Soilleireachd",
        "SETTING_BRIGHTNESS_DESCRIPTION": "Cuiridh seo atharrachadh air soilleireachd a' gheama.",
        "SETTING_CAMERA_MODE": "Modh camara",
        "SETTING_CAMERA_MODE_DESCRIPTION": "Atharraichidh seo an doigh anns a bhios a' chamara ag obair, m.e. aig àm ghnìomhan shonraichte, mar a bhith a' cleachdadh iuchraichean.",
        "SETTING_CAMERA_SPEED": "Luas a' chamara",
        "SETTING_CAMERA_SPEED_DESCRIPTION": "Atharraicheas dè cho luath 'sa ghluaiseas an camera.",
        "SETTING_CHANGE_PIERRE_SPAWN": "Atharraich modh nochdaidh Pierre",
        "SETTING_CHANGE_PIERRE_SPAWN_DESCRIPTION": "Leigidh seo le Pierre ùr a thigeas am bàrr a chuir an àite Pierre eile a tha fhathast beò.",
        "SETTING_CUTSCENE_VOLUME": "Tomhas nan seallaidhean",
        "SETTING_CUTSCENE_VOLUME_DESCRIPTION": "Cuiridh seo tomhas nan seallaidhean sa gheama.",
        "SETTING_DISABLE_EXTRA_GUNS": "Thoir air falbh armachd a bharrachd",
        "SETTING_DISABLE_EXTRA_GUNS_DESCRIPTION": "Thoir air falbh gach armachd agus ammo bhon gheama ach Pistols (airson ruith dùbhlain Pistols a-mhàin).",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS": "Droch staid leantainneach",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Cuir stad air Lara bho bhith ag ath-shlànachadh nuair a thòisicheas i ìre ùr (airson ruith gun slànachadh).",
        "SETTING_DISABLE_MEDPACKS": "Thoir air falbh pasganan slàinte",
        "SETTING_DISABLE_MEDPACKS_DESCRIPTION": "Thèid na pasganan slàinte uile a thoirt air falbh às a' gheama (airson ruith 'Gun Leigheas').",
        "SETTING_DISABLE_TREX_COLLISION": "Cuir às ri buaidh T-Rex marbh",
        "SETTING_DISABLE_TREX_COLLISION_DESCRIPTION": "Cuiridh seo às ri buaidh-bhualaidh corp T-Rex às deidh bàs, gus casg a chur air bacadh slighe a-mach.",
        "SETTING_ENABLE_3D_PICKUPS": "Togail 3D",
        "SETTING_ENABLE_3D_PICKUPS_DESCRIPTION": "Cuiridh seo modailean 3D an àite spraidean airson nithean togail.",
        "SETTING_ENABLE_ALLY_TARGETING": "Targaidich air càirdean",
        "SETTING_ENABLE_ALLY_TARGETING_DESCRIPTION": "Leigidh seo le Lara a targaidich air càirdean - manaich, 's a leithid. Mura tèid seo a chur an comas, bidh iad dìonach air peilearan Lara.",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION": "Roghainn ro-làimh air iuchraichean",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "Ma bhriogas Lara air gnìomh aig toll iuchrach neo àite tòimhseachain, taghaidh i an nì ceart gu fèin-obrachail.",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE": "Tuiseal air leathad air chùl",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE_DESCRIPTION": "Bheir seo air Lara tuisleadh ma leumas i air ais agus nuair a tha leathad air a cùlaibh (TR3). Ma tha e à comas, stadaidh Lara gu cruaidh an aghaidh an leathaid (TR1/2).",
        "SETTING_ENABLE_BAR_FLASHING": "Bàraichean deàrrsail",
        "SETTING_ENABLE_BAR_FLASHING_DESCRIPTION": "Cuiridh seo an àite bàraichean slàinte agus ocsaidean Lara deàrrsail nuair a tha i a' ruith ìosal air na goireasan seo.",
        "SETTING_ENABLE_BOULDER_SHAKE": "Crathadh ulpagan",
        "SETTING_ENABLE_BOULDER_SHAKE_DESCRIPTION": "Crathaidh an camara nuair a bhios ulpagan a' gluasad.",
        "SETTING_ENABLE_BOUNCY_GRENADES": "\\{review}Grenadan bouncy",
        "SETTING_ENABLE_BOUNCY_GRENADES_DESCRIPTION": "\\{review}Cuir comas air giùlan grenade stoidhle TR3: bidh iad a’ bualadh air ballachan agus claisean agus a’ dèanamh raon spreadhaidh nas motha, ach aig cosgais astar nas ìsle.",
        "SETTING_ENABLE_BRAID": "Feaman-fuilt Lara",
        "SETTING_ENABLE_BRAID_DESCRIPTION": "Cuiridh seo feaman-fuilt Lara an comas.",
        "SETTING_ENABLE_BREEZE": "Gaoth",
        "SETTING_ENABLE_BREEZE_DESCRIPTION": "Cuiridh seo buaidh na gaoithe air feaman-fuilt Lara ann an seòmraichean freagarrach.",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS": "Bùthadh (putanan F)",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS_DESCRIPTION": "Leigeas leis nam putanan F smachd mionaideach (1-frèam) a thoirt air gluasad Lara. Tha am feart seo gu tùsail ri fhaighinn a-mhàin anns a' phort TombATI (TR1).",
        "SETTING_ENABLE_BUFFERING_INVENTORY": "Bùthadh (clàr-stòraidh)",
        "SETTING_ENABLE_BUFFERING_INVENTORY_DESCRIPTION": "Leigeas leis am putan clàr-stòraidh smachd mionaideach (2-fhraim) a thoirt air gluasad Lara.",
        "SETTING_ENABLE_CHEATS": "Cleasan",
        "SETTING_ENABLE_CHEATS_DESCRIPTION": "Cuiridh seo diofar chleasan an comas:\n\n- L: crìochnaich an ìre sa bhad.\n- I: bheir do Lara na h-armachd uile, pailteas lòin, pasganan slàinte agus stuthan cuilbheart na h-ìre làithreach.\n- O: cuir snàmh tro èadhar an comas.\n     - Coisich: stad a' snàmh tro èadhar.\n     - Uidheamaich: fosgail an doras as fhaisge (chan obraichidh seo an-còmhnaidh).",
        "SETTING_ENABLE_COMPASS_STATS": "Staitistig ìre anns a' chombaist",
        "SETTING_ENABLE_COMPASS_STATS_DESCRIPTION": "Seallaidh seo staitistig na h-ìre nuair a thaghas tu a' chombaist.",
        "SETTING_ENABLE_CONSOLE": "Co-chomhairle leasachaidh",
        "SETTING_ENABLE_CONSOLE_DESCRIPTION": "Cuiridh seo an consol leasachaidh an comas.",
        "SETTING_ENABLE_CONTROLLED_DROPS": "Tuit fo smachd",
        "SETTING_ENABLE_CONTROLLED_DROPS_DESCRIPTION": "Leigidh seo le Lara tionndadh san adhar agus grèim a ghabhail air an oir a dh'fhàg i, fhad 's a tha am putan gnìomh air a chumail sios tron tuiteam.",
        "SETTING_ENABLE_CREDITS": "Sgrìoban creideis",
        "SETTING_ENABLE_CREDITS_DESCRIPTION": "Cuiridh seo sgrìoban creideis an comas às dèidh crìochnachadh a' gheama. Cha bheireas seo buaidh air an sgrion staitistig mu dheireadh.",
        "SETTING_ENABLE_CUTSCENES": "Seallaidhean-film",
        "SETTING_ENABLE_CUTSCENES_DESCRIPTION": "Cuiridh seo cluich seallaidhean-film an comas.",
        "SETTING_ENABLE_DEATHS_COUNTER": "Cunntair bhàsan Lara",
        "SETTING_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Seallaidh seo cunntas bàsan Lara anns a' chombaist agus anns na staitistig. Thèid seo ùrachadh sa bhad nuair a bhàsaicheas Lara.",
        "SETTING_ENABLE_DEMO": "Modh taisbeanaidh",
        "SETTING_ENABLE_DEMO_DESCRIPTION": "Leigidh le seo taisbeanadhan a chluich bhon phrìomh chlàr.",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME": "\\{review}Ùine solais gun chrìoch",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME_DESCRIPTION": "\\{review}Bidh e a’ casg air na solais-làimhe a dhol dheth gu bràth. Bidh solais air an tilgeil fhathast a’ dol dheth mar as àbhaist.",
        "SETTING_ENABLE_ENDLESS_SPRINT": "\\{review}Ruith gun chrìoch",
        "SETTING_ENABLE_ENDLESS_SPRINT_DESCRIPTION": "\\{review}Bidh seo a’ casg air Lara bho bhith sgìth gu bràth fhad ‘s a tha i a’ ruith gu luath. Bidh cnapan-starra fhathast ga stad.",
        "SETTING_ENABLE_ENEMY_ROTATION": "Ceàrn tùsail nàimhdean",
        "SETTING_ENABLE_ENEMY_ROTATION_DESCRIPTION": "Cuiridh ceàrn thuilleadh air thuaiream ri cuid de na nàimhdean nuair a thòisicheas iad.",
        "SETTING_ENABLE_ENHANCED_SAVES": "Buaidhean sàbhalaidh",
        "SETTING_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Leasaichidh sàbhaladh geama gus am bi buaidhean grafaigeach, ceò easan, sgaoiladairean lasraidh, agus tuilleadh, air an sàbhaladh an àite a dhol à sealladh nuair a luchdaichear iad.",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS": "Dorchachadh aig fàgail",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION": "Cuiridh seo dorchachadh an comas nuair a dh'fhàgas tu an geama gu deasg.",
        "SETTING_ENABLE_FADE_EFFECTS": "Buaidhean dorchachaidh",
        "SETTING_ENABLE_FADE_EFFECTS_DESCRIPTION": "Cuiridh seo dorchachadh eadar gluasadan air adhart — m.e. eadar grafaigean creideis neo clàr-seilbhe.",
        "SETTING_ENABLE_FIRE_LIGHTING": "Lasadh teine",
        "SETTING_ENABLE_FIRE_LIGHTING_DESCRIPTION": "Cuiridh seo comas air solas fiùghantach a bhith air a chruthachadh ri taobh lasraichean gnìomhach.",
        "SETTING_ENABLE_FMV": "Bhideothan",
        "SETTING_ENABLE_FMV_DESCRIPTION": "Cuiridh seo cluich bhideothan an comas.",
        "SETTING_ENABLE_FOOTPRINTS": "\\{review}Clachan-coise",
        "SETTING_ENABLE_FOOTPRINTS_DESCRIPTION": "\\{review}Leigeas le clachan-coise Lara a nochdadh air uachdaran sònraichte ann an ìrean taicichte.",
        "SETTING_ENABLE_GAME_MODES": "Taghadh modh geama",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Leigeas le roghainnean Geama Ùr+ a bhith rim faotainn sa phasport aig toiseach a' gheama.\n\n- Geama Ùr+: fuasgladh nan armachd air fad le peilearan gun chrìoch; bidh HP dùbailte aig na nàimhdean.\n- GÙ Iapanach: bidh na h-armachd ag adhbhrachadh milleadh dùbailte, agus bheir togail lòchrain 8 seach 6.\n- GÙ+ Iapanach: measgachadh de GÙ+ is GÙ Iapanach.",
        "SETTING_ENABLE_GUN_LIGHTING": "Solais armachd",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Cuiridh seo solais beòthail ri losgadh agus spreadhadh.",
        "SETTING_ENABLE_IDLE_POSE_CAMERA": "Camara seasaimh",
        "SETTING_ENABLE_IDLE_POSE_CAMERA_DESCRIPTION": "Gluaisidh an camara gus aghaidh a thoirt air Lara rè a beòthalachd seasaimh. Put seall gus an camara a ath-shuidheachadh.",
        "SETTING_ENABLE_INVERTED_LOOK": "Sealladh ais-iompaichte",
        "SETTING_ENABLE_INVERTED_LOOK_DESCRIPTION": "Tionndaidhidh an smachd Y-axis nuair a choimheadas Lara.",
        "SETTING_ENABLE_ITEM_EXAMINING": "Sgrùdadh nithean",
        "SETTING_ENABLE_ITEM_EXAMINING_DESCRIPTION": "Airson ìrean gnàthaichte — leigidh seo le tuairisgeulan nì a nochdadh san t-seilbh ma bheir ùghdar na h-ìre dàta freagarrach.",
        "SETTING_ENABLE_JUMP_TWISTS": "Snìomh leum",
        "SETTING_ENABLE_JUMP_TWISTS_DESCRIPTION": "Cuiridh seo snìomh is leth-chasach TR2+ an comas — m.e. brùth rolla rè leum neo dàibheadh.",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS": "Cleachd blocaichean putadh marbhach",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS_DESCRIPTION": "Ma tha seo comasach, nuair a thuiteas bloc putadh bhon adhar air Lara, cuiridh e i gu bàs i. Mur nach eil, theid Lara troimh a' bhloc.",
        "SETTING_ENABLE_LARA_MIC": "Micreofon ri taobh Lara",
        "SETTING_ENABLE_LARA_MIC_DESCRIPTION": "Cuiridh seo am micreofon aig suidheachadh Lara. Ma thèid seo air a chur dheth, bidh e aig suidheachadh a' chamara.",
        "SETTING_ENABLE_LEAN_JUMPING": "Leum le claonadh",
        "SETTING_ENABLE_LEAN_JUMPING_DESCRIPTION": "Leigidh Lara sleamhnachadh beagan air adhart/air ais le leum neodrach ma bhithear a' cumail iuchair stiùiridh.",
        "SETTING_ENABLE_LEDGE_JUMPS": "Leum bho oir",
        "SETTING_ENABLE_LEDGE_JUMPS_DESCRIPTION": "Leigidh seo le Lara leum suas no air ais nuair a tha i a' crochadh air oir, fhad 's a tha uachdar cruaidh os a comhair airson putadh às.",
        "SETTING_ENABLE_LEGAL": "Sgrionaichean laghail",
        "SETTING_ENABLE_LEGAL_DESCRIPTION": "Seallaidh seo scrion laghail agus bhideo Core Design aig toiseach a' gheama.",
        "SETTING_ENABLE_LOADING_SCREENS": "Sgrionaichean luchdachaidh",
        "SETTING_ENABLE_LOADING_SCREENS_DESCRIPTION": "Cuiridh seo scrionaichean luchdachaidh stoidhle PS1 an comas aig toiseach gach ìre.",
        "SETTING_ENABLE_MANUAL_CAMERA": "\\{review}Camara làimhe",
        "SETTING_ENABLE_MANUAL_CAMERA_DESCRIPTION": "\\{review}Cuir comas air na h-iuchraichean camara (\\{input camera_forward}\\{input camera_back}\\{input camera_left}\\{input camera_right}) a thathas a’ cleachdadh gus smachd a chumail air camara Modh Dealbh, gus cuideachd camara a’ gheama a chuairteachadh.",
        "SETTING_ENABLE_MUSIC_IN_MENU": "Ceòl sa phrìomh chlàr",
        "SETTING_ENABLE_MUSIC_IN_MENU_DESCRIPTION": "Cluichidh ceòl anns a' phrìomh chlàr.",
        "SETTING_ENABLE_NEUTRAL_TWISTS": "Snìomh neodrach",
        "SETTING_ENABLE_NEUTRAL_TWISTS_DESCRIPTION": "Leigidh seo le Lara tionndadh san adhar fhad 's a tha i a' leum gu neodrach. Brùth air na putanan leum is rola còmhla ri chèile nuair a tha i na seasamh.",
        "SETTING_ENABLE_PICKUP_AIDS": "Taic togail",
        "SETTING_ENABLE_PICKUP_AIDS_DESCRIPTION": "Cuiridh seo buaidh dealrach goirid faisg air nithean togail gus an dèanamh nas fhasa a dh'fhaicinn.",
        "SETTING_ENABLE_PITCHED_SOUNDS": "Fuaimean atharraichte",
        "SETTING_ENABLE_PITCHED_SOUNDS_DESCRIPTION": "Cuiridh seo cead air buaidhean fuaim le beagan caochlaidhean àirde-fuaim gus iomadachd a thoirt do dh'fhuaimean a' gheama.",
        "SETTING_ENABLE_PLAY_PREVIOUS_LEVELS": "Cluich ìrean roimhe",
        "SETTING_ENABLE_PS1_CRYSTALS": "Dath criostail PS1",
        "SETTING_ENABLE_PS1_CRYSTALS_DESCRIPTION": "Bidh na criostalan sàbhalaidh purpaidh mar a tha iad anns a' PhS1.",
        "SETTING_ENABLE_PS1_SFX": "Cleachd fuaimean a' PhS1",
        "SETTING_ENABLE_PS1_SFX_DESCRIPTION": "Cleachd fuaimean sònraichte bhon PhS1 an àite an fheaghainn PhC.\n\n - Fuaim Uzi (TR1 a-mhàin)\n- Fuaim casrùisgte Lara (TR2 a-mhàin)",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT": "Pasport freagairteach",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Cuiridh seo às do bhacadh cuir a-steach le brath ro-luath air tionndadh duilleagan a' phasport; leigidh e leutha bhith air an clàradh an àite a bhith air an stad.",
        "SETTING_ENABLE_RESPONSIVE_SPRINT": "Ruith luath freagairteach",
        "SETTING_ENABLE_RESPONSIVE_SPRINT_DESCRIPTION": "Cuiridh seo staid ruith luath nas freagairtiche an gnìomh do Lara.\n\n- leigidh le Lara ruith gu luath cho luath 's a tha neart aice, seach a bhith a' feitheamh gus am bi stamina làn aice.\n- leigidh le Lara ruith gu luath suas staidhre gun a bhith a stad le beòthalachd ruith àbhaisteach.",
        "SETTING_ENABLE_SAVE_CRYSTALS": "Criostalan sàbhalaidh",
        "SETTING_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Cuiridh seo cuingealachadh air sàbhaladh gu toiseach ìrean is criostalan sàbhalaidh aon-chleachdadh, coltach ris a' PhS1. Feumar ath-thòiseachadh an ìre airson seo obrachadh.",
        "SETTING_ENABLE_SHOTGUN_FLASH": "Lasadh gunna-sgaoil",
        "SETTING_ENABLE_SHOTGUN_FLASH_DESCRIPTION": "Cuiridh seo lasair an sàs nuair a losgais an gunna-sgaoil, coltach ri armachd eile.",
        "SETTING_ENABLE_SKYBOX": "Bogsa-nan-Speuran",
        "SETTING_ENABLE_SKYBOX_DESCRIPTION": "Cuiridh seo bogsa-nan-speuran an comas ann an ìrean far a bheil e freagarrach.",
        "SETTING_ENABLE_SLIDE_TO_RUN": "Sleamhnaich-gus-ruith",
