        "PHOTO_MODE_ADVANCE_FRAME": "Frame Vorwärts",
        "PHOTO_MODE_CAMERA_MOVE_PROMPT": "Kamera bewegen",
        "PHOTO_MODE_CAMERA_RESET_PROMPT": "Kamera zurücksetzen",
        "PHOTO_MODE_CAMERA_ROLL_PROMPT": "Rolle Kamera",
        "PHOTO_MODE_CAMERA_ROTATE_90_PROMPT": "Rotiere um 90 Grad",
        "PHOTO_MODE_CAMERA_ROTATE_PROMPT": "Rotiere Kamera",
        "PHOTO_MODE_CHANGE_LARA_POSE": "Pose ändern",
        "PHOTO_MODE_FOV_PROMPT": "FOV einstellen",
        "PHOTO_MODE_LARA_MOVE_PROMPT": "\\{review}Bewege Lara",
        "PHOTO_MODE_LARA_RESET_PROMPT": "\\{review}Setze Lara zurück",
        "PHOTO_MODE_LARA_ROLL_PROMPT": "\\{review}Rolle Lara",
        "PHOTO_MODE_LARA_ROTATE_90_PROMPT": "\\{review}Drehe Lara um 90°",
        "PHOTO_MODE_LARA_ROTATE_PROMPT": "\\{review}Drehe Lara",
        "PHOTO_MODE_SNAP_PROMPT": "Bild aufnehmen",
        "PHOTO_MODE_TITLE_CAMERA_POS": "Foto-Modus",
        "PHOTO_MODE_TITLE_LARA_POS": "\\{review}Lara bewegen",
        "PHOTO_MODE_TOGGLE_HELP": "Hilfe Ein/Aus",
        "SETTING_AIRBAR_COLOR": "Sauerstoffleistenfarbe",
        "SETTING_AIRBAR_COLOR_DESCRIPTION": "Farbe der Sauerstoffleiste.",
        "SETTING_AIRBAR_LOCATION": "Position der Sauerstoffleiste",
        "SETTING_AIRBAR_LOCATION_DESCRIPTION": "Position, an der die Sauerstoffleiste angezeigt wird.",
        "SETTING_ALLY_HEALTHBAR_COLOR": "Freundliche Einheiten-Leisten Farbe",
        "SETTING_ALLY_HEALTHBAR_COLOR_DESCRIPTION": "Farbe für die Gusundheitsleisten freundlich gesinnter Einheiten. Wird auf der gleiche Position angezeigt wie die Gesundheitsleisten der Feinde.",
        "SETTING_ALLY_HOSTILITY_POLICY": "\\{review}Verbündeten-Feindseligkeitspolitik",
        "SETTING_ALLY_HOSTILITY_POLICY_DESCRIPTION": "\\{review}Steuert, wie freundliche Einheiten reagieren, wenn sie Schaden nehmen.\n\n- Individuell: Jeder Verbündete ändert seine Feindseligkeit eigenständig (TR3-Stil).\n- Geteilt: Alle Verbündeten werden gemeinsam feindlich (TR2-Mönch-Stil).",
        "SETTING_AMBIENT_VOLUME": "\\{review}Umgebungslautstärke",
        "SETTING_AMBIENT_VOLUME_DESCRIPTION": "\\{review}Passt die Umgebungslautstärke an.",
        "SETTING_ANISOTROPY_FILTER": "Anisotropischer Filter",
        "SETTING_ANISOTROPY_FILTER_DESCRIPTION": "Erwiterte Textur-Filterung auf Entfernung.",
        "SETTING_ASPECT_MODE": "Seitenverhältnis",
        "SETTING_ASPECT_MODE_DESCRIPTION": "Erzwingt bestimmte Seitenverhältnisse mit Letterbox.",
        "SETTING_BAR_LOOK": "\\{review}Aussehen der Balken",
        "SETTING_BAR_LOOK_DESCRIPTION": "\\{review}Steuert das visuelle Erscheinungsbild der UI-Leisten.",
        "SETTING_BORDERS": "Rahmen",
        "SETTING_BORDERS_DESCRIPTION": "Fügt schwarze Rahmen um das Spiel-Fenster herum hinzu.",
        "SETTING_BRIGHTNESS": "Helligkeit",
        "SETTING_BRIGHTNESS_DESCRIPTION": "Ändert die Helligkeit des Spiels.",
        "SETTING_CAMERA_MODE": "Kamera-Modus",
        "SETTING_CAMERA_MODE_DESCRIPTION": "Passt das Kameraverhalten während Aktionen, wie dem Benutzen von Schlüsseln, ausegführt werden.",
        "SETTING_CAMERA_SPEED": "Kamera-Geschwindigkeit",
        "SETTING_CAMERA_SPEED_DESCRIPTION": "Ändert, wie schnell sich die Kamera bewegt.",
        "SETTING_CHANGE_PIERRE_SPAWN": "Ändere Pierre Spawn-Modus",
        "SETTING_CHANGE_PIERRE_SPAWN_DESCRIPTION": "Erstellt einen gerade erst ausgelösten (flüchtenden) Pierre und ersetzt einen bereits existierenden (flüchtenden) Pierre.",
        "SETTING_CUTSCENE_VOLUME": "\\{review}Zwischensequenz-Lautstärke",
        "SETTING_CUTSCENE_VOLUME_DESCRIPTION": "\\{review}Passt die Lautstärke der Zwischensequenzen im Spiel an.",
        "SETTING_DISABLE_EXTRA_GUNS": "\\{review}Entferne zusätzliche Waffen",
        "SETTING_DISABLE_EXTRA_GUNS_DESCRIPTION": "Entfernt alle Waffen- und Munitions-Pickups aus dem Spiel, außer Pistolen (für Pistolen-Only-Challenge-Läufe).",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS": "Bleibender Schaden",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Verhindert, dass Lara beim Starten eines neuen Levels geheilt wird (für \"No Heal Challenge\" Runs).",
        "SETTING_DISABLE_MEDPACKS": "Entferne Medi-Packs",
        "SETTING_DISABLE_MEDPACKS_DESCRIPTION": "Entfernt alle Medi-Packs aus dem Spiel (für \"No Meds Challenge\" Runs).",
        "SETTING_DISABLE_TREX_COLLISION": "Enferne die Kollision des toten T-Rex",
        "SETTING_DISABLE_TREX_COLLISION_DESCRIPTION": "Enfernt jegliche Kollision vom T-Rex sobald er stirbt. Dies ist sehr hilfreich, wenn die Leiche eines T-Rex den Ausgang blockiert.",
        "SETTING_ENABLE_3D_PICKUPS": "3D-Pickups",
        "SETTING_ENABLE_3D_PICKUPS_DESCRIPTION": "Aktiviert die Darstellung von 3D-Modellen für Pickups anstatt der üblichen Sprites.",
        "SETTING_ENABLE_ALLY_TARGETING": "Erlaube das ziehlen auf freundliche Einheiten",
        "SETTING_ENABLE_ALLY_TARGETING_DESCRIPTION": "Erlaubt Lara, auf freundliche Einheiten zu ziehlen, wie zum Beispiel Mönche. Wenn diese Option deaktiviert ist, sind freundliche Einheiten immun gegen Laras Munition.",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION": "Vorausgewählte Schlüssel-Items",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "Wenn Lara ein Schlüsselloch oder einen Rätsel-Slot verwendet und sie das dazu passende Item in ihrem Inventar hat, wird dieses automatisch ausgewählt.",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE": "\\{review}Stolpern an rückwärtiger Schräge",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE_DESCRIPTION": "\\{review}Lässt Lara stolpern, wenn sie rückwärts springt und sich hinter ihr eine Schräge befindet (TR3). Wenn deaktiviert, kommt Lara abrupt an der Schräge zum Stehen (TR1/2).",
        "SETTING_ENABLE_BAR_FLASHING": "\\{review}Leisten blinken",
        "SETTING_ENABLE_BAR_FLASHING_DESCRIPTION": "\\{review}Lässt Laras Gesundheits- und Sauerstoffanzeigen blinken, wenn eine der Ressourcen knapp wird.",
        "SETTING_ENABLE_BOULDER_SHAKE": "\\{review}Felskamerawackeln aktivieren",
        "SETTING_ENABLE_BOULDER_SHAKE_DESCRIPTION": "\\{review}Wenn aktiviert, wackelt die Kamera, sobald sich ein Fels bewegt.",
        "SETTING_ENABLE_BOUNCY_GRENADES": "\\{review}Sprunggranaten",
        "SETTING_ENABLE_BOUNCY_GRENADES_DESCRIPTION": "\\{review}Aktiviert das Granatenverhalten im Stil von TR3: Sie prallen von Wänden und Hängen ab und erzeugen einen größeren Explosionsradius, jedoch auf Kosten einer reduzierten Geschwindigkeit.",
        "SETTING_ENABLE_BRAID": "Laras Zopf",
        "SETTING_ENABLE_BRAID_DESCRIPTION": "Aktiviert Laras Zopf.",
        "SETTING_ENABLE_BREEZE": "Brise",
        "SETTING_ENABLE_BREEZE_DESCRIPTION": "Aktiviert eine Brise, die Laras Zopf in den richtigen Räumen zum Wehen bringt.",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS": "\\{review}Pufferung (F-Tasten)",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS_DESCRIPTION": "\\{review}Aktiviert F-Tasten (1-Frame) Pufferung, um eine präzise Steuerung von Laras Bewegung zu ermöglichen. Diese Funktion existiert ursprünglich nur im TombATI-Port (TR1).",
        "SETTING_ENABLE_BUFFERING_INVENTORY": "\\{review}Pufferung (Inventar)",
        "SETTING_ENABLE_BUFFERING_INVENTORY_DESCRIPTION": "\\{review}Aktiviert die Pufferung des Inventars (2 Frames), um eine präzise Steuerung von Laras Bewegung zu ermöglichen.",
        "SETTING_ENABLE_CHEATS": "Cheats",
        "SETTING_ENABLE_CHEATS_DESCRIPTION": "Aktiviert verschiedene Cheats:\n\n- L: Beende das Level sofort.\n- I: eine Erhöhung der Anzahl der Munition und Medipacks; und alle plotrelevanten Items des aktuellen Levels.\n- O: Aktiviere Flug-Cheat (in der Luft schwimmen).\n  - GEHEN-Taste: beende Flug-Modus.\n  - WAFFE ZIEHEN-Taste: öffne die nächstgelegene Tür (funktioniert an ein paar Stellen nicht).",
        "SETTING_ENABLE_COMPASS_STATS": "Levelstatistiken im Kompass",
        "SETTING_ENABLE_COMPASS_STATS_DESCRIPTION": "Aktiviert die Anzeige von Levelstatistiken wenn der Kompass ausgewählt wird.",
        "SETTING_ENABLE_CONSOLE": "Konsole",
        "SETTING_ENABLE_CONSOLE_DESCRIPTION": "Aktiviert die Entwickler-Konsole.",
        "SETTING_ENABLE_CONTROLLED_DROPS": "\\{review}Kontrollierter Fall",
        "SETTING_ENABLE_CONTROLLED_DROPS_DESCRIPTION": "\\{review}Ermöglicht Lara, sich in der Luft zu drehen und den Vorsprung zu greifen, den sie gerade verlassen hat, wenn die Aktionstaste beim Fallen gehalten wird.",
        "SETTING_ENABLE_CREDITS": "Credits",
        "SETTING_ENABLE_CREDITS_DESCRIPTION": "Ermöglicht die Anzeige der Credits nachdem man das Spiel durchgespielt hat. Beeinflusst nicht die Anzeige der Finalen Statistik.",
        "SETTING_ENABLE_CUTSCENES": "Zwischensequenzen",
        "SETTING_ENABLE_CUTSCENES_DESCRIPTION": "Aktiviert das Abspielen von Zwischensequenzen.",
        "SETTING_ENABLE_DEATHS_COUNTER": "Laras Tode zählen",
        "SETTING_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Aktiviert die Aufzählung von Laras Toden im Kompass und in den Level-Statistiken. Die Anzahl der Tode wird im aktuell geladenen Speicherstand aktualisiert, sobald sie stirbt.",
        "SETTING_ENABLE_DEMO": "Demo-Modus",
        "SETTING_ENABLE_DEMO_DESCRIPTION": "Aktiviert die Anzeige von Demos im Hauptmenü.",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME": "\\{review}Unendliche Fackelzeit",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME_DESCRIPTION": "\\{review}Verhindert, dass die tragbaren Fackeln jemals erlöschen. Geworfene Fackeln erlöschen jedoch weiterhin wie gewohnt.",
        "SETTING_ENABLE_ENDLESS_SPRINT": "\\{review}Endloses Sprinten",
        "SETTING_ENABLE_ENDLESS_SPRINT_DESCRIPTION": "\\{review}Verhindert, dass Lara beim Sprinten jemals müde wird. Hindernisse bringen sie jedoch weiterhin zum Stillstand.",
        "SETTING_ENABLE_ENEMY_ROTATION": "Zufällige Startwinkel für Gegner",
        "SETTING_ENABLE_ENEMY_ROTATION_DESCRIPTION": "Verwendet einen zusätzlichen zufälligen Startwinkel für ein paar Gegner, sobald sie initialisiert werden.",
        "SETTING_ENABLE_ENHANCED_SAVES": "Speichere Effekte",
        "SETTING_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Erweitert Spielstände so das Grafikeffekte, Wasserfall-Nebel, Flammenerzeuger und mehr gespeichert werden, anstatt beim Laden zu verschwinden.",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS": "Abblenden beim Beenden des Spiels",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION": "Aktiviert die Abblend-Effekte wenn man das Spiel vollständig beendet.",
        "SETTING_ENABLE_FADE_EFFECTS": "Überganseffekte",
        "SETTING_ENABLE_FADE_EFFECTS_DESCRIPTION": "Aktiviere Abblenden bei Übergängen, zum Beispiel bei Credits-, Grafikeinstellungs-, Inventar- und Pause-Bildübergängen.",
        "SETTING_ENABLE_FIRE_LIGHTING": "Feuer-Beleuchtung",
        "SETTING_ENABLE_FIRE_LIGHTING_DESCRIPTION": "Ermöglicht die generierung von dynamischen Lichteffekten neben aktiven Flammen.",
        "SETTING_ENABLE_FMV": "FMVs",
        "SETTING_ENABLE_FMV_DESCRIPTION": "Aktiviert das Abspielen von FMVs.",
        "SETTING_ENABLE_FOOTPRINTS": "\\{review}Fußspuren",
        "SETTING_ENABLE_FOOTPRINTS_DESCRIPTION": "\\{review}Ermöglicht das Anzeigen von Laras Fußspuren auf bestimmten Oberflächen in unterstützten Levels.",
        "SETTING_ENABLE_GAME_MODES": "Spielmodi-Auswahl",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Erlaubt die Auswahl der 'Neues Spiel Plus'-Optionen im 'Neues Spiel' Ausweis-Menü.\n\n- Neues Spiel+: schaltet alle Waffen mit unendlich Munition frei; Feinde haben verdoppelte Lebenserenergie.\n- Japanisch NS: Waffen verursachen doppelten Schaden und Fackel-Pickups enhalten 8 statt 6 Fackeln.\n- Japanisch NS+: eine Kombination aus Neus Spiel+ und Japanisch NS.",
        "SETTING_ENABLE_GUN_LIGHTING": "Dynamisches Licht für Waffen",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Aktiviert die verwendung von dynamischer Beleuchtung für Schüsse und Explosionen.",
        "SETTING_ENABLE_IDLE_POSE_CAMERA": "\\{review}Leerlauf-Kamera",
        "SETTING_ENABLE_IDLE_POSE_CAMERA_DESCRIPTION": "\\{review}Passt die Kamera an, sodass sie während der Posenanimation auf Lara gerichtet ist. Durch Drücken von Schauen wird die Kamera zurückgesetzt.",
        "SETTING_ENABLE_INVERTED_LOOK": "Invertiertes Umsehen",
        "SETTING_ENABLE_INVERTED_LOOK_DESCRIPTION": "Invertiert die Y-Axe von Laras Sichtsteuerung.",
        "SETTING_ENABLE_ITEM_EXAMINING": "Item-Untersuchung",
        "SETTING_ENABLE_ITEM_EXAMINING_DESCRIPTION": "Für benutzergenerierte Level - erlaubt die Anzeige von Item-Beschreibungen im Inventar, wenn der Ersteller des Levels die nötigen Daten zur Verfügung gestellt hat.",
        "SETTING_ENABLE_JUMP_TWISTS": "Sprungdrehungen",
        "SETTING_ENABLE_JUMP_TWISTS_DESCRIPTION": "Aktiviert TR2+-artige Sprungdrehungen und Purzelbäume, das heißt: Drücke Rolle während des Sprungs und Kopfsprung-Animationen.",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS": "\\{review}Tödliche Schiebeblöcke aktivieren",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS_DESCRIPTION": "Aktiviert, dass Lara sofort stirbt, wenn ein Schiebeblock von oben auf Lara herab fällt. Andernfalls wird Lara oben auf dem Block hängen bleiben und überleben.",
        "SETTING_ENABLE_LARA_MIC": "Mikrofon nah an Lara",
        "SETTING_ENABLE_LARA_MIC_DESCRIPTION": "Setzt das Mikrofon auf Laras Position. Wenn deaktiviert, wird das Mikrofon auf der Position der Kamera gesetzt.",
        "SETTING_ENABLE_LEAN_JUMPING": "Schmales Springen",
        "SETTING_ENABLE_LEAN_JUMPING_DESCRIPTION": "Erlaubt Lara, sich weiter voran oder rückwärts zu tasten, wenn man eine der Richtungstasten gedrückt hält, während sie einen neutralen Sprung ausführt.",
        "SETTING_ENABLE_LEDGE_JUMPS": "\\{review}Vorsprung-Sprünge",
        "SETTING_ENABLE_LEDGE_JUMPS_DESCRIPTION": "\\{review}Ermöglicht Lara, nach oben oder rückwärts zu springen, während sie an einem Vorsprung hängt, sofern sich eine feste Fläche vor ihr befindet, um sich abzustoßen.",
        "SETTING_ENABLE_LEGAL": "Rechtshinweise",
        "SETTING_ENABLE_LEGAL_DESCRIPTION": "Aktiviert die Rechtshinweise und die Core Design FMV beim Starten des Spiels.",
        "SETTING_ENABLE_LOADING_SCREENS": "Ladebildschirme",
        "SETTING_ENABLE_LOADING_SCREENS_DESCRIPTION": "Aktiviert PS1-artige Ladebildschirme vor jedem Level.",
        "SETTING_ENABLE_MANUAL_CAMERA": "\\{review}Manuelle Kamera",
        "SETTING_ENABLE_MANUAL_CAMERA_DESCRIPTION": "\\{review}Aktiviert die Kameratasten (\\{input camera_forward}\\{input camera_back}\\{input camera_left}\\{input camera_right}), die zur Steuerung der Kamera im Fotomodus verwendet werden, um auch die Ingame-Kamera zu drehen.",
        "SETTING_ENABLE_MUSIC_IN_MENU": "Hauptmenü-Musik",
        "SETTING_ENABLE_MUSIC_IN_MENU_DESCRIPTION": "Spielt Musik im Hauptmenü ab.",
        "SETTING_ENABLE_NEUTRAL_TWISTS": "\\{review}Neutrale Drehung",
        "SETTING_ENABLE_NEUTRAL_TWISTS_DESCRIPTION": "\\{review}Ermöglicht Lara eine Drehung in der Luft bei einem Sprung aus dem Stand. Drücke gleichzeitig die Sprung- und Rollentaste, während du stillstehst.",
        "SETTING_ENABLE_PICKUP_AIDS": "Gegenstände hervorheben",
        "SETTING_ENABLE_PICKUP_AIDS_DESCRIPTION": "Aktiviert einen periodischen Funkel-Effekt in der Nähe von Items, um ihre Gegenwart sichtbarer zu machen.",
        "SETTING_ENABLE_PITCHED_SOUNDS": "Gepitchte Sounds",
        "SETTING_ENABLE_PITCHED_SOUNDS_DESCRIPTION": "Erlaubt die zufällige Wiedergabe von Sound-Effekten, leicht gepitched, um die Spiel-Sounds zu variieren.",
        "SETTING_ENABLE_PLAY_PREVIOUS_LEVELS": "\\{review}Vorherige Level spielen",
        "SETTING_ENABLE_PS1_CRYSTALS": "PS1-Kristall-Farbton",
        "SETTING_ENABLE_PS1_CRYSTALS_DESCRIPTION": "Der Speicherkristall bekommt einen lila Farbton, ähnlich wie bei der PS1-Variante.",
        "SETTING_ENABLE_PS1_SFX": "\\{review}PS1 SFX-Ersetzungen",
        "SETTING_ENABLE_PS1_SFX_DESCRIPTION": "\\{review}Aktiviert bestimmte Soundeffekt-Ersetzungen mit PS1-Äquivalenten.\n\n- Uzi-Feuer (nur TR1)\n- Laras Barfußgeräusche (nur TR2)",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT": "Reaktionsfähiger Ausweis",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Deaktiviert, dass man die Umblättern-Animation des Ausweises abwarten muss, sie können nun so schnell umblättern, wie sie wollen.",
        "SETTING_ENABLE_RESPONSIVE_SPRINT": "\\{review}Reaktives Sprinten",
        "SETTING_ENABLE_RESPONSIVE_SPRINT_DESCRIPTION": "\\{review}Aktiviert einen reaktiveren Sprintzustand für Lara.\n\n- ermöglicht Sprinten, sobald Lara Energie hat, statt nur bei voller Ausdauer.\n- erlaubt Sprinten auf Treppen, ohne von Laras normaler Laufanimation unterbrochen zu werden.",
        "SETTING_ENABLE_SAVE_CRYSTALS": "Speicherkristalle",
        "SETTING_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Beschränkt Speichern auf den Anfang des Levels und Speicherkristalle. Level haben eine limitierte Anzahl von Speicherkristallen. Die Speicherkristalle funktionieren nur einmal, so wie auf der PS1. Eine Änderung dieser Option erfordert einen Neustart.",
        "SETTING_ENABLE_SHOTGUN_FLASH": "Schrotflinten-Mündungsfeuer",
        "SETTING_ENABLE_SHOTGUN_FLASH_DESCRIPTION": "Zeigt Mündungsfeuer an, wenn man mit der Schrotflinte schießt, wie bei anderen Waffen.",
        "SETTING_ENABLE_SKYBOX": "Skyboxes",
        "SETTING_ENABLE_SKYBOX_DESCRIPTION": "Aktiviert die Skybox in unterstützten Leveln.",
        "SETTING_ENABLE_SLIDE_TO_RUN": "\\{review}Rutsch-Lauf-Übergang",
        "SETTING_ENABLE_SLIDE_TO_RUN_DESCRIPTION": "\\{review}Ermöglicht es Lara, sofort loszulaufen, sobald sie nach dem Vorwärtsrutschen auf einer Schräge den Boden erreicht. Halte die Vorwärts-Taste gedrückt, um dies zu aktivieren.",
        "SETTING_ENABLE_SMOOTH_BARS": "Leisten-Farbverläufe",
        "SETTING_ENABLE_SMOOTH_BARS_DESCRIPTION": "Sorgt bei Gesundheitsleisten, Sauerstoffleisten und Gesundheitsleisten von Feinden für einen fließenden Farbübergang.",
        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT": "Sanftes Wand-Abprallen",
        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT_DESCRIPTION": "Erlaubt Lara, sich schneller zu fangen, nachdem sie gegen eine Wand gestoßen ist und eine der Richtungstasten zusammen mit der Vorwärtstaste gedrückt gehalten wird..",
        "SETTING_ENABLE_SOFT_STATICS": "\\{review}Weiche Netz-Kollision",
        "SETTING_ENABLE_SOFT_STATICS_DESCRIPTION": "\\{review}Ermöglicht es Lara, sich sanft gegen statische Meshes zu bewegen – ähnlich wie in TR4+ – anstatt abrupt anzuhalten.",
        "SETTING_ENABLE_SPRINT": "\\{review}Sprinten",
        "SETTING_ENABLE_SPRINT_DESCRIPTION": "\\{review}Ermöglicht Lara zu sprinten, ähnlich wie in TR3+.",
        "SETTING_ENABLE_STEP_ROLL_BOOST": "Stufen-Roll-Boost",
        "SETTING_ENABLE_STEP_ROLL_BOOST_DESCRIPTION": "Erlaubt Lara von einer ein-Click hohen Stufe (standard) geboostet zu werden, wenn nahe der Stufen-Kante Rollen gedrückt wird.",
        "SETTING_ENABLE_SWING_CANCEL": "Schwingen unterbrechen",
        "SETTING_ENABLE_SWING_CANCEL_DESCRIPTION": "Erlaubt, Laras Kanten-Schwinganimation abzubrechen, indem man kurz loslässt und sich schnell wieder festhält.",
        "SETTING_ENABLE_TARGET_CHANGE": "Zielwechsel",
        "SETTING_ENABLE_TARGET_CHANGE_DESCRIPTION": "Ermöglicht TR4+ artiges wechseln zwischen den Zielen, während man mit den Waffen auf sie zielt. Drücke die Zielwechsel-Taste während des ziehlens, um das anvisierte Ziel zu wechseln.",
        "SETTING_ENABLE_TIMER_IN_INVENTORY": "Timer zählt im Inventar",
        "SETTING_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION": "Lässt den In-Game-Timer weiterlaufen, selbst wenn während des Spiels das Inventar geöffnet ist.",
        "SETTING_ENABLE_TOTAL_STATS": "Finale Statistik-Anzeige",
        "SETTING_ENABLE_TOTAL_STATS_DESCRIPTION": "Aktiviert die Erstellung einer Gesamtstatistik vom ganzen Spiel, die nach dem Abspielen der Credits angezeigt wird.",
        "SETTING_ENABLE_TR2_JUMPING": "Reaktionsschnelleres Springen",
        "SETTING_ENABLE_TR2_JUMPING_DESCRIPTION": "\\{review}Erlaubt Lara, während des Rennens jederzeit zu springen.",
        "SETTING_ENABLE_TR2_SWIMMING": "Flüssiges Schwimmverhalten",
        "SETTING_ENABLE_TR2_SWIMMING_DESCRIPTION": "Verpasst Laras Drehgeschwindigkeit unter Wasser eine Beschleunigungskurve für ein runderes Steuerungsverhalten, ähnlich wie in TR2+.",
        "SETTING_ENABLE_TR2_SWIM_CANCEL": "Reaktionsschneller Schwimm-Abbruch",
        "SETTING_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION": "Erlaubt Lara, unter Wasser schneller stoppen zu können, wenn die Springen-Taste losgelassen wird.",
        "SETTING_ENABLE_TR3_SIDESTEPS": "Erweiterte Seit-Schritte",
        "SETTING_ENABLE_TR3_SIDESTEPS_DESCRIPTION": "Aktiviert Seitschritte im Stil von TR3+, e. g. Shift + Richtungspfeile. Deaktiviert die Seitschritt-Tasten.",
        "SETTING_ENABLE_UNDERWATER_ANIM_SFX": "Tauch-Animations Sounds",
        "SETTING_ENABLE_UNDERWATER_ANIM_SFX_DESCRIPTION": "Erlaubt Kontrolle über das Abspielen von bestimmten Animationen und Souneffekten - für Objekte, wie zum Beispiel Türen und Falltüren - wenn die Kamera unter Wasser ist.",
        "SETTING_ENABLE_UW_ROLL": "Rolle unter Wasser",
        "SETTING_ENABLE_UW_ROLL_DESCRIPTION": "Erlaubt Lara, eine Rolle unter Wasser durchzuführen, ähnlich wie in TR2+.",
        "SETTING_ENABLE_WADING": "Durchwaten",
        "SETTING_ENABLE_WADING_DESCRIPTION": "\\{review}Erlaubt Lara, flaches Wasser zu durchwaten, anstatt an der Wasseroberfläche stecken zu bleiben.",
        "SETTING_ENABLE_WALK_TO_ITEMS": "Animierte Interaktionen",
        "SETTING_ENABLE_WALK_TO_ITEMS_DESCRIPTION": " Lässt Lara zu Pickups und Schaltern hingehen, anstatt sie zu ihnen zu teleportieren.",
        "SETTING_ENABLE_WEATHER": "\\{review}Wetter",
        "SETTING_ENABLE_WEATHER_DESCRIPTION": "\\{review}Aktiviert die Darstellung von Wettereffekten in unterstützten Levels.",
        "SETTING_ENEMY_HEALTHBAR_COLOR": "Leisten-Farbe der Feinde",
        "SETTING_ENEMY_HEALTHBAR_COLOR_DESCRIPTION": "Gesundheitsleisten-Farbe der Feinde",
        "SETTING_ENEMY_HEALTHBAR_LOCATION": "Position der Gesundheitsleiste der Feinde",
        "SETTING_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION": "Die Position, an der die feindliche Gesundheitsleiste angezeigt wird.",
        "SETTING_ENEMY_HEALTHBAR_SHOW_MODE": "Gesundheitleiste der Feinde",
        "SETTING_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Aktiviert die Anzeige einer Gesundheitleiste für aktive Feinde.",
        "SETTING_EXPOSUREBAR_COLOR": "\\{review}Farbe der Ausdauerleiste",
        "SETTING_EXPOSUREBAR_COLOR_DESCRIPTION": "\\{review}Farbe der Kaltwasser-Ausdauerleiste.",
        "SETTING_EXPOSUREBAR_LOCATION": "\\{review}Position der Ausdauerleiste",
        "SETTING_EXPOSUREBAR_LOCATION_DESCRIPTION": "\\{review}Position, an der die Kaltwasser-Ausdauerleiste angezeigt wird.",
        "SETTING_FIX_ALLIGATOR_AI": "Fix: Alligator-AI",
        "SETTING_FIX_ALLIGATOR_AI_DESCRIPTION": "Fixt, dass die Alligatoren keinen Schaden machen, wenn Lara sich im Wasser befindet und sich nicht bewegt.",
        "SETTING_FIX_ANIMATED_SPRITES": "Fix: Sprite-Animationen",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "\\{review}Behebt die ursprünglichen Unterwasser-Pflanzen-Sprites, sodass sie in Wasserbereichen richtig animiert werden.",
        "SETTING_FIX_BEAR_AI": "Fix: Bären-AI",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Fixt, dass die aufrecht stehend ausgeführten Prankenhiebe von Bären Lara nicht mehr verfehlen.",
        "SETTING_FIX_BRIDGE_COLLISION": "Fix: Brückenkollision",
        "SETTING_FIX_BRIDGE_COLLISION_DESCRIPTION": "Fixt, dass Lara nicht in der Lage ist, sich an einigen Teilen von Brücken festzuhalten und unsichtbare Wände an den Kanten. Fixt auch Kollisions-Fehler mit Zugbrücken, Falltüren, und Brücken, wenn sie übereinander gestapelt sind, über Schrägen, und nahe dem Boden.",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND": "Fix: Falsch abspielender Sound",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND_DESCRIPTION": "Verhindert, dass der Geheimnis-Ton inkorrekterweise abgespielt wird, wenn man den Goldenen Schlüssel im Grab von Tihocan benutzt.",
        "SETTING_FIX_DESCENDING_GLITCH": "Fix: Zerbrechliche Böden-Stürze",
        "SETTING_FIX_DESCENDING_GLITCH_DESCRIPTION": "Fixt, dass Seit-Schritte und Vorwärtslaufen auf zerbrechlichen Platten dazu führen, dass Lara sofort herab zur darunter liegenden Platte fällt.",
        "SETTING_FIX_FLARE_THROW_PRIORITY": "Fix: Fackel-Wurf-Priorität",
        "SETTING_FIX_FLARE_THROW_PRIORITY_DESCRIPTION": "Fixt, dass Lara das Wegwerfen einer aufgebrauchten Fackel priorisiert, während sie sich in der Luft befindet. Dies kann manchmal dazu führen, dass sie nicht in der Lage ist, sich an Kanten festzuhalten.",
        "SETTING_FIX_FLOOR_DATA_ISSUES": "Fix: Floor-Data-Fehler",
        "SETTING_FIX_FLOOR_DATA_ISSUES_DESCRIPTION": "Fixt originale Fehler mit Boden Daten/Triggern.",
        "SETTING_FIX_FREE_FLARE_GLITCH": "Fix: gratis Fackel-Glitch",
        "SETTING_FIX_FREE_FLARE_GLITCH_DESCRIPTION": "Fixt die Möglichkeit, eine gratis Fackel zu erschaffen, wenn man während des Aufhebens eines Gegenstandes die Fackel-Taste drückt.",
        "SETTING_FIX_GLIDE_CAMERAS": "Fix: Gleitkameras",
        "SETTING_FIX_GLIDE_CAMERAS_DESCRIPTION": "Fixt, dass Gleitkameras die in den Level-Triggern gesetzten Timer beachten, anstatt die Geschwindigkeit nach dem ersten Frame auf Standard zurückzusetzen.",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH": "Fix: Item-Vervielfältigungs-Glitch",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION": "Fixt die Möglichkeit, Schlüsselgegenstände im Inventar mehrfach nutzen zu können.",
        "SETTING_FIX_ITEM_ROTS": "Fix: Item-Rotations-Fehler",
        "SETTING_FIX_ITEM_ROTS_DESCRIPTION": "Fixt originale Fehler mit einigen falsch rotierenden Pickups, wenn man die 3D-Pickups-Option verwendet.",
        "SETTING_FIX_LARA_PICKUP_EMBED": "Fix: Pickup-Fehler",
        "SETTING_FIX_LARA_PICKUP_EMBED_DESCRIPTION": "\\{review}Behebt ein Problem, bei dem Lara manchmal in Wände driftet, wenn sie unter Wasser Gegenstände einsammelt, sowie beim Einsammeln von Gegenständen über Wasser unter steil geneigten Decken.",
        "SETTING_FIX_M16_ACCURACY": "\\{review}Fix: M16/MP5-Genauigkeit",
        "SETTING_FIX_M16_ACCURACY_DESCRIPTION": "\\{review}Fixt die Genauigkeit des M16/MP5, während Lara rennt.",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY": "\\{review}Behebe die Priorität beim Aufheben von Affen",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY_DESCRIPTION": "\\{review}Angegriffene Affen werden das Zurückschlagen priorisieren, bevor sie Medi-Packs und Schlüssel aufsammeln.",
        "SETTING_FIX_QWOP_GLITCH": "Fix: QWOP-Glitch",
        "SETTING_FIX_QWOP_GLITCH_DESCRIPTION": "Fixt, dass Lara auf kleinen Stufen springt, was manchmal in einer seltsamen Lauf-Animation resultiert, bekannt als QWOP-Zustand.",
        "SETTING_FIX_SECRETS_KILLING_MUSIC": "Überlagernde Geheimnis-Musik",
        "SETTING_FIX_SECRETS_KILLING_MUSIC_DESCRIPTION": "Fixt dass der Ton vom Geheimnis-Einsammeln den momentan spielenden Musik-Titel unterbricht.",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC": "Überlagernde Feind-Sprache",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC_DESCRIPTION": "Fixt dass Feinde beim Sprechen den momentan spielenden Musiktitel unterbrechen.",
        "SETTING_FIX_STEP_GLITCH": "Fix: Stufen-Glitch",
        "SETTING_FIX_STEP_GLITCH_DESCRIPTION": "Fixt, dass Lara manchmal in Wände, die an Treppen angrenzen, gedrückt wird, wenn sie auf eine bestimmte Weise an ihnen entlangläuft.",
        "SETTING_FIX_TEXTURE_ISSUES": "Fix: Textur-Fehler",
        "SETTING_FIX_TEXTURE_ISSUES_DESCRIPTION": "Fixt originale Fehler mit fehlenden oder inkorrekten Texturen/Meshes.",
        "SETTING_FIX_WADE_WALL_HIT": "Fix: Wand-Treffer beim Waten",
        "SETTING_FIX_WADE_WALL_HIT_DESCRIPTION": "Fixt, dass Lara beim waten nicht reagiert, wenn sie eine Wand trifft.",
        "SETTING_FIX_WALK_RUN_JUMP": "Fix: Gehen-Laufen-Sprung",
        "SETTING_FIX_WALK_RUN_JUMP_DESCRIPTION": "Fixt, dass Lara manchmal nicht sofort springen kann, direkt nachdem sie von ihrer Gehen-Animation zur Laufen-Animation wechselt.",
        "SETTING_FIX_WATER_EXIT": "Wasser Ausstieg",
        "SETTING_FIX_WATER_EXIT_DESCRIPTION": "Fixt dass Lara direkt in einen angrenzenden, trockenen Raum oder in einen trockenen Raum unterhalb gelangen kann. Zusätzlich verhindert es, dass Lara aus dem Wasser heraus auf nicht begehbare Schrägen klettern kann.",
        "SETTING_FMV_VOLUME": "\\{review}FMV-Lautstärke",
        "SETTING_FMV_VOLUME_DESCRIPTION": "Passt die Lautstärke der Videosequenzen an.",
        "SETTING_FOG_COLOR_B": "\\{review}Nebel Farbe (B)",
        "SETTING_FOG_COLOR_B_DESCRIPTION": "\\{review}Blauanteil der Nebelfarbe.",
        "SETTING_FOG_COLOR_G": "\\{review}Nebel Farbe (G)",
        "SETTING_FOG_COLOR_G_DESCRIPTION": "\\{review}Grünanteil der Nebelfarbe.",
        "SETTING_FOG_COLOR_R": "\\{review}Nebel Farbe (R)",
        "SETTING_FOG_COLOR_R_DESCRIPTION": "\\{review}Rotanteil der Nebelfarbe.",
        "SETTING_FOG_END": "Ende des Nebels",
        "SETTING_FOG_END_DESCRIPTION": "Stellt die Distanz in Kacheln ein, in der der Nebel alles völlig verhüllt.",
        "SETTING_FOG_START": "Beginn des Nebels",
        "SETTING_FOG_START_DESCRIPTION": "Stellt die Distanz in Kacheln ein, in der der Nebel zu erscheinen beginnt.",
        "SETTING_FOG_TRANSPARENCY": "\\{review}Nebel Transparenz",
        "SETTING_FOG_TRANSPARENCY_DESCRIPTION": "Bestimmt ob die Überlagerung entfernter Geometrie mit 100% transparenten Flächen aktiviert werden soll.",
        "SETTING_FOV": "\\{review}Sichtfeld",
        "SETTING_FOV_DESCRIPTION": "\\{review}Blickwinkel in Grad. Größere Werte erweitern das Sichtfeld, kleinere verengen es.",
        "SETTING_FPS": "FPS",
        "SETTING_FPS_DESCRIPTION": "Stellt Spiel-Frames pro second ein.",
        "SETTING_GAMMA": "\\{review}Gamma",
        "SETTING_GAMMA_DESCRIPTION": "\\{review}Passt die Gammakurve an. Höhere Werte bedeuten hellere Beleuchtung. Der Wert 2,5 entspricht den Standardfarben.",
        "SETTING_HARPOON_RECOIL": "Harpunenrückstoß",
        "SETTING_HARPOON_RECOIL_DESCRIPTION": "Legt fest, wie oft Lara die Harpune nachladen muss, basierend auf ihrer momentanen Munitionsanzahl. Zum Beispiel, wenn es auf 3 festgelegt ist, muss sie nach jedem dritten Schuss nachladen. Auf 0 eingestellt, deaktiviert das Nachladen vollständig.",
        "SETTING_HEALTHBAR_COLOR": "Gesundheitsleisten-Farbe",
        "SETTING_HEALTHBAR_COLOR_DESCRIPTION": "Farbe der Gesundheitsleiste.",
        "SETTING_HEALTHBAR_LOCATION": "Position der Gesundheitsleiste",
        "SETTING_HEALTHBAR_LOCATION_DESCRIPTION": "Position, an der die Gesundheitsleiste angezeigt wird.",
        "SETTING_HEALTHBAR_POISON_COLOR": "\\{review}Gift Gesundheitsbalken Farbe",
        "SETTING_HEALTHBAR_POISON_COLOR_DESCRIPTION": "\\{review}Farbe des Gesundheitsbalkens, wenn Lara vergiftet ist.",
        "SETTING_IDLE_POSE_TIMEOUT": "\\{review}Leerlauf-Zeit",
        "SETTING_IDLE_POSE_TIMEOUT_DESCRIPTION": "\\{review}Ermöglicht Lara, nach der angegebenen Anzahl an Sekunden Inaktivität eine Posenanimation zu starten. Auf 0 setzen, um zu deaktivieren.",
        "SETTING_INVENTORY_AMBIENT_VOLUME": "\\{review}Umgebungslautstärke (Inventar)",
        "SETTING_INVENTORY_AMBIENT_VOLUME_DESCRIPTION": "\\{review}Passt die Umgebungslautstärke im Inventarbildschirm an.",
        "SETTING_INVENTORY_BACKGROUND_STYLE": "\\{review}Inventar-Hintergrund",
        "SETTING_INVENTORY_BACKGROUND_STYLE_DESCRIPTION": "\\{review}Ändert die Art und Weise, wie der Hintergrund für den Inventarring angezeigt wird.\n\n- Dunkel: TR1 (PC).\n- Sehr dunkel: TR1 (PS1).\n- Statisch: TR2 (PC).\n- Welle: TR2 (PS1).\n- Monochrom: TR3.",
        "SETTING_INVENTORY_FADE_EFFECTS": "\\{review}Inventar-Ausblend-Effekte",
        "SETTING_INVENTORY_FADE_EFFECTS_DESCRIPTION": "\\{review}Feinabstimmung, ob die Ausblend-Effekte im Inventarring des Spiels aktiviert oder deaktiviert sind. Die Option Ausblend-Effekte muss aktiviert sein, damit dies funktioniert.",
        "SETTING_INVENTORY_MUSIC_VOLUME": "\\{review}Musiklautstärke (Inventar)",
        "SETTING_INVENTORY_MUSIC_VOLUME_DESCRIPTION": "\\{review}Passt die Musiklautstärke im Inventarbildschirm an.",
        "SETTING_JUMP_LOCK_MODE": "Sprung-Block Modus",
        "SETTING_JUMP_LOCK_MODE_DESCRIPTION": "Erlaubt einzustellen, wie früh es Lara erlaubt ist zu springen, nachdem sie begonnen hat zu laufen.\n\n- Original: entspricht dem originalen TR2 Timing.\n- Getuned: springen ist 2 Frames früher möglich.\n- Deaktiviert: springen ist sofort nachdem die Laufen-Animation begonnen hat möglich.",
        "SETTING_LIGHTING_CONTRAST": "Beleuchtungs-Kontrast",
        "SETTING_LIGHTING_CONTRAST_DESCRIPTION": "Erhöht den Kontrast für dynamische Lichtquellen, wie zum Beispiel Fackeln und Mündungsfeuer.",
        "SETTING_LOAD_MUSIC_TRIGGERS": "Fix: Trigger für Musik, die nur einmal spielen soll",
        "SETTING_LOAD_MUSIC_TRIGGERS_DESCRIPTION": "Lädt vorher getriggerte Musik, so dass Musik, die nur einmal spielen soll, nicht ein weiteres Mal abgespielt wird.",
        "SETTING_LOOK_MODE": "Umsehen Modus",
        "SETTING_LOOK_MODE_DESCRIPTION": "Erlaubt einzustellen wann Lara in der Lage ist sich umzusehen.\n\n- Beschränkt: Umsehen ist nur möglich wenn Lara still steht, und nie wenn man unter Wasser ist.\n- Erweitert: Umsehen ist während der meisten Animationen möglich, ausser ein paar Ausnahmen wie das Schieben eines Blockes.\n- Unbeschränkt: Umsehen ist jederzeit während der normalen Steuerung von Lara möglich.",
        "SETTING_MASTER_VOLUME": "\\{review}\\{icon music} Hauptlautstärke",
        "SETTING_MASTER_VOLUME_DESCRIPTION": "\\{review}Passt die gesamte Spiel-Lautstärke an. Die restlichen Einstellungen sind relativ zu dieser Lautstärke.",
        "SETTING_MAXIMUM_SAVE_SLOTS": "Anzahl der Speicher-Slots",
        "SETTING_MAXIMUM_SAVE_SLOTS_DESCRIPTION": "Ändert die Anzahl der verfügbaren Speicher-Slots.",
        "SETTING_MENU_STYLE": "Menü-Stil",
        "SETTING_MENU_STYLE_DESCRIPTION": "Ändert, wie Menüs dargestellt werden.\n\n - PC: UI-Stil gleicht der PC-Version.\n - PS1: UI-Stil gleicht der PS1-Version.",
        "SETTING_MUSIC_LOAD_CONDITION": "Musik beim Laden wiederherstellen",
        "SETTING_MUSIC_LOAD_CONDITION_DESCRIPTION": "Lädt den Musiktitel der vor dem Speichern des Spiels abgespielt wurde.\n\n- Nie: keine Musik-Titel beim laden wiederherstellen.\n- Nicht-Umgebung: stellt nur Nicht-Umgebungs-Musiktitel beim laden wieder her.\n- Immer: stellt jede Art von Musiktitel beim Laden wieder her.",
        "SETTING_MUSIC_VOLUME": "\\{review}Musiklautstärke",
        "SETTING_MUSIC_VOLUME_DESCRIPTION": "\\{review}Passt die Musiklautstärke an.",
        "SETTING_MUTE_OUT_OF_FOCUS": "Ton stummschalten bei Fokusverlust",
        "SETTING_MUTE_OUT_OF_FOCUS_DESCRIPTION": "Schaltet alle Musik und Soundeffekte stumm wenn das Fenster des Spiels nicht fokusiert ist.",
        "SETTING_PAUSE_BACKGROUND_STYLE": "\\{review}Pause-Hintergrund",
        "SETTING_PAUSE_BACKGROUND_STYLE_DESCRIPTION": "\\{review}Ändert die Art und Weise, wie der Hintergrund für den Pausenbildschirm angezeigt wird.\n\n- Dunkel: TR1 (PC).\n- Sehr dunkel: TR1 (PS1).\n- Statisch: TR2 (PC).\n- Welle: TR2 (PS1).\n- Monochrom: TR3.",
        "SETTING_PAUSE_FADE_EFFECTS": "\\{review}Pause-Ausblend-Effekte",
        "SETTING_PAUSE_FADE_EFFECTS_DESCRIPTION": "\\{review}Feinabstimmung, ob die Ausblend-Effekte im Pausenbildschirm aktiviert oder deaktiviert sind. Die Option Ausblend-Effekte muss aktiviert sein, damit dies funktioniert.",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY": "Musik im Inventar pausieren",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY_DESCRIPTION": "Pausiert Spiel-Sounds, Umgebungsgeräusche und Musik im Inventar-Fenster.",
        "SETTING_PROJECTILE_AREA_DAMAGE": "\\{review}Flächenschaden durch Projektile",
        "SETTING_PROJECTILE_AREA_DAMAGE_DESCRIPTION": "\\{review}Steuert, wie der Wirkungsbereich für Raketenwerfer und Granatwerfer sich ausbreitet.\n\n- Einzelfeger: Verhalten von TR1 & TR2.\n- Mehrfachfeger: Verhalten von TR3.\n\nDie Mehrfachfeger-Option führt oft zu doppeltem Schaden bei einzelnen Gegnern.",
        "SETTING_QUICK_GUNS_MODE": "Schnell-Zieh-Tasten",
        "SETTING_QUICK_GUNS_MODE_DESCRIPTION": "Bestimmt das Verhalten der Schnell-Zieh-Tasten.\n\n- Nur ziehen: eine der Tasten zu drücken sorgt dafür, dass Lara die zugewiesene Waffe ausrüstet.\n- Ziehen oder wegstecken: das selbe wie bei 'Nur Ziehen', zusätzlich wird Lara die zugewiesene Waffe, die sie gerade benutzt, wegstecken.",
        "SETTING_REFLECTIONS": "Reflektionen",
        "SETTING_REFLECTIONS_DESCRIPTION": "Aktiviert Reflektionen auf bestimmten Objekten.",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS": "Waffen zwischen den Leveln merken",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION": "Bringt Lara dazu, sich zu erinnern, welche Waffe sie als Letztes im vorherigen Level verwendet hat, wenn ein neues Level beginnt. Bei Deaktivierung wird Lara auf geholsterte Pistolen zurückgreifen.",
        "SETTING_RESTORE_PS1_ENEMIES": "PS1 Feinde wiederherstellen",
        "SETTING_RESTORE_PS1_ENEMIES_DESCRIPTION": "\\{review}Fügt die Mumie hinzu, die in der PlayStation-Version von City of Khamoon, Raum 25, erscheint.\nDas Ändern dieser Option erfordert einen Neustart des Spiels.",
        "SETTING_SCREENSHOT_FORMAT": "Bildschirmfoto-Format",
        "SETTING_SCREENSHOT_FORMAT_DESCRIPTION": "Dateiformat des Bildschirmfotos.",
        "SETTING_SHADOW_TYPE": "\\{review}Schattenform",
        "SETTING_SHADOW_TYPE_DESCRIPTION": "\\{review}Wählt aus, wie die Schatten von Entitäten dargestellt werden.\n\n- Achteck: alte TR1- und TR2-Schatten\n- Kreis: runde Schatten\n- Sprite: TR3 texturbasierte Schatten",
        "SETTING_SHOW_BARS": "\\{review}Leisten anzeigen",
        "SETTING_SHOW_BARS_DESCRIPTION": "\\{review}Deaktiviert alle Ingame-Anzeigen und verdeckt Informationen über Laras Gesundheit und andere Ressourcen (für Herausforderungsdurchläufe).",
        "SETTING_SOUND_VOLUME": "\\{icon sound} Sound-Lautstärke",
        "SETTING_SOUND_VOLUME_DESCRIPTION": "Soundeffekt-Lautstärke einstellen.",
        "SETTING_SPRINTBAR_COLOR": "\\{review}Farbe der Sprintleiste",
        "SETTING_SPRINTBAR_COLOR_DESCRIPTION": "\\{review}Farbe der Sprintleiste",
        "SETTING_SPRINTBAR_LOCATION": "\\{review}Position der Sprintanleiste",
        "SETTING_SPRINTBAR_LOCATION_DESCRIPTION": "\\{review}Position, an der die Sprinleiste angezeigt wird.",
        "SETTING_SPRITE_LOCK_MODE": "\\{review}Sprite-Sperrmodus",
        "SETTING_SPRITE_LOCK_MODE_DESCRIPTION": "\\{review}Steuert, welche Achsen beim Anzeigen von Sprites auf dem Bildschirm gesperrt werden.\n\n- Keine: Sprites normal anzeigen.\n- Roll: Rollachse sperren – nur im Fotomodus nützlich.\n- Roll & Neigung: Sicherstellen, dass die Sprites aufrecht stehen und nicht auf dem Boden liegen, wenn man sie von oben betrachtet.\n- Perspektive: Roll- und Neigungsachsen sperren und zusätzlich die Sprites leicht zur Bildschirmmitte hin drehen.",
        "SETTING_START_LARA_HITPOINTS": "Laras Lebensenergie beim Starten eines Levels",
        "SETTING_START_LARA_HITPOINTS_DESCRIPTION": "Legt die Höhe des Gesundheitswertes von Lara für den Start eines jeden Levels fest.",
        "SETTING_STATS_BACKGROUND_STYLE": "\\{review}Statistik-Hintergrund",
        "SETTING_STATS_BACKGROUND_STYLE_DESCRIPTION": "\\{review}Ändert die Art und Weise, wie der Hintergrund für die Endlevel-Statistiken angezeigt wird.\n\n- Dunkel: TR1 (PC).\n- Sehr dunkel: TR1 (PS1).\n- Statisch: TR2 (PC).\n- Welle: TR2 (PS1).\n- Monochrom: TR3.",
        "SETTING_STATS_FADE_EFFECTS": "\\{review}Statistik-Ausblend-Effekte",
        "SETTING_STATS_FADE_EFFECTS_DESCRIPTION": "\\{review}Feinabstimmung, ob die Ausblend-Effekte im Statistikbildschirm am Ende des Levels aktiviert oder deaktiviert sind. Die Option Ausblend-Effekte muss aktiviert sein, damit dies funktioniert.",
        "SETTING_STATS_LEVEL_HEADER": "Level-Zähler",
        "SETTING_STATS_LEVEL_HEADER_DESCRIPTION": "Zeigt die aktuelle Level-Nummer ganz oben in den Level-Statistiken an.",
        "SETTING_STAT_DETAIL_MODE": "Statistik-Details",
        "SETTING_STAT_DETAIL_MODE_DESCRIPTION": "\\{review}Ermöglicht verschiedene Detailstufen der Statistik.\n\n- Minimal: zeigt den ursprünglichen Statistikdialog.\n- Detailliert: zeigt alle Statistiken aus Minimal sowie die maximalen Werte neben jedem Feld.\n- Vollständig: zeigt alle Statistiken aus Detailliert sowie neue Zeilen, die im ursprünglichen Dialog nicht verfügbar sind.",
        "SETTING_TARGET_MODE": "Modis für automatische Anvisierung",
        "SETTING_TARGET_MODE_DESCRIPTION": "Ändert das automatische Anvisierungsverhalten von Laras Waffen gegenüber Zielen.\n\n- Volles Lock-On: Das Ziel immer bleibt anvisiert, selbst wenn sich der Feind außer Sicht ist oder stirbt (OG TR1-3).\n- Halbes Lock-On: Das Ziel bleibt anvisiert wenn der Feind sich außer Sicht bewegt, löst aber die Anvisierung sobald der Gegner stibt.\n- Kein Lock-On: Löse die Anvisierung sobald der Feind sich außer Sicht bewegt oder stibt (TR4+).",
        "SETTING_TEXTURE_FILTER": "Textur-Filter",
        "SETTING_TEXTURE_FILTER_DESCRIPTION": "Wechselt zwischen weichgezeichneten und pixeligen Objekt-Texturen.",
        "SETTING_TRAPEZOID_FILTER": "Trapezoid-Filter",
        "SETTING_TRAPEZOID_FILTER_DESCRIPTION": "Korrigiert das Rendern von Vierecken.",
        "SETTING_UI_BAR_SCALE": "Leisten-Größe",
