        "PHOTO_MODE_LARA_ROTATE_90_PROMPT": "\\{review}Faire pivoter Lara de 90°",
        "PHOTO_MODE_LARA_ROTATE_PROMPT": "\\{review}Faire pivoter Lara",
        "PHOTO_MODE_SNAP_PROMPT": "Prendre une photo",
        "PHOTO_MODE_TITLE_CAMERA_POS": "Mode photo",
        "PHOTO_MODE_TITLE_LARA_POS": "\\{review}Déplacer Lara",
