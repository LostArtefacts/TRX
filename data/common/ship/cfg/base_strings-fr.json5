        "SETTING_AIRBAR_COLOR": "Couleur de la barre d'air",
        "SETTING_AIRBAR_COLOR_DESCRIPTION": "Couleur de la barre d'air.",
        "SETTING_AIRBAR_LOCATION": "Emplacement de la barre d'air",
        "SETTING_AIRBAR_LOCATION_DESCRIPTION": "Emplacement de la barre d'air.",
        "SETTING_ALLY_HEALTHBAR_COLOR": "\\{review}Couleur de la barre des alliés",
        "SETTING_ALLY_HEALTHBAR_COLOR_DESCRIPTION": "\\{review}Couleur de la barre de vie des alliés. Affichée à l'emplacement des barres de vie des ennemis.",
        "SETTING_ALLY_HOSTILITY_POLICY": "\\{review}Politique d'hostilité des alliés",
        "SETTING_ALLY_HOSTILITY_POLICY_DESCRIPTION": "\\{review}Contrôle la réaction des unités amies lorsqu'elles subissent des dégâts.\n\n- Individuel : chaque allié change d'hostilité de manière indépendante (style TR3).\n- Partagé : tous les alliés deviennent hostiles ensemble (style moine TR2).",
        "SETTING_AMBIENT_VOLUME": "\\{review}Volume ambiant",
        "SETTING_AMBIENT_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume ambiant.",
        "SETTING_ANISOTROPY_FILTER": "Filtre anisotropique",
        "SETTING_ANISOTROPY_FILTER_DESCRIPTION": "Améliore le filtrage des textures au loin.",
        "SETTING_ASPECT_MODE": "Mode d'aspect",
        "SETTING_ASPECT_MODE_DESCRIPTION": "Force un rapport d'aspect du jeu avec des bandes noires.",
        "SETTING_BAR_LOOK": "\\{review}Apparence des barres",
        "SETTING_BAR_LOOK_DESCRIPTION": "\\{review}Contrôle l'apparence visuelle des barres de l'interface utilisateur.",
        "SETTING_BORDERS": "\\{review}Bordures",
        "SETTING_BORDERS_DESCRIPTION": "\\{review}Ajoute des bordures noires autour de la fenêtre du jeu.",
        "SETTING_CAMERA_MODE": "Mode caméra",
        "SETTING_CAMERA_MODE_DESCRIPTION": "Ajuste le comportement de la caméra lors d'actions comme l'utilisation de clés.",
        "SETTING_CAMERA_SPEED": "Vitesse de la caméra",
        "SETTING_CAMERA_SPEED_DESCRIPTION": "Modifie la vitesse à laquelle se déplace la caméra manuelle.",
        "SETTING_CHANGE_PIERRE_SPAWN": "Modifier le comportement d'apparition de Pierre",
        "SETTING_CHANGE_PIERRE_SPAWN_DESCRIPTION": "Fait en sorte que l'apparition d'un nouveau Pierre (qui s'échappe) remplace l'éventuel Pierre (qui s'échappe) déjà existant.",
        "SETTING_CUTSCENE_VOLUME": "\\{review}Volume des cinématiques",
        "SETTING_CUTSCENE_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume des cinématiques en jeu.",
        "SETTING_DISABLE_EXTRA_GUNS": "\\{review}Supprimer les armes supplémentaires",
        "SETTING_DISABLE_EXTRA_GUNS_DESCRIPTION": "\\{review}Supprime toutes les armes et munitions ramassables dans le jeu sauf les pistolets (pour les défis uniquement avec pistolets).",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS": "Garder les dégâts",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Empêche que Lara ne guérisse automatiquement entre chaque niveau (pour les No Heal challenges).",
        "SETTING_DISABLE_MEDPACKS": "Supprimer les trousses de soin",
        "SETTING_DISABLE_MEDPACKS_DESCRIPTION": "Supprime toutes les trousses de soin de tous les niveaux (pour les No Meds challenges).",
        "SETTING_DISABLE_TREX_COLLISION": "Supprimer la colision du le cadavre du T-Rex",
        "SETTING_DISABLE_TREX_COLLISION_DESCRIPTION": "Supprime toutes les collisions avec le cadavre T-Rex. Cela aide lorsque son cadavre bloque un passage.",
        "SETTING_ENABLE_3D_PICKUPS": "Objets à ramasser 3D",
        "SETTING_ENABLE_3D_PICKUPS_DESCRIPTION": "Affiche les objets à ramasser en 3D au lieu de les afficher en sprites.",
        "SETTING_ENABLE_ALLY_TARGETING": "\\{review}Autoriser le ciblage des alliés",
        "SETTING_ENABLE_ALLY_TARGETING_DESCRIPTION": "\\{review}Permet à Lara de cibler des alliés, tels que des moines. Si désactivé, les alliés seront immunisés contre les munitions de Lara.",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION": "Présélection des bonnes clés",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "Lorsque Lara appuie sur Action en face d'une serreure ou un emplacement de puzzle et qu'elle a l'objet correspondant dans son inventaire, cet objet sera présélectionné.",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE": "\\{review}Trébuchement en pente arrière",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE_DESCRIPTION": "\\{review}Fait trébucher Lara si elle saute en arrière et qu’il y a une pente derrière elle (TR3). Si désactivé, Lara s’arrête net contre la pente (TR1/2).",
        "SETTING_ENABLE_BAR_FLASHING": "\\{review}Barres clignotantes",
        "SETTING_ENABLE_BAR_FLASHING_DESCRIPTION": "\\{review}Fait clignoter les barres de santé et d'oxygène de Lara lorsqu'elle est à court de l'une ou l'autre ressource.",
        "SETTING_ENABLE_BOULDER_SHAKE": "\\{review}Activer le tremblement des rochers",
        "SETTING_ENABLE_BOULDER_SHAKE_DESCRIPTION": "\\{review}Si activé, la caméra tremblera lorsqu’un rocher est en mouvement.",
        "SETTING_ENABLE_BOUNCY_GRENADES": "\\{review}Grenades rebondissantes",
        "SETTING_ENABLE_BOUNCY_GRENADES_DESCRIPTION": "\\{review}Active le comportement des grenades à la TR3 : elles ricochent sur les murs et les pentes et produisent un rayon d'explosion plus large, mais au prix d'une vitesse réduite.",
        "SETTING_ENABLE_BRAID": "Tresse de Lara",
        "SETTING_ENABLE_BRAID_DESCRIPTION": "Active la tresse de Lara.",
        "SETTING_ENABLE_BREEZE": "Vent",
        "SETTING_ENABLE_BREEZE_DESCRIPTION": "Active l'effet de vent sur la tresse de Lara dans les salles appropriées.",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS": "\\{review}Mise en mémoire tampon (touches F)",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS_DESCRIPTION": "\\{review}Active la mise en mémoire tampon de la touche F (1 image) pour obtenir un contrôle précis des mouvements de Lara. Cette fonction existe à l'origine uniquement dans le port TombATI (TR1).",
        "SETTING_ENABLE_BUFFERING_INVENTORY": "\\{review}Mise en mémoire tampon (inventaire)",
        "SETTING_ENABLE_BUFFERING_INVENTORY_DESCRIPTION": "\\{review}Active la mise en mémoire tampon de l'inventaire (2 images) pour un contrôle précis des mouvements de Lara.",
        "SETTING_ENABLE_CHEATS": "Triche",
        "SETTING_ENABLE_CHEATS_DESCRIPTION": "Active plusieurs fonctions de triche :\n- L: termine immédiatement le niveau.\n- I: donne toutes les armes à Lara, le maximum en munitions et trousses de soin, et tous les éléments utiles au niveau en cours.\n- O: Fait voler Lara (nager dans les airs).\n  - Touche MARCHER : Revenir au sol.\n  - Touche ESPACE : Ouvre les portes fermées (peut ne pas fonctionner sur certaines).",
        "SETTING_ENABLE_COMPASS_STATS": "Statistiques dans la boussole",
        "SETTING_ENABLE_COMPASS_STATS_DESCRIPTION": "Affiche les statistiques du niveau lorsque la boussole est sélectionnée.",
        "SETTING_ENABLE_CONSOLE": "Console",
        "SETTING_ENABLE_CONSOLE_DESCRIPTION": "Active la console de développement.",
        "SETTING_ENABLE_CONTROLLED_DROPS": "\\{review}Chutes contrôlées",
        "SETTING_ENABLE_CONTROLLED_DROPS_DESCRIPTION": "\\{review}Permet à Lara de se retourner en l'air et d’attraper la corniche qu'elle vient de quitter, si la touche d'action est maintenue pendant la chute.",
        "SETTING_ENABLE_CRAWL_JUMP": "\\{review}Saut en sortie de conduit",
        "SETTING_ENABLE_CRAWL_JUMP_DESCRIPTION": "\\{review}Permet à Lara de sauter hors des passages étroits.",
        "SETTING_ENABLE_CREDITS": "\\{review}Écrans de crédits",
        "SETTING_ENABLE_CREDITS_DESCRIPTION": "\\{review}Active les écrans de crédits affichés après avoir terminé le jeu. N'influence pas l'écran des statistiques finales.",
        "SETTING_ENABLE_CROUCH_ROLL": "\\{review}Roulade accroupie",
        "SETTING_ENABLE_CROUCH_ROLL_DESCRIPTION": "\\{review}Permet à Lara d'effectuer une roulade avant en position accroupie en appuyant sur sprint.",
        "SETTING_ENABLE_CUTSCENES": "Activer les cutscenes",
        "SETTING_ENABLE_CUTSCENES_DESCRIPTION": "Active les cutscenes en jeu.",
        "SETTING_ENABLE_DEATHS_COUNTER": "Compteur du nombres de morts",
        "SETTING_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Permet d'afficher un compteur de décès dans la boussole et dans les statistiques de niveau. Le nombre de morts est mis à jour dans la sauvegarde actuellement chargée dès que Lara meurt.",
        "SETTING_ENABLE_DEMO": "Activer le mode démo",
        "SETTING_ENABLE_DEMO_DESCRIPTION": "Active le mode démo dans le menu principal.",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME": "\\{review}Temps de torche sans fin",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME_DESCRIPTION": "\\{review}Empêche les torches portatives de s'éteindre. Les torches lancées s'éteindront toujours normalement.",
        "SETTING_ENABLE_ENDLESS_SPRINT": "\\{review}Sprint infini",
        "SETTING_ENABLE_ENDLESS_SPRINT_DESCRIPTION": "\\{review}Empêche Lara de se fatiguer lorsqu'elle sprinte. Les obstacles l'arrêteront toujours.",
        "SETTING_ENABLE_ENEMY_ROTATION": "\\{review}Randomiser l'angle de départ des ennemis",
        "SETTING_ENABLE_ENEMY_ROTATION_DESCRIPTION": "\\{review}Applique un angle aléatoire supplémentaire à certains ennemis lorsqu'ils sont initialisés.",
        "SETTING_ENABLE_ENHANCED_SAVES": "Sauvegarde les effets",
        "SETTING_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Améliore les sauvegardes afin que les effets graphiques, la brume des cascades, les émetteurs de flammes, etc. soient sauvegardés au lieu de disparaître au chargement.",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS": "Fondu de sortie",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION": "Active les effets de fondu lors de la sortie du jeu vers le bureau.",
        "SETTING_ENABLE_FADE_EFFECTS": "Effets de fondu",
        "SETTING_ENABLE_FADE_EFFECTS_DESCRIPTION": "Active les transitions en fondu, par exemple entre les images de crédit ou pour les transitions de l'inventaire et de l'écran de pause.",
        "SETTING_ENABLE_FIRE_LIGHTING": "\\{review}Allumage de feu",
        "SETTING_ENABLE_FIRE_LIGHTING_DESCRIPTION": "\\{review}Active l'éclairage dynamique généré à proximité des flammes actives.",
        "SETTING_ENABLE_FMV": "Activer les FMV",
        "SETTING_ENABLE_FMV_DESCRIPTION": "Active les FMV en jeu.",
        "SETTING_ENABLE_FOOTPRINTS": "\\{review}Empreintes de pas",
        "SETTING_ENABLE_FOOTPRINTS_DESCRIPTION": "\\{review}Permet l'affichage des empreintes de Lara sur certaines surfaces dans les niveaux pris en charge.",
        "SETTING_ENABLE_GAME_MODES": "Autres modes de jeu",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "\\{review}Permet de sélectionner de nouveaux modes de jeu dans le menu nouvelle partie du passeport au menu principal.\n- Nouvelle partie+ : Déverrouille toutes les armes avec munitions infinies ; les ennemis ont le double de points de vie.\n- Version Japonaise : Les armes font le double de dégâts.\n- Version Japonaise+ : Combine le mode Version Japonaise et le mode Nouvelle partie+.",
        "SETTING_ENABLE_GUN_LIGHTING": "Éclairage des armes",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "\\{review}Permet de générer un éclairage dynamique pour les coups de feu et les explosions.",
        "SETTING_ENABLE_IDLE_POSE_CAMERA": "\\{review}Caméra pose",
        "SETTING_ENABLE_IDLE_POSE_CAMERA_DESCRIPTION": "\\{review}Ajuste la caméra pour qu'elle soit orientée vers Lara pendant sa animation de pose. Appuyer sur regarder pour réinitialiser la caméra.",
        "SETTING_ENABLE_INVERTED_LOOK": "Inversion verticale du mode regarder",
        "SETTING_ENABLE_INVERTED_LOOK_DESCRIPTION": "Inverse l'axe Y lorsque Lara regarde autour d'elle.",
        "SETTING_ENABLE_ITEM_EXAMINING": "Description des objets",
        "SETTING_ENABLE_ITEM_EXAMINING_DESCRIPTION": "Pour les niveaux personnalisés - permet d'afficher les descriptions des objets dans l'inventaire lorsque le créateur du niveau a fourni ces informations.",
        "SETTING_ENABLE_JUMP_TWISTS": "Sauts périlleux",
        "SETTING_ENABLE_JUMP_TWISTS_DESCRIPTION": "\\{review}Activer les demi-tours en plein saut et les cabrioles.",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS": "\\{review}Activer les blocs-poussoirs mortels",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS_DESCRIPTION": "\\{review}Si activé, lorsqu'un bloc-poussoir tombe de l'air et atterrit sur Lara, il la tuera immédiatement. Sinon, Lara se retrouvera coincée sur le dessus du bloc et survivra.",
        "SETTING_ENABLE_LARA_MIC": "Micro sur Lara",
        "SETTING_ENABLE_LARA_MIC_DESCRIPTION": "Place le micro au niveau de Lara. Si cette option est désactivée, le micro sera placé au niveau de la caméra.",
        "SETTING_ENABLE_LEAN_JUMPING": "Contrôle du saut sur place",
        "SETTING_ENABLE_LEAN_JUMPING_DESCRIPTION": "Permet à Lara d'avancer ou de reculer pendant les sauts sur place lorsque la touche correspondante est enfoncée, comme possible depuis TR2.",
        "SETTING_ENABLE_LEDGE_JUMPS": "\\{review}Sauts depuis une corniche",
        "SETTING_ENABLE_LEDGE_JUMPS_DESCRIPTION": "\\{review}Permet à Lara de sauter vers le haut ou en arrière lorsqu'elle est suspendue à une corniche, à condition qu'il y ait une surface solide devant elle pour prendre appui.",
        "SETTING_ENABLE_LEGAL": "Afficher le contenu juridique",
        "SETTING_ENABLE_LEGAL_DESCRIPTION": "Affiche l'écran juridique et la FMV Core Design au début du jeu.",
        "SETTING_ENABLE_LOADING_SCREENS": "Activer les écrans de chargement",
        "SETTING_ENABLE_LOADING_SCREENS_DESCRIPTION": "\\{review}Contrôle les écrans de chargement avant le chargement des niveaux.\n\n- Désactivé : n'affiche jamais les écrans de chargement.\n- Toujours : affiche les écrans de chargement.\n- Nouvelles parties : n'affiche pas les écrans de chargement lors du chargement d'une sauvegarde.",
        "SETTING_ENABLE_MANUAL_CAMERA": "\\{review}Caméra manuelle",
        "SETTING_ENABLE_MANUAL_CAMERA_DESCRIPTION": "\\{review}Active les touches de la caméra (\\{input camera_forward}\\{input camera_back}\\{input camera_left}\\{input camera_right}) utilisées pour contrôler la caméra du mode photo, pour également faire pivoter la caméra en jeu.",
        "SETTING_ENABLE_MUSIC_IN_MENU": "Musique du menu principal",
        "SETTING_ENABLE_MUSIC_IN_MENU_DESCRIPTION": "Active ou non la musique dans le menu principal.",
        "SETTING_ENABLE_NEUTRAL_TWISTS": "\\{review}Pirouettes sur place",
        "SETTING_ENABLE_NEUTRAL_TWISTS_DESCRIPTION": "\\{review}Permet à Lara d'effectuer une rotation en l'air lors d'un saut sur place. Appuyez simultanément sur les touches de saut et de roulade en étant immobile.",
        "SETTING_ENABLE_PICKUP_AIDS": "Aides objets à ramasser",
        "SETTING_ENABLE_PICKUP_AIDS_DESCRIPTION": "Active un scintillement intermittent à proximité des objets à ramasser pour les mettre en valeur.",
        "SETTING_ENABLE_PITCHED_SOUNDS": "Hauteurs aléatoires des sons",
        "SETTING_ENABLE_PITCHED_SOUNDS_DESCRIPTION": "Modifie aléatoirement et légèrement la hauteur des effets sonores, afin de leur donner un peu de variation.",
        "SETTING_ENABLE_PLAY_PREVIOUS_LEVELS": "\\{review}Jouer les niveaux précédents",
        "SETTING_ENABLE_PS1_CRYSTALS": "Teinte des cristaux PS1",
        "SETTING_ENABLE_PS1_CRYSTALS_DESCRIPTION": "Les cristaux de sauvegarde seront colorés avec une teinte violette, plus similaires à ceux de la PS1.",
        "SETTING_ENABLE_PS1_SFX": "\\{review}PS1 remplacements SFX",
        "SETTING_ENABLE_PS1_SFX_DESCRIPTION": "\\{review}Active des remplacements spécifiques d'effets sonores en utilisant les équivalents PS1.\n\n- Tir d'Uzi (TR1 uniquement)\n- Sons de pieds nus de Lara (TR2 uniquement)",
        "SETTING_ENABLE_RESPONSIVE_CRAWL": "\\{review}Ramper réactif",
        "SETTING_ENABLE_RESPONSIVE_CRAWL_DESCRIPTION": "\\{review}Active des améliorations par rapport aux mécaniques de ramper d’origine.\n\n- Permet de reprendre le rampement plus rapidement après un arrêt.\n- Permet de passer de la course/sprint au rampement sans devoir s’arrêter d’abord.\n- Permet de passer du rampement à la roulade accroupie (si activée) sans devoir s’accroupir manuellement.\n- Permet de se tourner en position accroupie.\n- Restaure l’animation de ramassage en rampant de Lara (hors torches).",
        "SETTING_ENABLE_RESPONSIVE_MESH_TINT": "\\{review}Teinte réactive des meshes",
        "SETTING_ENABLE_RESPONSIVE_MESH_TINT_DESCRIPTION": "\\{review}Permet d’afficher les meshes individuelles de Lara avec une teinte aquatique lorsqu’elles se trouvent elles-mêmes sous l’eau (style TR3). Sinon, si Lara est dans l’eau, toutes ses meshes seront affichées avec la teinte (style TR1/2).",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT": "Passeport plus réactif",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Evite de bloquer complètement les contrôles pendant que les pages tournent : à la place, repousse simplement leur effet.",
        "SETTING_ENABLE_RESPONSIVE_SPRINT": "\\{review}Sprint réactif",
        "SETTING_ENABLE_RESPONSIVE_SPRINT_DESCRIPTION": "\\{review}Active un sprint plus réactif pour Lara.\n\n- permet de sprinter dès que Lara a de l'énergie, plutôt que d'attendre que son endurance soit pleine.\n- permet de sprinter dans les escaliers sans être interrompue par l'animation de course normale.",
        "SETTING_ENABLE_SAVE_CRYSTALS": "Cristaux de sauvegarde",
        "SETTING_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Limite les sauvegardes aux débuts de niveau et aux cristaux de sauvegarde. Les niveaux ont un nombre limité de cristaux, à usage unique, comme sur PS1. Modifier cette option nécessite de recommencer le niveau.",
        "SETTING_ENABLE_SHOTGUN_FLASH": "Flash du fusil",
        "SETTING_ENABLE_SHOTGUN_FLASH_DESCRIPTION": "Génère un flash lorsque Lara tire avec le fusil à pompe, comme pour les autres armes.",
        "SETTING_ENABLE_SKYBOX": "Ciel",
        "SETTING_ENABLE_SKYBOX_DESCRIPTION": "Active le ciel dans les niveaux pris en charge.",
        "SETTING_ENABLE_SLIDE_TO_RUN": "\\{review}Glissade-courir",
        "SETTING_ENABLE_SLIDE_TO_RUN_DESCRIPTION": "\\{review}Permet à Lara de commencer à courir immédiatement lorsqu'elle touche le sol après avoir glissé en avant sur une pente. Maintenez l'entrée avant pour activer.",
        "SETTING_ENABLE_SMOOTH_BARS": "Barres fluides",
        "SETTING_ENABLE_SMOOTH_BARS_DESCRIPTION": "Permet à la barre de santé et à la barre d'air d'utiliser des transitions de couleurs fluides.",
        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT": "\\{review}Déviation murale fluide",
        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT_DESCRIPTION": "\\{review}Permet à Lara de se remettre plus rapidement après avoir heurté un mur et qu'une touche de direction est maintenue avec l'avant.",
        "SETTING_ENABLE_SOFT_STATICS": "\\{review}Collision de maillage souple",
        "SETTING_ENABLE_SOFT_STATICS_DESCRIPTION": "\\{review}Permet à Lara de se déplacer en douceur contre les maillages statiques – comme dans TR4+ – plutôt que de s'arrêter brutalement.",
        "SETTING_ENABLE_SPRINT": "\\{review}Sprint",
        "SETTING_ENABLE_SPRINT_DESCRIPTION": "\\{review}Permet à Lara de sprinter, comme dans TR3 et les suivants.",
        "SETTING_ENABLE_STEP_ROLL_BOOST": "\\{review}Boost de roulade de marche",
        "SETTING_ENABLE_STEP_ROLL_BOOST_DESCRIPTION": "\\{review}Permet à Lara d'être propulsée d'un pas haut à un clic si la roulade est pressée près du bord.",
        "SETTING_ENABLE_SWING_CANCEL": "Annulation du balancement",
        "SETTING_ENABLE_SWING_CANCEL_DESCRIPTION": "Permet d'annuler l'animation de balancement à un rebord de Lara en relâchant puis en se raccrochant aussitôt, comme possible depuis TR2.",
        "SETTING_ENABLE_TARGET_CHANGE": "Changement de cible",
        "SETTING_ENABLE_TARGET_CHANGE_DESCRIPTION": "Rend possible le changement de cible comme possible depuis TR4. Appuyez sur la touche Regarder tout en visant pour changer de cible.",
        "SETTING_ENABLE_TIMER_IN_INVENTORY": "Comptabiliser du temps de jeu dans l'inventaire",
        "SETTING_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION": "Fait avancer le compteur du jeu même quand l'inventaire est ouvert.",
        "SETTING_ENABLE_TOTAL_STATS": "Écran des statistiques finales",
        "SETTING_ENABLE_TOTAL_STATS_DESCRIPTION": "Active un écran de statistiques finales du jeu qui apparait à la fin des crédits.",
        "SETTING_ENABLE_TR2_JUMPING": "Saut réactif",
        "SETTING_ENABLE_TR2_JUMPING_DESCRIPTION": "\\{review}Permet à Lara de sauter à tout moment pendant qu'elle court.",
        "SETTING_ENABLE_TR2_SWIMMING": "Nage fluide",
        "SETTING_ENABLE_TR2_SWIMMING_DESCRIPTION": "\\{review}Applique une accélération progressive aux rotations de Lara sous l'eau pour un mouvement plus naturel, comme c'est fait depuis TR2. Désactiver cette option donnera à Lara une vitesse de rotation plus rapide, comme dans TR1 d'origine.",
        "SETTING_ENABLE_TR2_SWIM_CANCEL": "Arrêt de nage réactif",
        "SETTING_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION": "Permet à Lara de s'arrêter de manière plus réactive sous l'eau lorsque la touche de nage est relâchée.",
        "SETTING_ENABLE_TR3_SIDESTEPS": "Pas de côtés améliorés",
        "SETTING_ENABLE_TR3_SIDESTEPS_DESCRIPTION": "Permet d'effectuer des pas de côtés comme à partir de TR3 (exemple : Maj + touches directionelles). Les touches dédiées restent fonctionnelles.",
        "SETTING_ENABLE_UNDERWATER_ANIM_SFX": "\\{review}SFX anim. sous l'eau",
        "SETTING_ENABLE_UNDERWATER_ANIM_SFX_DESCRIPTION": "\\{review}Permet de contrôler la lecture de certains effets sonores d'animation — pour des objets comme des portes ou des trappes — lorsque la caméra est sous l'eau.",
        "SETTING_ENABLE_UW_ROLL": "Roulade sous-marine",
        "SETTING_ENABLE_UW_ROLL_DESCRIPTION": "\\{review}Permet à Lara de faire une roulade pour se retourner sous l'eau.",
        "SETTING_ENABLE_WADING": "Patauger",
        "SETTING_ENABLE_WADING_DESCRIPTION": "\\{review}Permet à Lara de patauger dans les eaux peu profondes, plutôt que de rester bloquée à la surface.",
        "SETTING_ENABLE_WALK_TO_ITEMS": "Animées les placements",
        "SETTING_ENABLE_WALK_TO_ITEMS_DESCRIPTION": "Fait marcher Lara vers les objets et interrupteurs à proximité, au lieu de se téléporter vers eux.",
        "SETTING_ENABLE_WEATHER": "\\{review}Météo",
        "SETTING_ENABLE_WEATHER_DESCRIPTION": "\\{review}Active le rendu des effets météorologiques dans les niveaux pris en charge.",
        "SETTING_ENEMY_HEALTHBAR_COLOR": "Couleur de la barre des ennemis",
        "SETTING_ENEMY_HEALTHBAR_COLOR_DESCRIPTION": "Couleur de la barre de santé des ennemis.",
        "SETTING_ENEMY_HEALTHBAR_LOCATION": "Emplacement de la barre des ennemis",
        "SETTING_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION": "Emplacement de la barre de santé des ennemis.",
        "SETTING_ENEMY_HEALTHBAR_SHOW_MODE": "Comportement de la barre des ennemis",
        "SETTING_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Affiche une barre de santé pour l'ennemi ciblé.",
        "SETTING_EXPOSUREBAR_COLOR": "\\{review}Couleur de la barre d'exposition",
        "SETTING_EXPOSUREBAR_COLOR_DESCRIPTION": "\\{review}Couleur de la barre d'exposition à l'eau froide.",
        "SETTING_EXPOSUREBAR_LOCATION": "\\{review}Emplacement de la barre d'exposition",
        "SETTING_EXPOSUREBAR_LOCATION_DESCRIPTION": "\\{review}Emplacement où la barre d'exposition à l'eau froide est affichée.",
        "SETTING_FIX_ALLIGATOR_AI": "Corriger l'IA des aligators",
        "SETTING_FIX_ALLIGATOR_AI_DESCRIPTION": "Corrige le fait que les alligators n'infligent aucun dégât si Lara reste immobile dans l'eau.",
        "SETTING_FIX_ANIMATED_SPRITES": "Corriger les sprites animées",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "\\{review}Corrige les sprites originaux des plantes sous-marines pour qu'ils s'animent correctement dans les zones aquatiques.",
        "SETTING_FIX_BEAR_AI": "Corriger l'IA des ours",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Corrige l'attaque par coup de patte des ours pour qu'ils ne ratent pas Lara.",
        "SETTING_FIX_BRIDGE_COLLISION": "Corriger la colision des ponts",
        "SETTING_FIX_BRIDGE_COLLISION_DESCRIPTION": "Corrige l'impossibilité pour Lara de s'accrocher à des certaines parties de ponts et les murs invisibles à leurs bordures. Corrige également les problèmes de colision pour les ponts-levis, les trappes et les ponts lorsqu'ils sont les uns au-dessus des autres, au-dessus de pentes, ou près du sol.",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND": "Corriger le son de chaîne des blocs",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND_DESCRIPTION": "Corrige le fait que le son du secret se joue par erreur lors de l'utilisation de la Clé en Or dans la Tombe de Tihocan.",
        "SETTING_FIX_DESCENDING_GLITCH": "Corriger les chutes sur sols fragiles",
        "SETTING_FIX_DESCENDING_GLITCH_DESCRIPTION": "Corrige le fait que les pas de côté et la marche arrière sur des sols fragiles font que Lara se téléporte immédiatement au niveau inférieur.",
        "SETTING_FIX_FLARE_THROW_PRIORITY": "Corriger la priorité du jet des torches",
        "SETTING_FIX_FLARE_THROW_PRIORITY_DESCRIPTION": "Corrige le fait que Lara priorise le jet des torches usagées en plein vol, ce qui peut l'empêcher d'attraper les rebords.",
        "SETTING_FIX_FLOOR_DATA_ISSUES": "Corriger les bugs 'floor data'",
        "SETTING_FIX_FLOOR_DATA_ISSUES_DESCRIPTION": "Corrige les bugs originaux liés aux informations des secteurs.",
        "SETTING_FIX_FREE_FLARE_GLITCH": "Corrige le glitch de torche gratuite",
        "SETTING_FIX_FREE_FLARE_GLITCH_DESCRIPTION": "Corrige la possibilité de faire apparaître une torche gratuite en appuyant sur la touche Torche pendant que Lara ramasse un objet.",
        "SETTING_FIX_GLIDE_CAMERAS": "Corriger les transitions de caméra",
        "SETTING_FIX_GLIDE_CAMERAS_DESCRIPTION": "Corrige les transitions vers les caméras fixes pour respecter la vitesse définie dans les déclencheurs du niveau, au lieu d'utiliser une vitesse par défaut après la première image.",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH": "Corriger le glitch de duplication d'objet",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION": "Corrige le fait de pouvoir dupliquer l'utilisation des clés dans l'inventaire.",
        "SETTING_FIX_ITEM_ROTS": "Corriger l'orientation des objets à ramasser",
        "SETTING_FIX_ITEM_ROTS_DESCRIPTION": "Corrige les problèmes d'orientation de certains objets, lorsque l'option des objets à ramasser en 3D est utilisée.",
        "SETTING_FIX_LARA_PICKUP_EMBED": "\\{review}Bug de ramassage corrigé",
        "SETTING_FIX_LARA_PICKUP_EMBED_DESCRIPTION": "\\{review}Corrige un problème où Lara dérivait parfois dans les murs en ramassant des objets sous l’eau, ainsi qu’en ramassant des objets au-dessus de l’eau sous des plafonds fortement inclinés.",
        "SETTING_FIX_M16_ACCURACY": "\\{review}Corriger la précision du M16/MP5",
        "SETTING_FIX_M16_ACCURACY_DESCRIPTION": "\\{review}Corrige la précision du M16/MP5 pendant que Lara court.",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY": "\\{review}Corriger la priorité de ramassage des singes",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY_DESCRIPTION": "\\{review}Les singes attaqués privilégieront la riposte plutôt que de collecter les trousses de soins et les clés.",
        "SETTING_FIX_QWOP_GLITCH": "Corriger le glitch QWOP",
        "SETTING_FIX_QWOP_GLITCH_DESCRIPTION": "Corrige le fait que sauter sur des petites marches entraîne parfois Lara à se bloquer dans une animation de course étrange, connu sous le nom du glitch QWOP.",
        "SETTING_FIX_SECRETS_KILLING_MUSIC": "Superposer le son du secret",
        "SETTING_FIX_SECRETS_KILLING_MUSIC_DESCRIPTION": "Corrige le fait que la musique est coupée à la découverte d'un secret.",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC": "Superposer les voix des ennemis",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC_DESCRIPTION": "Corrige le fait que la musique est coupée lorsque les ennemis se mettent à parler.",
        "SETTING_FIX_STEP_GLITCH": "Corriger le glitch des petites marches",
        "SETTING_FIX_STEP_GLITCH_DESCRIPTION": "Corrige le fait que Lara est parfois aspirée dans des murs adjacents à des petites marches lorsqu'elle monte dessus d'une manière spécifique.",
        "SETTING_FIX_TEXTURE_ISSUES": "Corriger les problèmes de texture",
        "SETTING_FIX_TEXTURE_ISSUES_DESCRIPTION": "Corrige des problèmes de textures/morceaux d'objets manquants ou incorrects.",
        "SETTING_FIX_WADE_WALL_HIT": "\\{review}Corriger le coup de mur en marchant",
        "SETTING_FIX_WADE_WALL_HIT_DESCRIPTION": "\\{review}Corrige le fait que Lara ne réagisse pas lorsqu'elle heurte un mur en marchant.",
        "SETTING_FIX_WALK_RUN_JUMP": "Corriger le saut après marche",
        "SETTING_FIX_WALK_RUN_JUMP_DESCRIPTION": "Corrige le fait que Lara ne peut parfois pas sauter tout de suite après être passée de son animation de marche à celle de course.",
        "SETTING_FIX_WATER_EXIT": "\\{review}Corriger la sortie de l'eau",
        "SETTING_FIX_WATER_EXIT_DESCRIPTION": "\\{review}Corrige le fait que Lara puisse passer directement d'une pièce d'eau à une pièce sèche adjacente, ou à une pièce sèche en dessous. De plus, cela empêchera Lara de pouvoir sortir de l'eau sur des pentes non praticables.",
        "SETTING_FMV_VOLUME": "\\{review}Volume des FMV",
        "SETTING_FMV_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume des films.",
        "SETTING_FOG_COLOR": "\\{review}Couleur du brouillard",
        "SETTING_FOG_COLOR_DESCRIPTION": "\\{review}Couleur du brouillard.",
        "SETTING_FOG_END": "Fin de brouillard",
        "SETTING_FOG_END_DESCRIPTION": "Définit la distance en secteurs où le brouillard rend tout complètement obscurci.",
        "SETTING_FOG_START": "Début de brouillard",
        "SETTING_FOG_START_DESCRIPTION": "Définit la distance en secteurs où le brouillard commence à apparaître.",
        "SETTING_FOG_TRANSPARENCY": "\\{review}Transparence du brouillard",
        "SETTING_FOG_TRANSPARENCY_DESCRIPTION": "\\{review}Permet d'activer le mélange de la géométrie lointaine avec des faces 100% transparentes.",
        "SETTING_FOV": "\\{review}Champ de vision",
        "SETTING_FOV_DESCRIPTION": "\\{review}Angle de vue en degrés. Des valeurs plus grandes élargissent le champ de vision, des valeurs plus petites le rétrécissent.",
        "SETTING_FPS": "FPS",
        "SETTING_FPS_DESCRIPTION": "Définit le nombre d'images par seconde du jeu.",
        "SETTING_GAME_BRIGHTNESS": "Luminosité",
        "SETTING_GAME_BRIGHTNESS_DESCRIPTION": "Modifie la luminosité du jeu.",
        "SETTING_GAMMA": "\\{review}Gamma",
        "SETTING_GAMMA_DESCRIPTION": "\\{review}Ajuste la courbe gamma. Des valeurs plus élevées signifient un éclairage plus lumineux. La valeur de 2,5 correspond aux couleurs par défaut.",
        "SETTING_HARPOON_RECOIL": "\\{review}Recul du harpon",
        "SETTING_HARPOON_RECOIL_DESCRIPTION": "\\{review}Définit la fréquence à laquelle Lara doit recharger le harpon, en fonction de son nombre de munitions actuel. Par exemple, si réglé sur 3, elle devra recharger après chaque troisième tir. Réglez sur 0 pour désactiver complètement le rechargement.",
        "SETTING_HEALTHBAR_COLOR": "Couleur de la barre de santé",
        "SETTING_HEALTHBAR_COLOR_DESCRIPTION": "Couleur de la barre de santé.",
        "SETTING_HEALTHBAR_LOCATION": "Emplacement barre de santé",
        "SETTING_HEALTHBAR_LOCATION_DESCRIPTION": "Emplacement de la barre de santé",
        "SETTING_HEALTHBAR_POISON_COLOR": "\\{review}Couleur de la barre de santé empoisonnée",
        "SETTING_HEALTHBAR_POISON_COLOR_DESCRIPTION": "\\{review}Couleur de la barre de santé lorsque Lara est empoisonnée.",
        "SETTING_IDLE_POSE_TIMEOUT": "\\{review}Délai inactivité",
        "SETTING_IDLE_POSE_TIMEOUT_DESCRIPTION": "\\{review}Permet à Lara d'entrer dans une animation de pose après le nombre de secondes d'inactivité défini. Réglez sur 0 pour désactiver.",
        "SETTING_INVENTORY_AMBIENT_VOLUME": "\\{review}Volume ambiant (inventaire)",
        "SETTING_INVENTORY_AMBIENT_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume ambiant dans l'écran d'inventaire.",
        "SETTING_INVENTORY_BACKGROUND_STYLE": "\\{review}Arrière-plan de l'inventaire",
        "SETTING_INVENTORY_BACKGROUND_STYLE_DESCRIPTION": "\\{review}Modifie la façon dont l'arrière-plan de l'anneau d'inventaire est affiché.\n\n- Sombre : TR1 (PC).\n- Très sombre : TR1 (PS1).\n- Statique : TR2 (PC).\n- Ondulé : TR2 (PS1).\n- Monochrome : TR3.",
        "SETTING_INVENTORY_FADE_EFFECTS": "\\{review}Effets de fondu de l'inventaire",
        "SETTING_INVENTORY_FADE_EFFECTS_DESCRIPTION": "\\{review}Affine les effets de fondu à activer ou désactiver dans l'anneau d'inventaire en jeu. Nécessite que l'option Effets de fondu soit activée pour fonctionner.",
        "SETTING_INVENTORY_MUSIC_VOLUME": "\\{review}Volume de la musique (inventaire)",
        "SETTING_INVENTORY_MUSIC_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume de la musique dans l'écran d'inventaire.",
        "SETTING_JUMP_LOCK_MODE": "\\{review}Verrou saut",
        "SETTING_JUMP_LOCK_MODE_DESCRIPTION": "\\{review}Pour un saut réactif, permet de contrôler à quel moment après le début de la course Lara est autorisée à sauter.\n\n- Hérité : correspond au timing original de TR2.\n- Ajusté : le saut est possible 2 images plus tôt que dans TR2 d'origine.\n- Désactivé : le saut est possible immédiatement après l'animation de départ en course.",
        "SETTING_LARA_OUTFIT": "\\{review}Tenue de Lara",
        "SETTING_LARA_OUTFIT_DESCRIPTION": "\\{review}Modifie l’apparence de Lara. Le choix Par défaut respecte les changements de tenue normaux entre les niveaux ; sinon, la tenue sélectionnée restera active jusqu’à modification manuelle.",
        "SETTING_LIGHTING_CONTRAST": "Éclairage contrasté",
        "SETTING_LIGHTING_CONTRAST_DESCRIPTION": "Augmente le contraste pour les sources de lumière dynamiques telles que les torches et les flashs des armes.",
        "SETTING_LOAD_MUSIC_TRIGGERS": "Mémoriser les musiques jouées",
        "SETTING_LOAD_MUSIC_TRIGGERS_DESCRIPTION": "Mémorise les musiques qui ont déjà été jouées, pour ne pas les répéter après un rechargement de partie.",
        "SETTING_LOOK_MODE": "\\{review}Mode regard",
        "SETTING_LOOK_MODE_DESCRIPTION": "\\{review}Contrôle quand Lara peut utiliser la vue.\n\n- Restreint : le regard est autorisé uniquement à l’arrêt, jamais sous l’eau.\n- Amélioré : le regard est autorisé pendant la plupart des animations, sauf certaines comme pousser un bloc.\n- Illimité : le regard est autorisé à tout moment lorsque Lara est contrôlable.",
        "SETTING_MASTER_VOLUME": "\\{review}\\{icon music} Volume maître",
        "SETTING_MASTER_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume de tous les sons du jeu. Les autres réglages sont relatifs à ce volume.",
        "SETTING_MAXIMUM_SAVE_SLOTS": "Nombre d'emplacements de sauvegarde",
        "SETTING_MAXIMUM_SAVE_SLOTS_DESCRIPTION": "Change le nombre d'emplacements de sauvegarde disponibles.",
        "SETTING_MENU_STYLE": "Style des menus",
        "SETTING_MENU_STYLE_DESCRIPTION": "Changer la manière dont les menus sont affichés.\n - PC : Interface de la version PC.\n - PS1 : Interface de la version PlayStation.",
        "SETTING_MUSIC_LOAD_CONDITION": "Reprendre la musique au chargement",
        "SETTING_MUSIC_LOAD_CONDITION_DESCRIPTION": "Restaure la lecture des pistes audio qui étaient en cours de lecture lors de la sauvegarde.\n- Aucune : ne restaure jamais la lecture au chargement.\n- Pistes musicales : reprend uniquement les pistes musicales (hors ambiance) au chargement.\n- Tout : restaure tout type de piste audio au chargement.",
        "SETTING_MUSIC_VOLUME": "\\{review}Volume de la musique",
        "SETTING_MUSIC_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume de la musique.",
        "SETTING_MUTE_OUT_OF_FOCUS": "\\{review}Couper le son lorsque la fenêtre perd le focus",
        "SETTING_MUTE_OUT_OF_FOCUS_DESCRIPTION": "\\{review}Coupe toute la musique et les effets sonores lorsque la fenêtre du jeu n'est pas au premier plan.",
        "SETTING_PAUSE_BACKGROUND_STYLE": "\\{review}Pause en arrière-plan",
        "SETTING_PAUSE_BACKGROUND_STYLE_DESCRIPTION": "\\{review}Modifie la façon dont l'arrière-plan de l'écran de pause est affiché.\n\n- Sombre : TR1 (PC).\n- Très sombre : TR1 (PS1).\n- Statique : TR2 (PC).\n- Ondulé : TR2 (PS1).\n- Monochrome : TR3.",
        "SETTING_PAUSE_FADE_EFFECTS": "\\{review}Effets de fondu de la pause",
        "SETTING_PAUSE_FADE_EFFECTS_DESCRIPTION": "\\{review}Affine les effets de fondu à activer ou désactiver dans l'écran de pause. Nécessite que l'option Effets de fondu soit activée pour fonctionner.",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY": "Suspendre la musique dans l'inventaire",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY_DESCRIPTION": "Suspend les effets sonores du jeu, l'ambiance et la musique dans l'écran d'inventaire.",
        "SETTING_PROJECTILE_AREA_DAMAGE": "\\{review}Dégâts de zone de projectile",
        "SETTING_PROJECTILE_AREA_DAMAGE_DESCRIPTION": "\\{review}Contrôle la propagation de la zone d'effet pour le Lance-roquettes et le Lance-grenades.\n\n- Balayage unique : comportement de TR1 & TR2.\n- Balayage multiple : comportement de TR3.\n\nL'option de balayage multiple entraîne souvent des dégâts doublés sur les ennemis individuels.",
        "SETTING_QUICK_GUNS_MODE": "\\{review}Touches de l'arme rapide",
        "SETTING_QUICK_GUNS_MODE_DESCRIPTION": "\\{review}Contrôle le comportement des touches d'équipement de l'arme rapide.\n\n- Tirer seulement : appuyer sur une touche fera en sorte que Lara équipe l'arme assignée.\n- Tirer ou ranger : identique à ce qui précède, de plus Lara rangera l'arme assignée si elle la porte actuellement.",
        "SETTING_REFLECTIONS": "Reflets",
        "SETTING_REFLECTIONS_DESCRIPTION": "Active les reflets sur certains objets.",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS": "Mémoriser les armes entre les niveaux",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION": "\\{review}Mémoriser la dernière arme utilisée par Lara dans le niveau précédent au démarrage du suivant. Sans cette option, Lara reviendra aux pistolets rangés dans leurs holsters.",
        "SETTING_RESTORE_PS1_ENEMIES": "Restaure les ennemis PS1",
        "SETTING_RESTORE_PS1_ENEMIES_DESCRIPTION": "\\{review}Ajoute la momie qui apparaît dans la version PlayStation de City of Khamoon, salle 25.\nModifier cette option nécessitera de redémarrer le jeu.",
        "SETTING_SCREENSHOT_FORMAT": "Format des captures d'écran",
        "SETTING_SCREENSHOT_FORMAT_DESCRIPTION": "Format de fichier pour les captures d'écran.",
        "SETTING_SHADOW_TYPE": "\\{review}Forme des ombres",
        "SETTING_SHADOW_TYPE_DESCRIPTION": "\\{review}Sélectionne la manière dont les ombres des entités sont rendues.\n\n- Octogone : ombres des anciens TR1 et TR2\n- Cercle : ombres rondes\n- Sprite : ombres basées sur des textures TR3",
        "SETTING_SHOW_BARS": "\\{review}Afficher les barres",
        "SETTING_SHOW_BARS_DESCRIPTION": "\\{review}Désactive toutes les barres en jeu, masquant les informations sur la santé de Lara et d'autres ressources (pour les défis).",
        "SETTING_SOUND_VOLUME": "\\{icon sound} Volume du son",
        "SETTING_SOUND_VOLUME_DESCRIPTION": "Ajuste le volume des effets sonores.",
        "SETTING_SPRINTBAR_COLOR": "\\{review}Couleur de la barre de sprint",
        "SETTING_SPRINTBAR_COLOR_DESCRIPTION": "\\{review}Couleur de la barre de sprint.",
        "SETTING_SPRINTBAR_LOCATION": "\\{review}Emplacement de la barre de sprint",
        "SETTING_SPRINTBAR_LOCATION_DESCRIPTION": "\\{review}Emplacement où la barre de sprint est affichée.",
        "SETTING_SPRITE_LOCK_MODE": "\\{review}Mode verrouillage des sprites",
        "SETTING_SPRITE_LOCK_MODE_DESCRIPTION": "\\{review}Contrôle les axes à verrouiller lors de l'affichage des sprites à l'écran.\n\n- Aucun : afficher les sprites normalement.\n- Roulis : verrouiller l'axe de roulis – utile uniquement en mode photo.\n- Roulis et tangage : garantir que les sprites restent debout et ne reposent pas au sol lorsqu'on les regarde d'en haut.\n- Perspective : verrouiller les axes de roulis et de tangage et, en plus, faire pivoter légèrement les sprites vers le centre de l'écran.",
        "SETTING_START_LARA_HITPOINTS": "Points de vie de Lara",
        "SETTING_START_LARA_HITPOINTS_DESCRIPTION": "Définit les points de vie de Lara à chaque lancement de niveau.",
        "SETTING_STATS_BACKGROUND_STYLE": "\\{review}Arrière-plan des statistiques",
        "SETTING_STATS_BACKGROUND_STYLE_DESCRIPTION": "\\{review}Modifie la façon dont l'arrière-plan des statistiques de fin de niveau est affiché.\n\n- Sombre : TR1 (PC).\n- Très sombre : TR1 (PS1).\n- Statique : TR2 (PC).\n- Ondulé : TR2 (PS1).\n- Monochrome : TR3.",
        "SETTING_STATS_FADE_EFFECTS": "\\{review}Effets de fondu des statistiques",
        "SETTING_STATS_FADE_EFFECTS_DESCRIPTION": "\\{review}Affine les effets de fondu à activer ou désactiver dans l'écran des statistiques de fin de niveau. Nécessite que l'option Effets de fondu soit activée pour fonctionner.",
        "SETTING_STATS_LEVEL_HEADER": "\\{review}En-tête des statistiques de niveau",
        "SETTING_STATS_LEVEL_HEADER_DESCRIPTION": "\\{review}Affiche le numéro de niveau actuel en haut des statistiques de niveau.",
        "SETTING_STAT_DETAIL_MODE": "Détail des statistiques",
        "SETTING_STAT_DETAIL_MODE_DESCRIPTION": "\\{review}Permet différents niveaux de détail des statistiques.\n\n- Minimal : affiche la boîte de dialogue des statistiques originale.\n- Détail : affiche toutes les statistiques du mode minimal ainsi que les valeurs maximales près de chaque champ.\n- Complet : affiche toutes les statistiques du mode détail ainsi que de nouvelles lignes non disponibles dans la boîte de dialogue originale.",
        "SETTING_TARGET_MODE": "Mode de verrouillage",
        "SETTING_TARGET_MODE_DESCRIPTION": "Modifie le comportement de verrouillage des cibles.\n- Complet : Verrouille la cible même si elle sort du champ de vision ou meurt (TR1-3).\n- Hybride : Verrouille la cible si elle sort du champ de vision, mais déverrouille si elle meurt.\n- Aucun : Déverrouille la cible si elle sort du champ de vision ou meurt (TR4+).",
        "SETTING_TEXTURE_FILTER": "Filtre des texture",
        "SETTING_TEXTURE_FILTER_DESCRIPTION": "\\{review}Alterne entre des textures ingame lisses et pixelisées.",
        "SETTING_TRAPEZOID_FILTER": "Filtre trapézoïdal",
        "SETTING_TRAPEZOID_FILTER_DESCRIPTION": "Corrige le rendu des quadrilatères.",
        "SETTING_UI_BAR_SCALE": "Échelle des barres",
        "SETTING_UI_BAR_SCALE_DESCRIPTION": "Change la taille des barres de vie, d'air et des ennemis.",
        "SETTING_UI_BRIGHTNESS": "Luminosité de l'interface",
        "SETTING_UI_BRIGHTNESS_DESCRIPTION": "Modifie la luminosité de l'interface.",
        "SETTING_UI_FILTER": "\\{review}Filtre UI",
        "SETTING_UI_FILTER_DESCRIPTION": "\\{review}Alterne entre des textures UI lisses et pixelisées.",
        "SETTING_UI_LANGUAGE": "Langue",
        "SETTING_UI_LANGUAGE_DESCRIPTION": "Change la langue du texte de l'interface utilisateur.",
        "SETTING_UI_PICKUPS_OVERLAY": "Affichage des objets ramassés",
        "SETTING_UI_PICKUPS_OVERLAY_DESCRIPTION": "Affiche les objets en bas à droite lorsque Lara ramasse quelque chose.",
        "SETTING_UI_PICKUP_SCALE": "\\{review}Échelle de ramassage",
        "SETTING_UI_PICKUP_SCALE_DESCRIPTION": "\\{review}Modifie la taille des objets animés dans l'interface utilisateur lorsque Lara ramasse quelque chose.",
        "SETTING_UI_SCROLL_WRAPAROUND": "Boucler au défilement",
        "SETTING_UI_SCROLL_WRAPAROUND_DESCRIPTION": "Automatiquement retourner en haut après avoir atteint le bas d'un menu (et vice-versa).",
        "SETTING_UI_TEXT_SCALE": "Échelle de texte",
        "SETTING_UI_TEXT_SCALE_DESCRIPTION": "Change la taille du texte de l'interface utilisateur.",
        "SETTING_UNDERWATER_AMBIENT_VOLUME": "\\{review}Volume ambiant (sous l'eau)",
        "SETTING_UNDERWATER_AMBIENT_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume ambiant sous l'eau.",
        "SETTING_UNDERWATER_MUSIC_VOLUME": "\\{review}Volume de la musique (sous l'eau)",
        "SETTING_UNDERWATER_MUSIC_VOLUME_DESCRIPTION": "\\{review}Ajuste le volume de la musique sous l'eau.",
        "SETTING_UPSCALING_FACTOR": "\\{review}Facteur de mise à l'échelle",
        "SETTING_UPSCALING_FACTOR_DESCRIPTION": "Augmente la taille du jeu selon un multiplicateur, en maintenant l'aspect pixellisé.",
        "SETTING_UPSCALING_FILTER": "\\{review}Filtre de mise à l'échelle",
        "SETTING_UPSCALING_FILTER_DESCRIPTION": "Applique une apparence lisse ou pixelisée pour tout l'écran.",
        "SETTING_VSYNC": "VSync",
        "SETTING_VSYNC_DESCRIPTION": "Active ou désactive la synchronistaion verticale.",
        "SETTING_WALL_GLITCH_MODE": "\\{review}Mode de glitch de mur",
        "SETTING_WALL_GLITCH_MODE_DESCRIPTION": "\\{review}Permet d'utiliser le comportement de glitch de mur de TR1 dans TR2 et vice-versa ; permet également de corriger tous les types de glitch de mur.",
        "SETTING_WATER_COLOR": "Couleur de l'eau",
        "SETTING_WATER_COLOR_DESCRIPTION": "\\{review}Couleur de l'eau.",
        "SOUND_SETTINGS_MISC_TAB": "\\{review}Divers",
