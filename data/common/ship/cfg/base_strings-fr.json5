        "STATS_ASSAULT_FINISH": "\\{review}Fin",
        "STATS_ASSAULT_NO_TIMES_SET": "\\{review}Aucun temps défini",
        "STATS_ASSAULT_OTHER_TIMES_FMT": "\\{review}%s",
        "STATS_ASSAULT_TITLE": "\\{review}MEILLEURS TEMPS",
