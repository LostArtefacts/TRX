        "SETTING_SCREENSHOT_FORMAT_DESCRIPTION": "Format pliku użyty do zapisu zrzutów ekranu.",
        "SETTING_SHADOW_TYPE": "Kształt cieni",
        "SETTING_SHADOW_TYPE_DESCRIPTION": "Wybiera sposób rysowania cieni obiektów.\n\n- Ośmiokąt: stare cienie z TR1 i TR2\n- Elipsa: zaokrąglone cienie\n- Sprite: cienie oparte na teksturach z TR3",
        "SETTING_SHOW_BARS": "Pokaż paski",
        "SETTING_SHOW_BARS_DESCRIPTION": "Wyłącza wszystkie paski w grze, ukrywając informacje o zdrowiu Lary i innych zasobach.",
        "SETTING_SOUND_VOLUME": "\\{icon sound} Głośność dźwięku",
        "SETTING_SOUND_VOLUME_DESCRIPTION": "Dostosowuje głośność efektów dźwiękowych.",
        "SETTING_SPRINTBAR_COLOR": "Kolor paska sprintu",
        "SETTING_SPRINTBAR_COLOR_DESCRIPTION": "Kolor paska sprintu",
        "SETTING_SPRINTBAR_LOCATION": "Pozycja paska sprintu",
        "SETTING_SPRINTBAR_LOCATION_DESCRIPTION": "Lokalizacja, w której wyświetlany jest pasek sprintu.",
        "SETTING_SPRITE_LOCK_MODE": "Tryb blokady sprite'ów",
        "SETTING_SPRITE_LOCK_MODE_DESCRIPTION": "Blokuje dane osie podczas wyświetlania sprite'ów na ekranie.\n\n- Brak: wyświetlaj sprite'y normalnie.\n- Obrót: blokuje oś obrotu – przydatne tylko w trybie fotograficznym.\n- Obrót i pochylenie: zapewnia, że sprite'y stoją pionowo i nie kładą się na ziemi przy patrzeniu z góry.\n- Perspektywa: blokuje osie obrotu i pochylenia oraz dodatkowo lekko obraca sprite'y w kierunku środka ekranu.",
        "SETTING_START_LARA_HITPOINTS": "Startowe zdrowie Lary",
        "SETTING_START_LARA_HITPOINTS_DESCRIPTION": "Ustala wartość zdrowia, z którą Lara zaczyna każdy poziom.",
        "SETTING_STATS_BACKGROUND_STYLE": "Tło statystyk",
        "SETTING_STATS_BACKGROUND_STYLE_DESCRIPTION": "Zmienia sposób wyświetlania tła dla statystyk na końcu poziomu.\n\n- Ciemne: TR1 (PC).\n- Bardzo ciemne: TR1 (PS1).\n- Stałe: TR2 (PC).\n- Falujące: TR2 (PS1).\n- Czarno-białe: TR3.",
        "SETTING_STATS_FADE_EFFECTS": "\\{review}Efekty zanikania w statystykach",
        "SETTING_STATS_FADE_EFFECTS_DESCRIPTION": "\\{review}Dopasowuje efekty zanikania, aby były włączone lub wyłączone na ekranie statystyk po zakończeniu poziomu. Wymaga włączenia opcji Efekty zanikania, aby działało.",
        "SETTING_STATS_LEVEL_HEADER": "Numer poziomu w statystykach",
        "SETTING_STATS_LEVEL_HEADER_DESCRIPTION": "Wyświetla numer bieżącego poziomu na ekranach statystyk.",
        "SETTING_STAT_DETAIL_MODE": "Poziom szczegółów statystyk",
        "SETTING_STAT_DETAIL_MODE_DESCRIPTION": "Pozwala na różne poziomy szczegółowości ekranu statystyk.\n\n- Minimalny: pokazuje oryginalne okno statystyk.\n- Szczegółowy: pokazuje dodatkowo maksymalne wartości obok każdego pola.\n- Pełny: pokazuje także statystyki niedostępne w oryginalnej wersji gry.",
        "SETTING_TARGET_MODE": "Tryb blokady broni",
        "SETTING_TARGET_MODE_DESCRIPTION": "Zmienia tryb, w jaki bronie blokują się na celach.\n\n- Całkowity: zawsze utrzymuje blokadę celu, nawet jeśli przeciwnik wyjdzie z pola widzenia lub zginie (tak jak w TR1-3).\n- Częściowy: utrzymuje blokadę celu, jeśli przeciwnik wyjdzie z pola widzenia, ale traci ją, kiedy przeciwnik zginie.\n- Brak: traci blokadę celu, kiedy przeciwnik wyjdzie z pola widzenia lub zginie (tak jak w TR4+).",
        "SETTING_TEXTURE_FILTER": "Filtr tekstur",
        "SETTING_TEXTURE_FILTER_DESCRIPTION": "Przełącza między gładkimi a pikselowymi teksturami w grze.",
        "SETTING_TRAPEZOID_FILTER": "Filtr trapezoidalny",
        "SETTING_TRAPEZOID_FILTER_DESCRIPTION": "Poprawia rysowanie czworokątów, rozciągając teksturę między wszystkimi wierzchołkami zamiast dzielić je na dwa trójkąty.",
        "SETTING_UI_BAR_SCALE": "Skala pasków",
        "SETTING_UI_BAR_SCALE_DESCRIPTION": "Zmienia rozmiar pasków zdrowia i tlenu.",
        "SETTING_UI_FILTER": "Filtr UI",
        "SETTING_UI_FILTER_DESCRIPTION": "Przełącza między gładką a pikselową grafiką interfejsu.",
        "SETTING_UI_LANGUAGE": "Język",
        "SETTING_UI_LANGUAGE_DESCRIPTION": "Zmienia język tekstu interfejsu.",
        "SETTING_UI_PICKUP_SCALE": "Skala przedmiotów",
        "SETTING_UI_PICKUP_SCALE_DESCRIPTION": "Zmienia rozmiar przedmiotów animowanych w rogu ekranu, kiedy Lara coś podnosi.",
        "SETTING_UI_SCROLL_WRAPAROUND": "Cykliczne przewijanie",
        "SETTING_UI_SCROLL_WRAPAROUND_DESCRIPTION": "Zawijanie poza ostatni element spowoduje powrót na początek listy i na odwrót.",
        "SETTING_UI_TEXT_SCALE": "Skala tekstu",
        "SETTING_UI_TEXT_SCALE_DESCRIPTION": "Zmienia rozmiar tekstu interfejsu.",
        "SETTING_UNDERWATER_AMBIENT_VOLUME": "Głośność otoczenia (pod wodą)",
        "SETTING_UNDERWATER_AMBIENT_VOLUME_DESCRIPTION": "Reguluje głośność otoczenia pod wodą.",
