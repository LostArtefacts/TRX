        "SETTING_ALLY_HEALTHBAR_COLOR": "Kolor paska sojuszników",
        "SETTING_ALLY_HEALTHBAR_COLOR_DESCRIPTION": "Kolor paska zdrowia sojuszników. Wyświetlany w miejscu pasków zdrowia wrogów.",
        "SETTING_ALLY_HOSTILITY_POLICY": "\\{review}Polityka wrogości sojuszników",
        "SETTING_ALLY_HOSTILITY_POLICY_DESCRIPTION": "\\{review}Kontroluje, jak przyjazne jednostki reagują na otrzymane obrażenia.\n\n- Indywidualny: każdy sojusznik zmienia wrogość samodzielnie (styl TR3).\n- Wspólny: wszyscy sojusznicy stają się wrodzy razem (styl mnichów z TR2).",
        "SETTING_AMBIENT_VOLUME": "Głośność otoczenia",
        "SETTING_AMBIENT_VOLUME_DESCRIPTION": "Reguluje głośność otoczenia.",
        "SETTING_ANISOTROPY_FILTER": "Filtr anizotropowy",
        "SETTING_ANISOTROPY_FILTER_DESCRIPTION": "Zwiększa filtrowanie tekstur w dużej odległości od kamery.",
        "SETTING_ASPECT_MODE": "Proporcje ekranu",
        "SETTING_ASPECT_MODE_DESCRIPTION": "Wymusza określone proporcje obrazu w grze przez dodanie czarnych pasków po bokach (letterboxing).",
        "SETTING_BAR_LOOK": "Wygląd pasków",
        "SETTING_BAR_LOOK_DESCRIPTION": "Steruje wyglądem pasków życia i tlenu.",
        "SETTING_BORDERS": "Ramka",
        "SETTING_BORDERS_DESCRIPTION": "Dodaje czarną ramkę wokół okna gry.",
        "SETTING_BRIGHTNESS": "Jasność",
        "SETTING_BRIGHTNESS_DESCRIPTION": "Zmienia jasność gry.",
        "SETTING_CAMERA_MODE": "Tryb kamery",
        "SETTING_CAMERA_MODE_DESCRIPTION": "Zmienia zachowanie kamery podczas niektórych akcji, np. kiedy Lara używa kluczy lub dźwigni.",
        "SETTING_CAMERA_SPEED": "Prędkość kamery",
        "SETTING_CAMERA_SPEED_DESCRIPTION": "Zmienia prędkość, z jaką porusza się manualna kamera.",
        "SETTING_CHANGE_PIERRE_SPAWN": "Zmień tryb pojawiania się Pierre'a",
        "SETTING_CHANGE_PIERRE_SPAWN_DESCRIPTION": "Włączenie tej opcji sprawi, że podczas przechodzenia przez określone miejsca Pierre pojawi się bliżej. Jeśli opcja jest wyłączona, nic się nie zmieni. Dotyczy tylko sytuacji, gdzie nie Lara nie przegoniła Pierre'a.",
        "SETTING_CUTSCENE_VOLUME": "Głośność przerywników",
        "SETTING_CUTSCENE_VOLUME_DESCRIPTION": "Reguluje głośność przerywników filmowych w grze.",
        "SETTING_DISABLE_EXTRA_GUNS": "Wyłącz dodatkowe bronie",
        "SETTING_DISABLE_EXTRA_GUNS_DESCRIPTION": "Usuwa wszystkie bronie i amunicję z gry z wyjątkiem pistoletów.",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS": "Trwałe obrażenia",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Wyłącza leczenie Lary, gdy gracz zaczyna nowy poziom.",
        "SETTING_DISABLE_MEDPACKS": "Wyłącz apteczki",
        "SETTING_DISABLE_MEDPACKS_DESCRIPTION": "Usuwa wszystkie apteczki z gry.",
        "SETTING_DISABLE_TREX_COLLISION": "Usuń kolizję z ubitym T-Rexem",
        "SETTING_DISABLE_TREX_COLLISION_DESCRIPTION": "Usuwa wszelką kolizję z tyranozaurem po jego śmierci, co pomaga w sytuacjach, gdy jego cielsko uniemożliwia przejście.",
        "SETTING_ENABLE_3D_PICKUPS": "Znajdźki 3D",
        "SETTING_ENABLE_3D_PICKUPS_DESCRIPTION": "Rysuje przedmioty do podniesienia jako trójwymiarowe modele zamiast płaskich grafik.",
        "SETTING_ENABLE_ALLY_TARGETING": "Pozwól na celowanie w sojuszników",
        "SETTING_ENABLE_ALLY_TARGETING_DESCRIPTION": "Pozwala Larze celować w sojuszników, np. mnichów. Jeśli opcja jest wyłączona, sojusznicy będą całkowicie odporni na amunicję Lary.",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION": "Preselekcja przedmiotów",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "Kiedy Lara spróbuje wejść w interakcję z zamkiem lub slotem na przedmiot i ma odpowiednią rzecz w plecaku, zostanie ona automatycznie wybrana.",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE": "\\{review}Potknięcie na nachyleniu do tyłu",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE_DESCRIPTION": "\\{review}Powoduje, że Lara potyka się, gdy skacze do tyłu i za nią znajduje się nachylenie (TR3). Po wyłączeniu Lara zatrzymuje się gwałtownie na nachyleniu (TR1/2).",
        "SETTING_ENABLE_BAR_FLASHING": "Migające paski",
        "SETTING_ENABLE_BAR_FLASHING_DESCRIPTION": "Sprawia, że paski zdrowia i tlenu Lary zaczynają migać, kiedy dany zasób jest na wyczerpaniu.",
        "SETTING_ENABLE_BOULDER_SHAKE": "\\{review}Włącz wstrząsy głazów",
        "SETTING_ENABLE_BOULDER_SHAKE_DESCRIPTION": "\\{review}Po włączeniu kamera będzie się trząść, gdy głaz jest w ruchu.",
        "SETTING_ENABLE_BOUNCY_GRENADES": "\\{review}Odbijające się granaty",
        "SETTING_ENABLE_BOUNCY_GRENADES_DESCRIPTION": "\\{review}Włącza zachowanie granatów w stylu TR3: odbijają się od ścian i pochyłości oraz tworzą większy promień wybuchu, ale kosztem zmniejszonej prędkości.",
        "SETTING_ENABLE_BRAID": "Warkocz Lary",
        "SETTING_ENABLE_BRAID_DESCRIPTION": "Włącza warkocz Lary.",
        "SETTING_ENABLE_BREEZE": "Wiatr",
        "SETTING_ENABLE_BREEZE_DESCRIPTION": "Włącza efekt wiatru na warkoczu Lary w miejscach, które to obsługują.",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS": "Buforowanie (klawisze funkcyjne)",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS_DESCRIPTION": "Włącza buforowanie klawisza F w celu precyzyjnej kontroli ruchu Lary (1 klatka). Ta funkcja pierwotnie istniała tylko w porcie TombATI (TR1).",
        "SETTING_ENABLE_BUFFERING_INVENTORY": "Buforowanie (ekwipunek)",
        "SETTING_ENABLE_BUFFERING_INVENTORY_DESCRIPTION": "Włącza buforowanie ekranu ekwipunku, aby uzyskać precyzyjną kontrolę nad ruchem Lary (2 klatki).",
        "SETTING_ENABLE_CHEATS": "Cheaty",
        "SETTING_ENABLE_CHEATS_DESCRIPTION": "Włącza różne cheaty:\n\n- L: natychmiast kończy poziom.\n- I: daje Larze wszystkie bronie; zwiększa ilość amunicji i apteczek; daje wszystkie przedmioty z bieżącego poziomu.\n- O: włącza latanie.\n  - Klawisz chodzenia: wyjście z trybu latani.\n  - Klawisz broni: otwiera najbliższe drzwi.",
        "SETTING_ENABLE_COMPASS_STATS": "Statystyki w kompasie",
        "SETTING_ENABLE_COMPASS_STATS_DESCRIPTION": "Włącza wyświetlanie statystyk aktualnego poziomu przy wybraniu kompasu.",
        "SETTING_ENABLE_CONSOLE": "Konsola",
        "SETTING_ENABLE_CONSOLE_DESCRIPTION": "Włącza konsolę umożliwiającą wpisywanie różnych komend.",
        "SETTING_ENABLE_CONTROLLED_DROPS": "Bezpieczne krawędzie",
        "SETTING_ENABLE_CONTROLLED_DROPS_DESCRIPTION": "Pozwala Larze obrócić się w powietrzu i złapać krawędź z której gracz właśnie się ześliznął, jeśli trzymay jest przycisk akcji.",
        "SETTING_ENABLE_CREDITS": "Napisy końcowe",
        "SETTING_ENABLE_CREDITS_DESCRIPTION": "Włącza ekrany z napisami końcowymi wyświetlane po ukończeniu gry. Ustawienie nie ma wpływu na ekran końcowych statystyk.",
        "SETTING_ENABLE_CUTSCENES": "Przerywniki",
        "SETTING_ENABLE_CUTSCENES_DESCRIPTION": "Włącza odtwarzanie przerywników (cutscenek).",
        "SETTING_ENABLE_DEATHS_COUNTER": "Licznik śmierci Lary",
        "SETTING_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Włącza wyświetlanie licznika śmierci w statystykach poziomu. Liczba śmierci jest aktualizowana w aktualnie wczytanym zapisie w momencie, kiedy Lara ginie.",
        "SETTING_ENABLE_DEMO": "Tryb demo",
        "SETTING_ENABLE_DEMO_DESCRIPTION": "Włącza odtwarzanie krótkich demonstracyjnych sekwencji w menu głównym.",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME": "\\{review}Nieskończony czas świecy dymnej",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME_DESCRIPTION": "\\{review}Zapobiega wygasaniu przenośnych świec dymnych. Rzucone świece dymne nadal gasną normalnie.",
        "SETTING_ENABLE_ENDLESS_SPRINT": "\\{review}Niekończący się sprint",
        "SETTING_ENABLE_ENDLESS_SPRINT_DESCRIPTION": "\\{review}Zapobiega zmęczeniu Lary podczas biegu. Przeszkody nadal ją zatrzymają.",
        "SETTING_ENABLE_ENEMY_ROTATION": "Losuj rotację przeciwników",
        "SETTING_ENABLE_ENEMY_ROTATION_DESCRIPTION": "Zastosowuje dodatkowy losowy kąt do niektórych przeciwników podczas ładowania poziomu.",
        "SETTING_ENABLE_ENHANCED_SAVES": "Zapis efektów",
        "SETTING_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Zapisuje efekty graficzne, mgłę wodospadu, emitery płomieni itp., dzięki czemu nie znikają już po wczytaniu.",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS": "Przejścia przy wyjściu z gry",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION": "Włącza efekt płynnego przejścia przy wychodzeniu z gry do pulpitu.",
        "SETTING_ENABLE_FADE_EFFECTS": "Efekty przejścia",
        "SETTING_ENABLE_FADE_EFFECTS_DESCRIPTION": "Włącza efekty płynnych przejść, np. między grafikami napisów końcowych, lub przy włączaniu ekranu ekwipunku i ekranu pauzy.",
        "SETTING_ENABLE_FIRE_LIGHTING": "Światło dookoła ogni",
        "SETTING_ENABLE_FIRE_LIGHTING_DESCRIPTION": "Włącza generowanie dynamicznego oświetlenia obok aktywnych płomieni.",
        "SETTING_ENABLE_FMV": "Filmy",
        "SETTING_ENABLE_FMV_DESCRIPTION": "Włącza odtwarzanie filmów.",
        "SETTING_ENABLE_FOOTPRINTS": "Ślady stóp",
        "SETTING_ENABLE_FOOTPRINTS_DESCRIPTION": "Włącza wyświetlanie śladów stóp Lary na niektórych powierzchniach w obsługiwanych poziomach.",
        "SETTING_ENABLE_GAME_MODES": "Wybór trybu gry",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Pozwala na wybór opcji trybu przy rozpoczynaniu nowej gry.\n\n- Nowa Gra+: odblokowuje wszystkie bronie z nieskończoną amunicją; przeciwnicy mają podwójne zdrowie.\n- Japońska NG: bronie zadają podwójne obrażenia; znajdźki z flarami zawierają 8 flar zamiast 6.\n- Japońska NG+: połączenie Nowej Gry+ i Japońskiej NG.",
        "SETTING_ENABLE_GUN_LIGHTING": "Efekty świetlne broni",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Włącza dynamiczne oświetlenie przy strzelaniu z broni i eksplozjach.",
        "SETTING_ENABLE_IDLE_POSE_CAMERA": "Kamera bezczynności",
        "SETTING_ENABLE_IDLE_POSE_CAMERA_DESCRIPTION": "Dostosowuje kamerę tak, aby była skierowana na Larę podczas animacji bezczynności. Przycisk patrzenia resetuje kamerę.",
        "SETTING_ENABLE_INVERTED_LOOK": "Odwrócenie osi Y patrzenia",
        "SETTING_ENABLE_INVERTED_LOOK_DESCRIPTION": "Odwraca sterowanie rozglądania się w osi Y.",
        "SETTING_ENABLE_ITEM_EXAMINING": "Badanie przedmiotów",
        "SETTING_ENABLE_ITEM_EXAMINING_DESCRIPTION": "Pozwala na wyświetlanie opisów przedmiotów w ekwipunku w niestandardowych poziomach, gdzie autor poziomu dostarczył odpowiednie dane.",
        "SETTING_ENABLE_JUMP_TWISTS": "Przewroty w powietrzu",
        "SETTING_ENABLE_JUMP_TWISTS_DESCRIPTION": "Włącza możliwość przewrotu podczas skakania.",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS": "Zabójcze bloki",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS_DESCRIPTION": "Kiedy ta opcja jest włączona, spadające z wysokości bloki natychmiast zabijają Larę. W przeciwnym razie Lara stanie na powierzchni bloku i przeżyje (tak jak w oryginalnych grach).",
        "SETTING_ENABLE_LARA_MIC": "Mikrofon przy Larze",
        "SETTING_ENABLE_LARA_MIC_DESCRIPTION": "Ustawia mikrofon na pozycji Lary. Domyślnie mikrofon jest na pozycji kamery. Wpływa to głównie na głośność efektów – czy przy kamerach daleko od Lary będą one cicho, czy głośno.",
        "SETTING_ENABLE_LEAN_JUMPING": "Dalekie skoki w miejscu",
        "SETTING_ENABLE_LEAN_JUMPING_DESCRIPTION": "Pozwala Larze na przesuwanie się do przodu lub do tyłu dalej podczas wykonywania skoków w miejscu z wciśniętym odpowiednim klawiszem (tak jak w TR2+).",
        "SETTING_ENABLE_LEDGE_JUMPS": "Skoki z krawędzi",
        "SETTING_ENABLE_LEDGE_JUMPS_DESCRIPTION": "Pozwala Larze skoczyć w górę lub do tyłu, gdy zwisa z krawędzi, o ile przed nią znajduje się solidna powierzchnia, od której może się odepchnąć.",
        "SETTING_ENABLE_LEGAL": "Informacje prawne",
        "SETTING_ENABLE_LEGAL_DESCRIPTION": "Włącza ekran z informacjami prawnymi oraz filmik z logiem Core Design na początku gry.",
        "SETTING_ENABLE_LOADING_SCREENS": "Ekrany ładowania",
        "SETTING_ENABLE_LOADING_SCREENS_DESCRIPTION": "Włącza ekrany ładowania pokazywane przed każdym poziomem.",
        "SETTING_ENABLE_MANUAL_CAMERA": "\\{review}Ręczna kamera",
        "SETTING_ENABLE_MANUAL_CAMERA_DESCRIPTION": "\\{review}Włącza klawisze kamery (\\{input camera_forward}\\{input camera_back}\\{input camera_left}\\{input camera_right}) używane do sterowania kamerą w trybie zdjęć, aby również obracać kamerę w grze.",
        "SETTING_ENABLE_MUSIC_IN_MENU": "Muzyka w menu głównym",
        "SETTING_ENABLE_MUSIC_IN_MENU_DESCRIPTION": "Odtwarza muzykę w menu głównym.",
        "SETTING_ENABLE_NEUTRAL_TWISTS": "Salta w miejscu",
        "SETTING_ENABLE_NEUTRAL_TWISTS_DESCRIPTION": "Pozwala Larze obracać się w powietrzu podczas neutralnego skoku. Aby wykonać salto w miejscu, należy przytrzymać jednocześnie przyciski skoku i przewrotu.",
        "SETTING_ENABLE_PICKUP_AIDS": "Pomoce do znajdziek",
        "SETTING_ENABLE_PICKUP_AIDS_DESCRIPTION": "Włącza okazjonalne migotanie w pobliżu przedmiotów do podniesienia w celu zwiększenia ich widoczności.",
        "SETTING_ENABLE_PITCHED_SOUNDS": "Modulacja wysokości dźwięków",
        "SETTING_ENABLE_PITCHED_SOUNDS_DESCRIPTION": "Pozwala na losowe, nieznaczne zmiany tonacji efektów dźwiękowych dla urozmaicenia rozgrywki.",
        "SETTING_ENABLE_PLAY_PREVIOUS_LEVELS": "Zagraj w poprzednie poziomy",
        "SETTING_ENABLE_PS1_CRYSTALS": "Fioletowe kryształy",
        "SETTING_ENABLE_PS1_CRYSTALS_DESCRIPTION": "Kryształy zapisu będą rysowane z fioletowym odcieniem, bardziej podobnym do odcienia z PS1.",
        "SETTING_ENABLE_PS1_SFX": "Efekty dźwiękowe z PS1",
        "SETTING_ENABLE_PS1_SFX_DESCRIPTION": "Zamienia określone efekty dźwiękowe na odpowiedniki z PS1.\n\n- Pociski z Uzi (tylko TR1)\n- Odgłosy poruszania się boso (tylko TR2)",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT": "Responsywny paszport",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Wyłącza blokowanie klawiszy podczas przewracania stron paszportu, zamiast tego kolejkując pożądaną nawigację.",
        "SETTING_ENABLE_RESPONSIVE_SPRINT": "Responsywny sprint",
        "SETTING_ENABLE_RESPONSIVE_SPRINT_DESCRIPTION": "Włącza bardziej responsywny tryb sprintu dla Lary.\n\n- Pozwala sprintować, gdy Lara ma energię, a nie tylko przy pełnej wytrzymałości.\n- Umożliwia sprint po schodach bez przerywania zwykłą animacją biegu.",
        "SETTING_ENABLE_SAVE_CRYSTALS": "Kryształy zapisu",
        "SETTING_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Ogranicza zapisywanie do początku poziomów oraz kryształów zapisu umieszczonych w konkretnych lokacjach. Poziomy mają ograniczone, jednorazowe kryształy zapisu jak w wersji PS1. Zmiana tej opcji wymaga ponownego uruchomienia poziomu.",
        "SETTING_ENABLE_SHOTGUN_FLASH": "Rozbłyski ze strzelby",
