            "description": "Цвет шкалы здоровья противников.",
        },
        "ui.enemy_healthbar_location": {
            "title": "Положение шкалы здоровья врагов",
            "description": "Место, где отображается шкала здоровья противника.",
        },
        "ui.enemy_healthbar_show_mode": {
