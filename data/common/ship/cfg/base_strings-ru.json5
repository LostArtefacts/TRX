        "ui.enable_bar_flashing": {
            "title": "\\{review}Мигающие полосы",
            "description": "\\{review}Заставляет полосы здоровья и кислорода Лары мигать, когда один из ресурсов на исходе.",
        },
        "ui.enable_smooth_bars": {
