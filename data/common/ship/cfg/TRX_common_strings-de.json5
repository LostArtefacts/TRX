        "GRAPHIC_SETTINGS_WATER_COLOR_B": "Wasser-Farbe (B)",
        "GRAPHIC_SETTINGS_WATER_COLOR_B_DESCRIPTION": "Blaue Komponente der Farbe des Wassers.",
