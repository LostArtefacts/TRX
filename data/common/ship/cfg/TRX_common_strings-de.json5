        "GRAPHIC_SETTINGS_CAMERA_MODE": "Kamera-Modus",
        "GRAPHIC_SETTINGS_CAMERA_MODE_DESCRIPTION": "Passt das Kameraverhalten während Aktionen, wie dem Benutzen von Schlüsseln, ausegführt werden.",
        "GRAPHIC_SETTINGS_CAMERA_MODE_TR1": "TR1",
        "GRAPHIC_SETTINGS_CAMERA_MODE_TR2": "TR2",
        "GRAPHIC_SETTINGS_DEPTH_BUFFER": "Z-Buffer",
        "GRAPHIC_SETTINGS_DEPTH_BUFFER_DESCRIPTION": "Schaltet den depth buffer on oder aus. Am besten eingeschaltet lassen.",
        "GRAPHIC_SETTINGS_ENABLE_3D_PICKUPS": "3D-Pickups",
        "GRAPHIC_SETTINGS_ENABLE_3D_PICKUPS_DESCRIPTION": "Enables 3D models to be rendered in place of the sprites for pickup items.",
        "GRAPHIC_SETTINGS_ENABLE_BRAID": "Laras Zopf",
        "GRAPHIC_SETTINGS_ENABLE_BRAID_DESCRIPTION": "Aktiviert Laras Zopf.",
        "GRAPHIC_SETTINGS_ENABLE_BREEZE": "Brise",
        "GRAPHIC_SETTINGS_ENABLE_BREEZE_DESCRIPTION": "Aktiviert eine Brise, die Laras Zopf in den richtigen Räumen zum Wehen bringt.",
        "GRAPHIC_SETTINGS_ENABLE_EXIT_FADE_EFFECTS": "Abblenden beim Beenden des Spiels",
        "GRAPHIC_SETTINGS_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION": "Aktiviert die Abblend-Effekte wenn man das Spiel vollständig beendet.",
        "GRAPHIC_SETTINGS_ENABLE_FADE_EFFECTS": "Überganseffekte",
        "GRAPHIC_SETTINGS_ENABLE_FADE_EFFECTS_DESCRIPTION": "Aktiviere Abblenden bei Übergängen, zum Beispiel bei Credits-, Grafikeinstellungs-, Inventar- und Pause-Bildübergängen.",
        "GRAPHIC_SETTINGS_ENABLE_FIRE_LIGHTING": "Feuer-Beleuchtung",
        "GRAPHIC_SETTINGS_ENABLE_FIRE_LIGHTING_DESCRIPTION": "Ermöglicht die generierung von dynamischen Lichteffekten neben aktiven Flammen.",
        "GRAPHIC_SETTINGS_ENABLE_GUN_LIGHTING": "Dynamisches Licht für Waffen",
        "GRAPHIC_SETTINGS_ENABLE_PICKUP_AIDS": "Gegenstände hervorheben",
        "GRAPHIC_SETTINGS_ENABLE_PICKUP_AIDS_DESCRIPTION": "Aktiviert einen periodischen Funkel-Effekt in der Nähe von Items, um ihre Gegenwart sichtbarer zu machen.",
        "GRAPHIC_SETTINGS_ENABLE_PS1_CRYSTALS": "PS1-Kristall-Farbton",
        "GRAPHIC_SETTINGS_ENABLE_PS1_CRYSTALS_DESCRIPTION": "Der Speicherkristall bekommt einen lila Farbton, ähnlich wie bei der PS1-Variante.",
        "GRAPHIC_SETTINGS_ENABLE_ROUND_SHADOW": "Runde Schatten",
        "GRAPHIC_SETTINGS_ENABLE_ROUND_SHADOW_DESCRIPTION": "Aktiviert runde Schatten anstelle der standardmäßig achteckigen Schatten.",
        "GRAPHIC_SETTINGS_ENABLE_SHOTGUN_FLASH": "Schrotflinten-Mündungsfeuer",
        "GRAPHIC_SETTINGS_ENABLE_SHOTGUN_FLASH_DESCRIPTION": "Zeigt Mündungsfeuer an, wenn man mit der Schrotflinte schießt, wie bei anderen Waffen.",
        "GRAPHIC_SETTINGS_ENABLE_SKYBOX": "Skyboxes",
        "GRAPHIC_SETTINGS_ENABLE_SKYBOX_DESCRIPTION": "Aktiviert die Skybox in unterstützten Leveln.",
        "GRAPHIC_SETTINGS_ENABLE_SMOOTH_BARS": "Leisten-Farbverläufe",
        "GRAPHIC_SETTINGS_ENABLE_SMOOTH_BARS_DESCRIPTION": "Sorgt bei Gesundheitsleisten, Sauerstoffleisten und Gesundheitsleisten von Feinden für einen fließenden Farbübergang.",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_COLOR": "Leisten-Farbe der Feinde",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_COLOR_DESCRIPTION": "Gesundheitsleisten-Farbe der Feinde",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_LOCATION": "Position der Gesundheitsleiste der Feinde",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION": "Die Position, an der die feindliche Gesundheitsleiste angezeigt wird.",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_SHOW_MODE": "Gesundheitleiste der Feinde",
        "GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Aktiviert die Anzeige einer Gesundheitleiste für aktive Feinde.",
        "GRAPHIC_SETTINGS_FOG_END": "Ende des Nebels",
        "GRAPHIC_SETTINGS_FOG_END_DESCRIPTION": "Stellt die Distanz in Kacheln ein, in der der Nebel alles völlig verhüllt.",
        "GRAPHIC_SETTINGS_FOG_START": "Beginn des Nebels",
        "GRAPHIC_SETTINGS_FOG_START_DESCRIPTION": "Stellt die Distanz in Kacheln ein, in der der Nebel zu erscheinen beginnt.",
        "GRAPHIC_SETTINGS_FOV": "Field of View",
        "GRAPHIC_SETTINGS_FOV_DESCRIPTION": "Der gewünschte Field of View in Graden, wodurch die hartkodierten Standards überschrieben werden. Die Standardwerte sind 80 (horizontal) und 65 (vertikal).",
        "GRAPHIC_SETTINGS_FOV_VERTICAL": "Vertikales FOV",
        "GRAPHIC_SETTINGS_FOV_VERTICAL_DESCRIPTION": "Interpretiert den Field of View als vertikal anstatt horizontal. Könnte vorteilhaft für Widescreen-Auflösungen sein, besonders wenn man mehrere Bildschirme auf einmal benutzt, weil es das Bild auf der linken und rechten Seite dehnt, statt den oberen und unteren Teil des Bildes abzuschneiden.",
        "GRAPHIC_SETTINGS_FPS": "FPS",
        "GRAPHIC_SETTINGS_FPS_DESCRIPTION": "Stellt Spiel-Frames pro second ein.",
        "GRAPHIC_SETTINGS_HEALTHBAR_COLOR": "Gesundheitsleisten-Farbe",
        "GRAPHIC_SETTINGS_HEALTHBAR_COLOR_DESCRIPTION": "Farbe der Gesundheitsleiste.",
        "GRAPHIC_SETTINGS_HEALTHBAR_LOCATION": "Position der Gesundheitsleiste",
        "GRAPHIC_SETTINGS_HEALTHBAR_LOCATION_DESCRIPTION": "Position, an der die Gesundheitsleiste angezeigt wird.",
        "GRAPHIC_SETTINGS_HEALTHBAR_SHOW_MODE": "Gesundheitsleisten-Modus",
        "GRAPHIC_SETTINGS_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Ändert, wie die Gesundheitsleiste angezeigt wird.\n\n- Standard: Zeigt die Gesundheitsleiste am Anfang des Levels, wenn man getroffen wird oder wenn Waffen gezogen sind; blinkt bei 20% oder darunter.\n- Standard, kein blinken: Das selbe wie bei Standard, nur dass das Blinken deaktiviert ist.\n- Standart oder blinkend: Das selbe wie bei Standard, außer dass sie gezeigt wird, selbst wenn sie blinkt.\n- Nur blinken: Zeigt Laras Gesundheitsleiste *nur* wenn Laras Gesundheit unter 20% ist (für Challange Runs).\n- Immer: zeigt immer die Gesundheitsleiste.\n- Nie: Niemals die Gesundheitsleiste anzeigen (für Challange Runs).",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST": "Beleuchtungs-Kontrast",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_DESCRIPTION": "Erhöht den Kontrast für dynamische Lichtquellen, wie zum Beispiel Fackeln und Mündungsfeuer.",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_HIGH": "Hoch",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_LOW": "Niedrig",
        "GRAPHIC_SETTINGS_LIGHTING_CONTRAST_MEDIUM": "Mittel",
        "GRAPHIC_SETTINGS_MENU_STYLE": "Menü-Stil",
        "GRAPHIC_SETTINGS_MENU_STYLE_DESCRIPTION": "Ändert, wie Menüs dargestellt werden.\n\n - PC: UI-Stil gleicht der PC-Version.\n - PS1: UI-Stil gleicht der PS1-Version.",
        "GRAPHIC_SETTINGS_NEAREST_NEIGHBOR": "Aus",
        "GRAPHIC_SETTINGS_REFLECTIONS": "Reflektionen",
        "GRAPHIC_SETTINGS_REFLECTIONS_DESCRIPTION": "Aktiviert Reflektionen auf bestimmten Objekten.",
        "GRAPHIC_SETTINGS_RENDERING_TAB": "\\{review}Rendern",
        "GRAPHIC_SETTINGS_RENDER_MODE": "Render-Modus",
        "GRAPHIC_SETTINGS_RENDER_MODE_DESCRIPTION": "Schaltet zwischen CPU rendering (langsamer, eher oldschool) oder GPU (schneller und besser) um.",
        "GRAPHIC_SETTINGS_RENDER_MODE_HARDWARE": "Hardware",
        "GRAPHIC_SETTINGS_RENDER_MODE_SOFTWARE": "Software",
        "GRAPHIC_SETTINGS_SCREENSHOT_FORMAT": "Bildschirmfoto-Format",
        "GRAPHIC_SETTINGS_SCREENSHOT_FORMAT_DESCRIPTION": "Dateiformat des Bildschirmfotos.",
        "GRAPHIC_SETTINGS_SCREENSHOT_FORMAT_JPG": "JPG",
        "GRAPHIC_SETTINGS_SCREENSHOT_FORMAT_PNG": "PNG",
        "GRAPHIC_SETTINGS_STATS_LEVEL_HEADER": "Level-Zähler",
        "GRAPHIC_SETTINGS_STATS_LEVEL_HEADER_DESCRIPTION": "Zeigt die aktuelle Level-Nummer ganz oben in den Level-Statistiken an.",
        "GRAPHIC_SETTINGS_STAT_DETAIL_MODE": "Statistik-Details",
        "GRAPHIC_SETTINGS_STAT_DETAIL_MODE_DESCRIPTION": "Erlaubt verschiedene Stufen von Statistik-Details.\n\n- Minimal: Zeigt getötete Gegner, Pickups, Geheimnisse und benötigte Spielzeit.\n- Detailliert: Zeigt alle Statistiken zur minimalen Anzahl der Pickups sowie auch die maximale Anzahl der Pickups und getöteter Gegner in jedem Level an.\n- Vollständig; Zeigt alle Statistiken von Detailiert, zusätzlich noch Schuss-zu-Treffer-Verhältnis, verwendete Munition und Verbände sowie die zurückgelegte Strecke an.",
        "GRAPHIC_SETTINGS_STAT_DETAIL_MODE_DETAILED": "Detailliert",
        "GRAPHIC_SETTINGS_STAT_DETAIL_MODE_FULL": "Voll",
        "GRAPHIC_SETTINGS_STAT_DETAIL_MODE_MINIMAL": "Minimal",
        "GRAPHIC_SETTINGS_TEXTURE_FILTER": "Textur-Filter",
        "GRAPHIC_SETTINGS_TEXTURE_FILTER_DESCRIPTION": "Wechselt zwischen weichgezeichneten und pixeligen Objekt-Texturen.",
        "GRAPHIC_SETTINGS_TITLE": "Grafik Optionen",
        "GRAPHIC_SETTINGS_TRAPEZOID_FILTER": "Trapezoid-Filter",
        "GRAPHIC_SETTINGS_TRAPEZOID_FILTER_DESCRIPTION": "Korrigiert das Rendern von Vierecken.",
        "GRAPHIC_SETTINGS_UI_BAR_SCALE": "Leisten-Größe",
        "GRAPHIC_SETTINGS_UI_BAR_SCALE_DESCRIPTION": "Ändert die Größe der Gesundheitsleisten, Sauerstoffleisten und Gesundheitsleisten von Feinden.",
        "GRAPHIC_SETTINGS_UI_FILTER": "UI-Filter",
        "GRAPHIC_SETTINGS_UI_FILTER_DESCRIPTION": "Schaltet zwischen weichgezeichneten und pixeligen UI-Texturen hin und her.",
        "GRAPHIC_SETTINGS_UI_LANGUAGE": "Sprache",
        "GRAPHIC_SETTINGS_UI_LANGUAGE_DESCRIPTION": "Ändert die Sprache des UI-Textes.",
        "GRAPHIC_SETTINGS_UI_SCROLL_WRAPAROUND": "Scroll-Schleife",
        "GRAPHIC_SETTINGS_UI_SCROLL_WRAPAROUND_DESCRIPTION": "Ermöglicht die Richtungsnavigation in Menüs in einer Schleife.",
        "GRAPHIC_SETTINGS_UI_STYLE_PC": "PC",
