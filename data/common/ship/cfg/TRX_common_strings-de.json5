        "GRAPHIC_SETTINGS_UI_TAB": "\\{review}Oberfläche",
        "GRAPHIC_SETTINGS_UI_TEXT_SCALE": "Textgröße",
        "GRAPHIC_SETTINGS_UI_TEXT_SCALE_DESCRIPTION": "Ändert die Größe des UI-Textes.",
