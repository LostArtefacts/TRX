        "GAMEPLAY_SETTINGS_CAMERA_SPEED": "Kamera-Geschwindigkeit",
        "GAMEPLAY_SETTINGS_CAMERA_SPEED_DESCRIPTION": "Ändert, wie schnell sich die Kamera bewegt.",
        "GAMEPLAY_SETTINGS_CHANGE_PIERRE_SPAWN": "Ändere Pierre Spawn-Modus",
        "GAMEPLAY_SETTINGS_CHANGE_PIERRE_SPAWN_DESCRIPTION": "Erstellt einen gerade erst ausgelösten (flüchtenden) Pierre und ersetzt einen bereits existierenden (flüchtenden) Pierre.",
        "GAMEPLAY_SETTINGS_CONTROLS_TAB": "Steuerung",
        "GAMEPLAY_SETTINGS_DISABLE_HEALING_BETWEEN_LEVELS": "Bleibender Schaden",
        "GAMEPLAY_SETTINGS_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Verhindert, dass Lara beim Starten eines neuen Levels geheilt wird (für \"No Heal Challenge\" Runs).",
        "GAMEPLAY_SETTINGS_DISABLE_MAGNUMS": "Entferne Magnums",
        "GAMEPLAY_SETTINGS_DISABLE_MAGNUMS_DESCRIPTION": "Entfernt alle Magnum Pistolen und Magnum-Munitions-Pickups aus dem Spiel.",
        "GAMEPLAY_SETTINGS_DISABLE_MEDPACKS": "Entferne Medi-Packs",
        "GAMEPLAY_SETTINGS_DISABLE_MEDPACKS_DESCRIPTION": "Entfernt alle Medi-Packs aus dem Spiel (für \"No Meds Challenge\" Runs).",
        "GAMEPLAY_SETTINGS_DISABLE_SHOTGUN": "Entferne Schrotflinte",
        "GAMEPLAY_SETTINGS_DISABLE_SHOTGUN_DESCRIPTION": "Entfernt alle Schrotflinten und Schrotflinten-Munitions-Pickups aus dem Spiel.",
        "GAMEPLAY_SETTINGS_DISABLE_TREX_COLLISION": "Enferne die Kollision des toten T-Rex",
        "GAMEPLAY_SETTINGS_DISABLE_TREX_COLLISION_DESCRIPTION": "Enfernt jegliche Kollision vom T-Rex sobald er stirbt. Dies ist sehr hilfreich, wenn die Leiche eines T-Rex den Ausgang blockiert.",
        "GAMEPLAY_SETTINGS_DISABLE_UZIS": "Entferne Uzis",
        "GAMEPLAY_SETTINGS_DISABLE_UZIS_DESCRIPTION": "Entfernt alle Uzis und Uzi-Munitions-Pickups aus dem Spiel.",
        "GAMEPLAY_SETTINGS_ENABLE_ALLY_TARGETING": "Erlaube das ziehlen auf freundliche Einheiten",
        "GAMEPLAY_SETTINGS_ENABLE_ALLY_TARGETING_DESCRIPTION": "Erlaubt Lara, auf freundliche Einheiten zu ziehlen, wie zum Beispiel Mönche. Wenn diese Option deaktiviert ist, sind freundliche Einheiten immun gegen Laras Munition.",
        "GAMEPLAY_SETTINGS_ENABLE_AUTO_ITEM_SELECTION": "Vorausgewählte Schlüssel-Items",
        "GAMEPLAY_SETTINGS_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "Wenn Lara ein Schlüsselloch oder einen Rätsel-Slot verwendet und sie das dazu passende Item in ihrem Inventar hat, wird dieses automatisch ausgewählt.",
        "GAMEPLAY_SETTINGS_ENABLE_BUFFERING": "Eingabe-Bufferung",
        "GAMEPLAY_SETTINGS_ENABLE_BUFFERING_DESCRIPTION": "Aktiviert mit der F-Taste (1-Frame) und Inventar (2-Frames) Bufferung um ein präzises Steuergefühl für Laras Bewegungen zu erreichen.",
        "GAMEPLAY_SETTINGS_ENABLE_CHEATS": "Cheats",
        "GAMEPLAY_SETTINGS_ENABLE_CHEATS_DESCRIPTION": "Aktiviert verschiedene Cheats:\n\n- L: Beende das Level sofort.\n- I: eine Erhöhung der Anzahl der Munition und Medipacks; und alle plotrelevanten Items des aktuellen Levels.\n- O: Aktiviere Flug-Cheat (in der Luft schwimmen).\n  - GEHEN-Taste: beende Flug-Modus.\n  - WAFFE ZIEHEN-Taste: öffne die nächstgelegene Tür (funktioniert an ein paar Stellen nicht).",
        "GAMEPLAY_SETTINGS_ENABLE_COMPASS_STATS": "Levelstatistiken im Kompass",
        "GAMEPLAY_SETTINGS_ENABLE_COMPASS_STATS_DESCRIPTION": "Aktiviert die Anzeige von Levelstatistiken wenn der Kompass ausgewählt wird.",
        "GAMEPLAY_SETTINGS_ENABLE_CONSOLE": "Konsole",
        "GAMEPLAY_SETTINGS_ENABLE_CONSOLE_DESCRIPTION": "Aktiviert die Entwickler-Konsole.",
        "GAMEPLAY_SETTINGS_ENABLE_CREDITS": "Credits",
        "GAMEPLAY_SETTINGS_ENABLE_CREDITS_DESCRIPTION": "Ermöglicht die Anzeige der Credits nachdem man das Spiel durchgespielt hat. Beeinflusst nicht die Anzeige der Finalen Statistik.",
        "GAMEPLAY_SETTINGS_ENABLE_CUTSCENES": "Zwischensequenzen",
        "GAMEPLAY_SETTINGS_ENABLE_CUTSCENES_DESCRIPTION": "Aktiviert das Abspielen von Zwischensequenzen.",
        "GAMEPLAY_SETTINGS_ENABLE_DEATHS_COUNTER": "Laras Tode zählen",
        "GAMEPLAY_SETTINGS_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Aktiviert die Aufzählung von Laras Toden im Kompass und in den Level-Statistiken. Die Anzahl der Tode wird im aktuell geladenen Speicherstand aktualisiert, sobald sie stirbt.",
        "GAMEPLAY_SETTINGS_ENABLE_DEMO": "Demo-Modus",
        "GAMEPLAY_SETTINGS_ENABLE_DEMO_DESCRIPTION": "Aktiviert die Anzeige von Demos im Hauptmenü.",
        "GAMEPLAY_SETTINGS_ENABLE_ENEMY_ROTATION": "Zufällige Startwinkel für Gegner",
        "GAMEPLAY_SETTINGS_ENABLE_ENEMY_ROTATION_DESCRIPTION": "Verwendet einen zusätzlichen zufälligen Startwinkel für ein paar Gegner, sobald sie initialisiert werden.",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_SAVES": "Speichere Effekte",
        "GAMEPLAY_SETTINGS_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Erweitert Spielstände so das Grafikeffekte, Wasserfall-Nebel, Flammenerzeuger und mehr gespeichert werden, anstatt beim Laden zu verschwinden.",
        "GAMEPLAY_SETTINGS_ENABLE_FMV": "FMVs",
        "GAMEPLAY_SETTINGS_ENABLE_FMV_DESCRIPTION": "Aktiviert das Abspielen von FMVs.",
        "GAMEPLAY_SETTINGS_ENABLE_GAME_MODES": "Spielmodi-Auswahl",
        "GAMEPLAY_SETTINGS_ENABLE_GAME_MODES_DESCRIPTION": "Erlaubt die Auswahl der 'Neues Spiel Plus'-Optionen im 'Neues Spiel' Ausweis-Menü.\n\n- Neues Spiel+: schaltet alle Waffen mit unendlich Munition frei; Feinde haben verdoppelte Lebenserenergie.\n- Japanisch NS: Waffen verursachen doppelten Schaden und Fackel-Pickups enhalten 8 statt 6 Fackeln.\n- Japanisch NS+: eine Kombination aus Neus Spiel+ und Japanisch NS.",
        "GAMEPLAY_SETTINGS_ENABLE_INVERTED_LOOK": "Invertiertes Umsehen",
        "GAMEPLAY_SETTINGS_ENABLE_INVERTED_LOOK_DESCRIPTION": "Invertiert die Y-Axe von Laras Sichtsteuerung.",
        "GAMEPLAY_SETTINGS_ENABLE_ITEM_EXAMINING": "Item-Untersuchung",
        "GAMEPLAY_SETTINGS_ENABLE_ITEM_EXAMINING_DESCRIPTION": "Für benutzergenerierte Level - erlaubt die Anzeige von Item-Beschreibungen im Inventar, wenn der Ersteller des Levels die nötigen Daten zur Verfügung gestellt hat.",
        "GAMEPLAY_SETTINGS_ENABLE_JUMP_TWISTS": "Sprungdrehungen",
        "GAMEPLAY_SETTINGS_ENABLE_JUMP_TWISTS_DESCRIPTION": "Aktiviert TR2+-artige Sprungdrehungen und Purzelbäume, das heißt: Drücke Rolle während des Sprungs und Kopfsprung-Animationen.",
        "GAMEPLAY_SETTINGS_ENABLE_LEAN_JUMPING": "Schmales Springen",
        "GAMEPLAY_SETTINGS_ENABLE_LEAN_JUMPING_DESCRIPTION": "Erlaubt Lara, sich weiter voran oder rückwärts zu tasten, wenn man eine der Richtungstasten gedrückt hält, während sie einen neutralen Sprung ausführt.",
        "GAMEPLAY_SETTINGS_ENABLE_LEGAL": "Rechtshinweise",
        "GAMEPLAY_SETTINGS_ENABLE_LEGAL_DESCRIPTION": "Aktiviert die Rechtshinweise und die Core Design FMV beim Starten des Spiels.",
        "GAMEPLAY_SETTINGS_ENABLE_LOADING_SCREENS": "Ladebildschirme",
        "GAMEPLAY_SETTINGS_ENABLE_LOADING_SCREENS_DESCRIPTION": "Aktiviert PS1-artige Ladebildschirme vor jedem Level.",
        "GAMEPLAY_SETTINGS_ENABLE_RESPONSIVE_PASSPORT": "Reaktionsfähiger Ausweis",
        "GAMEPLAY_SETTINGS_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Deaktiviert, dass man die Umblättern-Animation des Ausweises abwarten muss, sie können nun so schnell umblättern, wie sie wollen.",
        "GAMEPLAY_SETTINGS_ENABLE_SAVE_CRYSTALS": "Speicherkristalle",
        "GAMEPLAY_SETTINGS_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Beschränkt Speichern auf den Anfang des Levels und Speicherkristalle. Level haben eine limitierte Anzahl von Speicherkristallen. Die Speicherkristalle funktionieren nur einmal, so wie auf der PS1. Eine Änderung dieser Option erfordert einen Neustart.",
        "GAMEPLAY_SETTINGS_ENABLE_SMOOTH_WALL_DEFLECT": "Sanftes Wand-Abprallen",
        "GAMEPLAY_SETTINGS_ENABLE_SMOOTH_WALL_DEFLECT_DESCRIPTION": "Erlaubt Lara, sich schneller zu fangen, nachdem sie gegen eine Wand gestoßen ist und eine der Richtungstasten zusammen mit der Vorwärtstaste gedrückt gehalten wird..",
        "GAMEPLAY_SETTINGS_ENABLE_STEP_ROLL_BOOST": "Step roll boost",
        "GAMEPLAY_SETTINGS_ENABLE_STEP_ROLL_BOOST_DESCRIPTION": "Allows Lara to be boosted off a one-click high step if roll is pressed near the edge.",
        "GAMEPLAY_SETTINGS_ENABLE_SWING_CANCEL": "Schwingen unterbrechen",
        "GAMEPLAY_SETTINGS_ENABLE_SWING_CANCEL_DESCRIPTION": "Erlaubt, Laras Kanten-Schwinganimation abzubrechen, indem man kurz loslässt und sich schnell wieder festhält.",
        "GAMEPLAY_SETTINGS_ENABLE_TARGET_CHANGE": "Zielwechsel",
        "GAMEPLAY_SETTINGS_ENABLE_TARGET_CHANGE_DESCRIPTION": "Ermöglicht TR4+ artiges wechseln zwischen den Zielen, während man mit den Waffen auf sie zielt. Drücke die Zielwechsel-Taste während des ziehlens, um das anvisierte Ziel zu wechseln.",
        "GAMEPLAY_SETTINGS_ENABLE_TIMER_IN_INVENTORY": "Timer zählt im Inventar",
        "GAMEPLAY_SETTINGS_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION": "Lässt den In-Game-Timer weiterlaufen, selbst wenn während des Spiels das Inventar geöffnet ist.",
        "GAMEPLAY_SETTINGS_ENABLE_TOTAL_STATS": "Finale Statistik-Anzeige",
        "GAMEPLAY_SETTINGS_ENABLE_TOTAL_STATS_DESCRIPTION": "Aktiviert die Erstellung einer Gesamtstatistik vom ganzen Spiel, die nach dem Abspielen der Credits angezeigt wird.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_JUMPING": "Reaktionsschnelleres Springen",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_JUMPING_DESCRIPTION": "Erlaubt Lara, während des Rennens jederzeit zu springen, ähnlich wie in TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIMMING": "Flüssiges Schwimmverhalten",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIMMING_DESCRIPTION": "Verpasst Laras Drehgeschwindigkeit unter Wasser eine Beschleunigungskurve für ein runderes Steuerungsverhalten, ähnlich wie in TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIM_CANCEL": "Reaktionsschneller Schwimm-Abbruch",
        "GAMEPLAY_SETTINGS_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION": "Erlaubt Lara, unter Wasser schneller stoppen zu können, wenn die Springen-Taste losgelassen wird, ähnlich wie in TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_TR3_SIDESTEPS": "Erweiterte Seit-Schritte",
        "GAMEPLAY_SETTINGS_ENABLE_TR3_SIDESTEPS_DESCRIPTION": "Aktiviert Seitschritte im Stil von TR3+, e. g. Shift + Richtungspfeile. Deaktiviert die Seitschritt-Tasten.",
        "GAMEPLAY_SETTINGS_ENABLE_UW_ROLL": "Rolle unter Wasser",
        "GAMEPLAY_SETTINGS_ENABLE_UW_ROLL_DESCRIPTION": "Erlaubt Lara, eine Rolle unter Wasser durchzuführen, ähnlich wie in TR2+.",
        "GAMEPLAY_SETTINGS_ENABLE_WADING": "Durchwaten",
        "GAMEPLAY_SETTINGS_ENABLE_WADING_DESCRIPTION": "Erlaubt Lara, flaches Wasser zu durchwaten, ähnlich wie in TR2+, anstatt an der Wasseroberfläche stecken zu bleiben.",
        "GAMEPLAY_SETTINGS_ENABLE_WALK_TO_ITEMS": "Animierte Interaktionen",
        "GAMEPLAY_SETTINGS_ENABLE_WALK_TO_ITEMS_DESCRIPTION": " Lässt Lara zu Pickups und Schaltern hingehen, anstatt sie zu ihnen zu teleportieren.",
        "GAMEPLAY_SETTINGS_FIXES_TAB": "Fixes",
        "GAMEPLAY_SETTINGS_FIX_ALLIGATOR_AI": "Fix: Alligator-AI",
        "GAMEPLAY_SETTINGS_FIX_ALLIGATOR_AI_DESCRIPTION": "Fixt, dass die Alligatoren keinen Schaden machen, wenn Lara sich im Wasser befindet und sich nicht bewegt.",
        "GAMEPLAY_SETTINGS_FIX_ANIMATED_SPRITES": "Fix: Sprite-Animationen",
        "GAMEPLAY_SETTINGS_FIX_ANIMATED_SPRITES_DESCRIPTION": "Fixt originale Fehler in Die Zisterne und Grab des Tihocan, bei denen Pflanzen-Sprites in Wassergebieten nicht animiert sind.",
        "GAMEPLAY_SETTINGS_FIX_BEAR_AI": "Fix: Bären-AI",
        "GAMEPLAY_SETTINGS_FIX_BRIDGE_COLLISION": "Fix: Brückenkollision",
        "GAMEPLAY_SETTINGS_FIX_BRIDGE_COLLISION_DESCRIPTION": "Fixt, dass Lara nicht in der Lage ist, sich an einigen Teilen von Brücken festzuhalten und unsichtbare Wände an den Kanten. Fixt auch Kollisions-Fehler mit Zugbrücken, Falltüren, und Brücken, wenn sie übereinander gestapelt sind, über Schrägen, und nahe dem Boden.",
        "GAMEPLAY_SETTINGS_FIX_DESCENDING_GLITCH": "Fix: Zerbrechliche Böden-Stürze",
        "GAMEPLAY_SETTINGS_FIX_DESCENDING_GLITCH_DESCRIPTION": "Fixt, dass Seit-Schritte und Vorwärtslaufen auf zerbrechlichen Platten dazu führen, dass Lara sofort herab zur darunter liegenden Platte fällt.",
        "GAMEPLAY_SETTINGS_FIX_FLARE_THROW_PRIORITY": "Fix: Fackel-Wurf-Priorität",
        "GAMEPLAY_SETTINGS_FIX_FLARE_THROW_PRIORITY_DESCRIPTION": "Fixt, dass Lara das Wegwerfen einer aufgebrauchten Fackel priorisiert, während sie sich in der Luft befindet. Dies kann manchmal dazu führen, dass sie nicht in der Lage ist, sich an Kanten festzuhalten.",
        "GAMEPLAY_SETTINGS_FIX_FLOOR_DATA_ISSUES": "Fix: Floor-Data-Fehler",
        "GAMEPLAY_SETTINGS_FIX_FLOOR_DATA_ISSUES_DESCRIPTION": "Fixt originale Fehler mit Boden Daten/Triggern.",
        "GAMEPLAY_SETTINGS_FIX_FREE_FLARE_GLITCH": "Fix: gratis Fackel-Glitch",
        "GAMEPLAY_SETTINGS_FIX_FREE_FLARE_GLITCH_DESCRIPTION": "Fixt die Möglichkeit, eine gratis Fackel zu erschaffen, wenn man während des Aufhebens eines Gegenstandes die Fackel-Taste drückt.",
        "GAMEPLAY_SETTINGS_FIX_GLIDE_CAMERAS": "Fix: Gleitkameras",
        "GAMEPLAY_SETTINGS_FIX_GLIDE_CAMERAS_DESCRIPTION": "Fixt, dass Gleitkameras die in den Level-Triggern gesetzten Timer beachten, anstatt die Geschwindigkeit nach dem ersten Frame auf Standard zurückzusetzen.",
        "GAMEPLAY_SETTINGS_FIX_ITEM_DUPLICATION_GLITCH": "Fix: Item-Vervielfältigungs-Glitch",
        "GAMEPLAY_SETTINGS_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION": "Fixt die Möglichkeit, Schlüsselgegenstände im Inventar mehrfach nutzen zu können.",
        "GAMEPLAY_SETTINGS_FIX_ITEM_ROTS": "Fix: Item-Rotations-Fehler",
        "GAMEPLAY_SETTINGS_FIX_ITEM_ROTS_DESCRIPTION": "Fixt originale Fehler mit einigen falsch rotierenden Pickups, wenn man die 3D-Pickups-Option verwendet.",
        "GAMEPLAY_SETTINGS_FIX_M16_ACCURACY": "Fix: M16-Genauigkeit",
        "GAMEPLAY_SETTINGS_FIX_M16_ACCURACY_DESCRIPTION": "Fixt die Genauigkeit des M16, während Lara rennt.",
        "GAMEPLAY_SETTINGS_FIX_PICKUP_DRIFT_GLITCH": "Fix: Abdrift-Glitch beim Aufheben",
        "GAMEPLAY_SETTINGS_FIX_PICKUP_DRIFT_GLITCH_DESCRIPTION": "Fixt, dass Lara, während sie unter Wasser Items aufhebt, abdriftet, was sie in Wände drücken kann.",
        "GAMEPLAY_SETTINGS_FIX_QWOP_GLITCH": "Fix: QWOP-Glitch",
        "GAMEPLAY_SETTINGS_FIX_QWOP_GLITCH_DESCRIPTION": "Fixt, dass Lara auf kleinen Stufen springt, was manchmal in einer seltsamen Lauf-Animation resultiert, bekannt als QWOP-Zustand.",
        "GAMEPLAY_SETTINGS_FIX_SHOTGUN_TARGETING": "Verbessertes ziehlen mit Schrotflinte",
        "GAMEPLAY_SETTINGS_FIX_STEP_GLITCH": "Fix: Stufen-Glitch",
        "GAMEPLAY_SETTINGS_FIX_STEP_GLITCH_DESCRIPTION": "Fixt, dass Lara manchmal in Wände, die an Treppen angrenzen, gedrückt wird, wenn sie auf eine bestimmte Weise an ihnen entlangläuft.",
        "GAMEPLAY_SETTINGS_FIX_TEXTURE_ISSUES": "Fix: Textur-Fehler",
        "GAMEPLAY_SETTINGS_FIX_TEXTURE_ISSUES_DESCRIPTION": "Fixt originale Fehler mit fehlenden oder inkorrekten Texturen/Meshes.",
        "GAMEPLAY_SETTINGS_FIX_TIHOCAN_SECRET_SOUND": "Fix: Falsch abspielender Sound",
        "GAMEPLAY_SETTINGS_FIX_TIHOCAN_SECRET_SOUND_DESCRIPTION": "Verhindert, dass der Geheimnis-Ton inkorrekterweise abgespielt wird, wenn man den Goldenen Schlüssel im Grab von Tihocan benutzt.",
        "GAMEPLAY_SETTINGS_FIX_WADE_WALL_HIT": "Fix: Wand-Treffer beim Waten",
        "GAMEPLAY_SETTINGS_FIX_WADE_WALL_HIT_DESCRIPTION": "Fixt, dass Lara beim waten nicht reagiert, wenn sie eine Wand trifft.",
        "GAMEPLAY_SETTINGS_FIX_WALK_RUN_JUMP": "Fix: Gehen-Laufen-Sprung",
        "GAMEPLAY_SETTINGS_FIX_WALK_RUN_JUMP_DESCRIPTION": "Fixt, dass Lara manchmal nicht sofort springen kann, direkt nachdem sie von ihrer Gehen-Animation zur Laufen-Animation wechselt.",
        "GAMEPLAY_SETTINGS_FIX_WATER_EXIT": "Wasser Ausstieg",
        "GAMEPLAY_SETTINGS_FIX_WATER_EXIT_DESCRIPTION": "Fixt dass Lara direkt in einen angrenzenden, trockenen Raum oder in einen trockenen Raum unterhalb gelangen kann. Zusätzlich verhindert es, dass Lara aus dem Wasser heraus auf nicht begehbare Schrägen klettern kann.",
        "GAMEPLAY_SETTINGS_GENERAL_TAB": "Allgemeines",
        "GAMEPLAY_SETTINGS_HARPOON_RECOIL": "Harpunenrückstoß",
        "GAMEPLAY_SETTINGS_HARPOON_RECOIL_DESCRIPTION": "Legt fest, wie oft Lara die Harpune nachladen muss, basierend auf ihrer momentanen Munitionsanzahl. Zum Beispiel, wenn es auf 3 festgelegt ist, muss sie nach jedem dritten Schuss nachladen. Auf 0 eingestellt, deaktiviert das Nachladen vollständig.",
        "GAMEPLAY_SETTINGS_JUMP_LOCK_DISABLED": "Deaktiviert",
        "GAMEPLAY_SETTINGS_JUMP_LOCK_LEGACY": "Original",
        "GAMEPLAY_SETTINGS_JUMP_LOCK_MODE": "Sprung-Block Modus",
        "GAMEPLAY_SETTINGS_JUMP_LOCK_MODE_DESCRIPTION": "Erlaubt einzustellen, wie früh es Lara erlaubt ist zu springen, nachdem sie begonnen hat zu laufen.\n\n- Original: entspricht dem originalen TR2 Timing.\n- Getuned: springen ist 2 Frames früher möglich.\n- Deaktiviert: springen ist sofort nachdem die Laufen-Animation begonnen hat möglich.",
        "GAMEPLAY_SETTINGS_JUMP_LOCK_TUNED": "Getuned",
        "GAMEPLAY_SETTINGS_LOAD_MUSIC_TRIGGERS": "Fix: Trigger für Musik, die nur einmal spielen soll",
        "GAMEPLAY_SETTINGS_LOAD_MUSIC_TRIGGERS_DESCRIPTION": "Lädt vorher getriggerte Musik, so dass Musik, die nur einmal spielen soll, nicht ein weiteres Mal abgespielt wird.",
        "GAMEPLAY_SETTINGS_LOOK_MODE": "Umsehen Modus",
        "GAMEPLAY_SETTINGS_LOOK_MODE_DESCRIPTION": "Erlaubt einzustellen wann Lara in der Lage ist sich umzusehen.\n\n- Beschränkt: Umsehen ist nur möglich wenn Lara still steht, und nie wenn man unter Wasser ist.\n- Erweitert: Umsehen ist während der meisten Animationen möglich, ausser ein paar Ausnahmen wie das Schieben eines Blockes.\n- Unbeschränkt: Umsehen ist jederzeit während der normalen Steuerung von Lara möglich.",
        "GAMEPLAY_SETTINGS_LOOK_MODE_ENHANCED": "Erweitert",
        "GAMEPLAY_SETTINGS_LOOK_MODE_RESTRICTED": "Beschränkt",
        "GAMEPLAY_SETTINGS_LOOK_MODE_UNRESTRICTED": "Unbeschränkt",
        "GAMEPLAY_SETTINGS_MAXIMUM_SAVE_SLOTS": "Anzahl der Speicher-Slots",
        "GAMEPLAY_SETTINGS_MAXIMUM_SAVE_SLOTS_DESCRIPTION": "Ändert die Anzahl der verfügbaren Speicher-Slots.",
        "GAMEPLAY_SETTINGS_MODS_TAB": "Mods",
        "GAMEPLAY_SETTINGS_QUICK_GUNS_MODE": "Schnell-Zieh-Tasten",
        "GAMEPLAY_SETTINGS_QUICK_GUNS_MODE_DESCRIPTION": "Bestimmt das Verhalten der Schnell-Zieh-Tasten.\n\n- Nur ziehen: eine der Tasten zu drücken sorgt dafür, dass Lara die zugewiesene Waffe ausrüstet.\n- Ziehen oder wegstecken: das selbe wie bei 'Nur Ziehen', zusätzlich wird Lara die zugewiesene Waffe, die sie gerade benutzt, wegstecken.",
        "GAMEPLAY_SETTINGS_QUICK_GUNS_MODE_DRAW_AND_HOLSTER": "Ziehen oder wegstecken",
        "GAMEPLAY_SETTINGS_QUICK_GUNS_MODE_DRAW_ONLY": "Nur ziehen",
        "GAMEPLAY_SETTINGS_REMEMBER_GUNS_BETWEEN_LEVELS": "Waffen zwischen den Leveln merken",
        "GAMEPLAY_SETTINGS_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION": "Bringt Lara dazu, sich zu erinern, welche Waffe sie als Letztes im vorherigen Level verwendet hat, wenn ein neues Level beginnt. Bei Deaktivierung, wird Lara auf Pistolen zurückgreifen.",
        "GAMEPLAY_SETTINGS_RESTORE_PS1_ENEMIES": "PS1 Feinde wiederherstellen",
        "GAMEPLAY_SETTINGS_RESTORE_PS1_ENEMIES_DESCRIPTION": "Fügt die Mumie in Raum 25 ein, welche in der Playstation-Version von City of Khamoon erscheint.\nEine Veränderung dieser Option erfordert einen Neustart des Levels.",
        "GAMEPLAY_SETTINGS_START_LARA_HITPOINTS": "Laras Lebensenergie beim Starten eines Levels",
        "GAMEPLAY_SETTINGS_START_LARA_HITPOINTS_DESCRIPTION": "Legt die Höhe des Gesundheitswertes von Lara für den Start eines jeden Levels fest.",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_FULL": "Full lock",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_NONE": "No lock",
        "GAMEPLAY_SETTINGS_TARGET_LOCK_MODE_SEMI": "Semi lock",
        "GAMEPLAY_SETTINGS_TARGET_MODE": "Weapon lock mode",
        "GAMEPLAY_SETTINGS_TARGET_MODE_DESCRIPTION": "Changes the behavior how weapons lock onto targets.\n\n- Full lock: always keep target lock even if the enemy moves out of sight or dies (OG TR1).\n- Semi lock: keep target lock if the enemy moves out of sight but lose target lock if the enemy dies.\n- No lock: lose target lock if the enemy goes out of sight or dies (TR4+).",
        "GAMEPLAY_SETTINGS_TITLE": "Gameplay-Optionen",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_FIXED": "Gefixt",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_MODE": "Wand-Glitch Ein/Aus",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_MODE_DESCRIPTION": "Erlaubt, das Wand-Glitchverhalten von TR1 zu nutzen und umgekehrt; gleichermaßen erlaubt es, alle Arten von Wand-Glitches zu fixen.",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_TR1": "TR1",
        "GAMEPLAY_SETTINGS_WALL_GLITCH_TR2": "TR2",
        "GRAPHIC_SETTINGS_AIRBAR_COLOR": "Sauerstoffleistenfarbe",
        "GRAPHIC_SETTINGS_AIRBAR_COLOR_DESCRIPTION": "Farbe der Sauerstoffleiste.",
        "GRAPHIC_SETTINGS_AIRBAR_LOCATION": "Position der Sauerstoffleiste",
        "GRAPHIC_SETTINGS_AIRBAR_LOCATION_DESCRIPTION": "Position, an der die Sauerstoffleiste angezeigt wird.",
        "GRAPHIC_SETTINGS_AIRBAR_SHOW_MODE": "Sauerstoffleisten-Modus",
        "GRAPHIC_SETTINGS_AIRBAR_SHOW_MODE_DESCRIPTION": "Ändert, wie die Sauerstoffleiste angezeigt wird.\n\n- Standard: Zeigt die Sauerstoffleiste nur im Wasser und sie blinkt, wenn Laras Sauerstoffleiste bei 20% oder niedriger ist.\n- Standard, kein Blinken: Das selbe wie bei Standard, nur dass das Blinken deaktiviert ist.\n- Nur blinken: Zeigt die Sauerstoffleiste nur dann, wenn Laras Sauerstoff bei 20% oder darunter ist.\n- Nie: Niemals die Sauerstoffleiste anzeigen (für Challange Runs).",
        "GRAPHIC_SETTINGS_ALLY_HEALTHBAR_COLOR": "Freundliche Einheiten-Leisten Farbe",
        "GRAPHIC_SETTINGS_ALLY_HEALTHBAR_COLOR_DESCRIPTION": "Farbe für die Gusundheitsleisten freundlich gesinnter Einheiten. Wird auf der gleiche Position angezeigt wie die Gesundheitsleisten der Feinde.",
        "GRAPHIC_SETTINGS_ANISOTROPY_FILTER": "Anisotropischer Filter",
        "GRAPHIC_SETTINGS_ANISOTROPY_FILTER_DESCRIPTION": "Erwiterte Textur-Filterung auf Entfernung.",
        "GRAPHIC_SETTINGS_ASPECT_MODE": "Seitenverhältnis",
        "GRAPHIC_SETTINGS_ASPECT_MODE_16_10": "16:10",
        "GRAPHIC_SETTINGS_ASPECT_MODE_16_9": "16:9",
        "GRAPHIC_SETTINGS_ASPECT_MODE_4_3": "4:3",
        "GRAPHIC_SETTINGS_ASPECT_MODE_ANY": "\\{review}Auto",
        "GRAPHIC_SETTINGS_ASPECT_MODE_DESCRIPTION": "Erzwingt bestimmte Seitenverhältnisse mit Letterbox.",
