        "SETTING_AIRBAR_COLOR": "Colore barra ossigeno",
        "SETTING_AIRBAR_COLOR_DESCRIPTION": "Colore utilizzato per la barra dell'ossigeno.",
        "SETTING_AIRBAR_LOCATION": "Posizione barra ossigeno",
        "SETTING_AIRBAR_LOCATION_DESCRIPTION": "Posizione in cui viene visualizzata la barra dell'ossigeno.",
        "SETTING_ALLY_HEALTHBAR_COLOR": "Colore barra alleati",
        "SETTING_ALLY_HEALTHBAR_COLOR_DESCRIPTION": "Colore utilizzato per la barra della salute degli alleati. La barra viene mostrata nella stessa posizione della barra della salute dei nemici.",
        "SETTING_ALLY_HOSTILITY_POLICY": "\\{review}Politica di ostilità degli alleati",
        "SETTING_ALLY_HOSTILITY_POLICY_DESCRIPTION": "\\{review}Controlla come le unità amiche reagiscono quando subiscono danni.\n\n- Individuale: ogni alleato cambia ostilità autonomamente (stile TR3).\n- Condiviso: tutti gli alleati diventano ostili insieme (stile monaco TR2).",
        "SETTING_AMBIENT_VOLUME": "Volume ambientale",
        "SETTING_AMBIENT_VOLUME_DESCRIPTION": "Regola il volume dei suoni ambientali.",
        "SETTING_ANISOTROPY_FILTER": "Filtro anisotropico",
        "SETTING_ANISOTROPY_FILTER_DESCRIPTION": "Migliora il filtraggio delle texture a distanza.",
        "SETTING_ASPECT_MODE": "Rapporto d'aspetto",
        "SETTING_ASPECT_MODE_DESCRIPTION": "Forza determinati rapporti d'aspetto del gioco con barre nere ai bordi.",
        "SETTING_BAR_LOOK": "Aspetto barre",
        "SETTING_BAR_LOOK_DESCRIPTION": "Controlla l'aspetto visivo delle barre dell'interfaccia utente.",
        "SETTING_BORDERS": "Bordi",
        "SETTING_BORDERS_DESCRIPTION": "Aggiunge dei bordi neri attorno alla finestra del gioco.",
        "SETTING_CAMERA_MODE": "Modalità telecamera",
        "SETTING_CAMERA_MODE_DESCRIPTION": "Regola il comportamento della telecamera durante azioni come l'uso degli oggetti chiave.",
        "SETTING_CAMERA_SPEED": "Velocità telecamera",
        "SETTING_CAMERA_SPEED_DESCRIPTION": "Modifica la velocità di movimento della telecamera manuale.",
        "SETTING_CHANGE_PIERRE_SPAWN": "Modifica generazione Pierre",
        "SETTING_CHANGE_PIERRE_SPAWN_DESCRIPTION": "Fa in modo che, alla sua generazione, un Pierre (in fuga) sostituisca un altro Pierre (in fuga) già esistente.",
        "SETTING_CUTSCENE_VOLUME": "Volume scene di intermezzo",
        "SETTING_CUTSCENE_VOLUME_DESCRIPTION": "Regola il volume delle scene di intermezzo presenti nel gioco.",
        "SETTING_DISABLE_EXTRA_GUNS": "Rimuovi armi extra",
        "SETTING_DISABLE_EXTRA_GUNS_DESCRIPTION": "Rimuove tutte le armi e le relative munizioni dal gioco tranne le pistole (per le sfide con solo pistole).",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS": "Danni persistenti",
        "SETTING_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION": "Lara non guarisce quando inizia un nuovo livello (per le sfide).",
        "SETTING_DISABLE_MEDPACKS": "Rimuovi i kit medici",
        "SETTING_DISABLE_MEDPACKS_DESCRIPTION": "Rimuove tutti i kit medici dal gioco (per le sfide).",
        "SETTING_DISABLE_TREX_COLLISION": "Rimuovi collisione T-Rex morto",
        "SETTING_DISABLE_TREX_COLLISION_DESCRIPTION": "Rimuove tutte le collisioni con il T-Rex dopo la sua dipartita. Utile quando il corpo del T-Rex blocca il passaggio.",
        "SETTING_ENABLE_3D_PICKUPS": "Oggetti 3D",
        "SETTING_ENABLE_3D_PICKUPS_DESCRIPTION": "Sostituisce gli oggetti recuperabili 2D con i rispettivi modelli 3D.",
        "SETTING_ENABLE_ALLY_TARGETING": "Consenti fuoco amico",
        "SETTING_ENABLE_ALLY_TARGETING_DESCRIPTION": "Permette a Lara di colpire gli alleati, come i monaci. Se disabilitato, gli alleati saranno immuni alle munizioni di Lara.",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION": "Preselezione oggetti chiave",
        "SETTING_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION": "Quando Lara preme azione contro un buco della serratura o un altro ricettacolo e ha l'oggetto corrispondente nell'inventario, quell'oggetto verrà preselezionato.",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE": "\\{review}Inciampo su pendenza all’indietro",
        "SETTING_ENABLE_BACK_SLOPE_STUMBLE_DESCRIPTION": "\\{review}Fa inciampare Lara se salta all’indietro e c’è una pendenza dietro di lei (TR3). Se disattivato, Lara si arresta bruscamente contro la pendenza (TR1/2).",
        "SETTING_ENABLE_BAR_FLASHING": "Barre lampeggianti",
        "SETTING_ENABLE_BAR_FLASHING_DESCRIPTION": "Fa in modo che le barre della salute e dell'ossigeno di Lara lampeggino quando stanno per esaurirsi.",
        "SETTING_ENABLE_BOULDER_SHAKE": "\\{review}Attiva vibrazione massi",
        "SETTING_ENABLE_BOULDER_SHAKE_DESCRIPTION": "\\{review}Se attivata, la telecamera vibrerà quando un masso è in movimento.",
        "SETTING_ENABLE_BOUNCY_GRENADES": "\\{review}Granate rimbalzanti",
        "SETTING_ENABLE_BOUNCY_GRENADES_DESCRIPTION": "\\{review}Abilita il comportamento delle granate in stile TR3: rimbalzano su muri e pendii e producono un raggio d'esplosione più ampio, ma a scapito di una velocità ridotta.",
        "SETTING_ENABLE_BRAID": "Treccia di Lara",
        "SETTING_ENABLE_BRAID_DESCRIPTION": "Abilita la treccia di Lara.",
        "SETTING_ENABLE_BREEZE": "Brezza",
        "SETTING_ENABLE_BREEZE_DESCRIPTION": "Abilita l'effetto brezza sulla treccia di Lara nelle stanze appropriate.",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS": "Buffering (tasti funzione)",
        "SETTING_ENABLE_BUFFERING_FUNC_KEYS_DESCRIPTION": "Abilita il buffering dei tasti funzione (1 fotogramma) per ottenere un controllo preciso dei movimenti di Lara. Questa funzione esisteva originariamente solo nella versione TombATI (TR1).",
        "SETTING_ENABLE_BUFFERING_INVENTORY": "Buffering (inventario)",
        "SETTING_ENABLE_BUFFERING_INVENTORY_DESCRIPTION": "Abilita il buffering dell'inventario (2 fotogrammi) per ottenere un controllo preciso dei movimenti di Lara.",
        "SETTING_ENABLE_CHEATS": "Trucchi",
        "SETTING_ENABLE_CHEATS_DESCRIPTION": "Abilita vari trucchi:\n\n- L: termina immediatamente il livello.\n- I: dà a Lara tutte le armi; maggior quantità di munizioni e kit medici; tutti gli oggetti necessari per superare il livello.\n- O: abilita il trucco DOZY (nuotare a mezz'aria).\n  - tasto CAMMINA: disabilita il trucco DOZY.\n  - tasto ESTRAI ARMA: apre la porta più vicina (non funziona in certi casi).",
        "SETTING_ENABLE_COMPASS_STATS": "Statistiche livello bussola",
        "SETTING_ENABLE_COMPASS_STATS_DESCRIPTION": "Abilita la visualizzazione delle statistiche del livello quando è selezionata la bussola.",
        "SETTING_ENABLE_CONSOLE": "Console",
        "SETTING_ENABLE_CONSOLE_DESCRIPTION": "Abilita la console per sviluppatori.",
        "SETTING_ENABLE_CONTROLLED_DROPS": "Cadute controllate",
        "SETTING_ENABLE_CONTROLLED_DROPS_DESCRIPTION": "Permette a Lara di ruotare a mezz'aria e afferrare la sporgenza della superficie da cui è appena scivolata, se durante la caduta viene premuto il tasto Azione.",
        "SETTING_ENABLE_CRAWL_JUMP": "\\{review}Salto in uscita dal cunicolo",
        "SETTING_ENABLE_CRAWL_JUMP_DESCRIPTION": "\\{review}Consente a Lara di saltare fuori dagli spazi angusti.",
        "SETTING_ENABLE_CREDITS": "Titoli di coda",
        "SETTING_ENABLE_CREDITS_DESCRIPTION": "Abilita i titoli di coda mostrati dopo aver completato il gioco. Non influisce sulla schermata finale delle statistiche.",
        "SETTING_ENABLE_CROUCH_ROLL": "\\{review}Capriola accovacciata",
        "SETTING_ENABLE_CROUCH_ROLL_DESCRIPTION": "\\{review}Permette a Lara di eseguire una capriola in avanti da accovacciata premendo sprint.",
        "SETTING_ENABLE_CUTSCENES": "Scene di intermezzo",
        "SETTING_ENABLE_CUTSCENES_DESCRIPTION": "Abilita la riproduzione delle scene di intermezzo.",
        "SETTING_ENABLE_DEATHS_COUNTER": "Conta morti di Lara",
        "SETTING_ENABLE_DEATHS_COUNTER_DESCRIPTION": "Permette di mostrare il conteggio delle morti nella bussola e nelle statistiche del livello. Il conteggio delle morti viene aggiornato nel salvataggio attualmente caricato ogni volta che Lara muore.",
        "SETTING_ENABLE_DEMO": "Modalità demo",
        "SETTING_ENABLE_DEMO_DESCRIPTION": "Abilita la riproduzione delle demo nel menu principale.",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME": "\\{review}Tempo infinito delle torce",
        "SETTING_ENABLE_ENDLESS_FLARE_TIME_DESCRIPTION": "\\{review}Impedisce alle torce portatili di spegnersi mai. Le torce lanciate si spegneranno comunque normalmente.",
        "SETTING_ENABLE_ENDLESS_SPRINT": "\\{review}Corsa infinita",
        "SETTING_ENABLE_ENDLESS_SPRINT_DESCRIPTION": "\\{review}Impedisce a Lara di stancarsi mai durante la corsa. Gli ostacoli la fermeranno comunque.",
        "SETTING_ENABLE_ENEMY_ROTATION": "Rotazione nemici casuale",
        "SETTING_ENABLE_ENEMY_ROTATION_DESCRIPTION": "Applica una rotazione casuale aggiuntiva ad alcuni nemici quando vengono inizializzati.",
        "SETTING_ENABLE_ENHANCED_SAVES": "Salva gli effetti",
        "SETTING_ENABLE_ENHANCED_SAVES_DESCRIPTION": "Migliora il sistema di salvataggio in modo che gli effetti grafici, la foschia delle cascate, gli emettitori di fiamme e altro vengano salvati invece di scomparire dopo il caricamento della partita.",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS": "Dissolvenza in uscita",
        "SETTING_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION": "Abilita l'effetto di dissolvenza quando si esce dal gioco.",
        "SETTING_ENABLE_FADE_EFFECTS": "Effetti di dissolvenza",
        "SETTING_ENABLE_FADE_EFFECTS_DESCRIPTION": "Abilita le transizioni in dissolvenza, ad esempio tra le immagini dei titoli di coda o per le transizioni tra le schermate di inventario e pausa.",
        "SETTING_ENABLE_FIRE_LIGHTING": "Illuminazione fuoco",
        "SETTING_ENABLE_FIRE_LIGHTING_DESCRIPTION": "Abilita l'illuminazione dinamica accanto alle sorgenti di fuoco attive.",
        "SETTING_ENABLE_FMV": "FMV",
        "SETTING_ENABLE_FMV_DESCRIPTION": "Abilita la riproduzione dei filmati.",
        "SETTING_ENABLE_FOOTPRINTS": "Impronte",
        "SETTING_ENABLE_FOOTPRINTS_DESCRIPTION": "Abilita, nei livelli supportati, la visualizzazione delle impronte di Lara su alcune superfici.",
        "SETTING_ENABLE_GAME_MODES": "Selezione modalità di gioco",
        "SETTING_ENABLE_GAME_MODES_DESCRIPTION": "Consente di selezionare le modalità di gioco aggiuntive dal menu passaporto.\n\n- Nuova Partita+: sblocca tutte le armi con munizioni infinite; i nemici hanno punti vita doppi.\n- NP giapponese: le armi causano il doppio dei danni; le scatole di razzi contengono 8 razzi di segnalazione anziché 6.\n- NP giapponese+: combinazione di Nuova Partita+ e NP giapponese.",
        "SETTING_ENABLE_GUN_LIGHTING": "Illuminazione spari",
        "SETTING_ENABLE_GUN_LIGHTING_DESCRIPTION": "Abilita l'illuminazione dinamica per spari ed esplosioni.",
        "SETTING_ENABLE_IDLE_POSE_CAMERA": "Telecamera posa inattiva",
        "SETTING_ENABLE_IDLE_POSE_CAMERA_DESCRIPTION": "Regola la telecamera in modo che sia rivolta verso Lara mentre viene riprodotta la sua animazione di posa inattiva. Premi Guarda per reimpostare la telecamera.",
        "SETTING_ENABLE_INVERTED_LOOK": "Visuale invertita",
        "SETTING_ENABLE_INVERTED_LOOK_DESCRIPTION": "Inverte i controlli dell'asse Y quando Lara si guarda intorno.",
        "SETTING_ENABLE_ITEM_EXAMINING": "Esame degli oggetti",
        "SETTING_ENABLE_ITEM_EXAMINING_DESCRIPTION": "Per livelli personalizzati: consente di visualizzare le descrizioni degli oggetti nell'inventario quando fornite dall'autore del livello.",
        "SETTING_ENABLE_JUMP_TWISTS": "Capriole a mezz’aria",
        "SETTING_ENABLE_JUMP_TWISTS_DESCRIPTION": "Abilita i salti mortali e le capriole a mezz'aria, ovvero premendo il tasto Capriola durante le animazioni del salto e del tuffo ad angelo.",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS": "Blocchi mobili letali",
        "SETTING_ENABLE_KILLER_PUSHBLOCKS_DESCRIPTION": "Se abilitato, quando un blocco mobile cade e atterra su Lara, lei morirà all'istante. Se disabilitato, Lara si sposterà sopra il blocco e rimarrà illesa.",
        "SETTING_ENABLE_LARA_MIC": "Microfono vicino a Lara",
        "SETTING_ENABLE_LARA_MIC_DESCRIPTION": "Imposta il microfono in modo che sia collocato nella posizione di Lara. Se disabilitato, il microfono sarà collocato nella posizione della telecamera.",
        "SETTING_ENABLE_LEAN_JUMPING": "Salti inclinati",
        "SETTING_ENABLE_LEAN_JUMPING_DESCRIPTION": "Permette a Lara di spostarsi leggermente in avanti o indietro, tenendo premuto il relativo tasto, quando esegue salti sul posto.",
        "SETTING_ENABLE_LEDGE_JUMPS": "Salti da sporgenza",
        "SETTING_ENABLE_LEDGE_JUMPS_DESCRIPTION": "Permette a Lara di saltare verso l'alto o all'indietro mentre è appesa a una sporgenza, a patto che ci sia una superficie solida sotto i suoi piedi con cui darsi uno slancio",
        "SETTING_ENABLE_LEGAL": "Contenuto legale",
        "SETTING_ENABLE_LEGAL_DESCRIPTION": "Abilita la schermata di introduzione e il video Core Design all'avvio del gioco.",
        "SETTING_ENABLE_LOADING_SCREENS": "Schermate di caricamento",
        "SETTING_ENABLE_LOADING_SCREENS_DESCRIPTION": "\\{review}Controlla le schermate di caricamento prima del caricamento dei livelli.\n\n- Disattivato: non mostra mai le schermate di caricamento.\n- Sempre: mostra le schermate di caricamento.\n- Nuove partite: non mostra le schermate quando si carica un salvataggio.",
        "SETTING_ENABLE_MANUAL_CAMERA": "\\{review}Telecamera manuale",
        "SETTING_ENABLE_MANUAL_CAMERA_DESCRIPTION": "\\{review}Abilita i tasti della telecamera (\\{input camera_forward}\\{input camera_back}\\{input camera_left}\\{input camera_right}) usati per controllare la telecamera della Modalità Foto, per ruotare anche la telecamera di gioco.",
        "SETTING_ENABLE_MUSIC_IN_MENU": "Musica menu principale",
        "SETTING_ENABLE_MUSIC_IN_MENU_DESCRIPTION": "Riproduce la musica nel menu principale.",
        "SETTING_ENABLE_NEUTRAL_TWISTS": "Rotazione da fermo",
        "SETTING_ENABLE_NEUTRAL_TWISTS_DESCRIPTION": "Permette a Lara di ruotare in aria mentre esegue un salto da fermo. Mentre sei fermo, premi contemporaneamente i tasti Salta e Capriola.",
        "SETTING_ENABLE_PICKUP_AIDS": "Segnalazione oggetti",
        "SETTING_ENABLE_PICKUP_AIDS_DESCRIPTION": "Abilita un effetto scintillante intermittente vicino agli oggetti da raccogliere per evidenziarne la presenza.",
        "SETTING_ENABLE_PITCHED_SOUNDS": "Tonalità suoni",
        "SETTING_ENABLE_PITCHED_SOUNDS_DESCRIPTION": "Per una maggiore varietà, consente di modificare in modo leggero e casuale la tonalità degli effetti sonori.",
        "SETTING_ENABLE_PLAY_PREVIOUS_LEVELS": "Gioca livelli precedenti",
        "SETTING_ENABLE_PS1_CRYSTALS": "Tinta cristalli PS1",
        "SETTING_ENABLE_PS1_CRYSTALS_DESCRIPTION": "I cristalli di salvataggio saranno di color viola, più simili a quelli della versione PS1.",
        "SETTING_ENABLE_PS1_SFX": "Effetti sonori PS1",
        "SETTING_ENABLE_PS1_SFX_DESCRIPTION": "Sostituisce alcuni effetti sonori con quelli della versione PS1.\n\n- Suono dello sparo delle Uzi (solo TR1)\n- Suono dei passi a piedi nudi di Lara (solo TR2)",
        "SETTING_ENABLE_RESPONSIVE_CRAWL": "\\{review}Strisciare reattivo",
        "SETTING_ENABLE_RESPONSIVE_CRAWL_DESCRIPTION": "\\{review}Abilita miglioramenti rispetto alle meccaniche di strisciamento originali.\n\n- Consente di riprendere a strisciare più rapidamente dopo essersi fermati.\n- Consente di passare da corsa/scatto a strisciare senza fermarsi prima.\n- Consente di passare da strisciare a rotolata accovacciata (se abilitata) senza doversi prima accovacciare manualmente.\n- Consente di girarsi mentre si è accovacciati.\n- Ripristina l’animazione di raccolta in strisciamento di Lara (escluse le torce).",
        "SETTING_ENABLE_RESPONSIVE_MESH_TINT": "\\{review}Colorazione reattiva delle mesh",
        "SETTING_ENABLE_RESPONSIVE_MESH_TINT_DESCRIPTION": "\\{review}Consente alle singole mesh di Lara di essere renderizzate con una tonalità d’acqua se si trovano sott’acqua (stile TR3). In caso contrario, se Lara è in acqua, tutte le sue mesh verranno renderizzate con la tonalità (stile TR1/2).",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT": "Passaporto reattivo",
        "SETTING_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION": "Fa in modo che sfogliare le pagine del passaporto sia più istantaneo, tenendo conto dei tasti premuti dell'utente",
        "SETTING_ENABLE_RESPONSIVE_SPRINT": "Scatto migliorato",
        "SETTING_ENABLE_RESPONSIVE_SPRINT_DESCRIPTION": "Abilita per Lara una modalità di scatto migliorata.\n\n- consente di effettuare uno scatto non appena Lara ha energia, invece di dover aspettare che la barra della resistenza sia piena.\n- consente di effettuare uno scatto sulle scale senza essere interrotti dall’animazione di corsa normale.",
        "SETTING_ENABLE_SAVE_CRYSTALS": "Cristalli di salvataggio",
        "SETTING_ENABLE_SAVE_CRYSTALS_DESCRIPTION": "Permette di salvare all'inizio di ogni livello o utilizzando i cristalli. I livelli hanno un numero limitato di cristalli di salvataggio che possono essere utilizzati una sola volta, come nella versione PS1. La modifica di questa opzione richiederà il riavvio del livello.",
        "SETTING_ENABLE_SHOTGUN_FLASH": "Lampo sparo fucile",
        "SETTING_ENABLE_SHOTGUN_FLASH_DESCRIPTION": "Mostra il lampo dello sparo quando Lara fa fuoco con il fucile a pompa, come per le altre armi.",
        "SETTING_ENABLE_SKYBOX": "Cieli",
        "SETTING_ENABLE_SKYBOX_DESCRIPTION": "Abilita il cielo nei livelli supportati.",
        "SETTING_ENABLE_SLIDE_TO_RUN": "Corri dopo scivolata",
        "SETTING_ENABLE_SLIDE_TO_RUN_DESCRIPTION": "Permette a Lara di iniziare a correre immediatamente quando tocca terra dopo essere scivolata in avanti da una pendenza. Per farlo, tieni premuto il tasto Corri.",
        "SETTING_ENABLE_SMOOTH_BARS": "Barre sfumate",
        "SETTING_ENABLE_SMOOTH_BARS_DESCRIPTION": "Fa in modo che la barra della salute e la barra dell'ossigeno utilizzino transizioni di colore uniformi.",
        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT": "Deflessione rapida da muro",
        "SETTING_ENABLE_SMOOTH_WALL_DEFLECT_DESCRIPTION": "Permette a Lara di riprendersi più velocemente dopo aver urtato un muro e un tasto direzionale viene premuto insieme con il tasto Corri.",
        "SETTING_ENABLE_SOFT_STATICS": "Collisione delicata con mesh",
        "SETTING_ENABLE_SOFT_STATICS_DESCRIPTION": "Permette a Lara di muoversi dolcemente contro le maglie poligonali statiche – simile a TR4+ – anziché fermarsi bruscamente.",
        "SETTING_ENABLE_SPRINT": "Scatto",
        "SETTING_ENABLE_SPRINT_DESCRIPTION": "Permette a Lara di effettuare uno scatto, come in TR3+.",
        "SETTING_ENABLE_STEP_ROLL_BOOST": "Spinta su gradino",
        "SETTING_ENABLE_STEP_ROLL_BOOST_DESCRIPTION": "Fa in modo che Lara sia spinta giù da un gradino se si preme il tasto Capriola vicino al bordo.",
        "SETTING_ENABLE_SWING_CANCEL": "Annulla oscillazione",
        "SETTING_ENABLE_SWING_CANCEL_DESCRIPTION": "Consente di annullare l'animazione di oscillazione di Lara dalle sporgenze, lasciandole andare e afferrandole di nuovo rapidamente",
        "SETTING_ENABLE_TARGET_CHANGE": "Cambio bersaglio",
        "SETTING_ENABLE_TARGET_CHANGE_DESCRIPTION": "Abilita il cambio di bersaglio in stile TR4+ mentre si punta l'arma. Premi il tasto Cambia Bersaglio mentre miri per cambiare bersaglio.",
        "SETTING_ENABLE_TIMER_IN_INVENTORY": "Cronometro nell'inventario",
        "SETTING_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION": "Fa in modo che il tempo di gioco scorra anche nel menu dell'inventario.",
        "SETTING_ENABLE_TOTAL_STATS": "Schermata statistiche finali",
        "SETTING_ENABLE_TOTAL_STATS_DESCRIPTION": "Abilita la schermata delle statistiche totali di gioco che viene visualizzata dopo i titoli di coda.",
        "SETTING_ENABLE_TR2_JUMPING": "Salti reattivi",
        "SETTING_ENABLE_TR2_JUMPING_DESCRIPTION": "Permette a Lara di saltare in qualsiasi momento mentre corre.",
        "SETTING_ENABLE_TR2_SWIMMING": "Nuoto naturale",
        "SETTING_ENABLE_TR2_SWIMMING_DESCRIPTION": "Fornisce alla velocità di virata subacquea di Lara una curva di accelerazione per movimenti più fluidi, come in TR2+. Disabilitando questa opzione, Lara avrà una velocità di virata più rapida, come in TR1.",
        "SETTING_ENABLE_TR2_SWIM_CANCEL": "Annullamento reattivo nuoto",
        "SETTING_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION": "Permette a Lara di fermarsi in modo più istantaneo sott'acqua quando viene rilasciato il tasto per nuotare.",
        "SETTING_ENABLE_TR3_SIDESTEPS": "Passi laterali migliorati",
        "SETTING_ENABLE_TR3_SIDESTEPS_DESCRIPTION": "Abilita i passi laterali in stile TR3+, ad es. MAIUSC+frecce direzionali. I pulsanti dedicati per i passi laterali continueranno a funzionare.",
        "SETTING_ENABLE_UNDERWATER_ANIM_SFX": "Effetti sonori sott'acqua",
        "SETTING_ENABLE_UNDERWATER_ANIM_SFX_DESCRIPTION": "Permette di gestire la riproduzione di specifici effetti sonori legati ad animazioni, per oggetti quali porte e botole, quando la telecamera è sott'acqua.",
        "SETTING_ENABLE_UW_ROLL": "Capriola sott'acqua",
        "SETTING_ENABLE_UW_ROLL_DESCRIPTION": "Permette a Lara di eseguire capriole mentre è sott'acqua.",
        "SETTING_ENABLE_WADING": "Guadare",
        "SETTING_ENABLE_WADING_DESCRIPTION": "Permette a Lara di guadare acque poco profonde, anziché rimanere bloccata sulla superficie dell'acqua.",
        "SETTING_ENABLE_WALK_TO_ITEMS": "Interazioni animate",
        "SETTING_ENABLE_WALK_TO_ITEMS_DESCRIPTION": "Fa in modo che Lara si avvicini agli oggetti, alle leve e agli interruttori quando questi sono nelle vicinanze, invece di teletrasportarsi su di loro.",
        "SETTING_ENABLE_WEATHER": "Tempo meteorologico",
        "SETTING_ENABLE_WEATHER_DESCRIPTION": "Abilita, nei livelli supportati, la visualizzazione degli effetti atmosferici.",
        "SETTING_ENEMY_HEALTHBAR_COLOR": "Colore barra nemici",
        "SETTING_ENEMY_HEALTHBAR_COLOR_DESCRIPTION": "Colore utilizzato per la barra della salute dei nemici.",
        "SETTING_ENEMY_HEALTHBAR_LOCATION": "Posizione barra nemici",
        "SETTING_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION": "Posizione in cui viene visualizzata la barra della salute dei nemici.",
        "SETTING_ENEMY_HEALTHBAR_SHOW_MODE": "Modalità barra nemici",
        "SETTING_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION": "Abilita la visualizzazione della barra della salute per il nemico ingaggiato.",
        "SETTING_EXPOSUREBAR_COLOR": "Colore barra esposizione",
        "SETTING_EXPOSUREBAR_COLOR_DESCRIPTION": "Colore utilizzato per la barra di esposizione all'acqua fredda.",
        "SETTING_EXPOSUREBAR_LOCATION": "Posizione barra esposizione",
        "SETTING_EXPOSUREBAR_LOCATION_DESCRIPTION": "Posizione in cui viene visualizzata la barra di esposizione all'acqua fredda.",
        "SETTING_FIX_ALLIGATOR_AI": "Correggi IA degli alligatori",
        "SETTING_FIX_ALLIGATOR_AI_DESCRIPTION": "Risolve il problema degli alligatori che non infliggono danni se Lara rimane ferma nell'acqua.",
        "SETTING_FIX_ANIMATED_SPRITES": "Correggi animazioni sprite",
        "SETTING_FIX_ANIMATED_SPRITES_DESCRIPTION": "Corregge gli sprite originali delle piante idrofite in modo che si animino correttamente nelle aree acquatiche.",
        "SETTING_FIX_BEAR_AI": "Correggi IA degli orsi",
        "SETTING_FIX_BEAR_AI_DESCRIPTION": "Risolve il problema per cui gli attacchi con la zampa degli orsi non colpiscono Lara.",
        "SETTING_FIX_BRIDGE_COLLISION": "Correggi collisione ponti",
        "SETTING_FIX_BRIDGE_COLLISION_DESCRIPTION": "Risolve il problema per cui Lara non è in grado di afferrare parti di alcuni ponti e muri invisibili ai bordi. Corregge anche i problemi di collisione con ponti levatoi, botole e ponti quando sono impilati l'uno sull'altro, su pendii o vicino al suolo.",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND": "Correggi suono dei segreti",
        "SETTING_FIX_CHAINBLOCK_SECRET_SOUND_DESCRIPTION": "Impedisce la riproduzione errata del suono dei segreti quando si utilizza la chiave d'oro nella Tomba di Tihocan.",
        "SETTING_FIX_DESCENDING_GLITCH": "Correggi cadute da pavimenti",
        "SETTING_FIX_DESCENDING_GLITCH_DESCRIPTION": "Risolve il problema per cui i passi laterali e il camminare all'indietro su pavimenti fragili fanno sì che Lara scenda immediatamente sul pavimento sottostante.",
        "SETTING_FIX_FLARE_THROW_PRIORITY": "Correggi priorità lancio razzi",
        "SETTING_FIX_FLARE_THROW_PRIORITY_DESCRIPTION": "Risolve il problema per cui Lara dà priorità al lancio di un razzo di segnalazione esaurito mentre è a mezz'aria, il che può impedirle di afferrare le sporgenze.",
        "SETTING_FIX_FLOOR_DATA_ISSUES": "Correggi dati livelli",
        "SETTING_FIX_FLOOR_DATA_ISSUES_DESCRIPTION": "Risolve i problemi dei livelli originali relativi a dati/eventi.",
        "SETTING_FIX_FREE_FLARE_GLITCH": "Correggi errore dei razzi",
        "SETTING_FIX_FREE_FLARE_GLITCH_DESCRIPTION": "Risolve il problema in cui, se si preme il tasto di estrazione di un razzo di segnalazione mentre si raccoglie un qualsiasi oggetto, ne verrà creato uno dal nulla.",
        "SETTING_FIX_GLIDE_CAMERAS": "Correggi telecamere a scorrimento",
        "SETTING_FIX_GLIDE_CAMERAS_DESCRIPTION": "Corregge le telecamere a scorrimento affinché rispettino il tempo impostato negli eventi di livello invece di tornare alla velocità predefinita dopo il primo fotogramma.",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH": "Correggi duplicazione oggetti",
        "SETTING_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION": "Risolve il problema per cui è possibile duplicare l'utilizzo degli oggetti chiave nell'inventario.",
        "SETTING_FIX_ITEM_ROTS": "Correggi rotazione oggetti",
        "SETTING_FIX_ITEM_ROTS_DESCRIPTION": "Risolve i problemi relativi all'orientamento errato di alcuni oggetti quando viene utilizzata l'opzione Oggetti 3D nei livelli originali.",
        "SETTING_FIX_LARA_PICKUP_EMBED": "Correggi errore di raccolta",
        "SETTING_FIX_LARA_PICKUP_EMBED_DESCRIPTION": "Risolve i problemi per cui Lara a volte scivola contro i muri quando raccoglie oggetti sott’acqua, e per cui si incastra sotto i soffitti fortemente inclinati quando raccoglie gli oggetti sopra l'acqua.",
        "SETTING_FIX_M16_ACCURACY": "Correggi precisione M16/MP5",
        "SETTING_FIX_M16_ACCURACY_DESCRIPTION": "Corregge la precisione della mira dell'M16/MP5 mentre Lara corre.",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY": "\\{review}Correggi la priorità di raccolta delle scimmie",
        "SETTING_FIX_MONKEY_PICKUP_PRIORITY_DESCRIPTION": "\\{review}Le scimmie attaccate daranno priorità alla ritirata rispetto alla raccolta di Medi pack e Chiavi.",
        "SETTING_FIX_QWOP_GLITCH": "Correggi errore QWOP",
        "SETTING_FIX_QWOP_GLITCH_DESCRIPTION": "Risolve il problema per cui a volte Lara, saltando da piccoli gradini, provoca una strana animazione di corsa nota come stato QWOP.",
        "SETTING_FIX_SECRETS_KILLING_MUSIC": "Musica segreti in polifonia",
        "SETTING_FIX_SECRETS_KILLING_MUSIC_DESCRIPTION": "Risolve il problema per cui il suono riprodotto dalla scoperta di un segreto interrompe la traccia musicale attiva.",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC": "Dialoghi nemici in polifonia",
        "SETTING_FIX_SPEECHES_KILLING_MUSIC_DESCRIPTION": "Risolve il problema per cui i nemici, quando parlano, interrompono la traccia musicale attiva.",
        "SETTING_FIX_STEP_GLITCH": "Correggi errore gradini",
        "SETTING_FIX_STEP_GLITCH_DESCRIPTION": "Risolve il problema per cui Lara a volte viene spinta contro i muri adiacenti ai gradini quando corre su di loro in un certo modo.",
        "SETTING_FIX_TEXTURE_ISSUES": "Correggi problemi texture",
        "SETTING_FIX_TEXTURE_ISSUES_DESCRIPTION": "Risolve i problemi riguardanti texture o maglie poligonali mancanti o errate nei livelli originali.",
        "SETTING_FIX_WADE_WALL_HIT": "Correggi impatto muro",
        "SETTING_FIX_WADE_WALL_HIT_DESCRIPTION": "Risolve il problema per cui Lara non reagisce quando urta un muro mentre guada.",
        "SETTING_FIX_WALK_RUN_JUMP": "Correggi cammina corsa salto",
        "SETTING_FIX_WALK_RUN_JUMP_DESCRIPTION": "Risolve il problema per cui a volte Lara non riesce a saltare immediatamente dopo essere passata dall'animazione di camminata a quella di corsa.",
        "SETTING_FIX_WATER_EXIT": "Correggi uscita dall'acqua",
        "SETTING_FIX_WATER_EXIT_DESCRIPTION": "Risolve il problema che permette a Lara di passare direttamente da una stanza con acqua ad una senza acqua adiacente o sottostante. Inoltre, questo impedirà a Lara di uscire dall'acqua su pendii non calpestabili.",
        "SETTING_FMV_VOLUME": "Volume FMV",
        "SETTING_FMV_VOLUME_DESCRIPTION": "Regola il volume dei filmati.",
        "SETTING_FOG_COLOR": "Colore nebbia",
        "SETTING_FOG_COLOR_DESCRIPTION": "Colore della nebbia.",
        "SETTING_FOG_END": "Fine nebbia",
        "SETTING_FOG_END_DESCRIPTION": "Imposta la distanza nelle piastrelle in cui la nebbia oscura completamente ogni cosa.",
        "SETTING_FOG_START": "Inizio nebbia",
        "SETTING_FOG_START_DESCRIPTION": "Imposta la distanza nelle piastrelle in cui inizia ad apparire la nebbia.",
        "SETTING_FOG_TRANSPARENCY": "Trasparenza nebbia",
        "SETTING_FOG_TRANSPARENCY_DESCRIPTION": "Abilita la fusione di geometrie distanti con superfici completamente trasparenti.",
        "SETTING_FOV": "Campo visivo",
        "SETTING_FOV_DESCRIPTION": "Angolo di visione in gradi. Valori più grandi ampliano il campo visivo, valori più piccoli lo restringono.",
        "SETTING_FPS": "FPS",
        "SETTING_FPS_DESCRIPTION": "Imposta i fotogrammi al secondo.",
        "SETTING_GAME_BRIGHTNESS": "Luminosità",
        "SETTING_GAME_BRIGHTNESS_DESCRIPTION": "Modifica la luminosità del gioco.",
        "SETTING_GAMMA": "Gamma",
        "SETTING_GAMMA_DESCRIPTION": "Regola la curva gamma. Valori più alti restituiscono una luminosità maggiore. Il valore 2,5 equivale al livello dei colori predefinito.",
        "SETTING_HARPOON_RECOIL": "Ricarica fucile subacqueo",
        "SETTING_HARPOON_RECOIL_DESCRIPTION": "Imposta la frequenza con cui Lara deve ricaricare il fucile subacqueo, in base al numero attuale di munizioni. Ad esempio, se impostato a 3, dovrà ricaricare dopo ogni terzo colpo. Impostare a 0 per disabilitare completamente la ricarica.",
        "SETTING_HEALTHBAR_COLOR": "Colore barra salute",
        "SETTING_HEALTHBAR_COLOR_DESCRIPTION": "Colore utilizzato per la barra della salute.",
        "SETTING_HEALTHBAR_LOCATION": "Posizione barra salute",
        "SETTING_HEALTHBAR_LOCATION_DESCRIPTION": "Posizione in cui viene visualizzata la barra della salute.",
        "SETTING_HEALTHBAR_POISON_COLOR": "\\{review}Colore della barra della salute avvelenata",
        "SETTING_HEALTHBAR_POISON_COLOR_DESCRIPTION": "\\{review}Colore della barra della salute quando Lara è avvelenata.",
        "SETTING_IDLE_POSE_TIMEOUT": "Tempo di inattività",
        "SETTING_IDLE_POSE_TIMEOUT_DESCRIPTION": "Permette a Lara di riprodurre la sua animazione di posa dopo il numero di secondi d'inattività specificato. Impostalo a 0 per disabilitarlo.",
        "SETTING_INVENTORY_AMBIENT_VOLUME": "Volume ambientale (inventario)",
        "SETTING_INVENTORY_AMBIENT_VOLUME_DESCRIPTION": "Regola il volume dei suoni ambientali nella schermata dell'inventario.",
        "SETTING_INVENTORY_BACKGROUND_STYLE": "Sfondo inventario",
        "SETTING_INVENTORY_BACKGROUND_STYLE_DESCRIPTION": "Modifica il modo in cui viene visualizzato lo sfondo dell'inventario.\n\n- Scuro: TR1 (PC).\n- Molto scuro: TR1 (PS1).\n- Statico: TR2 (PC).\n- Ondeggiante: TR2 (PS1).\n- Monocromatico: TR3.",
        "SETTING_INVENTORY_FADE_EFFECTS": "\\{review}Effetti di dissolvenza nell'inventario",
        "SETTING_INVENTORY_FADE_EFFECTS_DESCRIPTION": "\\{review}Regola finemente gli effetti di dissolvenza per essere abilitati o disabilitati nell'anello dell'inventario di gioco. È necessario che l'opzione Effetti di dissolvenza sia abilitata per funzionare.",
        "SETTING_INVENTORY_MUSIC_VOLUME": "Volume musica (inventario)",
        "SETTING_INVENTORY_MUSIC_VOLUME_DESCRIPTION": "Regola il volume della musica nella schermata dell'inventario.",
        "SETTING_JUMP_LOCK_MODE": "Modalità blocco salto",
        "SETTING_JUMP_LOCK_MODE_DESCRIPTION": "Per salti più reattivi, consente di modificare quanto tempo deve attendere Lara per poter saltare dopo aver iniziato a correre.\n\n- Originale: corrisponde alla durata di tempo in TR2.\n- Modificato: è possibile effettuare il salto 2 fotogrammi prima.\n- Disattivato: è possibile effettuare il salto subito dopo l'inizio della corsa.",
        "SETTING_LARA_OUTFIT": "\\{review}Outfit di Lara",
        "SETTING_LARA_OUTFIT_DESCRIPTION": "\\{review}Modifica l’aspetto di Lara. Se si seleziona Predefinito, verranno rispettati i normali cambi di outfit tra i livelli; in caso contrario, l’outfit scelto resterà attivo finché non verrà modificato manualmente.",
        "SETTING_LIGHTING_CONTRAST": "Contrasto",
        "SETTING_LIGHTING_CONTRAST_DESCRIPTION": "Aumenta il contrasto per fonti di luce dinamiche come razzi di segnalazione e lampi di armi da fuoco.",
        "SETTING_LOAD_MUSIC_TRIGGERS": "Ricorda musica riprodotta",
        "SETTING_LOAD_MUSIC_TRIGGERS_DESCRIPTION": "Contrassegna le tracce musicali riprodotte nel file di salvataggio, in modo che le tracce legate ad eventi non vengano rieseguite dopo il caricamento della partita.",
        "SETTING_LOOK_MODE": "Modalità osservazione",
        "SETTING_LOOK_MODE_DESCRIPTION": "Permette di gestire in quali situazioni Lara può guardarsi attorno (tasto 'Guarda').\n\n- Limitato: è consentito esaminare l'ambiente solo quando Lara è ferma e mai quando è sott'acqua.\n- Avanzato: è consentito esaminare l'ambiente durante la maggior parte delle situazioni, tranne in alcune come quando si spingono i blocchi.\n- Illimitato: è sempre consentito esaminare l'ambiente durante il normale controllo di Lara.",
        "SETTING_MASTER_VOLUME": "\\{icon music} Volume principale",
        "SETTING_MASTER_VOLUME_DESCRIPTION": "Regola il volume di gioco. Le altre impostazioni sono relative a questo volume.",
        "SETTING_MAXIMUM_SAVE_SLOTS": "Numero slot di salvataggio",
        "SETTING_MAXIMUM_SAVE_SLOTS_DESCRIPTION": "Modifica il numero di slot di salvataggio disponibili.",
        "SETTING_MENU_STYLE": "Stile menu",
        "SETTING_MENU_STYLE_DESCRIPTION": "Modifica la modalità di visualizzazione dei menu.\n\n - PC: lo stile dell'interfaccia utente corrisponde alla versione PC.\n - PS1: lo stile dell'interfaccia utente corrisponde alla versione PS1.",
        "SETTING_MUSIC_LOAD_CONDITION": "Ripristina traccia",
        "SETTING_MUSIC_LOAD_CONDITION_DESCRIPTION": "Carica la traccia musicale che era in riproduzione al momento del salvataggio della partita.\n\n- Mai: non ripristina le tracce musicali al caricamento.\n- Non ambientale: ripristina le tracce musicali ma non i suoni ambientali al caricamento.\n- Sempre: ripristina qualsiasi tipo di traccia al caricamento.",
        "SETTING_MUSIC_VOLUME": "Volume musica",
        "SETTING_MUSIC_VOLUME_DESCRIPTION": "Regola il volume della musica.",
        "SETTING_MUTE_OUT_OF_FOCUS": "Disattiva se in secondo piano",
        "SETTING_MUTE_OUT_OF_FOCUS_DESCRIPTION": "Disattiva tutta la musica e gli effetti sonori quando la finestra del gioco non è in primo piano.",
        "SETTING_PAUSE_BACKGROUND_STYLE": "Sfondo di pausa",
        "SETTING_PAUSE_BACKGROUND_STYLE_DESCRIPTION": "Modifica il modo in cui viene visualizzato lo sfondo della schermata di pausa.\n\n- Scuro: TR1 (PC).\n- Molto scuro: TR1 (PS1).\n- Statico: TR2 (PC).\n- Ondeggiante: TR2 (PS1).\n- Monocromatico: TR3.",
        "SETTING_PAUSE_FADE_EFFECTS": "\\{review}Effetti di dissolvenza nella pausa",
        "SETTING_PAUSE_FADE_EFFECTS_DESCRIPTION": "\\{review}Regola finemente gli effetti di dissolvenza per essere abilitati o disabilitati nella schermata di pausa. È necessario che l'opzione Effetti di dissolvenza sia abilitata per funzionare.",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY": "Ferma musica nell'inventario",
        "SETTING_PAUSE_MUSIC_IN_INVENTORY_DESCRIPTION": "Mette in pausa i suoni di gioco, la musica e i suoni ambientali nella schermata dell'inventario.",
        "SETTING_PROJECTILE_AREA_DAMAGE": "\\{review}Danno ad area da proiettile",
        "SETTING_PROJECTILE_AREA_DAMAGE_DESCRIPTION": "\\{review}Controlla come si propaga l'area d'effetto per il Lanciarazzi e il Lanciarazzi a granate.\n\n- Singola scansione: comportamento di TR1 e TR2.\n- Multi-scansione: comportamento di TR3.\n\nL'opzione multi-scansione spesso causa danni doppi ai singoli nemici.",
        "SETTING_QUICK_GUNS_MODE": "Equipaggiamento rapido armi",
        "SETTING_QUICK_GUNS_MODE_DESCRIPTION": "Controlla il comportamento dei tasti per l'equipaggiamento rapido delle armi.\n\n- Solo equipaggia: premendo il tasto, Lara equipaggerà l'arma assegnata.\n- Equipaggia o riponi: premendo il tasto, Lara equipaggerà l'arma assegnata. In aggiunta, con lo stesso tasto, la riporrà se la sta attualmente tenendo in mano.",
        "SETTING_REFLECTIONS": "Riflessi",
        "SETTING_REFLECTIONS_DESCRIPTION": "Abilita i riflessi su alcuni oggetti.",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS": "Ricorda armi tra livelli",
        "SETTING_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION": "Fa sì che Lara ricordi quale arma ha usato per ultima nel livello precedente quando inizia un nuovo livello. Se disabilitato, Lara tornerà ad avere nella fondina le sue pistole.",
        "SETTING_RESTORE_PS1_ENEMIES": "Ripristina nemici PS1",
        "SETTING_RESTORE_PS1_ENEMIES_DESCRIPTION": "Aggiunge la mummia che appare nella versione PlayStation del livello 'Città di Khamoon', stanza 25.\nLa modifica di questa opzione richiederà il riavvio della partita.",
        "SETTING_SCREENSHOT_FORMAT": "Formato cattura schermo",
        "SETTING_SCREENSHOT_FORMAT_DESCRIPTION": "Formato del file da utilizzare per le istantanee dello schermo.",
        "SETTING_SHADOW_TYPE": "Forma delle ombre",
        "SETTING_SHADOW_TYPE_DESCRIPTION": "Seleziona la modalità di renderizzazione delle ombre dei personaggi.\n\n- Ottagono: ombre in stile TR1 e TR2\n- Cerchio: ombre rotonde\n- Sprite: ombre basate su texture come in TR3",
        "SETTING_SHOW_BARS": "Mostra barre",
        "SETTING_SHOW_BARS_DESCRIPTION": "Disabilita tutte le barre di gioco, nascondendo le informazioni sulla salute di Lara e altre risorse (per le sfide).",
        "SETTING_SOUND_VOLUME": "\\{icon sound} Volume effetti",
        "SETTING_SOUND_VOLUME_DESCRIPTION": "Regola il volume degli effetti sonori.",
        "SETTING_SPRINTBAR_COLOR": "Colore barra resistenza",
        "SETTING_SPRINTBAR_COLOR_DESCRIPTION": "Colore della barra della resistenza visualizzata durante uno scatto.",
        "SETTING_SPRINTBAR_LOCATION": "Posizione barra resistenza",
        "SETTING_SPRINTBAR_LOCATION_DESCRIPTION": "Posizione in cui viene visualizzata la barra della resistenza.",
        "SETTING_SPRITE_LOCK_MODE": "Modalità blocco sprite",
        "SETTING_SPRITE_LOCK_MODE_DESCRIPTION": "Controlla quali assi bloccare durante la visualizzazione degli sprite sullo schermo.\n\n- Nessuno: mostra gli sprite normalmente.\n- Rotazione: blocca l'asse di rotazione – utile solo in modalità foto.\n- Rotazione e inclinazione: fa in modo che gli sprite rimangano in posizione verticale e non si inclinino verso il suolo quando li si guarda dall'alto.\n- Prospettiva: blocca gli assi di rotazione e inclinazione e, inoltre, ruota leggermente gli sprite verso il centro dello schermo.",
        "SETTING_START_LARA_HITPOINTS": "Salute iniziale di Lara",
        "SETTING_START_LARA_HITPOINTS_DESCRIPTION": "Imposta il valore di salute di Lara all'inizio di ogni livello.",
        "SETTING_STATS_BACKGROUND_STYLE": "Sfondo statistiche",
        "SETTING_STATS_BACKGROUND_STYLE_DESCRIPTION": "Modifica il modo in cui viene visualizzato lo sfondo delle statistiche di fine livello.\n\n- Scuro: TR1 (PC).\n- Molto scuro: TR1 (PS1).\n- Statico: TR2 (PC).\n- Ondeggiante: TR2 (PS1).\n- Monocromatico: TR3.",
        "SETTING_STATS_FADE_EFFECTS": "\\{review}Effetti di dissolvenza nelle statistiche",
        "SETTING_STATS_FADE_EFFECTS_DESCRIPTION": "\\{review}Regola finemente gli effetti di dissolvenza per essere abilitati o disabilitati nella schermata delle statistiche di fine livello. È necessario che l'opzione Effetti di dissolvenza sia abilitata per funzionare.",
        "SETTING_STATS_LEVEL_HEADER": "Contatore livelli",
        "SETTING_STATS_LEVEL_HEADER_DESCRIPTION": "Mostra il numero del livello attuale nella parte superiore della schermata delle statistiche del livello.",
        "SETTING_STAT_DETAIL_MODE": "Dettagli statistiche",
        "SETTING_STAT_DETAIL_MODE_DESCRIPTION": "Consente di scegliere tra vari livelli di dettaglio per la visualizzazione delle statistiche.\n\n- Minimo: mostra la finestra delle statistiche originale.\n- Dettagliato: mostra tutte le statistiche della modalità 'Minimo' e, in aggiunta, i conteggi massimi accanto ad ogni informazione.\n- Completo: mostra tutte le statistiche della modalità 'Dettagliato' e, in aggiunta, nuove informazioni non disponibili nella finestra originale.",
        "SETTING_TARGET_MODE": "Modalità aggancio bersaglio",
        "SETTING_TARGET_MODE_DESCRIPTION": "Modifica il comportamento di aggancio dei bersagli.\n\n- Completo: mantieni sempre il bersaglio agganciato anche se il nemico esce dal campo visivo o muore (TR1-3).\n- Parziale: mantieni il bersaglio agganciato anche se il nemico esce dal campo visivo, ma lo perdi se muore.\n- Nessuno: perdi il bersaglio agganciato se il nemico esce dal campo visivo o muore (TR4+).",
        "SETTING_TEXTURE_FILTER": "Filtro texture",
        "SETTING_TEXTURE_FILTER_DESCRIPTION": "Passa dalle texture di gioco filtrate a quelle pixelate e viceversa.",
        "SETTING_TRAPEZOID_FILTER": "Filtro trapezoidale",
        "SETTING_TRAPEZOID_FILTER_DESCRIPTION": "Corregge la renderizzazione dei quadrilateri.",
        "SETTING_UI_BAR_SCALE": "Scala barra",
        "SETTING_UI_BAR_SCALE_DESCRIPTION": "Modifica le dimensioni delle barre della salute, dell'ossigeno e dei nemici.",
        "SETTING_UI_BRIGHTNESS": "Luminosità interfaccia",
        "SETTING_UI_BRIGHTNESS_DESCRIPTION": "Modifica la luminosità dell'interfaccia.",
        "SETTING_UI_FILTER": "Filtro interfaccia",
        "SETTING_UI_FILTER_DESCRIPTION": "Passa dall'interfaccia di gioco filtrata a quella pixelata e viceversa.",
        "SETTING_UI_LANGUAGE": "Lingua",
        "SETTING_UI_LANGUAGE_DESCRIPTION": "Cambia la lingua dell'interfaccia utente.",
        "SETTING_UI_PICKUPS_OVERLAY": "Notifiche raccolta",
        "SETTING_UI_PICKUPS_OVERLAY_DESCRIPTION": "Mostra gli oggetti nell'angolo in basso a destra quando Lara raccoglie qualcosa.",
        "SETTING_UI_PICKUP_SCALE": "Scala oggetti raccolti",
        "SETTING_UI_PICKUP_SCALE_DESCRIPTION": "Modifica la dimensione degli oggetti animati visualizzati nell'interfaccia utente quando Lara raccoglie qualcosa.",
        "SETTING_UI_SCROLL_WRAPAROUND": "Scorrimento continuo",
        "SETTING_UI_SCROLL_WRAPAROUND_DESCRIPTION": "Consente la navigazione direzionale nei menu senza soluzione di continuità.",
        "SETTING_UI_TEXT_SCALE": "Scala testo",
        "SETTING_UI_TEXT_SCALE_DESCRIPTION": "Modifica la dimensione del testo dell'interfaccia utente.",
        "SETTING_UNDERWATER_AMBIENT_VOLUME": "Volume ambientale (sott'acqua)",
        "SETTING_UNDERWATER_AMBIENT_VOLUME_DESCRIPTION": "Regola il volume dei suoni ambientali quando si è sott'acqua.",
        "SETTING_UNDERWATER_MUSIC_VOLUME": "Volume musica (sott'acqua)",
        "SETTING_UNDERWATER_MUSIC_VOLUME_DESCRIPTION": "Regola il volume della musica quando si è sott'acqua.",
        "SETTING_UPSCALING_FACTOR": "Fattore di scala",
        "SETTING_UPSCALING_FACTOR_DESCRIPTION": "Ridimensiona l'immagine di gioco in base a un fattore di scala definito, mantenendo un aspetto pixelato.",
        "SETTING_UPSCALING_FILTER": "Filtro ridimensionamento",
        "SETTING_UPSCALING_FILTER_DESCRIPTION": "Alterna l'aspetto smussato o pixelato per l'intero schermo.",
        "SETTING_VSYNC": "Sincronizzazione verticale",
        "SETTING_VSYNC_DESCRIPTION": "Attiva o disattiva la sincronizzazione verticale.",
        "SETTING_WALL_GLITCH_MODE": "Modalità errore muro",
        "SETTING_WALL_GLITCH_MODE_DESCRIPTION": "Consente di utilizzare il comportamento dell'errore del muro di TR1 in TR2 e viceversa; consente inoltre di correggere tutti i tipi di errore del muro.",
        "SETTING_WATER_COLOR": "Colore acqua",
