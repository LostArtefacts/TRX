{
    // NOTE: bad changes to this file may result in crashes.
    // Lines starting with double slashes are comments and are ignored.

    "main_menu_picture": "todo.webp",
    "savegame_fmt_legacy": "savegame.%d",
    "savegame_fmt_bson": "save_tr3_%02d.dat",

    "demo_version": false,
    "enable_tr2_item_drops": true,
    "convert_dropped_guns": true,

    "title": {
        "path": "data/title.tr2",
        "music_track": 60,
        "sequence": [
            {"type": "exit_to_title"},
        ],
    },

    "sfx_path": "data/main.sfx",
    "injections": [
        "data/injections/font.bin",
        "data/injections/lara_animations.bin",
        "data/injections/pda_model.bin",
        "data/injections/lara_extra.bin",
    ],

    "levels": [
        // 0. Lara's Home
        {
            "type": "gym",
            "path": "data/house.tr2",
            "music_track": -1,
            "sequence": [
                {"type": "loop_game"},
                {"type": "level_stats"},
            ],
        },
    ],

    "demos": [
    ],

    "cutscenes": [
    ],

    "fmvs": [
    ],

    "hidden_config": [
    ],
}
