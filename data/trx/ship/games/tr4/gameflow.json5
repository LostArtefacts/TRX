                {"type": "remove_weapons"},
                {"type": "give_item", "object_id": "small_medipack_item", "quantity": 3},
                {"type": "give_item", "object_id": "large_medipack_item"},
                {"type": "loop_game"},
                {"type": "level_complete"},
            ],
        },

