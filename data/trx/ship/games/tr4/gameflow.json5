{
    // NOTE: bad changes to this file may result in crashes.
    // Lines starting with double slashes are comments and are ignored.

    "engine": 4,
    "name": "Tomb Raider IV",

    "savegame_file_fmt": "save_tr4_%02d.dat",

    "enable_tr2_item_drops": true,
    "convert_dropped_guns": true,

    "ambient_tracks": [
        97, 102, 105, 106, 107, 108, 109, 110, 111,
    ],

    "injections": [
        "font.bin",
        "lara_outfits.bin",
        "lara_animations.bin",
        "sparks_gfx.bin",
        "shadow_sprite.bin",
    ],

    "title": {
        "path": "title.tr4",
        "music_track": 104,
        "lara_outfit": "tr4_classic",
        "sequence": [
            {"type": "play_fmv", "fmv_id": 0},
            {"type": "exit_to_title"},
        ],
    },

    "levels": [
        // 1. Angkor Wat
        {
            "path": "angkor1.tr4",
            "music_track": 110,
            "lara_outfit": "tr4_young",
            "sequence":[
                {"type": "play_fmv", "fmv_id": 12},
                // {"type": "setup_inv_item", "obj_id": "puzzle_item_1", "offset_y": 1, "scale": 384, "rot_x": 0, "rot_y": 36864, "rot_z": 0, "flags": 2},
                {"type": "setup_horizon", "layer": 0, "color": "#A0A0C0", "speed": 7}, // second layer also supported, seemingly unused?
