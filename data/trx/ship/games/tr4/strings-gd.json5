                "puzzle_item_4_combo_2": {
                    "name": "Pìos Cartùis 2",
                },
                "examine_item_2": {
                    "name": "Riaghailtean Senet",
                    "description": "Gus an geama a bhuannachadh, thoir na pìosan agad uile far a' bhùird le bhith gan cur air a' cheàrnag ankh mu dheireadh. Nuair a thig do chothrom, tilg na maidean. 'S e an àireamh de thaobhan geala a tha a' sealltainn an sgòr agad-sa.\n\nMura h-eil taobh geal sam bith a' sealltainn, 's e sia an sgòr a th' agad. Ma gheibheas tu sia no ma thig thu air ceàrnag ankh, gheibh thu cothrom eile as asgaidh. Ma thig thu air pìos neach-dùbhlain, thèid am pìos sin a thilleadh chun an àite-tòiseachaidh.",
                }
            }
        },
