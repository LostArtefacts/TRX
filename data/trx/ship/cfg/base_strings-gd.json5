        "ui.sprintbar_location": {
            "title": "\\{review}Bàr ruith luath",
            "description": "Far a nochdas am bàr ruith luath air an sgrion.",
        },
        "ui.stats.show_ammo": {
            "title": "Bualadh ammo / cleachdadh",
            "description": "Seall an loidhne ammo anns na staitistig ìre.",
        },
        "ui.stats.show_crystals": {
            "title": "Criostalan",
            "description": "Tha e a’ sealltainn an rìgh criostalan ann an staitistig an ìre.",
        },
        "ui.stats.show_deaths": {
            "title": "Bàs",
            "description": "Seall bàsan Lara anns na staitistig compais agus anns na staitistig ìre. Tha cunntas bàis air ùrachadh anns an sàbhalaidh a tha air a luchdachadh an-dràsta cho luath ‘s a bhàsaich Lara.",
        },
        "ui.stats.show_distance_travelled": {
            "title": "Astar air a siubhal",
            "description": "Seall an loidhne astar air a siubhal anns na staitistig ìre.",
        },
        "ui.stats.show_kills": {
            "title": "Murtan",
            "description": "Seall an loidhne murtan anns na staitistig ìre.",
        },
        "ui.stats.show_level_header": {
            "title": "Àireamh ìre",
            "description": "Seall àireamh an ìre làithreach aig mullach nan staitistig ìre.",
        },
        "ui.stats.show_medipacks_used": {
            "title": "Pacaidean slàinte air an cleachdadh",
            "description": "Seall an loidhne pacaidean slàinte air an cleachdadh anns na staitistig ìre.",
        },
        "ui.stats.show_pickups": {
            "title": "Togalaichean",
            "description": "Seall an loidhne togalaichean anns na staitistig ìre.",
        },
        "ui.stats.show_secrets": {
            "title": "Dìomhair air an lorg",
            "description": "Seall an loidhne dìomhair air an lorg anns na staitistig ìre.",
        },
        "ui.stats.show_time_taken": {
            "title": "Ùine a ghabh",
            "description": "Seall an loidhne ùine a ghabh anns na staitistig ìre.",
        },
        "ui.stats.show_totals": {
            "title": "Seall na suimean",
            "description": "Sealltainn iomlanan ri taobh staitistig nuair a tha sin iomchaidh. Chan eil dìomhaireachdan air an toirt buaidh leis an suidheachadh seo.",
        },
        "ui.stats.style": {
            "title": "Stoidhle staitistig",
            "description": "Smachd air mar a thèid an còmhradh staitistig a thaisbeanadh.\n\n- Furasta: seall an cruth nas sìmplidh gun fhrèam.\n- Leacanach: seall an cruth le bogsaichean.",
        },
        "ui.stats_background_style": {
            "title": "Dealbh-cùil staitistig",
            "description": "Atharraichidh an doigh anns a bhitheas an dealbh-cùil air a shealltainn san sgrion-staitistig.\n\n- Dorcha: TR1 (PC).\n- Fìor dhorcha: TR1 (PS1).\n- Statach: TR2 (PC).\n- Crathadh: TR2 (PS1).\n- Aon-dhathach: TR3.",
        },
        "ui.stats_fade_effects": {
            "title": "Buaidhean falamh staitistig",
            "description": "A' rèiteachadh gu mionaideach na buaidhean falamh airson an cleachdadh neo an cur dheth air scrion staitistig deireadh ìre. Feumaidh an roghainn Buaidhean Falamh a bhith air a thaghadh gus seo obrachadh.",
        },
        "ui.text_scale": {
            "title": "Meud teacsa",
            "description": "Atharraicheas meud an teacsa.",
        },
        "visuals.background_brightness": {
            "title": "Soilleireachd dealbhan",
            "description": "Atharraichidh soilleireachd nan dealbhan agus nam pàtranan cùlaibh.",
        },
        "visuals.blood_effects": {
            "title": "Buaidhean fuil",
            "description": "Smachd air dathan spàirn fola.\n\n- Ciorramh: chan eilear a’ sealltainn spàirn fola sam bith.\n- Pinc: an àbhaist ann an sgaoilidhean PC Gearmailteach de TR3.\n- Dearg: an àbhaist anns a h-uile sgaoileadh reic eile.",
        },
        "visuals.braid_status": {
            "title": "Feaman-fuilt Lara",
            "description": "An doiugh anns a bhitheas feaman-fuilt Lara air an sealltainn.\n\n- Dheth: cha tèid feaman-fuilt Lara a shealltainn idir.\n- Air: thèid feaman-fuilt Lara a shealltainn leis na h-aodach uile a tha a' cur taic riutha.\n- Fèin-obrachail: tha feaman-fuilt Lara dheth leis na h-aodach àbhaisteach TR1 agus air leis na h-aodach eile uile a tha a' cur taic riutha.",
        },
        "visuals.breeze_mode": {
            "title": "Gaoth",
            "description": "Cuiridh seo buaidh na gaoithe air feaman-fuilt Lara, boinneagan uisge a' thuiteas far Lara, agus an t-uisge/sneachd ann an seòmraichean freagarrach.\n\n- Dheth: cuir à comas buaidh na gaoithe.\n- TR2: bidh a' ghaoth an-còmhnaidh a' sèideadh air aon taobh.\n- TR3/4: bidh taobh na gaoithe ag atharrachadh thar ùine.",
        },
        "visuals.camera_mode": {
            "title": "Modh camara",
            "description": "Taghaidh seo giùlan camara dè an geama a thèid a chleachdadh.\n\n- TR1: leanaidh an camara-tòrachd bogsaichean lorg-slighe na h-ìre.\n- TR2: an aon rud, le crìochan tòrachd is seallaidh eadar-dhealaichte agus dòigh eile air camarathan suidhichte a làimhseachadh.\n- TR3: cleachdaidh an camara-tòrachd loidhne-seallaidh an àite nam bogsaichean lorg-slighe.\n- TR4: mar TR3, agus freagraidh an camara cuideachd nuair a ghluaiseas gnìomh sealladh Lara, mar a bhith a' togail nì no a' dol timcheall oisean 'na crochadh.",
        },
        "visuals.enable_3d_pickups": {
            "title": "Togail 3D",
            "description": "Cuiridh seo modailean 3D an àite spraidean airson nithean togail.",
        },
        "visuals.enable_droplets": {
            "title": "Boinnean uisge",
            "description": "Leigeas le boinnean uisge sileadh far Lara às dèidh dhi an t-uisge fhàgail.",
        },
        "visuals.enable_exit_fade_effects": {
            "title": "Dorchachadh aig fàgail",
            "description": "Cuiridh seo dorchachadh an comas nuair a dh'fhàgas tu an geama gu deasg.",
        },
        "visuals.enable_fade_effects": {
            "title": "Buaidhean dorchachaidh",
            "description": "Cuiridh seo dorchachadh eadar gluasadan air adhart — m.e. eadar grafaigean creideis neo clàr-seilbhe.",
        },
        "visuals.enable_fire_lighting": {
            "title": "Lasadh teine",
            "description": "Cuiridh seo comas air solas fiùghantach a bhith air a chruthachadh ri taobh lasraichean gnìomhach.",
        },
        "visuals.enable_fog_bulbs": {
            "title": "Builgeanan ceò",
            "description": "Cuiridh seo comas air èifeachdan ceò a chaidh an suidheachadh anns na h-ìrean.",
        },
        "visuals.enable_footprints": {
            "title": "Clachan-coise",
            "description": "Leigeas le clachan-coise Lara a nochdadh air uachdaran sònraichte ann an ìrean taicichte.",
        },
        "visuals.enable_glide_cameras": {
            "title": "Camarathan sleamhainn",
            "description": "Cuir an comas gluasad sleamhainn air camarathan stèidhichte a bhios a' coimhead air Lara le lùb astair rèidh a chleachdadh. Ma tha e à comas, atharraichidh na camarathan seo an sealladh sa bhad.",
        },
        "visuals.enable_gun_glow": {
            "title": "Soillseachadh gunna",
            "description": "Cuiridh seo gàir mun cuairt air losgadh gunna agus lòchran gu leth-truailleach, mar a chìthear anns an dreach TR2 PS1.",
        },
        "visuals.enable_gun_lighting": {
            "title": "Solais armachd",
            "description": "Cuiridh seo solais beòthail ri losgadh agus spreadhadh.",
        },
        "visuals.enable_photo_mode_collision": {
            "title": "Bualadh modh dhealbhan",
            "description": "Leanntaidh an camara geoimeatraidh na h-ìre ann am modh dhealbhan. Ma tha seo à comas, faodaidh an camara gluasad gu saor tro bhallachan, mullaichean agus an làir.",
        },
        "visuals.enable_poison_vision": {
            "title": "Sealladh puinnseanta",
            "description": "Buaileas am faicsinneachd fhad 's a tha Lara puinnseanta. Cuir dheth ma tha thu buailteach do tinneas gluasad.",
        },
        "visuals.enable_ps1_crystals": {
            "title": "Dath criostail PS1",
            "description": "Bidh na criostalan sàbhalaidh purpaidh mar a tha iad anns a' PhS1.",
        },
        "visuals.enable_ps1_rain": {
            "title": "Boinneagan uisge PS1",
            "description": "Thèid boinneagan uisge a chur ris an t-sealladh seach am measgachadh ann, agus mar sin bidh iad bàn mar a bha iad air a' PS1.",
        },
        "visuals.enable_reflections": {
            "title": "Meòrachadh",
            "description": "Cuiridh seo meòrachadh air nithean sònraichte an comas.",
        },
        "visuals.enable_shotgun_flash": {
            "title": "Lasadh gunna-sgaoil",
            "description": "Cuiridh seo lasair an sàs nuair a losgais an gunna-sgaoil, coltach ri armachd eile.",
        },
        "visuals.enable_skybox": {
            "title": "Bogsa-nan-Speuran",
            "description": "Cuiridh seo bogsa-nan-speuran an comas ann an ìrean far a bheil e freagarrach.",
        },
        "visuals.enable_static_lighting": {
            "title": "Solas air mogalan statach",
            "description": "Leigidh seo le lasraichean is solais fiùghantach eile mogalan statach a shoillseachadh. Chan eil TR4 tùsail a' soillseachadh ach geoimeatraidh nan seòmraichean.",
        },
        "visuals.enable_weather": {
            "title": "Aimsir",
            "description": "Cuir air neo dheth an aimsir anns na h-ìrean anns a bheil i an àite.",
        },
        "visuals.fix_animated_sprites": {
            "title": "Càraich beòthachaidhean spraidean",
            "description": "Ceartachaidh nan sprìodan lusan fo uisge tùsail gus an gluasad gu ceart ann an raointean uisge.",
        },
        "visuals.fix_item_rots": {
            "title": "Càraich suidheachadh nithean",
            "description": "Ceartaichidh seo grunn dhuilgheadasan anns na geamannan tùsail a tha air an adhbhrachadh le nithean air an cur no air an stiùireadh gu ceàrr.",
        },
        "visuals.fix_smoke_emitters": {
            "title": "Ceartaich sgaoiladairean ceò",
            "description": "Ceartaich sgaoiladairean ceò a bu chòir a bhith air an sealltainn dubh ach a th'air an sealltainn geal.",
        },
        "visuals.fix_texture_issues": {
            "title": "Càraich duilgheadasan inneach",
            "description": "Càradh bugan tùsail le inneach neo modalan a tha ceàrr neo a dhìth.",
        },
        "visuals.fog_color": {
            "title": "Dath ceò",
            "description": "Dath a' cheòth.",
        },
        "visuals.fog_end": {
            "title": "Deireadh ceò",
            "description": "Suidhichidh seo an astar (ann an leacan) bhon chamara far a dhùnas ceò air a h-uile càil. Anns an TR2 is TR3 thùsail, tachraidh sin aig 20 leac. Faodaidh ìre luach dhi fhèin a ghiùlan, agus thèid sin a chleachdadh na àite.",
        },
        "visuals.fog_start": {
            "title": "Tòiseachadh ceò",
            "description": "Suidhichidh seo an astar (ann an leacan) bhon chamara far a thoisicheas ceò. Anns an TR2 is TR3 thùsail, tòisichidh e aig 12 leac. Faodaidh ìre luach dhi fhèin a ghiùlan, agus thèid sin a chleachdadh na àite.",
        },
        "visuals.fog_transparency": {
            "title": "Follaiseachd a' cheòth",
            "description": "Leigidh seo le sealladh geoimeatraidh a tha fada air falbh bhon a' chamara a bhith follaiseachd gu h-iomlan.",
        },
        "visuals.fov": {
            "title": "Raonadh seallaidh",
            "description": "Ceàrn seallaidh ann an ceumannan. Bidh luachan nas motha a' leudachadh raon seallaidh, agus bidh luachan nas lugha ga chuingealachadh.",
        },
        "visuals.game_brightness": {
            "title": "Soilleireachd",
            "description": "Cuiridh seo atharrachadh air soilleireachd a' gheama.",
        },
        "visuals.gamma": {
            "title": "Gamma",
            "description": "Cuir buaidh air dorchadas a' gheama. Tha luachan nas àirde a' ciallachadh solas nas soilleire. Tha luach 2.5 a' ciallachadh dathan àbhaisteach.",
        },
        "visuals.golden_lara": {
            "title": "\\{review}Lara Òir",
            "description": "\\{review}Tionndaidhidh seo Lara gu òr, ge b' e dè an t-aodach a th' oirre, mar a nì làmh Mhìdeis.",
        },
        "visuals.lara_outfit": {
            "title": "Aodach Lara",
            "description": "Atharraicheas seo coltas Lara. Ma thèid Bunaiteach a thaghadh, thèid atharrachaidhean aodaich àbhaisteach eadar ìrean a chumail; airson dad sam bith eile, mairidh an t-aodach a chaidh a thaghadh gus an tèid atharrachadh le làimh.",
        },
        "visuals.logo_locale": {
            "description": "\\{review}Dè an suaicheantas a sheallas sgrìn an tiotail. Tha fear ann sa gheama thùsail airson gach cànan anns an deach fhoillseachadh.",
            "title": "\\{review}Suaicheantas an tiotail",
            "values": {
                "de": "\\{review}Gearmailtis",
                "en-gb": "\\{review}Beurla (RA)",
                "en-us": "\\{review}Beurla (SA)",
                "fr": "\\{review}Fraingis",
            }
        },
        "visuals.shadow_type": {
            "title": "Cruth nan faileasan",
            "description": "Tagh mar a thèid faileasan nithean air an sealltainn.\n\n- Ochd-cheàrnach: faileas seann TR1 agus TR2\n- Cearcall: faileas cruinn\n- Spraide: faileas stèidhichte air teacsa TR3",
        },
        "visuals.sunglasses_mode": {
            "title": "Speuclairean-grèine Lara",
            "description": "Atharraichidh seo stoidhle speuclairean-grèine Lara. Nòta: bidh na lionsan meòrachail ma tha an roghainn iomchaidh air a chur an comas.\n\n- Dheth: Cha bhi speuclairean-grèine air Lara.\n- Neo-shoilleir: Bidh lionsan neo-shoilleir air speuclairean-grèine Lara.\n- Follaiseach: Bidh lionsan leth-fhoilleiseach air speuclairean-grèine Lara.",
        },
        "visuals.ui_brightness": {
            "title": "Soilleireachd EA",
            "description": "Cuiridh seo atharrachadh air soilleireachd na h-eadar-aghaidh.",
        },
        "visuals.water_color": {
            "title": "Dath an uisge",
            "description": "Dath an uisge.",
        },
        "visuals.water_color_mode": {
            "description": "Modh dath an uisge a thèid a chleachdadh. Nuair a tha ro-shuidheachadh air a thaghadh, cumaidh e dath an uisge gu h-ìosal; fàgaidh Gnàthaichte an dath sin agad fhèin.",
            "title": "Ro-shuidheachadh dath an uisge",
            "values": {
                "custom": "Gnàthaichte",
                "dos": "DOS",
                "pc": "PC",
                "pc_hardware": "PC (bathar-cruaidh)",
                "pc_software": "PC (bathar-bog)",
                "ps1": "PS1",
                "tombati": "TombATI",
            }
        },
        "visuals.water_tint_mode": {
            "title": "\\{review}Dath an uisge",
            "description": "\\{review}Dè uiread de Lara a ghabhas dath an uisge fhad 's a tha i san uisge. Bidh Slàn a' dathadh a h-uile pàirt dhith, mar a nì TR1 is TR2. Bidh A rèir mogail a' dathadh gach mogail a rèir far a bheil e, mar a nì TR3 is TR4. Bidh Freagarrach ga gearradh aig uachdar an uisge, agus mar sin cha ghabh ach na tha fon uisge an dath.",
        },
        "window.is_fullscreen": {
            "title": "\\{review}Làn-sgrìn",
            "description": "\\{review}Lìonaidh e an sgrìn, no ruithidh e ann an uinneag.",
        }
    },
