        },
        "ui.stats.show_secrets": {
            "title": "Odnalezione sekrety",
            "description": "Pokazuje liczbę zebranych sekretów w statystykach.",
        },
        "ui.stats.show_time_taken": {
            "title": "Czas",
            "description": "Pokazuje czasu ukończenia poziomu lub gry w statystykach.",
        },
        "ui.stats.show_totals": {
            "title": "Pokaż maksymalne wartości",
            "description": "Pokazuje maksymalne wartości obok opcji, w których jest to możliwe. Nie dotyczy sekretów, które zawsze pokazują maksymalną wartość.",
        },
        "ui.stats.style": {
            "title": "Styl statystyk",
            "description": "Kontroluje sposób wyświetlania okna statystyk.\n\n- Prosty: pokazuje układ bez ramki (TR1).\n- Z obramowaniem: pokazuje układ z ramką (TR2+).",
        },
        "ui.stats_background_style": {
            "title": "Tło statystyk",
            "description": "Zmienia sposób wyświetlania tła dla statystyk na końcu poziomu.\n\n- Ciemne: TR1 (PC).\n- Bardzo ciemne: TR1 (PS1).\n- Stałe: TR2 (PC).\n- Falujące: TR2 (PS1).\n- Czarno-białe: TR3.",
        },
        "ui.stats_fade_effects": {
            "title": "Efekty przejścia w statystykach",
            "description": "Włącza lub wyłącza efekty przejścia na ekranach statystyk. Wymaga opcji ogólnych efektów przejścia do działania.",
        },
        "ui.text_scale": {
            "title": "Skala tekstu",
            "description": "Zmienia rozmiar tekstu interfejsu.",
        },
        "visuals.background_brightness": {
            "title": "\\{review}Jasność tła",
            "description": "\\{review}Zmienia jasność obrazów i wzorów tła.",
        },
        "visuals.blood_effects": {
            "title": "Efekty krwi",
            "description": "Zmienia kolor efektów krwi.\n\n- Wyłączone: nie pokazuje krwi.\n- Różowe: domyślny kolor w niemieckiej wersji PC TR3.\n- Czerwone: domyślne we wszystkich innych wersjach.",
        },
        "visuals.breeze_mode": {
            "title": "Wiatr",
            "description": "\\{review}Zmienia sposób, w jaki bryza wpływa na warkocz Lary, krople wody spadające z Lary oraz deszcz/śnieg w odpowiednich pomieszczeniach.\n\n- Wyłączone: wyłącza efekt bryzy.\n- TR2: bryza zawsze wieje w tym samym kierunku.\n- TR3/4: kierunek bryzy zmienia się z upływem czasu.",
        },
        "visuals.camera_mode": {
            "title": "Tryb kamery",
            "description": "\\{review}Wybiera, z której gry pochodzi zachowanie kamery.\n\n- TR1: kamera podążająca korzysta z siatki nawigacji poziomu.\n- TR2: to samo, z innymi ograniczeniami podążania i rozglądania się oraz inną obsługą kamer stałych.\n- TR3: kamera podążająca korzysta z linii wzroku zamiast siatki nawigacji.\n- TR4: jak TR3, a kamera reaguje też, gdy jakaś akcja przesuwa widok Lary, na przykład podnoszenie przedmiotu lub obchodzenie narożnika w zwisie.",
        },
        "visuals.enable_3d_pickups": {
            "title": "Znajdźki 3D",
            "description": "Rysuje przedmioty do podniesienia jako trójwymiarowe modele zamiast płaskich grafik.",
        },
        "visuals.enable_braid": {
            "title": "Warkocz Lary",
            "description": "Włącza warkocz Lary.",
        },
        "visuals.enable_droplets": {
            "title": "\\{review}Krople wody",
            "description": "\\{review}Włącza wyświetlanie kropli wody skapujących z Lary po wyjściu z wody.",
        },
        "visuals.enable_exit_fade_effects": {
            "title": "Przejścia przy wyjściu z gry",
            "description": "Włącza efekt płynnego przejścia przy wychodzeniu z gry do pulpitu.",
        },
        "visuals.enable_fade_effects": {
            "title": "Efekty przejścia",
            "description": "Włącza efekty płynnych przejść, np. między grafikami napisów końcowych, lub przy włączaniu ekranu ekwipunku i ekranu pauzy.",
        },
        "visuals.enable_fire_lighting": {
            "title": "Światło dookoła ogni",
            "description": "Włącza generowanie dynamicznego oświetlenia obok aktywnych płomieni.",
        },
        "visuals.enable_fog_bulbs": {
            "title": "\\{review}Kule mgły",
            "description": "\\{review}Włącza wolumetryczne efekty mgły rozmieszczone w poziomach.",
        },
        "visuals.enable_footprints": {
            "title": "Ślady stóp",
            "description": "Włącza wyświetlanie śladów stóp Lary na niektórych powierzchniach w obsługiwanych poziomach.",
        },
        "visuals.enable_glide_cameras": {
            "title": "Płynne kamery",
            "description": "Włącza efekt płynnych przejść dla kamer skierowanych na Larę. Wyłączenie tej opcji spowoduje natychmiastową zmianę widoku na Larę.",
        },
        "visuals.enable_gun_glow": {
            "title": "\\{review}Poświata broni",
            "description": "\\{review}Renderuje błyski broni i flar półprzezroczyste oraz dodaje wokół nich efekt rozbłysku, jak w wersji TR2 na PS1.",
        },
        "visuals.enable_gun_lighting": {
            "title": "Efekty świetlne broni",
            "description": "Włącza dynamiczne oświetlenie przy strzelaniu z broni i eksplozjach.",
        },
        "visuals.enable_poison_vision": {
            "title": "\\{review}Zatrute widzenie",
            "description": "\\{review}Zniekształca widok, gdy Lara jest zatruta. Wyłącz, jeśli masz skłonność do choroby lokomocyjnej.",
        },
        "visuals.enable_ps1_crystals": {
            "title": "Fioletowe kryształy",
            "description": "Kryształy zapisu będą rysowane z fioletowym odcieniem, bardziej podobnym do odcienia z PS1.",
        },
        "visuals.enable_ps1_rain": {
            "title": "\\{review}Krople deszczu z PS1",
            "description": "\\{review}Krople deszczu będą dodawane do sceny zamiast wtapiane w nią, dzięki czemu będą jasne jak na PS1.",
        },
        "visuals.enable_reflections": {
            "title": "Odbicia",
            "description": "Włącza efekt lustrzanych odbić na niektórych obiektach.",
        },
        "visuals.enable_responsive_mesh_tint": {
            "title": "Reaktywne barwienie wody",
            "description": "Nadaje częściom ciała Lary wodne zabarwienie tylko wtedy, gdy znajdują się pod wodą (styl TR3). Przy wyłączonej opcji, zabarwienie jest nadawane całemu ciału Lary (styl TR1/2).",
        },
        "visuals.enable_shotgun_flash": {
            "title": "Rozbłyski ze strzelby",
            "description": "Rysuje płomienie podczas strzelania ze strzelby, jak w przypadku innych broni.",
        },
        "visuals.enable_skybox": {
            "title": "Niebo",
            "description": "Włącza niebo w obsługiwanych poziomach.",
        },
        "visuals.enable_static_lighting": {
            "title": "\\{review}Oświetlenie statycznych meshy",
            "description": "\\{review}Pozwala płomieniom i innym dynamicznym światłom oświetlać statyczne meshe. Oryginalny TR4 oświetla wyłącznie geometrię pomieszczeń.",
        },
        "visuals.enable_weather": {
            "title": "Pogoda",
            "description": "Włącza efekty pogodowe w obsługiwanych poziomach.",
        },
        "visuals.fix_animated_sprites": {
            "title": "Napraw animacje sprite'ów",
            "description": "Przywraca glonom efekt animacji w wodnych poziomach.",
        },
        "visuals.fix_item_rots": {
            "title": "\\{review}Napraw pozycje obiektów",
            "description": "\\{review}Naprawia kilka błędów z oryginalnych gier spowodowanych nieprawidłowym rozmieszczeniem lub orientacją obiektów.",
        },
        "visuals.fix_texture_issues": {
            "title": "Napraw tekstury",
            "description": "Naprawia błędy oryginalnej gry zw. z brakującymi lub nieprawidłowymi teksturami.",
        },
        "visuals.fog_color": {
            "title": "Kolor mgły",
            "description": "Kolor mgły.",
        },
        "visuals.fog_end": {
            "title": "Koniec mgły",
            "description": "\\{review}Ustala odległość w sektorach, w której gra przestaje rysować poziom. W oryginalnych TR2 i TR3 dzieje się to przy 20 sektorach. Poziom może mieć własną wartość, która jest wtedy używana.",
        },
        "visuals.fog_start": {
            "title": "Początek mgły",
            "description": "\\{review}Ustala odległość w sektorach, w której gra zaczyna ograniczać widoczność. W oryginalnych TR2 i TR3 zaczyna się to przy 12 sektorach. Poziom może mieć własną wartość, która jest wtedy używana.",
        },
        "visuals.fog_transparency": {
            "title": "Przezroczystość mgły",
            "description": "Obiekty oddalone od kamery będą się stawać coraz bardziej przezroczyste.",
        },
        "visuals.fov": {
            "title": "Kąt widzenia",
            "description": "Kąt widzenia w stopniach. Większe wartości poszerzają pole widzenia, mniejsze je zmniejszają.",
        },
        "visuals.game_brightness": {
            "title": "Jasność",
            "description": "Zmienia jasność gry.",
        },
        "visuals.gamma": {
            "title": "Gamma",
            "description": "Reguluje krzywą gamma. Wyższe wartości oznaczają jaśniejsze oświetlenie. Wartość 2,5 wyłącza modulację.",
        },
        "visuals.golden_lara": {
            "title": "\\{review}Złota Lara",
            "description": "\\{review}Zamienia Larę w złoto, niezależnie od noszonego stroju, tak jak ręka Midasa.",
        },
        "visuals.lara_outfit": {
            "title": "Strój Lary",
            "description": "Zmienia strój Lary. Opcja domyślna zachowuje standardowe zmiany między poziomami; w przeciwnym razie wybrany strój pozostaje aktywny, dopóki nie zostanie zmieniony ręcznie.",
        },
        "visuals.shadow_type": {
            "title": "Kształt cieni",
            "description": "Wybiera sposób rysowania cieni obiektów.\n\n- Ośmiokąt: stare cienie z TR1 i TR2\n- Elipsa: zaokrąglone cienie\n- Sprite: cienie oparte na teksturach z TR3",
        },
        "visuals.sunglasses_mode": {
            "title": "Okulary przeciwsłoneczne",
            "description": "Zmienia styl okularów przeciwsłonecznych Lary. Uwaga: jeśli opcja odbić jest włączona, soczewki będą refleksyjne.\n\n- Wyłączone: Lara nie będzie nosić okularów przeciwsłonecznych.\n- Nieprzezroczyste: okulary będą miały nieprzezroczyste soczewki.\n- Przezroczyste: okulary będą miały półprzezroczyste soczewki.",
        },
        "visuals.ui_brightness": {
            "title": "Jasność interfejsu",
            "description": "Zmienia jasność interfejsu.",
        },
        "visuals.water_color": {
            "title": "Kolor wody",
            "description": "Kolor wody.",
        },
        "visuals.water_color_mode": {
            "description": "\\{review}Który podwodny odcień ma zostać użyty. Dopóki ustawienie jest wybrane, utrzymuje kolor wody poniżej; Własny pozostawia ten kolor tobie.",
            "title": "\\{review}Ustawienie koloru wody",
            "values": {
                "custom": "\\{review}Własny",
                "dos": "\\{review}DOS",
                "pc": "\\{review}PC",
                "pc_hardware": "\\{review}PC (sprzętowy)",
                "pc_software": "\\{review}PC (programowy)",
                "ps1": "\\{review}PS1",
                "tombati": "\\{review}TombATI",
            }
        },
        "window.is_fullscreen": {
            "title": "\\{review}Pełny ekran",
            "description": "\\{review}Wypełnia ekran lub działa w oknie.",
        }
    },
