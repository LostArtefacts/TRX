        },
        "ui.enemy_healthbar_show_mode": {
            "title": "Tryb paska wroga",
            "description": "\\{review}Określa, kiedy pokazywany jest pasek zdrowia namierzonego przez Larę wroga.\n\n- Zawsze: pokazuj dla każdego celu.\n- Tylko bossowie: pokazuj tylko, gdy celem jest boss.\n- Wyłączony: nigdy nie pokazuj.",
