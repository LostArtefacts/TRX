        },
        "ui.stats.show_deaths": {
            "title": "Śmierci",
            "description": "Pokazuje liczbę śmierci Lary w statystykach. Liczba śmierci jest aktualizowana w aktualnie załadowanym zapisie w momencie śmierci.",
        },
        "ui.stats.show_distance_travelled": {
            "title": "Przebyta odległość",
            "description": "Pokazuje przebytą odległość w km w statystykach.",
        },
        "ui.stats.show_kills": {
            "title": "Zabójstwa",
            "description": "Pokazuje liczbę pokonanych przeciwników w statystykach.",
        },
        "ui.stats.show_level_header": {
            "title": "Aktualny poziom",
            "description": "Pokazuje aktualny numer poziomu na górze statystyk.",
        },
        "ui.stats.show_medipacks_used": {
            "title": "Użyte apteczki",
            "description": "Pokazuje ilość zużytych apteczek w statystykach (mała apteczka = 0.5, duża apteczka = 1).",
        },
        "ui.stats.show_pickups": {
            "title": "Zebrane przedmioty",
