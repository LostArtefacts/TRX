        "audio.enable_underwater_anim_sfx": {
            "title": "Efekty dźwiękowe pod wodą",
            "description": "Włącza odtwarzanie określonych efektów dźwiękowych animacji – dla obiektów takich jak drzwi i włazy – gdy kamera jest pod wodą.",
        },
        "audio.fix_chainblock_secret_sound": {
            "title": "Napraw dźwięku blokady łańcucha",
            "description": "\\{review}Zapobiega nieprawidłowemu odtwarzaniu dźwięku sekretu po użyciu złotego klucza w Grobowcu Tihocana w TR1.",
        },
        "audio.fix_secrets_killing_music": {
            "title": "Warstwowe dźwięki sekretów",
            "description": "Sprawia, że podnoszenie sekretów nie zatrzymuje aktualnie odtwarzanej muzyki.",
        },
        "audio.fix_sliding_sfx": {
            "title": "\\{review}Napraw odgłosy ślizgania",
            "description": "\\{review}Naprawia dalsze odtwarzanie odgłosów ślizgania Lary, gdy nie znajduje się już ona w prawidłowym stanie ślizgania (styl TR3+). Wyłączenie tej opcji pozwala odgłosom zakończyć odtwarzanie normalnie, niezależnie od stanu Lary (styl TR1/2).",
        },
        "audio.fix_speeches_killing_music": {
            "title": "Warstwowe wypowiedzi wrogów",
            "description": "Sprawia, że wypowiedzi wrogów nie zatrzymuje aktualnie odtwarzanej muzyki.",
        },
        "audio.fmv_volume": {
            "title": "Głośność filmów",
            "description": "Reguluje głośność filmów.",
        },
        "audio.inventory_ambient_volume": {
            "title": "Głośność otoczenia (ekwipunek)",
            "description": "Reguluje głośność otoczenia na ekranie ekwipunku.",
        },
        "audio.inventory_music_volume": {
            "title": "Głośność muzyki (ekwipunek)",
            "description": "Reguluje głośność muzyki na ekranie ekwipunku.",
        },
        "audio.load_music_triggers": {
            "title": "Napraw wyzwalacze muzyki",
            "description": "Ładuje wcześniej wyzwolone utwory muzyczne, tak aby jednorazowe ścieżki nie były odtwarzane ponownie.",
        },
        "audio.master_volume": {
            "title": "Głośność",
            "description": "Reguluje głośność wszystkich dźwięków w grze. Pozostałe ustawienia są względem tej głośności.",
        },
        "audio.music_load_condition": {
            "title": "\\{review}Muzyka po wczytaniu",
            "description": "Ładuje ścieżkę dźwiękową graną podczas zapisu gry.\n\n- Nigdy: restartuje dźwięki otoczenia od 0.\n- Tylko muzyka: przywraca utwory muzyczne.\n- Zawsze: przywraca także dźwięki otoczenia od momentu, w którym gracz dokonał zapisu.",
        },
        "audio.music_volume": {
            "title": "\\{icon music} Głośność muzyki",
            "description": "Reguluje głośność muzyki.",
        },
        "audio.mute_out_of_focus": {
            "title": "\\{review}Wycisz w tle",
            "description": "Wycisza muzykę i efekty dźwiękowe, kiedy okno gry jest nieaktywne.",
        },
        "audio.sound_volume": {
            "title": "\\{icon sound} Głośność dźwięku",
            "description": "Dostosowuje głośność efektów dźwiękowych.",
        },
        "audio.underwater_ambient_volume": {
            "title": "Głośność otoczenia (pod wodą)",
            "description": "Reguluje głośność otoczenia pod wodą.",
        },
        "audio.underwater_music_volume": {
            "title": "Głośność muzyki (pod wodą)",
            "description": "Reguluje głośność muzyki pod wodą.",
        },
        "debug.enable_endless_flare_time": {
            "title": "Nielimitowany czas flar",
            "description": "Zapobiega wygasaniu flar. Rzucone flary nadal gasną normalnie.",
        },
        "debug.enable_endless_sprint": {
            "title": "Nielimitowany sprint",
            "description": "Lara nie męczy się podczas biegu, lecz przeszkody wciąż ją zatrzymują.",
        },
        "gameplay.ally_hostility_policy": {
            "title": "Wrogość sojuszników",
            "description": "Kontroluje zachowanie jednostek kiedy zostaną zranione przez gracza.\n\n- Indywidualne: każdy sojusznik zmienia wrogość samodzielnie (styl TR3).\n- Współdzielone: wszyscy sojusznicy stają się wrodzy jednocześnie (styl mnichów z TR2).",
        },
        "gameplay.camera_speed": {
            "title": "Prędkość kamery",
            "description": "Zmienia prędkość, z jaką porusza się manualna kamera.",
        },
        "gameplay.change_pierre_spawn": {
            "title": "Zmień tryb pojawiania się Pierre'a",
            "description": "Włączenie tej opcji sprawi, że podczas przechodzenia przez określone miejsca Pierre pojawi się bliżej. Jeśli opcja jest wyłączona, nic się nie zmieni. Dotyczy tylko sytuacji, gdzie nie Lara nie przegoniła Pierre'a.",
        },
        "gameplay.creature_drown_policy": {
            "title": "Zasady tonięcia stworzeń",
            "description": "Określa zachowanie stworzeń lądowych w pomieszczeniach z wodą.\n\n- Wyłączone: stworzenia lądowe nigdy nie toną (styl TR1).\n- Domyślne: stworzenia lądowe toną w wodzie o głębokości 2 klików lub większej (styl TR2/3).\n- Zanurzone: stworzenia lądowe toną tylko wtedy, gdy są całkowicie zanurzone.",
        },
        "gameplay.disable_extra_guns": {
            "title": "Wyłącz dodatkowe bronie",
            "description": "Usuwa wszystkie bronie i amunicję z gry z wyjątkiem pistoletów.",
        },
        "gameplay.disable_healing_between_levels": {
            "title": "Trwałe obrażenia",
            "description": "Wyłącza leczenie Lary, gdy gracz zaczyna nowy poziom.",
        },
        "gameplay.disable_medpacks": {
            "title": "Wyłącz apteczki",
            "description": "Usuwa wszystkie apteczki z gry.",
        },
        "gameplay.disable_trex_collision": {
            "title": "Usuń kolizję z ubitym T-Rexem",
            "description": "Usuwa wszelką kolizję z tyranozaurem po jego śmierci, co pomaga w sytuacjach, gdy jego cielsko uniemożliwia przejście.",
        },
        "gameplay.enable_ally_kill_count": {
            "title": "\\{review}Licz zabójstwa od sojuszników",
            "description": "Uwzględnia zabójstwa wrogów dokonane przez sojuszników Lary do łącznej liczby pokonanych przeciwników.",
        },
        "gameplay.enable_ally_targeting": {
            "title": "Pozwól na celowanie w sojuszników",
            "description": "Pozwala Larze celować w sojuszników, np. mnichów. Jeśli opcja jest wyłączona, sojusznicy będą całkowicie odporni na amunicję Lary.",
        },
        "gameplay.enable_alternative_turns": {
            "title": "\\{review}Alternatywne obroty",
            "description": "\\{review}Pozwala Larze wykonywać alternatywne obroty i skręty, gdy stoi w miejscu.\n\n- Naciśnij jednocześnie przewrót i skok, aby wykonać obrót w miejscu.\n- Naciśnij jednocześnie przewrót i chód, aby szybko obrócić się w miejscu.\n- Naciśnij przycisk przewrotu na drążkach, aby szybko obrócić się w miejscu.",
        },
        "gameplay.enable_auto_item_selection": {
            "title": "Preselekcja przedmiotów",
            "description": "Kiedy Lara spróbuje wejść w interakcję z zamkiem lub slotem na przedmiot i ma odpowiednią rzecz w plecaku, zostanie ona automatycznie wybrana.",
        },
        "gameplay.enable_back_slope_stumble": {
            "title": "Potknięcia na spadach do tyłu",
            "description": "Powoduje, że Lara potyka się, gdy się cofa, a za nią znajduje się pochylnia (TR3). Przy wyłączonej opcji, Lara zatrzymuje się gwałtownie na pochylniach (TR1/2).",
        },
        "gameplay.enable_binoculars": {
            "title": "\\{review}Lornetka",
            "description": "\\{review}Udostępnia lornetkę do wyboru w ekwipunku.",
        },
        "gameplay.enable_body_bags": {
            "title": "Usuwanie ciał",
            "description": "Umożliwia usuwanie zabitych przeciwników, gdy Lara przekracza określone wyzwalacze na niektórych poziomach. Wyłączenie tej opcji spowoduje, że martwi przeciwnicy będą zawsze wyświetlani.",
        },
        "gameplay.enable_boulder_shake": {
            "title": "Wstrząsy kamery od głazów",
            "description": "Włączenie opcji spowoduje wstrząsy kamery, kiedy w pobliżu Lary toczą się głazy.",
        },
        "gameplay.enable_bouncy_grenades": {
            "title": "Odbicia granatów",
            "description": "Włącza zachowanie granatów w stylu TR3 – odbijają się od ścian i pochyłości i zyskują większy promień wybuchu kosztem mniejszej prędkości.",
        },
        "gameplay.enable_cheats": {
            "title": "Cheaty",
            "description": "Włącza różne cheaty:\n\n- \\{input level_skip_cheat}: natychmiast kończy poziom.\n- \\{input item_cheat}: daje Larze wszystkie bronie; zwiększa ilość amunicji i apteczek; daje wszystkie przedmioty z bieżącego poziomu.\n- \\{input fly_cheat}: włącza latanie.\n  - \\{input slow}: wyjście z trybu latania.\n  - \\{input draw}: otwiera najbliższe drzwi.",
        },
        "gameplay.enable_cinematic_skips": {
            "title": "\\{review}Pomijanie scenek",
            "description": "\\{review}Umożliwia pomijanie sekwencji przelotów kamery za pomocą przycisku Wstecz/Menu.",
        },
        "gameplay.enable_cinematics": {
            "title": "Animacje startowe",
            "description": "Włącza specjalne animacje na początku niektórych poziomów.",
        },
        "gameplay.enable_compass_stats": {
            "title": "Statystyki w kompasie",
            "description": "Włącza wyświetlanie statystyk aktualnego poziomu przy wybraniu kompasu.",
        },
        "gameplay.enable_console": {
            "title": "Konsola",
            "description": "Włącza konsolę umożliwiającą wpisywanie różnych komend.",
        },
        "gameplay.enable_continuous_pushblocks": {
            "title": "\\{review}Ciągłe przesuwanie bloków",
            "description": "\\{review}Pozwala Larze na dalsze pchanie lub ciągnięcie bloków tak długo, jak przycisk akcji jest przytrzymany, podobnie jak w TR4+. Jeśli wyłączone, Lara zatrzyma się po każdej animacji pchania/ciągnięcia.",
        },
        "gameplay.enable_controlled_drops": {
            "title": "Bezpieczne krawędzie",
            "description": "Pozwala Larze obrócić się w powietrzu i złapać krawędź z której gracz właśnie się ześliznął, jeśli trzymay jest przycisk akcji.",
        },
        "gameplay.enable_corner_shimmying": {
            "title": "\\{review}Przechodzenie za rogi",
            "description": "\\{review}Pozwala Larze przechodzić za rogi, gdy wisi na krawędzi lub wspina się po ścianie (styl TR4).",
        },
        "gameplay.enable_crawl_jump": {
            "title": "Skok z wąskich przestrzeni",
            "description": "Umożliwia Larze wyskoczenie przy krawędziach w wąskich przestrzeniach, kiedy porusza się na czworaka.",
        },
        "gameplay.enable_crawl_tilt": {
            "title": "Nachylenie podczas czołgania",
            "description": "Dopasowuje rotację Lary do geometrii podłoża podczas czołgania.",
        },
        "gameplay.enable_crawling": {
            "title": "Kucanie",
            "description": "\\{review}Pozwala Larze kucać i chodzić na czwroaka. Występuje od TR3; oryginalne TR1 i TR2 nie mają żadnego z nich.",
        },
        "gameplay.enable_credits": {
            "title": "Napisy końcowe",
            "description": "Włącza ekrany z napisami końcowymi wyświetlane po ukończeniu gry. Ustawienie nie ma wpływu na ekran końcowych statystyk.",
        },
        "gameplay.enable_crouch_roll": {
            "title": "Przewrót z kucania",
            "description": "Pozwala Larze wykonać przewrót w przód z kucania po naciśnięciu klawisza sprintu.",
        },
        "gameplay.enable_cutscenes": {
            "title": "Przerywniki",
            "description": "Włącza odtwarzanie przerywników (cutscenek).",
        },
        "gameplay.enable_demo": {
            "title": "Tryb demo",
            "description": "Włącza odtwarzanie krótkich demonstracyjnych sekwencji w menu głównym.",
        },
        "gameplay.enable_enemy_rotation": {
            "title": "Losuj rotację przeciwników",
            "description": "Zastosowuje dodatkowy losowy kąt do niektórych przeciwników podczas ładowania poziomu.",
        },
        "gameplay.enable_enhanced_saves": {
            "title": "Zapis efektów",
            "description": "Zapisuje efekty graficzne, mgłę wodospadu, emitery płomieni itp., dzięki czemu nie znikają już po wczytaniu.",
        },
        "gameplay.enable_environment_kill_count": {
            "title": "\\{review}Licz śmierci od środowiska",
            "description": "Uwzględnia zabójstwa wrogów przez środowisko, takie jak lasery ochronne lub utonięcie, do łącznej liczby pokonanych przeciwników.",
        },
        "gameplay.enable_fast_pickups": {
            "title": "\\{review}Szybkie podnoszenie",
            "description": "\\{review}Pozwala Larze szybciej podnosić przedmioty, podobnie jak w TR4+.",
        },
        "gameplay.enable_fast_pull_up": {
            "title": "\\{review}Szybkie podciąganie",
            "description": "\\{review}Pozwala Larze szybciej podciągać się na krawędzie.",
        },
        "gameplay.enable_fast_shimmying": {
            "title": "\\{review}Szybkie przemieszczanie w zwisie",
            "description": "\\{review}Pozwala Larze poruszać się szybciej podczas przemieszczania się w lewo lub w prawo w zwisie.",
        },
        "gameplay.enable_fmv": {
            "title": "Filmy",
            "description": "Włącza odtwarzanie filmów.",
        },
        "gameplay.enable_idle_pose_camera": {
            "title": "Kamera bezczynności",
            "description": "Dostosowuje kamerę tak, aby była skierowana na Larę podczas animacji bezczynności. Przycisk patrzenia resetuje kamerę.",
        },
        "gameplay.enable_inverted_look": {
            "title": "Odwrócenie osi Y patrzenia",
            "description": "Odwraca sterowanie rozglądania się w osi Y.",
        },
        "gameplay.enable_item_examining": {
            "title": "Badanie przedmiotów",
            "description": "Pozwala na wyświetlanie opisów przedmiotów w ekwipunku w niestandardowych poziomach, gdzie autor poziomu dostarczył odpowiednie dane.",
        },
        "gameplay.enable_jump_twists": {
            "title": "Przewroty w powietrzu",
            "description": "\\{review}Włącza możliwość przewrotu podczas skakania. Występuje od TR2; oryginalny TR1 nie ma żadnego z nich.",
        },
        "gameplay.enable_killer_pushblocks": {
            "title": "Zabójcze bloki",
            "description": "Kiedy ta opcja jest włączona, spadające z wysokości bloki natychmiast zabijają Larę. W przeciwnym razie Lara stanie na powierzchni bloku i przeżyje (tak jak w oryginalnych grach).",
        },
        "gameplay.enable_lean_jumping": {
            "title": "Dalekie skoki w miejscu",
            "description": "\\{review}Pozwala Larze na przesuwanie się do przodu lub do tyłu dalej podczas wykonywania skoków w miejscu z wciśniętym odpowiednim klawiszem (tak jak w TR2+). W oryginalnym TR1 przesuwa się do przodu niezależnie od wciśniętego klawisza, ale znacznie wolniej.",
        },
        "gameplay.enable_ledge_jumps": {
            "title": "Skoki z krawędzi",
            "description": "Pozwala Larze skoczyć w górę lub do tyłu, gdy zwisa z krawędzi, o ile przed nią znajduje się solidna powierzchnia, od której może się odepchnąć.",
        },
        "gameplay.enable_legal": {
            "title": "Informacje prawne",
            "description": "Włącza ekran z informacjami prawnymi oraz filmik z logiem Core Design na początku gry.",
        },
        "gameplay.enable_manual_camera": {
            "title": "Manualna kamera",
            "description": "Umożliwia klawiszom kamery obracanie jej także podczas gry, nie tylko w trybie zdjęć.",
        },
        "gameplay.enable_multiple_pickups": {
            "title": "\\{review}Podnoszenie wielu przedmiotów",
            "description": "\\{review}Pozwala Larze podnieść wszystkie przedmioty znajdujące się w tym samym miejscu w ramach jednej animacji (TR1–3). Po wyłączeniu tej opcji Lara musi powtórzyć animację dla każdego przedmiotu (TR4+).",
        },
        "gameplay.enable_pickup_aids": {
            "title": "Pomoce do znajdziek",
            "description": "Włącza okazjonalne migotanie w pobliżu przedmiotów do podniesienia w celu zwiększenia ich widoczności.",
        },
        "gameplay.enable_play_previous_levels": {
            "title": "Zagraj w poprzednie poziomy",
            "description": "Włącza funkcje \"Zagraj w poprzednie poziomy\" oraz \"Co się wydarzyło do tej pory\" na ekranie wyboru Nowej Gry.",
        },
        "gameplay.enable_responsive_crawl": {
            "title": "Responsywne kucanie",
            "description": "Włącza ulepszenia względem oryginalnej mechaniki kucania i czołgania.\n\n- Umożliwia szybsze wznowienie czołgania po zatrzymaniu.\n- Umożliwia przejście z biegu/sprintu do kucnięcia bez konieczności wcześniejszego zatrzymania się.\n- Umożliwia przejście z czołgania do przewrotu w przysiadzie (jeśli jest włączony) bez konieczności przejścia w kucnięcie.\n- Umożliwia obracanie się podczas kucania.\n- Przywraca animację podnoszenia przedmiotów podczas czołgania Lary (z wyłączeniem flar).",
        },
        "gameplay.enable_responsive_sprint": {
            "title": "Responsywny sprint",
            "description": "Włącza bardziej responsywny tryb sprintu dla Lary.\n\n- Pozwala sprintować, gdy Lara ma energię, a nie tylko przy pełnej wytrzymałości.\n- Umożliwia sprint po schodach bez przerywania zwykłą animacją biegu.",
        },
        "gameplay.enable_slide_to_run": {
            "title": "Bieg po zjechaniu",
            "description": "Umożliwia Larze natychmiastowe wznowienie biegu po zjechaniu w dół stoku. Aby aktywować, należy przytrzymać przycisk ruchu do przodu.",
        },
        "gameplay.enable_slow_ledge_swing": {
            "title": "Powolne kołysanie na krawędzi",
            "description": "Umożliwia Larze powolne kołysanie się po uchwyceniu bardzo cienkiej krawędzi (styl TR3). Jeśli wyłączone, Lara zakołysze się tylko krótko, po czym wróci do nieruchomej pozycji wiszącej (styl TR1/2).",
        },
        "gameplay.enable_smooth_wall_deflect": {
            "title": "Gładkie odbicia od ściany",
            "description": "\\{review}Pozwala Larze szybciej się odbić po uderzeniu w ścianę, gdy jednocześnie trzymany jest klawisz kierunku oraz do przodu. Występuje od TR2; po wyłączeniu Lara wraca do tempa oryginalnego TR1.",
        },
        "gameplay.enable_snap_interactions": {
            "title": "\\{review}Przyciąganie do interakcji",
            "description": "\\{review}Pozwala Larze natychmiast ustawiać się przy obiektach interaktywnych, takich jak przedmioty do podniesienia i przełączniki. Jeśli opcja jest wyłączona, Lara będzie musiała najpierw całkowicie się zatrzymać, zanim będzie mogła wejść w interakcję. Natychmiastowe ustawianie odpowiada TR1/2, a wcześniejsze zatrzymanie TR3+.",
        },
        "gameplay.enable_soft_statics": {
            "title": "\\{review}Miękka kolizja z obiektami",
            "description": "Pozwala Larze płynnie przesuwać się wzdłuż statycznych obiektów, jak w TR4+, zamiast nagle się zatrzymywać.",
        },
        "gameplay.enable_sprint": {
            "title": "Sprint",
            "description": "Pozwala Larze sprintować, podobnie jak w TR3 i nowszych grach.",
        },
        "gameplay.enable_step_roll_boost": {
            "title": "Przewroty na schodkach",
            "description": "\\{review}Pozwala Larze uzyskać dodatkowy skok z małych schodków, jeśli spróbuje wykonać przewrót blisko krawędzi. Robi tak tylko oryginalny TR1; TR2+ nie.",
        },
        "gameplay.enable_swamp_sidestepping": {
            "title": "\\{review}Kroki w bok na bagnach",
            "description": "\\{review}Umożliwia Larze wykonywanie kroków w bok w pomieszczeniach z bagnem.",
        },
        "gameplay.enable_swing_cancel": {
            "title": "Łapanie krawędzi po puszczeniu",
            "description": "\\{review}Pozwala na anulowanie animacji huśtania Lary na krawędzi poprzez jej puszczenie i szybkie złapanie ponownie (tak jak w TR2+). Oryginalny TR1 na to nie pozwala.",
        },
        "gameplay.enable_timer_in_inventory": {
            "title": "Upływ czasu w ekwipunku",
            "description": "Sprawia, że zegar w grze działa nawet podczas wyświetlania menu ekwipunku.",
        },
        "gameplay.enable_toggle_crouch": {
            "title": "Prostsze kucanie",
            "description": "Pozwala Larze pozostać w kucki po jednokrotnym naciśnięciu przycisku kucania. Naciśnij kucanie ponownie, aby wstać.",
        },
        "gameplay.enable_toggle_sprint": {
            "title": "Prostszy sprint",
            "description": "Pozwala Larze biec sprintem po jednokrotnym naciśnięciu przycisku sprintu. Naciśnij sprint ponownie, aby przestać sprintować.",
        },
        "gameplay.enable_total_stats": {
            "title": "Statystyki końcowe",
            "description": "Włącza ekran finalnych statystyk z całej gry, odtwarzany po napisach końcowych.",
        },
        "gameplay.enable_tr2_jumping": {
            "title": "Responsywne skakanie",
            "description": "\\{review}Pozwala Larze skakać w dowolnym momencie podczas biegu. Występuje od TR2; po wyłączeniu Lara skacze w ustalonych punktach animacji biegu, jak w oryginalnym TR1.",
        },
        "gameplay.enable_tr2_swim_cancel": {
            "title": "Mniejszy dryf pod wodą",
            "description": "\\{review}Pozwala Larze na bardziej responsywne zatrzymanie się pod wodą po zwolnieniu klawisza pływania. Występuje od TR2; po wyłączeniu zatrzymuje się jak w oryginalnym TR1.",
        },
        "gameplay.enable_tr2_swimming": {
            "title": "Zwinniejsze pływanie",
            "description": "Powoduje, że Lara przyspiesza płynniej, ale wolniej podczas obracania pod wodą (tak jak w TR2+). Wyłączenie tej opcji zapewni Larze szybszą prędkość skrętu (tak jak w TR1).",
        },
        "gameplay.enable_underwater_auto_draw": {
            "title": "\\{review}Dobywanie broni pod wodą",
            "description": "\\{review}Sprawia, że klawisz dobycia broni sięga po broń przydatną pod wodą, na przykład harpun, zamiast nie robić nic, gdy ostatnio trzymanej broni nie da się tam użyć.",
        },
        "gameplay.enable_uw_roll": {
            "title": "Przewroty pod wodą",
            "description": "\\{review}Pozwala Larze na przewrót pod wodą. Występuje od TR2; oryginalny TR1 nie ma przewrotu pod wodą.",
        },
        "gameplay.enable_wading": {
            "title": "Brodzenie",
            "description": "\\{review}Pozwala Larze na brodzenie w płytkiej wodzie. Wyłączenie powoduje utknięcie na powierzchni wody. Występuje od TR2; oryginalny TR1 nie pozwala brodzić.",
        },
        "gameplay.enable_walk_to_items": {
            "title": "Animowane interakcje",
            "description": "\\{review}Sprawia, że Lara podchodzi do przedmiotów do podniesienia, przełączników, dziurek od klucza i gniazd zagadek, gdy znajduje się w pobliżu, zamiast teleportować się do nich.",
        },
        "gameplay.fix_alligator_ai": {
            "title": "Napraw AI aligatorów",
            "description": "Naprawia błąd w którym aligatory nie zadają obrażeń, jeśli Lara pozostaje nieruchomo w wodzie.",
        },
        "gameplay.fix_animated_spikes": {
            "title": "\\{review}Napraw animowane kolce",
            "description": "\\{review}Naprawia problem z resetowaniem aktywowanych animowanych kolców po wczytaniu zapisu gry.",
        },
        "gameplay.fix_bear_ai": {
            "title": "Napraw AI niedźwiedzi",
            "description": "Naprawia atak niedźwiedzia, aby nie chybiał Lary.",
        },
        "gameplay.fix_breakable_wall_clip": {
            "title": "\\{review}Napraw kruche ściany",
            "description": "\\{review}Naprawia problem, w którym Lara może podciągnąć się lub przeczołgać przez kruche ściany stojące na krawędzi sektora. Po włączeniu Lara zatrzymuje się przed ścianą, dopóki nie zostanie ona zniszczona.",
        },
        "gameplay.fix_bridge_collision": {
            "title": "Napraw kolizję mostów",
            "description": "Naprawia problem, w którym Lara nie może chwycić części niektórych mostów oraz krawędzi. Naprawia również problemy z kolizją mostów zwodzonych, pułapek i zwykłych mostów, gdy są nałożone na siebie, są przy zboczach lub blisko ziemi.",
        },
        "gameplay.fix_descending_glitch": {
            "title": "Napraw glitch z łamliwą podłogą",
            "description": "\\{review}Naprawia problem, w którym chodzenie w bok lub do tyłu na łamliwej podłodze powoduje natychmiastowy teleport Lary na podłogę poniżej. Oryginalne TR2+ nie mają tego błędu; TR1 ma.",
        },
        "gameplay.fix_flare_throw_priority": {
            "title": "Napraw priorytet rzucania flar",
            "description": "Rozwiązuje problem, w którym Lara wyrzuca zużytą flarę w powietrze y nie może po tym złapać krawędzi.",
        },
        "gameplay.fix_floor_data_issues": {
            "title": "Napraw triggery",
            "description": "Naprawia błędy oryginalnej gry zw. z triggerami / wyzwalaczami.",
        },
        "gameplay.fix_free_flare_glitch": {
            "title": "Napraw darmową flarę",
            "description": "\\{review}Naprawia możliwość pojawienia się darmowej flary, jeśli gracz naciśnie przycisk flary podczas zbierania jakiegoś przedmiotu, lub prosząc o nią przez ekwipunek podczas czołgania się.",
        },
        "gameplay.fix_item_duplication_glitch": {
            "title": "Napraw klonowanie przedmiotów",
            "description": "Naprawia możliwość klonowania przedmiotów w górnym pierścieniu ekwipunku.",
        },
        "gameplay.fix_lara_pickup_embed": {
            "title": "Napraw podnoszenie przedmiotów",
            "description": "Naprawia problem, w wyniku którego gra umieszczała Larę wewnątrz ścian podczas zbierania przedmiotów pod wodą lub pod stromymi sufitami.",
        },
        "gameplay.fix_lift_collision": {
            "title": "Napraw kolizje wind",
            "description": "\\{review}Naprawia problemy z kolizją ruchomych wind, które mogą spowodować zablokowanie Lary lub przenikanie przez nie.",
        },
        "gameplay.fix_m16_accuracy": {
            "title": "Napraw celność M16/MP5",
            "description": "Naprawia celność M16/MP5 podczas biegania.",
        },
        "gameplay.fix_monkey_pickup_priority": {
            "title": "Priorytet ataku u małp",
            "description": "Zaatakowane małpy skupią się na odwecie zamiast podnosić apteczki i klucze.",
        },
        "gameplay.fix_pipeman_aim": {
            "title": "Popraw celowanie tubylców",
            "description": "Naprawia błąd, przez który tubylcy z dmuchawkami czasami nie potrafili dobrze wycelować w Larę.",
        },
        "gameplay.fix_qwop_glitch": {
            "title": "Napraw glitch QWOP",
            "description": "Naprawia rzadki problem pojawiający się, kiedy Lara zeskakuje z małych schodków, co skutkuje dziwną animacją biegu znaną jako stan QWOP.",
        },
        "gameplay.fix_step_glitch": {
            "title": "Napraw glitch ze schodami",
            "description": "\\{review}Naprawia problem, w którym Lara czasami jest popychana w ściany przylegające do małych stopni, kiedy biegnie po nich w określony sposób. Oryginalny TR1 nie ma tego błędu; TR2 i TR3 mają.",
        },
        "gameplay.fix_underwater_crawl": {
            "title": "Napraw czołganie pod wodą",
            "description": "Naprawia błąd pozwalający Larze czołgać się z lądu do pomieszczeń z wodą lub bagnem o dowolnej głębokości. Po włączeniu Lara będzie mogła czołgać się jedynie do głębokości nieco większej niż jeden klik.",
        },
        "gameplay.fix_wade_wall_hit": {
            "title": "Zderzenia w wodzie po pas",
            "description": "Naprawia problem, w którym Lara nie reaguje na uderzenie w ścianę podczas brodzenia w wodzie po pas.",
        },
        "gameplay.fix_walk_run_jump": {
            "title": "Napraw skakanie podczas biegu",
            "description": "Naprawia problem, w którym Lara czasami nie może skoczyć natychmiast po przejściu z animacji chodzenia do biegu.",
        },
        "gameplay.fix_wall_geometry": {
            "title": "Napraw geometrię ścian",
            "description": "\\{review}Naprawia przypadki w geometrii oryginalnych poziomów, w których nachylenia wewnątrz ścian mogą prowadzić do niedokładnych obliczeń wysokości. Oryginalne TR3+ nie mają tego problemu; TR1 i TR2 mają.",
        },
        "gameplay.fix_water_exit": {
            "title": "Napraw wyjście z wody",
            "description": "Naprawia problem, w którym Lara może przejść bezpośrednio z zatopionego pomieszczenia do sąsiadującego suchego pomieszczenia. Dodatkowo, opcja zapobiega Larze wchodzeniu z wody na nachylone powierzchnie, na których nie można stać.",
        },
        "gameplay.game_modes_policy": {
            "title": "Wybór trybu gry",
            "description": "\\{review}Pozwala na wybór opcji trybu przy rozpoczynaniu nowej gry.\n\n- Nowa Gra+: odblokowuje wszystkie bronie z nieskończoną amunicją; przeciwnicy mają podwójne zdrowie.\n\nDostępne opcje:\n\n- Zawsze: okno wyboru trybów gry będzie zawsze dostępne.\n- Nigdy: okno wyboru trybów gry nigdy nie będzie dostępne, a każda nowa gra będzie zwykłą grą.\n- Po ukończeniu: okno wyboru trybów gry będzie dostępne dopiero po ukończeniu gry.",
        },
        "gameplay.harpoon_recoil": {
            "title": "Odrzut harpuna",
            "description": "Ustawia, jak często Lara musi przeładowywać harpun w zależności od aktualnej ilości amunicji. Np. przy ustawieniu wartości na 3 Lara będzie musiała przeładować po każdym trzecim strzale. Ustawienie na 0 całkowicie wyłącza przeładowywanie.",
        },
        "gameplay.idle_pose_timeout": {
            "title": "Czas bezczynności",
            "description": "Pozwala Larze przyjąć pozę po określonej liczbie sekund bezczynności. Wartość 0 wyłącza tę funkcję.",
        },
        "gameplay.intro_fmv_mode": {
            "title": "\\{review}Czas wstępnego FMV",
            "description": "\\{review}Kontroluje, kiedy odtwarzany jest wstępny film fabularny FMV w każdej grze.\n\n- Nowa gra: odtwarzaj go podczas rozpoczynania nowej gry.\n- Uruchomienie: odtwarzaj go za każdym razem, gdy gra jest uruchamiana lub przełączana, tak jak w oryginalnych grach.",
        },
        "gameplay.jump_lock_mode": {
            "title": "Tryb blokady skoku",
            "description": "Kontroluje, jak szybko Lara może skoczyć po rozpoczęciu biegu. Poszczególne tryby:\n\n- Klasyczny: odpowiada TR2.\n- Dostrojony: skok jest możliwy o 2 klatki wcześniej niż w TR2.\n- Wyłączony: skok jest możliwy natychmiast po animacji startu biegu.",
        },
        "gameplay.loading_screens": {
            "title": "Ekrany ładowania",
            "description": "Kontroluje sposób pokazywania ekranów ładowania wyświetlanych przed rozgrywką.\n\n- Wyłączone: całkowicie wyłącza ekrany ładowania.\n- Zawsze: pokazuje ekrany ładowania zawsze przed zaczęciem gry.\n- Tylko nowa gra: pomija ekrany ładowania podczas wczytywania zapisanej gry.",
        },
        "gameplay.look_mode": {
            "title": "Tryb rozglądania",
            "description": "\\{review}Określa, kiedy Lara może się rozglądać.\n\n- Ograniczony: rozglądanie tylko w bezruchu, nigdy pod wodą.\n- Rozszerzony: rozglądanie dozwolone podczas większości animacji, z wyjątkiem np. pchania bloku.\n- Nieograniczony: rozglądanie zawsze dozwolone przy normalnym sterowaniu Larą.\n\nOgraniczony odpowiada oryginalnemu TR1, a Rozszerzony oryginalnym TR2+.",
        },
        "gameplay.m16_aim_mode": {
            "title": "\\{review}Warianty celowania M16/MP5",
            "description": "\\{review}Określa, kiedy Lara celuje z M16/MP5 z ramienia zamiast z biodra.\n\n- Klasyczny: Lara unosi broń do ramienia za każdym razem, gdy się zatrzyma.\n- Rozszerzony: Lara strzela dalej z biodra, dopóki przycisk Akcji jest wciśnięty, i unosi broń do ramienia tylko wtedy, gdy zaczyna strzelać w bezruchu. Przy włączonej poprawce celności strzał z biodra jest mniej celny i zadaje mniejsze obrażenia.",
        },
        "gameplay.maximum_quick_save_slots": {
            "title": "Liczba slotów szybkiego zapisu",
            "description": "Zmienia liczbę dostępnych slotów szybkiego zapisu.",
        },
        "gameplay.maximum_save_slots": {
            "title": "Liczba slotów zapisu",
            "description": "Zmienia liczbę dostępnych slotów na zapisy.",
        },
        "gameplay.pause_on_focus_lost": {
            "title": "Pauza po utracie fokusu",
            "description": "Zatrzymuje grę, gdy jej okno traci fokus.",
        },
        "gameplay.projectile_area_damage": {
            "title": "Przebieg eksplozji pocisków",
            "description": "Kontroluje metodę liczenia zasięgu eksplozji pocisków z wyrzutni rakiet i granatników.\n\n- Pojedynczy przebieg: zachowanie z TR1 i TR2.\n- Wielokrotny przebieg: zachowanie z TR3.\n\nWielokrotny przebieg często powoduje podwójne obrażenia dla pojedynczych celów.",
        },
        "gameplay.remember_gun_status": {
            "title": "\\{review}Broń między poziomami",
            "description": "Włączenie tej opcji sprawi, że Lara zapamięta wybór broni z poprzedniego poziomu. W przeciwnym wypadku Lara zawsze będzie wracać do pistoletów, domyślnie schowanych w kaburach.",
        },
        "gameplay.restore_ps1_enemies": {
            "title": "Przywróć przeciwników z PS1",
            "description": "\\{review}Dodaje mumię, która pojawia się w wersji na PlayStation w City of Khamoon w TR1, pokój 25.\nZmiana tej opcji do poprawnego działania wymaga ponownego uruchomienia gry.",
        },
        "gameplay.ring_memory_mode": {
            "title": "\\{review}Pozycja w ekwipunku",
            "description": "\\{review}Otwiera pierścień na pozycji, na której go zamknięto, zamiast na pierwszej.\n\n- Wył.: każde otwarcie zaczyna się od pierwszej pozycji, jak w oryginalnej grze.\n- Pierścień główny: zapamiętywany jest tylko pierścień przedmiotów.\n- Wszystkie pierścienie: zapamiętywane są pierścienie przedmiotów i kluczy.\n\nPierwsza pozycja wraca, gdy Lara nie ma już zapamiętanej rzeczy, a każdy poziom zaczyna się od niej.",
        },
        "gameplay.save_crystal_mode": {
            "title": "\\{review}Tryb kryształów",
            "description": "\\{review}Określa, co robią kryształy rozmieszczone na poziomach.\n\n- Wyłączone: kryształy nie występują.\n- Zapisywanie: kryształy są jednorazowe i pozwalają Larze zapisać grę w miejscu, w którym stoją, jak w wersji PS1 TR1. Poza tym zapis jest możliwy tylko na początku poziomów.\n- Zapisywanie (znajdźki): kryształy można zebrać i użyć z ekwipunku, aby zapisać grę w dowolnym miejscu, jak w wersji PS1 TR3. Poza tym zapis jest możliwy tylko na początku poziomów.\n- Leczenie: kryształy przywracają połowę zdrowia Lary i leczą zatrucie, gdy ich dotknie, jak w wersji PC TR3.\n- Znajdźki: kryształy są przedmiotami do zebrania, liczonymi w statystykach poziomu, i nie robią nic więcej.\n\nZmiana tej opcji wymaga ponownego uruchomienia poziomu.",
        },
        "gameplay.start_lara_hitpoints": {
            "title": "Startowe zdrowie Lary",
            "description": "Ustala wartość zdrowia, z którą Lara zaczyna każdy poziom.",
        },
        "gameplay.target_change_mode": {
            "title": "Zmiana celu",
            "description": "\\{review}Zmienia sposób, w jaki Lara przełącza się między celami podczas celowania.\n\n- Wyłączone: Lara zachowuje obecny cel.\n- Rozszerzone: naciśnij przycisk Zmiana celu, aby przełączyć.\n- TR4: naciśnij krótko przycisk Rozejrzyj się, aby przełączyć; przytrzymanie go pozwala się rozejrzeć po krótkiej chwili.",
        },
        "gameplay.target_mode": {
            "title": "Tryb blokady broni",
            "description": "Zmienia tryb, w jaki bronie blokują się na celach.\n\n- Całkowity: zawsze utrzymuje blokadę celu, nawet jeśli przeciwnik wyjdzie z pola widzenia lub zginie (tak jak w TR1-3).\n- Częściowy: utrzymuje blokadę celu, jeśli przeciwnik wyjdzie z pola widzenia, ale traci ją, kiedy przeciwnik zginie.\n- Brak: traci blokadę celu, kiedy przeciwnik wyjdzie z pola widzenia lub zginie (tak jak w TR4+).",
        },
        "gameplay.wall_glitch_mode": {
            "title": "Tryb glitchy ścian",
            "description": "\\{review}Wybiera, które błędy ścian Lara może wykonywać.\n\n- TR1: jak w oryginalnym TR1, gdzie skok w przód w ścianę przenosi Larę na jej szczyt.\n- TR2: jak w oryginalnych TR2 i TR3, gdzie ten skok już nie działa, ale Lara wciąż może się przenieść, uderzając jednocześnie o podłogę i ścianę przy pewnej geometrii.\n- Naprawione: żaden z tych błędów nie działa, a Lara nie przejdzie już przez zablokowany sektor drzwi.",
        },
        "input.enable_buffering_func_keys": {
            "title": "Buforowanie (klawisze funkcyjne)",
            "description": "Włącza buforowanie klawisza F w celu precyzyjnej kontroli ruchu Lary (1 klatka). Ta funkcja pierwotnie istniała tylko w porcie TombATI (TR1).",
        },
        "input.enable_buffering_inventory": {
            "title": "Buforowanie (ekwipunek)",
            "description": "Włącza buforowanie ekranu ekwipunku, aby uzyskać precyzyjną kontrolę nad ruchem Lary (2 klatki).",
        },
        "input.enable_controller": {
            "title": "\\{review}Obsługa kontrolera",
            "description": "\\{review}Pozwala grze odczytywać podłączone kontrolery. Wyłącz tę opcję, jeśli korzystasz z zewnętrznego programu mapującego, który już zamienia kontroler na sygnały klawiatury.",
        },
        "input.enable_responsive_passport": {
            "title": "Responsywny paszport",
            "description": "Wyłącza blokowanie klawiszy podczas przewracania stron paszportu, zamiast tego kolejkując pożądaną nawigację.",
        },
        "input.enable_touch_controls": {
            "title": "Sterowanie dotykowe",
            "description": "Wyświetla ekranową nakładkę sterowania dotykowego dla urządzeń z ekranem dotykowym.",
        },
        "input.enable_tr3_sidesteps": {
            "title": "Ulepszone kroki w bok",
            "description": "Umożliwia chodzenie w bok w stylu TR3+, tj. shift+strzałki kierunkowe. Naturalnie, przyciski dedykowane do kroków w bok nadal będą działać.",
        },
        "input.quick_guns_mode": {
            "title": "Szybkie klawisze broni",
            "description": "Kontroluje zachowanie klawiszy do szybkiego wyposażania broni.\n\n- Wyposaż: naciśnięcie klawisza spowoduje, że Lara wyposaży daną broń.\n- Wyposaż lub schowaj: to samo co powyżej; dodatkowo Lara schowa daną broń, jeśli ma ją aktualnie wyposażoną.",
        },
        "input.touch_button_scale": {
            "title": "Rozmiar przycisków dotykowych",
            "description": "Dostosowuje rozmiar ekranowych przycisków sterowania dotykowego.",
        },
        "input.touch_dpad_deadzone": {
            "title": "Martwa strefa D-pada dotykowego",
            "description": "Dostosowuje martwą strefę ekranowego D-pada. Większa martwa strefa wymaga większego ruchu, zanim zostanie zarejestrowane wejście kierunkowe.",
        },
        "input.touch_dpad_scale": {
            "title": "Rozmiar D-pada dotykowego",
            "description": "Dostosowuje rozmiar ekranowego D-pada.",
        },
        "input.touch_opacity": {
            "title": "\\{review}Przezroczystość dotyku",
            "description": "Dostosowuje przezroczystość ekranowych przycisków sterowania dotykowego.",
        },
        "language": {
            "title": "Język",
            "description": "Zmienia język tekstu interfejsu.",
        },
        "rendering.anisotropy_filter": {
            "title": "Filtr anizotropowy",
            "description": "Zwiększa filtrowanie tekstur w dużej odległości od kamery.",
        },
        "rendering.aspect_mode": {
            "title": "Proporcje ekranu",
            "description": "Wymusza określone proporcje obrazu w grze przez dodanie czarnych pasków po bokach (letterboxing).",
        },
        "rendering.borders": {
            "title": "Ramka",
            "description": "Dodaje czarną ramkę wokół okna gry.",
        },
        "rendering.dither_mode": {
            "title": "\\{review}Dithering",
            "description": "\\{review}Wybiera cieniowanie palety oryginalnego renderera programowego PC lub dithering RGB555 z PlayStation.",
        },
        "rendering.enable_affine_mapping": {
            "title": "\\{review}Afiniczne mapowanie tekstur",
            "description": "\\{review}Usuwa korekcję perspektywy przy teksturowaniu, której PlayStation nie miało, więc tekstury falują i pływają po dużych powierzchniach przy ruchu kamery.",
        },
        "rendering.enable_ps1_fog": {
            "title": "\\{review}Mgła z PlayStation",
            "description": "\\{review}Zlewa odległą geometrię z kolorem mgły tak, jak robiło to wygaszanie głębi na PlayStation: wzdłuż 1/odległości zamiast odległości i liczone na wierzchołek, więc przejście pasmuje na dużych powierzchniach.",
        },
        "rendering.enable_trapezoid_filter": {
            "title": "Filtr trapezoidalny",
            "description": "Poprawia rysowanie czworokątów, rozciągając teksturę między wszystkimi wierzchołkami zamiast dzielić je na dwa trójkąty.",
        },
        "rendering.enable_vsync": {
            "title": "Synchronizacja pionowa",
            "description": "Włącza lub wyłącza synchronizację pionową.",
        },
        "rendering.fmv_filter": {
            "title": "\\{review}Filtr FMV",
            "description": "\\{review}Przełącza między gładkim a pikselowym wyglądem filmów FMV.",
        },
        "rendering.fps": {
            "title": "Klatki na sekundę",
            "description": "Ustawia liczbę klatek na sekundę w grze.",
        },
        "rendering.lighting_contrast": {
            "title": "Kontrast oświetlenia",
            "description": "Zwiększa kontrast dla dynamicznych źródeł światła, takich jak flary i rozbłyski broni.",
        },
        "rendering.lighting_curve": {
            "title": "\\{review}Model oświetlenia",
            "description": "\\{review}Określa, jak mocno oświetlenie wierzchołków skaluje teksturę.\n\n- Płaski zatrzymuje się na jasności samej tekstury, więc jest ciemniejszy (TR3 PC).\n- Overbright odpowiada rendererom PC: w pełni oświetlony wierzchołek rozjaśnia teksel dwukrotnie, a nadmiar jest dodawany później (TR4 PC).\n- Nasycenie to model PlayStation: również podwaja teksel, ale pozwala każdemu kolorowi obciąć się tam, gdzie trafi, dzięki czemu jasne powierzchnie zachowują własny kolor zamiast blaknąć do bieli (TR3/TR4 PS1).",
        },
        "rendering.multisampling_factor": {
            "title": "\\{review}Wielopróbkowanie",
            "description": "\\{review}Wygładza krawędzie ścian i obiektów, pobierając kilka próbek każdego piksela wzdłuż nich. Znacznie tańsze niż nadpróbkowanie, ale pozostawia bez zmian krawędzie sprite'ów takich jak roślinność i ogień.",
        },
        "rendering.screenshot_format": {
            "title": "Format zrzutów ekranu",
            "description": "Format pliku użyty do zapisu zrzutów ekranu.",
        },
        "rendering.sprite_lock_mode": {
            "title": "Tryb blokady sprite'ów",
            "description": "Blokuje dane osie podczas wyświetlania sprite'ów na ekranie.\n\n- Brak: wyświetlaj sprite'y normalnie.\n- Obrót: blokuje oś obrotu – przydatne tylko w trybie fotograficznym.\n- Obrót i pochylenie: zapewnia, że sprite'y stoją pionowo i nie kładą się na ziemi przy patrzeniu z góry.\n- Perspektywa: blokuje osie obrotu i pochylenia oraz dodatkowo lekko obraca sprite'y w kierunku środka ekranu.",
        },
        "rendering.supersampling_factor": {
            "title": "\\{review}Nadpróbkowanie",
            "description": "\\{review}Renderuje grę w wielokrotności jej rozdzielczości i uśrednia ją z powrotem, wygładzając poszarpane krawędzie. Wyższe współczynniki wymagają od karty graficznej wielokrotnie więcej pracy.",
        },
        "rendering.texture_filter": {
            "title": "Filtr tekstur",
            "description": "Przełącza między gładkimi a pikselowymi teksturami w grze.",
        },
        "rendering.ui_filter": {
            "title": "Filtr UI",
            "description": "Przełącza między gładką a pikselową grafiką interfejsu.",
        },
        "rendering.upscaling_factor": {
            "title": "Współczynnik skalowania",
            "description": "Skaluje grę o ustalony współczynnik, zachowując pikselowy wygląd.",
        },
        "rendering.upscaling_filter": {
            "title": "Filtr skalowania",
            "description": "Przełącza gładki lub pikselowy wygląd dla całego ekranu.",
        },
        "rendering.vertex_snap_mode": {
            "title": "\\{review}Przyciąganie wierzchołków",
            "description": "\\{review}Kontroluje siatkę przyciągania wierzchołków dla drgającej geometrii z wydań na PlayStation.\n\n- Wyłączone: wyłącza przyciąganie wierzchołków.\n- 320x240: używa oryginalnej siatki 320x240.\n- Rozdzielczość skalowania: używa rozdzielczości skalowania.",
        },
        "ui.airbar_color": {
            "title": "Kolor paska tlenu",
            "description": "Kolor paska tlenu.",
        },
        "ui.airbar_color_ps1": {
            "title": "Kolor paska tlenu",
            "description": "Kolor paska tlenu.",
        },
        "ui.airbar_location": {
            "title": "Lokalizacja paska tlenu",
            "description": "Miejsce, w którym wyświetlany jest pasek tlenu.",
        },
        "ui.ammo_counter_location": {
            "title": "Lokalizacja licznika amunicji",
            "description": "Miejsce, w którym wyświetlany jest licznik amunicji.",
        },
        "ui.bar_look": {
            "title": "Wygląd pasków",
            "description": "\\{review}Wybiera ramkę i kolory, którymi rysowane są paski interfejsu, zaczerpnięte z jednego z oryginalnych wydań. Wybór decyduje też o tym, który zestaw ustawień kolorów poniżej obowiązuje.",
        },
        "ui.bar_scale": {
            "title": "Skala pasków",
            "description": "Zmienia rozmiar pasków zdrowia i tlenu.",
        },
        "ui.enable_bar_flashing": {
            "title": "Migające paski",
            "description": "Sprawia, że paski zdrowia i tlenu Lary zaczynają migać, kiedy dany zasób jest na wyczerpaniu.",
        },
        "ui.enable_smooth_bars": {
            "title": "Wygładzanie pasków",
            "description": "Sprawia, że paski życia i tlenu używają gładkich przejść kolorów.",
        },
        "ui.enable_wraparound": {
            "title": "Cykliczne przewijanie",
            "description": "Zawijanie poza ostatni element spowoduje powrót na początek listy i na odwrót.",
        },
        "ui.enemy_healthbar_color": {
            "title": "Kolor paska zdrowia wrogów",
