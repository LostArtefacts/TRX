    "settings": {
        "audio.ambient_volume": {
            "title": "Volumen ambiental",
            "description": "Ajusta el volumen del sonido ambiental.",
        },
        "audio.cutscene_volume": {
            "title": "Volumen de escenas",
            "description": "Ajusta el volumen de las escenas cinematográficas del juego.",
        },
        "audio.enable_ambient_crossfade": {
            "title": "Fundido cruzado del ambiente",
            "description": "Realiza un fundido entre una pista de ambiente en bucle y la siguiente cuando cambia, en lugar de cortar la primera de golpe.",
        },
        "audio.enable_lara_mic": {
            "title": "Micrófono cerca de Lara",
            "description": "Establece el micrófono en la posición de Lara. Si se desactiva, el micrófono se situará en la posición de la cámara.",
        },
        "audio.enable_music_in_inventory": {
            "title": "Reproducir música en el inventario",
            "description": "Permite que los sonidos del juego, el ambiente y la música sigan reproduciéndose en la pantalla del inventario.",
        },
        "audio.enable_music_in_menu": {
            "title": "Música del menú principal",
            "description": "Reproduce música en el menú principal.",
        },
        "audio.enable_music_on_death": {
            "title": "Reproducir música tras morir",
            "description": "Mantiene la pista de música activa reproduciéndose cuando Lara muere.",
        },
        "audio.enable_pitched_sounds": {
            "title": "Variación de tono en sonidos",
            "description": "Permite que los efectos de sonido tengan ligeros cambios de tono de forma aleatoria para dar más variedad a los sonidos del juego.",
        },
        "audio.enable_ps1_sfx": {
            "title": "Sustituir por efectos de PS1",
            "description": "Activa la sustitución de efectos de sonido específicos por sus equivalentes de PS1.\n\n- Disparo de Uzi (solo TR1)\n- Desplazamiento lateral por salientes (solo TR1)\n- Sonidos de Lara descalza (solo TR2)\n- Ráfagas de lanzallamas y llamaradas (solo TR3)",
        },
        "audio.enable_underwater_anim_sfx": {
            "title": "Efectos de animación bajo el agua",
            "description": "Permite controlar la reproducción de efectos de sonido de animaciones específicas (para objetos como puertas y trampillas) cuando la cámara está bajo el agua.",
        },
        "audio.fix_chainblock_secret_sound": {
            "title": "Corregir sonido de bloque de cadena",
            "description": "Evita que el sonido de secreto se reproduzca incorrectamente al usar la llave de oro en la Tumba de Tihocan de TR1.",
        },
        "audio.fix_secrets_killing_music": {
            "title": "Música de secreto superpuesta",
            "description": "Corrige el error por el cual el sonido al recoger un secreto detenía la pista de música activa.",
        },
        "audio.fix_sliding_sfx": {
            "title": "Corregir efecto de deslizamiento",
            "description": "Corrige el efecto de sonido de deslizamiento de Lara para que deje de sonar cuando ya no está en una pendiente (estilo TR3+). Si se desactiva, el efecto terminará de reproducirse normalmente sin importar dónde esté Lara (estilo TR1/2).",
        },
        "audio.fix_speeches_killing_music": {
            "title": "Voces de enemigos superpuestas",
            "description": "Corrige el error por el cual los enemigos detenían la pista de música activa al hablar.",
        },
        "audio.fmv_volume": {
            "title": "Volumen de videos (FMV)",
            "description": "Ajusta el volumen de las secuencias cinemáticas de video.",
        },
        "audio.inventory_ambient_volume": {
            "title": "Volumen ambiental (inventario)",
            "description": "Ajusta el volumen ambiental en la pantalla del inventario.",
        },
        "audio.inventory_music_volume": {
            "title": "Volumen de música (inventario)",
            "description": "Ajusta el volumen de la música en la pantalla del inventario.",
        },
        "audio.load_music_triggers": {
            "title": "Corregir activadores de música únicos",
            "description": "Carga la música de un solo uso que ya se haya activado previamente para que las pistas no vuelvan a sonar repetidas.",
        },
        "audio.master_volume": {
            "title": "Volumen maestro",
            "description": "Ajusta todo el volumen del juego. El resto de las configuraciones son relativas a este volumen.",
        },
        "audio.media_language": {
            "auto": "Automático",
            "description": "Elige el idioma de los vídeos y las voces, independientemente del idioma del texto. Automático reproduce el doblaje del idioma del texto si está instalado; Original reproduce los archivos tal como están instalados.",
            "retail": "Original",
            "title": "Idioma de las voces",
        },
        "audio.music_load_condition": {
            "title": "Restaurar música al cargar",
            "description": "Carga la pista de música que sonaba cuando se guardó la partida.\n\n- Nunca: no restaura las pistas de música al cargar.\n- No ambiental: restaura solo las pistas de música que no sean ambientales al cargar.\n- Siempre: restaura cualquier tipo de pista de música al cargar.",
        },
        "audio.music_volume": {
            "title": "\\{icon music} Volumen de música",
            "description": "Ajusta el volumen de la música.",
        },
        "audio.mute_out_of_focus": {
            "title": "Silenciar audio al perder el foco",
            "description": "Silencia toda la música y efectos de sonido cuando la ventana del juego no está en primer plano.",
        },
        "audio.sound_volume": {
            "title": "\\{icon sound} Volumen de efectos",
            "description": "Ajusta el volumen de los efectos de sonido.",
        },
        "audio.underwater_ambient_volume": {
            "title": "Volumen ambiental (bajo el agua)",
            "description": "Ajusta el volumen ambiental al estar bajo el agua.",
        },
        "audio.underwater_muffle": {
            "title": "Amortiguar la música bajo el agua",
            "description": "Amortigua la música cuando la cámara está bajo el agua, como si se oyera a través del agua.\n\n- Desactivado: la música se oye con claridad.\n- Solo ambiente: solo se amortigua la pista de ambiente.\n- Toda la música: se amortiguan las pistas de música y ambiente.",
        },
        "audio.underwater_music_volume": {
            "title": "Volumen de música (bajo el agua)",
            "description": "Ajusta el volumen de la música al estar bajo el agua.",
        },
        "debug.enable_endless_flare_time": {
            "title": "Bengalas infinitas",
            "description": "Evita que las bengalas de mano se apaguen. Las bengalas que se lancen se seguirán apagando con normalidad.",
        },
        "debug.enable_endless_sprint": {
            "title": "Esprint infinito",
            "description": "Evita que Lara se canse al esprintar. Los obstáculos la seguirán frenando con normalidad.",
        },
        "gameplay.ally_hostility_policy": {
            "title": "Política de hostilidad de aliados",
            "description": "Controla cómo reaccionan las unidades aliadas al recibir daño.\n\n- Individual: cada aliado cambia su hostilidad por su cuenta (estilo TR3).\n- Compartida: todos los aliados se vuelven hostiles a la vez (estilo monjes de TR2).",
        },
        "gameplay.camera_speed": {
            "title": "Velocidad de la cámara",
            "description": "Cambia la velocidad de movimiento de la cámara manual.",
        },
        "gameplay.change_pierre_spawn": {
            "title": "Cambiar modo de aparición de Pierre",
            "description": "Hace que un Pierre recién activado (en huida) reemplace a uno ya existente (en huida).",
        },
        "gameplay.creature_drown_policy": {
            "title": "Política de ahogamiento de criaturas",
            "description": "Controla el comportamiento de las criaturas terrestres en habitaciones con agua.\n\n- Nunca: las criaturas terrestres nunca se ahogarán (estilo TR1).\n- Predeterminado: las criaturas terrestres se ahogarán en agua de 2 bloques o más de profundidad (estilo TR2/3).\n- Sumergido: las criaturas terrestres se ahogarán solo cuando estén completamente sumergidas.",
        },
        "gameplay.disable_extra_guns": {
            "title": "Eliminar armas adicionales",
            "description": "Elimina del juego todas las armas y municiones coleccionables excepto las pistolas (para partidas de desafío de 'Solo Pistolas').",
        },
        "gameplay.disable_healing_between_levels": {
            "title": "Daño persistente",
            "description": "Evita que Lara recupere la salud al comenzar un nuevo nivel (para partidas de desafío de 'Sin Curación').",
        },
        "gameplay.disable_medpacks": {
            "title": "Eliminar botiquines",
            "description": "Elimina todos los botiquines del juego (para partidas de desafío de 'Sin Botiquines').",
        },
        "gameplay.disable_trex_collision": {
            "title": "Eliminar colisión con T-Rex muerto",
            "description": "Elimina por completo la colisión con el T-Rex tras su muerte. Esto ayuda cuando el cuerpo del T-Rex bloquea la salida.",
        },
        "gameplay.enable_ally_kill_count": {
            "title": "Contar bajas de aliados",
            "description": "Suma las bajas enemigas causadas por los aliados de Lara al total de bajas de la partida.",
        },
        "gameplay.enable_ally_targeting": {
            "title": "Permitir apuntar a aliados",
            "description": "Permite que Lara apunte a unidades aliadas, como los monjes. Si se desactiva, los aliados serán inmunes a la munición de Lara.",
        },
        "gameplay.enable_alternative_turns": {
            "title": "Giro alternativo",
            "description": "Permite que Lara realice movimientos alternativos de giro o torsión cuando está estática.\n\n- Pulsa los controles de dar voltereta y saltar a la vez para realizar un giro neutral.\n- Pulsa los controles de dar voltereta y caminar a la vez para girar rápidamente sobre el sitio.\n- Pulsa el control de dar voltereta mientras cuelgas de barras para girar rápidamente sobre el sitio.",
        },
        "gameplay.enable_auto_item_selection": {
            "title": "Preselección de objetos de misión",
            "description": "Cuando Lara pulse el botón de acción frente a una cerradura o ranura de rompecabezas, y tenga el objeto correspondiente en el inventario, dicho objeto se seleccionará automáticamente.",
        },
        "gameplay.enable_back_slope_stumble": {
            "title": "Tropiezo en pendientes hacia atrás",
            "description": "Hace que Lara tropiece si salta hacia atrás y hay una pendiente detrás de ella (TR3). Si se desactiva, Lara se detendrá en seco contra la pendiente (TR1/2).",
        },
        "gameplay.enable_binoculars": {
            "title": "Prismáticos",
            "description": "Hace que los prismáticos estén disponibles para seleccionarse en el inventario.",
        },
        "gameplay.enable_body_bags": {
            "title": "Activadores de bolsas de cadáveres",
            "description": "Permite la eliminación de enemigos derrotados cuando Lara cruza activadores específicos en ciertos niveles. Si se desactiva, los enemigos muertos siempre se seguirán mostrando.",
        },
        "gameplay.enable_boulder_shake": {
            "title": "Temblor por rocas rodantes",
            "description": "Si está activado, la cámara temblará cuando una roca rodante esté en movimiento.",
        },
        "gameplay.enable_bouncy_grenades": {
            "title": "Granadas rebotantes",
            "description": "Activa el comportamiento de granadas al estilo TR3: rebotan en paredes y pendientes y producen un radio de explosión mayor, pero a costa de una velocidad reducida.",
        },
        "gameplay.enable_cheats": {
            "title": "Trucos",
            "description": "Activa varios trucos:\n\n- \\{input level_skip_cheat}: termina el nivel inmediatamente.\n- \\{input item_cheat}: le otorga a Lara todas las armas, un aumento de munición y botiquines, y todos los objetos de misión del nivel actual.\n- \\{input fly_cheat}: activa el truco de vuelo (nadar en el aire).\n  - \\{input slow}: sale del modo vuelo.\n  - \\{input draw}: abre la puerta más cercana (no funciona en algunos lugares).",
        },
        "gameplay.enable_cinematic_skips": {
            "title": "Omitir cinemáticas",
            "description": "Permite saltarse las secuencias de cámara panorámica usando los controles de inventario, volver al menú, confirmar menú o acción, y con el control de mirar incluso si el nivel marca la secuencia como obligatoria.",
        },
        "gameplay.enable_cinematics": {
            "title": "Cinemáticas panorámicas",
            "description": "Activa las cinemáticas panorámicas de cámara al inicio de ciertos niveles que las tengan definidas.",
        },
        "gameplay.enable_compass_stats": {
            "title": "Estadísticas del nivel en la brújula",
            "description": "Permite mostrar las estadísticas del nivel actual cuando se selecciona la brújula.",
        },
        "gameplay.enable_console": {
            "title": "Consola",
            "description": "Activa la consola de desarrollo.",
        },
        "gameplay.enable_continuous_pushblocks": {
            "title": "Empuje continuo de bloques",
            "description": "Permite que Lara siga empujando o tirando de los bloques mientras se mantenga pulsado el botón de acción, similar a TR4+. Si se desactiva, Lara se detendrá después de cada animación de empuje/tiro.",
        },
        "gameplay.enable_controlled_drops": {
            "title": "Caídas controladas",
            "description": "Permite a Lara girar en el aire y agarrarse al saliente del que acaba de bajarse si se mantiene pulsado el botón de acción mientras cae.",
        },
        "gameplay.enable_corner_shimmying": {
            "title": "Desplazamiento lateral por esquinas",
            "description": "Permite a Lara rodear esquinas mientras cuelga de salientes o escala paredes (estilo TR4).",
        },
        "gameplay.enable_crawl_jump": {
            "title": "Salto al salir de gatas",
            "description": "Permite a Lara saltar para salir de los espacios estrechos por los que va a gatas.",
        },
        "gameplay.enable_crawl_tilt": {
            "title": "Inclinación al ir a gatas",
            "description": "Alinea la rotación de Lara con la geometría del suelo cuando avanza a gatas.",
        },
        "gameplay.enable_crawling": {
            "title": "A gatas",
            "description": "Permite a Lara agacharse y avanzar a gatas (estilo TR3+). Los TR1 y TR2 originales no incluyen ninguna de estas acciones.",
        },
        "gameplay.enable_credits": {
            "title": "Pantallas de créditos",
            "description": "Activa las pantallas de créditos que se muestran tras completar el juego. No influye en la pantalla de estadísticas finales.",
        },
        "gameplay.enable_crouch_roll": {
            "title": "Voltereta agachada",
            "description": "Permite a Lara realizar una voltereta hacia adelante mientras está agachada pulsando el botón de esprintar.",
        },
        "gameplay.enable_cutscenes": {
            "title": "Escenas cinematográficas",
            "description": "Activa la reproducción de las escenas del juego (cutscenes).",
        },
        "gameplay.enable_demo": {
            "title": "Modo Demo",
            "description": "Activa la visualización de demostraciones en el menú principal.",
        },
        "gameplay.enable_enemy_rotation": {
            "title": "Ángulo inicial de enemigos aleatorio",
            "description": "Aplica un ángulo de dirección aleatorio adicional a algunos enemigos cuando aparecen por primera vez.",
        },
        "gameplay.enable_enhanced_saves": {
            "title": "Efectos en guardados",
            "description": "Mejora el guardado de partidas para que los efectos gráficos, la niebla de las cascadas, los emisores de llamas y otros elementos se guarden en lugar de desaparecer al cargar.",
        },
        "gameplay.enable_environment_kill_count": {
            "title": "Contar bajas por el entorno",
            "description": "Suma los enemigos eliminados por elementos del entorno, como láseres de seguridad o ahogamiento, al total de bajas de la partida.",
        },
        "gameplay.enable_fast_pickups": {
            "title": "Recogida rápida",
            "description": "Permite a Lara recoger objetos del suelo con mayor rapidez, similar a TR4+.",
        },
        "gameplay.enable_fast_pull_up": {
            "title": "Subida rápida",
            "description": "Permite a Lara impulsarse hacia arriba y subir desde los salientes con mayor rapidez.",
        },
        "gameplay.enable_fast_shimmying": {
            "title": "Desplazamiento lateral rápido",
            "description": "Permite a Lara moverse más rápido al desplazarse colgada hacia la izquierda o derecha.",
        },
        "gameplay.enable_fmv": {
            "title": "Videos (FMV)",
            "description": "Activa la reproducción de los videos introductorios y de historia.",
        },
        "gameplay.enable_idle_pose_camera": {
            "title": "Cámara en postura estática",
            "description": "Ajusta la cámara para enfocar el rostro de Lara durante su animación cuando se queda quieta. Pulsar el botón de mirar restablecerá la cámara.",
        },
        "gameplay.enable_inverted_look": {
            "title": "Mirada invertida",
            "description": "Invierte los controles del eje Y cuando Lara usa el modo mirar.",
        },
        "gameplay.enable_item_examining": {
            "title": "Examinar objetos",
            "description": "Para niveles personalizados: permite mostrar descripciones de los objetos en el inventario siempre que el autor del nivel haya incluido los datos correspondientes.",
        },
        "gameplay.enable_jump_twists": {
            "title": "Giros en el aire",
            "description": "Activa los giros y volteretas en el aire; es decir, permite pulsar el botón de dar voltereta durante los saltos y las animaciones de salto de ángel (estilo TR2+). El TR1 original no incluye ninguno de los dos.",
        },
        "gameplay.enable_killer_pushblocks": {
            "title": "Bloques de empuje mortales",
            "description": "Si está activado, cuando un bloque de empuje caiga desde el aire y golpee a Lara, la matará al instante. De lo contrario, Lara atravesará la parte superior del bloque y sobrevivirá.",
        },
        "gameplay.enable_laser_sight_toggle": {
            "title": "Alternar mira láser",
            "description": "Permite abrir la vista de la mira láser con la tecla de mirar y cerrarla con otra pulsación. Si se desactiva, hay que mantener pulsada la tecla de mirar para mantener la vista abierta, como en el juego original.",
        },
        "gameplay.enable_lean_jumping": {
            "title": "Inclinación en saltos",
            "description": "Permite a Lara desplazarse un poco más hacia adelante o hacia atrás al realizar saltos neutrales manteniendo pulsado el botón correspondiente (estilo TR2+). En el TR1 original, Lara se desplaza hacia adelante sin importar el control que se pulse, y mucho más lento.",
        },
        "gameplay.enable_ledge_jumps": {
            "title": "Saltos desde salientes",
            "description": "Permite a Lara saltar hacia arriba o hacia atrás mientras cuelga de un saliente, siempre que tenga una superficie sólida enfrente para impulsarse.",
        },
        "gameplay.enable_legal": {
            "title": "Pantallas legales",
            "description": "Activa la pantalla de avisos legales y el video introductorio de Core Design al iniciar el juego.",
        },
        "gameplay.enable_manual_camera": {
            "title": "Cámara manual",
            "description": "Permite que los botones de la cámara (\\{input camera_forward}\\{input camera_back}\\{input camera_left}\\{input camera_right}) utilizados para controlar el modo foto también sirvan para rotar la cámara de juego.",
        },
        "gameplay.enable_monkey_bar_edge_deflect": {
            "title": "Desvío en barras",
            "description": "Permite que Lara se desvíe al pasar por los extremos de las barras cuando avanza.",
        },
        "gameplay.enable_monkey_bar_shimmy_turn": {
            "title": "Giro al avanzar por barras",
            "description": "Permite a Lara girar mientras se desplaza a lo largo de las barras de techo (monkey bars), de forma similar a como lo hace al dar pasos laterales o al nadar de lado en la superficie del agua.",
        },
        "gameplay.enable_multiple_pickups": {
            "title": "Recogida múltiple",
            "description": "Permite a Lara recoger todos los objetos que compartan la misma posición en el suelo usando una sola animación (TR1-3). Si se desactiva, Lara deberá repetir la animación por cada objeto (TR4+).",
        },
        "gameplay.enable_pickup_aids": {
            "title": "Ayudas para objetos",
            "description": "Activa un efecto de destello intermitente cerca de los objetos del suelo para resaltar su presencia.",
        },
        "gameplay.enable_play_previous_levels": {
            "title": "Jugar niveles anteriores",
            "description": "Activa las funciones \"Jugar niveles anteriores\" y \"La historia hasta ahora...\" en la pantalla de selección de nueva partida.",
        },
        "gameplay.enable_responsive_crawl": {
            "title": "Movimiento a gatas mejorado",
            "description": "Activa mejoras sobre las mecánicas originales de ir a gatas.\n\n- Permite reanudar el avance a gatas más rápido tras detenerse.\n- Permite pasar de correr/esprintar a ir a gatas sin tener que detenerse por completo primero.\n- Permite pasar de ir a gatas a dar una voltereta agachada (si está activada) sin tener que agacharse manualmente primero.\n- Permite girar mientras se está agachada.\n- Restaura la animación de Lara para recoger objetos a gatas (excepto bengalas).",
        },
        "gameplay.enable_responsive_sprint": {
            "title": "Esprint mejorado",
            "description": "Activa un estado de esprint con mayor capacidad de respuesta para Lara.\n\n- Permite esprintar siempre que Lara tenga energía, en lugar de solo cuando su barra de resistencia esté completamente llena.\n- Permite esprintar escaleras arriba en lugar de verse interrumpido por la animación regular de correr de Lara.",
        },
        "gameplay.enable_slide_to_run": {
            "title": "Transición de deslizamiento a carrera",
            "description": "Permite a Lara empezar a correr inmediatamente al tocar el suelo tras deslizarse hacia adelante por una pendiente. Mantén pulsado el botón de avanzar para activarlo.",
        },
        "gameplay.enable_slow_ledge_swing": {
            "title": "Balanceo lento en salientes",
            "description": "Permite a Lara balancearse lentamente cuando se agarra a un saliente muy estrecho (estilo TR3). Si se desactiva, Lara se balanceará brevemente antes de quedarse colgando estática (estilo TR1/2).",
        },
        "gameplay.enable_smooth_wall_deflect": {
            "title": "Desvío suave contra paredes",
            "description": "Permite a Lara recuperarse más rápido tras chocar contra una pared si se mantiene pulsada una tecla de dirección junto con la de avanzar (estilo TR2+). Si se desactiva, se recuperará al ritmo del TR1 original.",
        },
        "gameplay.enable_snap_interactions": {
            "title": "Alineación instantánea de interacción",
            "description": "Permite a Lara alinearse instantáneamente con los objetivos de interacción, como objetos del suelo e interruptores (estilo TR1/2). Si se desactiva, Lara tendrá que estar completamente quieta antes de interactuar (estilo TR4+).",
        },
        "gameplay.enable_soft_statics": {
            "title": "Colisión suave con objetos estáticos",
            "description": "Permite a Lara moverse suavemente al rozar elementos estáticos del mapa —similar a TR4+— en lugar de detenerse en seco.",
        },
        "gameplay.enable_sprint": {
            "title": "Esprintar",
            "description": "Permite a Lara esprintar, similar a TR3+.",
        },
        "gameplay.enable_step_roll_boost": {
            "title": "Impulso de voltereta en escalones",
            "description": "Permite a Lara impulsarse desde un escalón de un bloque de altura si se pulsa el botón de dar voltereta cerca del borde. Solo el TR1 original hace esto; los TR2+ no.",
        },
        "gameplay.enable_swamp_sidestepping": {
            "title": "Pasos laterales en pantanos",
            "description": "Permite a Lara dar pasos laterales dentro de las salas con pantanos.",
        },
        "gameplay.enable_swing_cancel": {
            "title": "Cancelar balanceo",
            "description": "Permite cancelar la animación de balanceo en salientes de Lara soltándose y volviéndose a agarrar rápidamente (estilo TR2+). El TR1 original no lo permite.",
        },
        "gameplay.enable_timer_in_inventory": {
            "title": "Contar tiempo en el inventario",
            "description": "Hace que el temporizador del juego siga corriendo incluso mientras se muestra la pantalla del inventario.",
        },
        "gameplay.enable_toggle_crouch": {
            "title": "Alternar agachado",
            "description": "Permite a Lara permanecer agachada tras pulsar el botón de agacharse una sola vez. Pulsa agacharse de nuevo para ponerte de pie.",
        },
        "gameplay.enable_toggle_sprint": {
            "title": "Alternar esprint",
            "description": "Permite a Lara seguir esprintando tras pulsar el botón de esprintar una sola vez. Pulsa esprintar de nuevo para dejar de hacerlo.",
        },
        "gameplay.enable_total_stats": {
            "title": "Pantalla de estadísticas finales",
            "description": "Activa una pantalla con las estadísticas totales de toda la partida que se muestra después de los créditos.",
        },
        "gameplay.enable_tr2_jumping": {
            "title": "Salto dinámico",
            "description": "Permite a Lara saltar en cualquier punto mientras corre (estilo TR2+). Si se desactiva, saltará solo en los puntos fijos de la animación de carrera, como en el TR1 original.",
        },
        "gameplay.enable_tr2_swim_cancel": {
            "title": "Cancelación de nado dinámica",
            "description": "Permite a Lara detenerse de forma más inmediata bajo el agua cuando se suelta el botón de nadar (estilo TR2+). Si se desactiva, se detendrá gradualmente como en el TR1 original.",
        },
        "gameplay.enable_tr2_swimming": {
            "title": "Nado suave",
            "description": "Aplica una curva de aceleración a la velocidad de giro de Lara bajo el agua para lograr un movimiento más suave, igual que en los TR2+ originales. Desactivar esta opción hará que el giro sea más seco, como en el TR1 original.",
        },
        "gameplay.enable_underwater_auto_draw": {
            "title": "Desenfundar armas bajo el agua",
            "description": "Hace que al pulsar el botón de desenfundar bajo el agua, Lara saque un arma que pueda usar allí (como el lanzarpone), en lugar de no hacer nada si el último arma que sostuvo no es compatible en el agua.",
        },
        "gameplay.enable_uw_roll": {
            "title": "Giro bajo el agua",
            "description": "Permite a Lara dar un giro rápido de 180° mientras nada bajo el agua (estilo TR2+). El TR1 original no incluye esta acción.",
        },
        "gameplay.enable_wading": {
            "title": "Vadeo en agua profunda",
            "description": "Permite a Lara avanzar fatigosamente por aguas poco profundas, en lugar de quedarse atascada flotando en la superficie del agua (estilo TR2+). El TR1 original no incluye esta acción.",
        },
        "gameplay.enable_walk_to_items": {
            "title": "Interacciones animadas",
            "description": "Hace que Lara camine de forma natural hacia los objetos del suelo, interruptores, cerraduras y ranuras de puzles cuando está cerca, en lugar de teletransportarse instantáneamente frente a ellos.",
        },
        "gameplay.enemy_health_scale": {
            "title": "Salud de los enemigos",
            "description": "Ajusta la salud inicial de los enemigos. No afecta a los aliados.",
        },
        "gameplay.fix_alligator_ai": {
            "title": "Corregir IA de los caimanes",
            "description": "Corrige el error por el cual los caimanes no infligían ningún daño si Lara se quedaba completamente quieta en el agua.",
        },
        "gameplay.fix_animated_spikes": {
            "title": "Corregir pinchos animados",
            "description": "Corrige el error por el cual los pinchos animados que ya se habían activado se restablecían a su estado inicial al cargar una partida guardada.",
        },
        "gameplay.fix_bear_ai": {
            "title": "Corregir IA de los osos",
            "description": "Corrige el ataque de zarpazo del oso para evitar que falle al intentar golpear a Lara.",
        },
        "gameplay.fix_bird_start_pos": {
            "title": "Corregir posición inicial de las aves",
            "description": "Corrige el problema por el que las aves aparecen en el suelo inferior aunque se hayan colocado inicialmente en el aire.",
        },
        "gameplay.fix_breakable_wall_clip": {
            "title": "Corregir traspaso de muros destruibles",
            "description": "Corrige el error que permitía a Lara saltar o avanzar a gatas atravesando muros destruibles que se encontraban en el límite de un sector del mapa. Si se activa, Lara se detendrá ante el muro hasta que este se destruya.",
        },
        "gameplay.fix_bridge_collision": {
            "title": "Corregir colisión de puentes",
            "description": "Corrige el error que impedía a Lara agarrarse a ciertas partes de algunos puentes y a muros invisibles en los bordes. También soluciona fallos de colisión con puentes levadizos, trampillas y puentes apilados entre sí, sobre pendientes o cerca del suelo.",
        },
        "gameplay.fix_descending_glitch": {
            "title": "Corregir caída en suelos frágiles",
            "description": "Corrige el fallo por el cual dar pasos laterales o caminar hacia atrás sobre baldosas rompibles provocaba que Lara descendiera inmediatamente a la baldosa de abajo. Los TR2+ originales no tienen este error, pero TR1 sí.",
        },
        "gameplay.fix_enemy_route_delay": {
            "title": "Corregir demora de rutas enemigas",
            "description": "Corrige el retraso de varios segundos que pueden sufrir los enemigos al buscar una nueva ruta después de que Lara se mueva.",
        },
        "gameplay.fix_falling_glitch": {
            "title": "Corregir las caídas",
            "description": "Corrige que Lara pueda saltar desde las trampillas justo al abrirse en vez de caer, y que no caiga cuando el suelo cede mientras gira agachada.",
        },
        "gameplay.fix_flare_throw_priority": {
            "title": "Corregir prioridad al lanzar bengalas",
            "description": "Corrige el fallo que priorizaba la acción de lanzar una bengala gastada mientras Lara estaba en el aire, lo que podía provocar que no pudiera agarrarse a los salientes.",
        },
        "gameplay.fix_floor_data_issues": {
            "title": "Corregir datos de suelo",
            "description": "Corrige errores originales relacionados con los datos del suelo y los activadores (triggers).",
        },
        "gameplay.fix_free_flare_glitch": {
            "title": "Corregir truco de bengala gratis",
            "description": "Corrige el error que permitía generar una bengala gratuita al pulsar el botón de bengala mientras se recogía cualquier objeto, o al solicitar una desde el inventario mientras se avanzaba a gatas.",
        },
        "gameplay.fix_item_duplication_glitch": {
            "title": "Corregir duplicación de objetos",
            "description": "Corrige el error que permitía duplicar el uso de objetos clave de misión dentro del inventario.",
        },
        "gameplay.fix_lara_pickup_embed": {
            "title": "Corregir incrustación al recoger",
            "description": "Corrige el fallo por el cual Lara a veces se desplazaba por inercia dentro de los muros al recoger objetos bajo el agua, e impide que se quede incrustada bajo techos muy inclinados al recoger un objeto fuera del agua.",
        },
        "gameplay.fix_lift_collision": {
            "title": "Corregir colisión de ascensores",
            "description": "Corrige el fallo por el cual Lara no colisionaba correctamente con los ascensores o plataformas en movimiento, lo que podía hacer que se quedara atascada o los atravesara.",
        },
        "gameplay.fix_m16_accuracy": {
            "title": "Corregir precisión de M16/MP5",
            "description": "Corrige la precisión al disparar el fusil M16 o el MP5 mientras Lara se encuentra corriendo.",
        },
        "gameplay.fix_monkey_pickup_priority": {
            "title": "Corregir prioridad de recogida de monos",
            "description": "Hace que los monos atacados prioricen contraatacar y defenderse en lugar de entretenerse recogiendo botiquines y llaves del suelo.",
        },
        "gameplay.fix_pipeman_aim": {
            "title": "Corregir puntería de enemigos con cerbatana",
            "description": "Corrige el fallo por el cual los enemigos con cerbatana a veces no lograban apuntar o dirigir los dardos correctamente hacia Lara.",
        },
        "gameplay.fix_qwop_glitch": {
            "title": "Corregir error de animación QWOP",
            "description": "Corrige el fallo por el cual Lara, al saltar sobre escalones muy pequeños, a veces activaba una animación de carrera extraña y deforme, conocida como estado QWOP.",
        },
        "gameplay.fix_step_glitch": {
            "title": "Corregir error de escalón",
            "description": "Corrige el fallo por el cual Lara a veces se veía empujada dentro de los muros adyacentes a los escalones al subir corriendo por ellos de una forma específica. El TR1 original no tiene este error, pero TR2 y TR3 sí.",
        },
        "gameplay.fix_underwater_crawl": {
            "title": "Corregir avance a gatas bajo el agua",
            "description": "Corrige el error que permitía a Lara avanzar a gatas desde la tierra hacia habitaciones con agua o pantanos de cualquier profundidad. Si se activa, Lara solo podrá avanzar a gatas hasta una profundidad que supere ligeramente un bloque de altura.",
        },
        "gameplay.fix_wade_sprint": {
            "title": "Corregir el esprint en agua poco profunda",
            "description": "Corrige que Lara pueda esprintar por agua de profundidad vadeable si entra corriendo.",
        },
        "gameplay.fix_wade_wall_hit": {
            "title": "Corregir choque de muro al vadear",
            "description": "Corrige el fallo por el cual Lara no reaccionaba ni mostraba animación al chocar contra una pared mientras avanzaba vadeando por el agua.",
        },
        "gameplay.fix_walk_run_jump": {
            "title": "Corregir salto de caminata a carrera",
            "description": "Corrige el problema por el cual Lara a veces era incapaz de saltar inmediatamente después de cambiar su animación de caminar a correr.",
        },
        "gameplay.fix_wall_geometry": {
            "title": "Corregir geometría de muros",
            "description": "Corrige casos en la geometría de los niveles originales donde las inclinaciones internas de las paredes provocaban cálculos de altura inexactos. Los TR3+ originales no tienen este problema, pero TR1 y TR2 sí.",
        },
        "gameplay.fix_water_exit": {
            "title": "Corregir salida del agua",
            "description": "Corrige el error que permite a Lara pasar directamente de una sala con agua a una sala seca adyacente, o a una sala seca situada debajo. Además, esto evitará que Lara pueda salir del agua hacia pendientes en las que no se pueda mantener en pie.",
        },
        "gameplay.game_modes_policy": {
            "title": "Selección de modo de juego",
            "description": "Permite seleccionar las opciones de Nueva partida+ desde el menú del pasaporte de nueva partida.\n\n- Nueva partida+: desbloquea todas las armas con munición infinita; los enemigos tienen el doble de PS.\n\nOpciones disponibles:\n\n- Siempre: el diálogo de modos de juego siempre estará disponible.\n- Nunca: el diálogo de modos de juego nunca estará disponible y cada nueva partida será normal.\n- Al completar: el diálogo de modos de juego solo estará disponible después de haber completado el juego.",
        },
        "gameplay.harpoon_recoil": {
            "title": "Retroceso del arpón",
            "description": "Establece la frecuencia con la que Lara debe recargar el lanzaarpones, según su cantidad actual de munición. Por ejemplo, si se establece en 3, tendrá que recargar después de cada tercer disparo. Establécelo en 0 para desactivar la recarga por completo.",
        },
        "gameplay.idle_pose_timeout": {
            "title": "Tiempo de espera para postura inactiva",
            "description": "Permite que Lara entre en una animación de postura cuando haya estado inactiva durante el número especificado de segundos. Establécelo en 0 para desactivarlo.",
        },
        "gameplay.intro_fmv_mode": {
            "title": "Sincronización de las FMV de introducción",
            "description": "Controla cuándo se reproduce el vídeo cinematográfico (FMV) de introducción de cada juego.\n\n- Nueva partida: se reproduce al comenzar una nueva partida.\n- Lanzamiento: se reproduce cada vez que se inicia el juego o se cambia a él, al igual que en los juegos originales.",
        },
        "gameplay.jump_lock_mode": {
            "title": "Modo de bloqueo de salto",
            "description": "Para un salto más receptivo, permite controlar cuánto tiempo después de empezar a correr se le permite saltar a Lara.\n\n- Heredado: coincide con los tiempos originales de TR2.\n- Ajustado: se puede saltar 2 fotogramas antes.\n- Desactivado: se puede saltar inmediatamente después de la animación de inicio de carrera.",
        },
        "gameplay.lara_damage_scale": {
            "title": "Daño recibido por Lara",
            "description": "Ajusta el daño que recibe Lara de cualquier fuente, como enemigos, trampas y caídas.",
        },
        "gameplay.loading_screens": {
            "title": "Pantallas de carga",
            "description": "Controla las pantallas de carga antes de cargar un nivel.\n\n- Desactivado: nunca muestra pantallas de carga.\n- Siempre: muestra pantallas de carga.\n- Nuevas partidas: omite mostrar pantallas de carga al cargar un guardado.",
        },
        "gameplay.look_mode": {
            "title": "Modo de mirada",
            "description": "Permite controlar cuándo puede Lara usar la mirada.\n\n- Restringido: mirar solo está permitido cuando Lara está inmóvil, y nunca bajo el agua, como en el TR1 original.\n- Mejorado: mirar está permitido durante la mayoría de las animaciones, excepto en las de empujar un bloque, como en el TR2+ original.\n- Sin restricciones: mirar está permitido en cualquier momento durante el control normal de Lara.",
        },
        "gameplay.m16_aim_mode": {
            "title": "Variantes de apuntado de M16/MP5",
            "description": "Controla cuándo apunta Lara la M16/MP5 desde el hombro en lugar de hacerlo desde la cadera.\n\n- Original: Lara se lleva el arma al hombro cada vez que deja de moverse.\n- Mejorado: Lara sigue disparando desde la cadera mientras se mantiene presionado el botón de Acción, y solo se lleva el arma al hombro cuando empieza a disparar estando quieta. Con la corrección de precisión activada, el disparo desde la cadera es menos preciso y causa menos daño por disparo.",
        },
        "gameplay.maximum_quick_save_slots": {
            "title": "Número de ranuras de guardado rápido",
            "description": "Cambia el número de ranuras disponibles para el guardado rápido.",
        },
        "gameplay.maximum_save_slots": {
            "title": "Número de ranuras de guardado",
            "description": "Cambia el número de ranuras disponibles para guardar la partida.",
        },
        "gameplay.pause_on_focus_lost": {
            "title": "Pausar al perder el foco",
            "description": "Evita que el juego avance cuando la ventana del juego pierde el foco.",
        },
        "gameplay.projectile_area_damage": {
            "title": "Daño de área de proyectiles",
            "description": "Controla cómo se propaga el efecto de área para el Lanzacohetes y el Lanzagranadas.\n\n- Barrido único: comportamiento de TR1 y TR2.\n- Barrido múltiple: comportamiento de TR3.\n\nLa opción de barrido múltiple a menudo termina infligiendo el doble de daño a los enemigos individuales.",
        },
        "gameplay.remember_gun_status": {
            "title": "Recordar armas entre niveles",
            "description": "Hace que Lara recuerde qué arma estaba usando por última vez en el nivel anterior al comenzar un nuevo nivel. Si se desactiva, Lara volverá a llevar las pistolas enfundadas.",
        },
        "gameplay.restore_ps1_enemies": {
            "title": "Restaurar enemigos de PS1",
            "description": "Añade la momia que aparece en la sala 25 de la Ciudad de Khamoon en la versión de TR1 para PlayStation.\nCambiar esta opción requiere reiniciar el juego.",
        },
        "gameplay.ring_memory_mode": {
            "title": "Recordar posición del inventario",
            "description": "Abre un anillo en la última sección en la que se dejó, en lugar de hacerlo en la primera.\n\n- Desactivado: cada apertura comienza en la primera sección, como en el juego original.\n- Anillo principal: solo se recuerda el anillo de objetos.\n- Todos los anillos: se recuerdan tanto el anillo de objetos como el de llaves.\n\nLa primera sección vuelve a aparecer si Lara ya no lleva lo que se recordaba, y cada nivel comenzará allí.",
        },
        "gameplay.save_crystal_mode": {
            "title": "Modo de cristales",
            "description": "Elige la función que cumplen los cristales esparcidos por los niveles.\n\n- Desactivado: los cristales no están presentes.\n- Guardado: los cristales son de un solo uso y permiten a Lara guardar la partida donde se encuentran, como en la versión de PS1 de TR1. De lo contrario, el guardado se limita al inicio de los niveles.\n- Guardado (objetos): los cristales se recolectan y permiten a Lara guardar la partida desde el inventario en cualquier lugar donde se encuentre, como en la versión de PS1 de TR3. De lo contrario, el guardado se limita al inicio de los niveles.\n- Curación: los cristales restauran la mitad de la salud de Lara y curan el veneno cuando los toca, como en la versión para PC de TR3.\n- Coleccionables: los cristales son objetos recolectables que cuentan en las estadísticas del nivel y no hacen nada más.\n\nCambiar esta opción requerirá reiniciar el nivel.",
        },
        "gameplay.start_lara_hitpoints": {
            "title": "Salud inicial de Lara",
            "description": "Establece el valor de la salud de Lara al comienzo de cada nivel.",
        },
        "gameplay.target_change_mode": {
            "title": "Cambio de objetivo",
            "description": "Cambia la forma en que Lara alterna entre objetivos mientras apunta con las armas.\n\n- Desactivado: Lara mantiene el objetivo actual.\n- Mejorado: presiona el botón Cambiar objetivo para alternar.\n- TR4: toca el botón de Mirar para alternar; mantenerlo presionado seguirá permitiendo mirar alrededor tras un breve retraso.",
        },
        "gameplay.target_mode": {
            "title": "Modo de fijación de armas",
            "description": "Cambia el comportamiento de cómo las armas fijan los objetivos.\n\n- Fijación completa: mantiene siempre la fijación del objetivo incluso si el enemigo se pierde de vista o muere (TR1-3 original).\n- Fijación parcial: mantiene la fijación si el enemigo se pierde de vista, pero la pierde si el enemigo muere.\n- Sin fijación: pierde la fijación si el enemigo se pierde de vista o muere (TR4+).",
        },
        "gameplay.wall_glitch_mode": {
            "title": "Modo de errores de muro",
            "description": "Elige qué errores de muro (glitches) puede realizar Lara.\n\n- TR1: como en el TR1 original, lo que incluye saltar hacia adelante contra un muro y teletransportarse a la parte superior de este.\n- TR2: como en los TR2 y TR3 originales, donde ese salto ya no funciona, pero Lara aún puede teletransportarse al golpear el suelo y el muro al mismo tiempo en ciertas geometrías.\n- Corregido: ninguno de los errores funciona y Lara ya no puede atravesar el sector bloqueado de una puerta.",
        },
        "input.enable_buffering_func_keys": {
            "title": "Almacenamiento en búfer (teclas F)",
            "description": "Activa el almacenamiento en búfer de las teclas F (1 fotograma) para lograr un control preciso del movimiento de Lara. Esta función originalmente solo existe en la versión TombATI (TR1).",
        },
        "input.enable_buffering_inventory": {
            "title": "Almacenamiento en búfer (inventario)",
            "description": "Activa el almacenamiento en búfer del inventario (2 fotogramas) para lograr un control preciso del movimiento de Lara.",
        },
        "input.enable_controller": {
            "title": "Soporte de mando",
            "description": "Permite que el juego detecte mandos conectados. Desactiva esta opción si utilizas un software externo de reasignación que ya traduzca las entradas de tu mando a comandos de teclado.",
        },
        "input.enable_responsive_passport": {
            "title": "Pasaporte receptivo",
            "description": "Evita que se bloqueen las acciones del usuario cuando el pasaporte pasa de página, programando los giros de página en su lugar.",
        },
        "input.enable_touch_controls": {
            "title": "Controles táctiles",
            "description": "Muestra una interfaz superpuesta de controles táctiles en pantalla para dispositivos con pantalla táctil.",
        },
        "input.enable_tr3_sidesteps": {
            "title": "Pasos laterales mejorados",
            "description": "Activa los pasos laterales al estilo de TR3+, por ejemplo, Shift + flechas de dirección. Los botones dedicados para pasos laterales seguirán funcionando.",
        },
        "input.quick_guns_mode": {
            "title": "Teclas de armas rápidas",
            "description": "Controla el comportamiento de las teclas de equipamiento rápido de armas.\n\n- Solo desenfundar: presionar una tecla hará que Lara equipe el arma asignada.\n- Desenfundar o enfundar: igual que el anterior, pero además Lara guardará el arma asignada si ya la lleva en la mano actualmente.",
        },
        "input.touch_button_scale": {
            "title": "Escala de botones táctiles",
            "description": "Ajusta el tamaño de los botones de control táctil en pantalla.",
        },
        "input.touch_dpad_deadzone": {
            "title": "Zona muerta de la cruceta táctil",
            "description": "Ajusta la zona muerta de la cruceta táctil en pantalla. Una zona muerta más grande requiere un mayor movimiento antes de que se registre la dirección.",
        },
        "input.touch_dpad_scale": {
            "title": "Escala de la cruceta táctil",
            "description": "Ajusta el tamaño de la cruceta táctil en pantalla.",
        },
        "input.touch_opacity": {
            "title": "Opacidad táctil",
            "description": "Ajusta la transparencia de los botones de control táctil en pantalla.",
        },
        "language": {
            "title": "Idioma",
            "description": "Cambia el idioma del texto de la interfaz de usuario.",
        },
        "rendering.anisotropy_filter": {
            "title": "Filtro anisotrópico",
            "description": "Mejora el filtrado de texturas a largas distancias.",
        },
        "rendering.aspect_mode": {
            "title": "Modo de relación de aspecto",
            "description": "Fuerza ciertas relaciones de aspecto en el juego mediante franjas negras (letterbox).",
        },
        "rendering.borders": {
            "title": "Bordes",
            "description": "Añade bordes negros alrededor de la ventana del juego.",
        },
        "rendering.dither_mode": {
            "title": "Tramado (Dithering)",
            "description": "Selecciona el sombreado de paleta original del renderizador por software de PC o el tramado RGB555 de PlayStation.",
        },
        "rendering.enable_affine_mapping": {
            "title": "Mapeado de texturas afín",
            "description": "Elimina la corrección de perspectiva de las texturas, como en PlayStation, haciendo que se deformen y fluctúen sobre superficies grandes al mover la cámara.",
        },
        "rendering.enable_hall_of_mirrors": {
            "title": "Efecto de espejo",
            "description": "Mantiene en pantalla el fotograma anterior donde no se dibuja nada, como en las versiones de PC. Algunos niveles usan esto para crear efectos, como en Thames Wharf. Las zonas exteriores sin cielo siguen limpiándose.",
        },
        "rendering.enable_palette_quantize": {
            "title": "Cuantización de paleta",
            "description": "Asigna cada color renderizado al color más cercano en la paleta del nivel. Con el tramado activado, la paleta genera degradados entre sus colores.",
        },
        "rendering.enable_ps1_blending": {
            "title": "Mezcla de PlayStation",
            "description": "Mezcla ciertos efectos y caras con la escena, como en PlayStation. El humo, las sombras y las huellas restan su color a la escena, oscureciendo todos los canales de color por igual y produciendo un resultado más saturado. En TR1 y TR2, las caras como las superficies de agua, el cristal y los destellos de disparos, así como efectos como salpicaduras, llamas y explosiones, se mezclan al 50 % con la escena. En TR3, la sangre también se mezcla al 50 %. Si se desactiva, todo esto se dibuja como en PC.",
        },
        "rendering.enable_ps1_fog": {
            "title": "Niebla de PlayStation",
            "description": "Mezcla la geometría lejana con el color de la niebla de la misma forma que lo hacía el indicador de profundidad de PlayStation: a lo largo de 1/distancia en lugar de la distancia, y calculado por vértice, de modo que el gradiente forma franjas en superficies grandes.",
        },
        "rendering.enable_ps1_pixel_aspect": {
            "title": "\\{review}Relación de aspecto de píxel de PlayStation",
            "description": "\\{review}Muestra el mundo del juego más estrecho, como lo hacía la PlayStation en un televisor. La imagen sigue llenando la pantalla. La interfaz no cambia.",
        },
        "rendering.enable_trapezoid_filter": {
            "title": "Filtro trapezoidal",
            "description": "Corrige el renderizado de los cuadriláteros.",
        },
        "rendering.enable_vsync": {
            "title": "Sincronización vertical (VSync)",
            "description": "Activa o desactiva la sincronización vertical.",
        },
        "rendering.fmv_filter": {
            "title": "Filtro de FMV",
            "description": "Alterna entre un aspecto suavizado y uno pixelado para los vídeos cinematográficos (FMV).",
        },
        "rendering.fps": {
            "title": "FPS",
            "description": "Establece los fotogramas por segundo del juego.",
        },
        "rendering.lighting_contrast": {
            "title": "Contraste de iluminación",
            "description": "Aumenta el contraste de las fuentes de luz dinámicas, como las bengalas y los fogonazos de las armas.",
        },
        "rendering.lighting_curve": {
            "title": "Modelo de iluminación",
            "description": "Elige hasta qué punto la iluminación por vértices escala la textura.\n\n- Plano: se detiene en el propio brillo de la textura, que es más tenue (TR3 PC).\n- Brillo excesivo: es lo que hacían los renderizadores de PC: un vértice completamente iluminado lleva el téxel al doble de su brillo, y el exceso se añade después (TR4 PC).\n- Saturado: es el de PlayStation, duplicando también el téxel pero dejando que cada color se recorte donde corresponda, lo que mantiene las superficies brillantes en su propio color en lugar de desvanecerlas (TR3/TR4 PS1).",
        },
        "rendering.multisampling_factor": {
            "title": "Multimuestreo (Multisampling)",
            "description": "Suaviza los bordes de los muros y objetos tomando varias muestras de cada píxel a lo largo de ellos. Es mucho más económico que el supermuestreo, pero no afecta a los bordes de los sprites como el follaje y el fuego.",
        },
        "rendering.screenshot_format": {
            "title": "Formato de captura de pantalla",
            "description": "Formato de archivo para las capturas de pantalla.",
        },
        "rendering.sprite_lock_mode": {
            "title": "Modo de bloqueo de sprites",
            "description": "Controla qué ejes bloquear al mostrar sprites en la pantalla.\n\n- Ninguno: muestra los sprites normalmente.\n- Rotación (Roll): bloquea el eje de rotación (útil solo en el modo foto).\n- Rotación y cabeceo (Roll & pitch): garantiza que los sprites se mantengan erguidos y no se queden planos en el suelo al mirarlos desde arriba.\n- Perspectiva: bloquea los ejes de rotación y cabeceo y, además, gira los sprites ligeramente hacia el centro de la pantalla.",
        },
        "rendering.supersampling_factor": {
            "title": "Supermuestreo (Supersampling)",
            "description": "Renderiza el juego a un múltiplo de su resolución y luego calcula el promedio para reducirla, lo que suaviza los bordes dentados. Los factores más altos requieren un esfuerzo varias veces mayor por parte de la tarjeta gráfica.",
        },
        "rendering.texture_filter": {
            "title": "Filtro de texturas",
            "description": "Alterna entre texturas del juego suavizadas o pixeladas.",
        },
        "rendering.ui_filter": {
            "title": "Filtro de interfaz (UI)",
            "description": "Alterna entre texturas de la interfaz de usuario suavizadas o pixeladas.",
        },
        "rendering.upscaling_factor": {
            "title": "Factor de escalado",
            "description": "Escala el juego por un factor determinado, manteniendo el aspecto pixelado.",
        },
        "rendering.upscaling_filter": {
            "title": "Filtro de escalado",
            "description": "Alterna el aspecto suavizado o pixelado para toda la pantalla.",
        },
        "rendering.vertex_snap_mode": {
            "title": "Ajuste de vértices (Vertex snapping)",
            "description": "Controla la cuadrícula de ajuste de vértices para la geometría temblorosa de los lanzamientos de PlayStation.\n\n- Desactivado: desactiva el ajuste de vértices.\n- 320x240: utiliza la cuadrícula original de 320x240.\n- Resolución escalada: utiliza la resolución de escalado.",
        },
        "ui.airbar_color": {
            "title": "Color de la barra de aire",
            "description": "Color de la barra de aire.",
        },
        "ui.airbar_color_ps1": {
            "title": "Color de la barra de aire",
            "description": "Color de la barra de aire.",
        },
        "ui.airbar_location": {
            "title": "Ubicación de la barra de aire",
            "description": "Ubicación donde se muestra la barra de aire.",
        },
        "ui.ammo_counter_location": {
            "title": "Ubicación del contador de munición",
            "description": "Ubicación donde se muestra el contador de munición.",
        },
        "ui.background_blur": {
            "title": "Desenfoque del fondo",
            "description": "Desenfoca el juego detrás de las pantallas de inventario, pausa y estadísticas. El desenfoque se suma al estilo de fondo elegido.",
        },
        "ui.bar_look": {
            "title": "Aspecto de las barras",
            "description": "Elige el marco y los colores con los que se dibujan las barras de la interfaz, tomados de uno de los lanzamientos originales. La elección también decide qué conjunto de configuraciones de color de barra de abajo se aplica.",
        },
        "ui.bar_scale": {
            "title": "Escala de las barras",
            "description": "Cambia el tamaño de las barras de la interfaz.",
        },
        "ui.enable_bar_flashing": {
            "title": "Parpadeo de barras",
            "description": "Hace que las barras de salud y oxígeno de Lara parpadeen cuando se está quedando sin alguno de estos recursos.",
        },
        "ui.enable_bar_side_borders": {
            "title": "Bordes laterales",
            "description": "Dibuja el borde adicional a los lados de las barras de PS1.",
        },
        "ui.enable_smooth_bars": {
            "title": "Barras fluidas",
            "description": "Hace que las barras de la interfaz utilicen transiciones de color fluidas.",
        },
        "ui.enable_wraparound": {
            "title": "Desplazamiento cíclico",
            "description": "Permite que la navegación direccional en los menús vuelva al principio al llegar al final.",
        },
        "ui.enemy_healthbar_color": {
            "title": "Color de la barra del enemigo",
            "description": "Color de la barra de salud del enemigo.",
        },
        "ui.enemy_healthbar_color_allies": {
            "title": "Color de la barra de aliados",
            "description": "Color de la barra de salud de los aliados. Se muestra en el lugar de las barras de salud de los enemigos.",
        },
        "ui.enemy_healthbar_color_allies_ps1": {
            "title": "Color de la barra de aliados",
            "description": "Color de la barra de salud de los aliados. Se muestra en el lugar de las barras de salud de los enemigos.",
        },
        "ui.enemy_healthbar_color_ps1": {
            "title": "Color de la barra del enemigo",
            "description": "Color de la barra de salud del enemigo.",
        },
        "ui.enemy_healthbar_location": {
            "title": "Ubicación de la barra del enemigo",
            "description": "Ubicación donde se muestra la barra de salud del enemigo.",
        },
        "ui.enemy_healthbar_show_mode": {
            "title": "Modo de la barra del enemigo",
            "description": "Controla cuándo se muestra una barra de salud para el enemigo al que Lara está apuntando.\n\n- Siempre: la muestra para cualquier objetivo.\n- Solo jefes: la muestra solo cuando el objetivo es un jefe.\n- Nunca: no la muestra nunca.",
        },
        "ui.exposurebar_color": {
            "title": "Color de la barra de exposición",
            "description": "Color de la barra de exposición al agua fría.",
        },
