        },
        "ui.stats.show_crystals": {
            "title": "Cristales",
            "description": "Muestra la fila de cristales en las estadísticas del nivel.",
        },
        "ui.stats.show_deaths": {
            "title": "Muertes",
            "description": "Muestra las muertes de Lara en las estadísticas de la brújula y en las estadísticas del nivel. El contador de muertes se actualiza en el archivo de guardado cargado actualmente tan pronto como Lara muere.",
        },
        "ui.stats.show_distance_travelled": {
            "title": "Distancia recorrida",
            "description": "Muestra la fila de distancia recorrida en las estadísticas del nivel.",
        },
        "ui.stats.show_kills": {
            "title": "Bajas",
            "description": "Muestra la fila de bajas en las estadísticas del nivel.",
        },
        "ui.stats.show_level_header": {
            "title": "Contador de nivel",
            "description": "Muestra el número del nivel actual en la parte superior de las estadísticas del nivel.",
        },
        "ui.stats.show_medipacks_used": {
            "title": "Botiquines usados",
            "description": "Muestra la fila de botiquines usados en las estadísticas del nivel.",
        },
        "ui.stats.show_pickups": {
            "title": "Objetos recogidos",
            "description": "Muestra la fila de objetos recogidos en las estadísticas del nivel.",
        },
        "ui.stats.show_secrets": {
            "title": "Secretos encontrados",
            "description": "Muestra la fila de secretos encontrados en las estadísticas del nivel.",
        },
        "ui.stats.show_time_taken": {
            "title": "Tiempo empleado",
            "description": "Muestra la fila del tiempo empleado en las estadísticas del nivel.",
        },
        "ui.stats.show_totals": {
            "title": "Mostrar totales",
            "description": "Muestra los totales junto a las estadísticas cuando corresponda. Los secretos no se ven afectados por esta opción.",
        },
        "ui.stats.style": {
            "title": "Estilo de estadísticas",
            "description": "Controla cómo se muestra el cuadro de estadísticas.\n\n- Simple: muestra el diseño más sencillo sin recuadro.\n- Con bordes: muestra el diseño encuadrado.",
        },
        "ui.stats_background_style": {
            "title": "Fondo de estadísticas",
            "description": "Cambia la forma en que se muestra el fondo para las estadísticas del final del nivel.\n\n- Oscuro: TR1 (PC).\n- Muy oscuro: TR1 (PS1).\n- Estático: TR2 (PC).\n- Onda: TR2 (PS1).\n- Monocromo: TR3.",
        },
        "ui.stats_fade_effects": {
            "title": "Efectos de fundido de estadísticas",
            "description": "Ajusta con precisión los efectos de fundido que se activan o desactivan en la pantalla de estadísticas del final del nivel. Requiere que la opción Efectos de fundido esté activada para funcionar.",
        },
        "ui.text_scale": {
            "title": "Escala del texto",
            "description": "Cambia el tamaño del texto de la interfaz de usuario.",
        },
        "visuals.background_brightness": {
            "title": "Brillo del fondo",
            "description": "Cambia el brillo de los patrones e imágenes de fondo.",
        },
        "visuals.blood_effects": {
            "title": "Efectos de sangre",
            "description": "Controla los colores de las salpicaduras de sangre.\n\n- Desactivado: no se muestran salpicaduras de sangre.\n- Rosa: el predeterminado en las versiones alemanas de TR3 para PC.\n- Rojo: el predeterminado en todos los demás lanzamientos comerciales.",
        },
        "visuals.braid_status": {
            "title": "Trenza de Lara",
            "description": "Controla cómo se muestra la trenza de Lara.\n\n- Desactivado: nunca se muestra la trenza de Lara.\n- Activado: se muestra la trenza de Lara en todos los atuendos que la admitan.\n- Automático: la trenza está desactivada para los atuendos normales de TR1 y activada para todos los demás que la admitan.",
        },
        "visuals.breeze_mode": {
            "title": "Brisa",
            "description": "Cambia la forma en que la brisa afecta a la trenza de Lara, a las gotas de agua que caen de ella y a la lluvia o nieve en las salas correspondientes.\n\n- Desactivado: desactiva el efecto de la brisa.\n- TR2: la brisa siempre sopla en la misma dirección.\n- TR3/4: la brisa cambia de dirección con el tiempo.",
        },
        "visuals.camera_mode": {
            "title": "Modo de cámara",
            "description": "Elige el comportamiento de cámara de qué juego utilizar.\n\n- TR1: la cámara de seguimiento va tras los cuadros de navegación del nivel.\n- TR2: igual que el anterior, con límites de seguimiento y de mirada diferentes, y un manejo distinto de las cámaras fijas.\n- TR3: la cámara de seguimiento utiliza la línea de visión en lugar de los cuadros de navegación.\n- TR4: igual que TR3, pero la cámara también reacciona cuando una acción mueve la vista de Lara, como recoger un objeto o rodear una esquina colgada de un borde.",
        },
        "visuals.controls_model": {
            "description": "Qué modelo muestra el objeto de controles del inventario. Automático muestra un mando cuando los controles están configurados para usar uno y, en caso contrario, el teclado. Original muestra el modelo incluido en cada nivel.",
            "title": "Modelo de controles",
            "values": {
                "auto": "Automático",
                "keyboard": "Teclado",
                "original": "Original",
                "ps1": "Mando de PlayStation",
                "saturn": "Mando de Sega Saturn",
            }
        },
        "visuals.enable_3d_pickups": {
            "title": "Objetos en 3D",
            "description": "Permite renderizar modelos en 3D en lugar de sprites para los objetos que se pueden recoger.",
        },
        "visuals.enable_all_upv_wakes": {
            "title": "Estelas en todas las UPV",
            "description": "Todas las UPV dejarán estelas detrás del manillar. Si se desactiva, solo dejarán estelas las UPV activadas por un activador, como en la versión de PC.",
        },
        "visuals.enable_droplets": {
            "title": "Gotas de agua",
            "description": "Activa el renderizado de las gotas de agua que gotean de Lara después de salir del agua.",
        },
        "visuals.enable_exit_fade_effects": {
            "title": "Fundido al salir del juego",
            "description": "Activa los efectos de fundido al salir del juego hacia el escritorio.",
        },
        "visuals.enable_fade_effects": {
            "title": "Efectos de fundido",
            "description": "Activa las transiciones de fundido, por ejemplo, entre las pantallas de créditos o para las transiciones del inventario y la pantalla de pausa.",
        },
        "visuals.enable_fire_lighting": {
            "title": "Iluminación de fuego",
            "description": "Permite generar iluminación dinámica junto a las llamas activas.",
        },
        "visuals.enable_fog_bulbs": {
            "title": "Bulbos de niebla",
            "description": "Activa los efectos de niebla volumétrica colocados en los niveles.",
        },
        "visuals.enable_footprints": {
            "title": "Huellas",
            "description": "Activa el renderizado de las huellas de Lara en ciertas superficies en los niveles que lo admitan.",
        },
        "visuals.enable_glide_cameras": {
            "title": "Suavizado de cámaras",
            "description": "Activa una acción de deslizamiento suave en las cámaras fijas que miran a Lara adoptando una curva de velocidad fluida. Si se desactiva, dichas cámaras cambiarán la vista para mirar a Lara de forma inmediata.",
        },
        "visuals.enable_gun_glow": {
            "title": "Resplandor de armas",
            "description": "Renderiza los fogonazos de las armas y las bengalas de forma semitransparente y añade un efecto de brillo (bloom) a su alrededor, como se veía en la versión de PS1 de TR2.",
        },
        "visuals.enable_gun_lighting": {
            "title": "Iluminación de armas",
            "description": "Permite generar iluminación dinámica para los disparos y las explosiones.",
        },
        "visuals.enable_photo_mode_collision": {
            "title": "Colisión en modo foto",
            "description": "Fuerza a la cámara a respetar la geometría al explorar un nivel en el modo foto. Si se desactiva, la cámara se puede mover libremente a través de muros, techos y suelos.",
        },
        "visuals.enable_poison_vision": {
            "title": "Efecto de visión envenenada",
            "description": "Deforma la vista mientras Lara está envenenada. Desactívalo si tienes propensión al mareo por movimiento.",
        },
        "visuals.enable_ps1_crystals": {
            "title": "Tono de cristales de PS1",
            "description": "Los cristales de guardado se dibujarán con un tono morado, más similar al estilo de PS1.",
        },
        "visuals.enable_ps1_rain": {
            "title": "Gotas de lluvia de PS1",
            "description": "Las gotas de lluvia se añadirán a la escena en lugar de mezclarse con ella, de modo que aparezcan pálidas como en la PS1.",
        },
        "visuals.enable_rain_splashes": {
            "title": "Salpicaduras de lluvia",
            "description": "Las gotas de lluvia salpicarán al golpear el suelo o el agua.",
        },
        "visuals.enable_reflections": {
            "title": "Reflejos",
            "description": "Activa los reflejos en ciertos objetos.",
        },
        "visuals.enable_shotgun_flash": {
            "title": "Fogonazo de escopeta",
            "description": "Dibuja llamas al disparar la escopeta, al igual que con las otras armas.",
        },
        "visuals.enable_skybox": {
            "title": "Cajas de cielo (Skyboxes)",
            "description": "Activa la caja de cielo en los niveles compatibles.",
        },
        "visuals.enable_spherical_fog": {
            "title": "\\{review}Niebla esférica",
            "description": "\\{review}Hace que la niebla dependa de la distancia a la cámara, así que girar la cámara no cambia lo lejos que se ve. Si se desactiva, la niebla depende de la profundidad en la dirección de la vista, como en los juegos originales, y los bordes de la pantalla muestran más lejos que el centro.",
        },
        "visuals.enable_static_lighting": {
            "title": "Iluminación de mallas estáticas",
            "description": "Permite que las llamas y otras luces dinámicas iluminen las mallas estáticas. El TR4 original solo ilumina la geometría de las salas.",
        },
        "visuals.enable_weather": {
            "title": "Clima",
            "description": "Activa el renderizado de los efectos climáticos en los niveles compatibles.",
        },
        "visuals.fix_animated_sprites": {
            "title": "Corregir animaciones de sprites",
            "description": "Corrige los sprites de plantas submarinas originales para que se animen correctamente en las zonas de agua.",
        },
        "visuals.fix_item_rots": {
            "title": "Corregir problemas de colocación de objetos",
            "description": "Corrige varios problemas del juego original causados por la configuración o colocación incorrecta de objetos, incluyendo rotaciones, posiciones y asignaciones de salas.",
        },
        "visuals.fix_projectile_brightness": {
            "title": "Corregir brillo de proyectiles",
            "description": "Corrige que los proyectiles, como cuchillos, arpones y granadas, se dibujen con el brillo máximo en lugar de recibir la iluminación de la sala.",
        },
        "visuals.fix_smoke_emitters": {
            "title": "Corregir emisores de humo",
            "description": "Corrige los emisores de humo destinados a ser negros que se renderizaban como blancos.",
        },
        "visuals.fix_texture_issues": {
            "title": "Corregir problemas de texturas",
            "description": "Corrige problemas originales de texturas o mallas faltantes e incorrectas.",
        },
        "visuals.fog_color": {
            "title": "Color de la niebla",
            "description": "Color de la niebla.",
        },
        "visuals.fog_end": {
            "title": "Fin de la niebla",
            "description": "Establece la distancia en bloques donde la niebla oculta todo por completo. Los TR2 y TR3 originales alcanzan ese punto a los 20 bloques. Un nivel puede incluir su propio valor, el cual se usará en su lugar.",
        },
        "visuals.fog_start": {
            "title": "Inicio de la niebla",
            "description": "Establece la distancia en bloques donde la niebla comienza a aparecer. Los TR2 y TR3 originales comienzan a los 12 bloques. Un nivel puede incluir su propio valor, el cual se usará en su lugar.",
        },
        "visuals.fog_transparency": {
            "title": "Transparencia de la niebla",
            "description": "Determina si se activa la mezcla de la geometría lejana en caras 100% transparentes.",
        },
        "visuals.fov": {
            "title": "Campo de visión (FOV)",
            "description": "Ángulo de visión en grados. Los valores más grandes amplían el campo de visión y los más pequeños lo reducen.",
        },
        "visuals.game_brightness": {
            "title": "Brillo del juego",
            "description": "Cambia el brillo del juego.",
        },
        "visuals.gamma": {
            "title": "Gamma",
            "description": "Ajusta la curva de gamma. Valores más altos significan una iluminación más brillante. El valor de 2.5 representa los colores predeterminados.",
        },
        "visuals.golden_lara": {
            "title": "Lara de oro",
            "description": "Convierte a Lara en oro, independientemente del atuendo que lleve puesto, tal como lo hace la mano de Midas.",
        },
        "visuals.lara_outfit": {
            "title": "Atuendo de Lara",
            "description": "Cambia la apariencia de Lara. Elegir Predeterminado respetará cualquier cambio de atuendo habitual entre niveles; de lo contrario, el valor elegido persistirá hasta que se cambie manualmente.",
        },
        "visuals.level_start_transition": {
            "description": "Cómo aparece un nivel al iniciarlo o cargar una partida. Fundido cruzado mezcla la pantalla de carga con el nivel. Fundido a negro desvanece la pantalla de carga hasta el negro y luego muestra el nivel desde el negro, como en el TR4 original. Sin pantalla de carga, ambos modos muestran el nivel mediante un fundido desde negro. Desactivado muestra el nivel de inmediato.",
            "title": "Transición al iniciar el nivel",
            "values": {
                "black": "Fundido a negro",
                "cross-fade": "Fundido cruzado",
                "disabled": "Desactivado",
            }
        },
        "visuals.logo_locale": {
            "description": "Determina cuál de los logotipos del juego muestra la pantalla de título. El original incluye uno para cada idioma en el que fue publicado.",
            "title": "Logotipo del título",
            "values": {
                "de": "Alemán",
                "en-gb": "Inglés (Reino Unido)",
                "en-us": "Inglés (EE. UU.)",
                "fr": "Francés",
            }
        },
        "visuals.shadow_type": {
            "title": "Forma de las sombras",
            "description": "Selecciona cómo se renderizan las sombras de las entidades.\n\n- Octógono: sombras antiguas de TR1 y TR2\n- Círculo: sombras redondas\n- Sprite: sombras basadas en texturas de TR3",
        },
        "visuals.sunglasses_mode": {
            "title": "Gafas de sol de Lara",
            "description": "Cambia el estilo de las gafas de sol de Lara. Ten en cuenta que los cristales serán reflectantes si la opción correspondiente está activada.\n\n- Desactivado: Lara no llevará gafas de sol.\n- Opaco: las gafas de sol de Lara tendrán cristales opacos.\n- Transparente: las gafas de sol de Lara tendrán cristales semitransparentes.",
        },
        "visuals.sunglasses_reflective": {
            "title": "Gafas de sol reflectantes",
            "description": "Activa los reflejos en las lentes de las gafas de sol de Lara. También deben estar activados los reflejos.",
        },
        "visuals.ui_brightness": {
            "title": "Brillo de la interfaz (UI)",
            "description": "Cambia el brillo de la interfaz de usuario.",
        },
        "visuals.water_color": {
            "title": "Color del agua",
            "description": "Color del agua.",
        },
        "visuals.water_color_mode": {
            "description": "Determina el tono subacuático de qué versión utilizar. Mientras se elija un ajuste predefinido, este mantendrá el color del agua indicado abajo; Personalizado te deja ese color a tu elección.",
            "title": "Ajuste predefinido de color del agua",
            "values": {
                "custom": "Personalizado",
                "dos": "DOS",
                "pc": "PC",
                "pc_hardware": "PC (hardware)",
                "pc_software": "PC (software)",
                "ps1": "PS1",
                "tombati": "TombATI",
            }
        },
        "visuals.water_tint_mode": {
            "title": "Tinte del agua",
            "description": "Determina qué parte de Lara se ve afectada por el color del agua mientras está en ella. Completo la tiñe por entero, como hacen TR1 y TR2. Por malla tiñe cada una de sus mallas según donde se sitúe, como hacen TR3 y TR4. Receptivo la corta en la superficie del agua, de modo que solo la parte que queda bajo el agua adopta el color.",
        },
        "window.is_borderless": {
            "title": "Pantalla completa sin bordes",
            "description": "Ocupa toda la pantalla con una ventana sin bordes, para que otras ventanas y superposiciones puedan permanecer por encima del juego.",
        },
        "window.is_fullscreen": {
            "title": "Pantalla completa",
            "description": "Llena la pantalla o se ejecuta en una ventana.",
        }
    },
