        "ui.instant_save_load_screen": {
            "title": "Pantalla de guardado/carga instantánea",
            "description": "Muestra las ranuras de guardado en su propia pantalla, sin el anillo del inventario, animaciones, fundidos ni sonido, de modo que aparezcan al instante.",
        },
        "ui.inventory_background_style": {
            "title": "Fondo del inventario",
            "description": "Cambia la forma en que se muestra el fondo del anillo del inventario.\n\n- Oscuro: TR1 (PC).\n- Muy oscuro: TR1 (PS1).\n- Estático: TR2 (PC).\n- Onda: TR2 (PS1).\n- Monocromo: TR3.",
        },
        "ui.inventory_fade_effects": {
            "title": "Efectos de fundido del inventario",
            "description": "Ajusta con precisión los efectos de fundido que se activan o desactivan en el anillo del inventario del juego. Requiere que la opción Efectos de fundido esté activada para funcionar.",
        },
        "ui.menu_style": {
            "title": "Estilo del menú",
            "description": "Cambia el modo en que se muestran los menús.\n\n- PC: el estilo de la interfaz coincide con la versión de PC.\n- PS1: el estilo de la interfaz coincide con la versión de PS1.",
        },
        "ui.menu_system": {
            "description": "Cómo muestra el juego sus menús. Anillo muestra los objetos de Lara en un anillo giratorio, como en TR1 a TR3. Plano los muestra en una fila en pantalla, junto con una lista de acciones disponibles, como en el TR4 original.",
            "title": "Sistema de menú",
            "values": {
                "flat": "Plano",
                "ring": "Anillo",
            }
        },
        "ui.pause_background_style": {
