        "gameplay.creature_drown_policy": {
            "title": "Умови утоплення істот",
            "description": "Керує поведінкою сухопутних істот у затоплених кімнатах.\n\n— Ніколи: сухопутні істоти ніколи не тонуть (стиль TR1).\n— За умовчанням: істоти тонуть у воді глибиною від 2 кліків (стиль TR2/3).\n— Повне занурення: істоти тонуть лише тоді, коли повністю опиняються під водою.",
        },
        "gameplay.disable_extra_guns": {
