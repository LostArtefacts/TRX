            "description": "Дозволяє Ларі брати на приціл дружніх юнітів, наприклад, ченців. Якщо вимкнено, союзники будуть несприйнятливі до зброї Лари.",
        },
        "gameplay.enable_alternative_turns": {
            "title": "Альтернативні розвороти",
            "description": "Дозволяє Ларі виконувати додаткові рухи та розвороти, коли вона стоїть на місці.\n\n— Натисніть «Перекат» + «Стрибок» разом для нейтрального розвороту в повітрі.\n— Натисніть «Перекат» + «Крок» разом для швидкого розвороту на місці.\n— Натисніть «Перекат» під час руху по рукоходу для швидкого розвороту на місці.",
        },
        "gameplay.enable_auto_item_selection": {
            "title": "Автовибір квестових предметів",
            "description": "Коли Лара натискає кнопку дії біля замкової щілини або пазла, і у неї в інвентарі є відповідна річ, цей предмет буде вибрано автоматично.",
        },
        "gameplay.enable_back_slope_stumble": {
            "title": "Перечіплювання об схил ззаду",
            "description": "Змушує Лару перечіплюватися та втрачати рівновагу, якщо вона відстрибує назад на схил (стиль TR3). Якщо вимкнено, Лара просто різко зупиниться перед схилом (стиль TR1/2).",
        },
        "gameplay.enable_binoculars": {
            "title": "Бінокль",
            "description": "Додає бінокль до списку доступних предметів в інвентарі.",
