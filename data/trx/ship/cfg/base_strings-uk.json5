        },
        "gameplay.enable_environment_kill_count": {
            "title": "Враховувати вбиті оточенням цілі",
            "description": "Додає ворогів, які загинули від пасток на локації (наприклад, захисних лазерів чи утоплення), до загальної статистики вбивств.",
        },
        "gameplay.enable_fast_pickups": {
            "title": "Швидке підбирання предметів",
            "description": "Дозволяє Ларі значно швидше піднімати предмети з підлоги, подібно до TR4+.",
        },
        "gameplay.enable_fast_pull_up": {
            "title": "Швидке підтягування",
            "description": "Дозволяє Ларі швидше підтягуватися та вилазити з уступів.",
        },
        "gameplay.enable_fast_shimmying": {
            "title": "Швидке пересування у висі",
            "description": "Дозволяє Ларі рухатися швидше під час пересування вліво або вправо, тримаючись за край руками.",
        },
        "gameplay.enable_fmv": {
            "title": "Відеоролики",
            "description": "Умикає відтворення заздалегідь записаних відеороликів (кат-сцен).",
        },
        "gameplay.enable_idle_pose_camera": {
            "title": "Камера під час спокою",
            "description": "Повертає камеру обличчям до Лари, коли вона програє анімацію спокою (очікування). Натискання кнопки огляду скидає положення камери.",
        },
        "gameplay.enable_inverted_look": {
            "title": "Інверсія огляду",
            "description": "Інвертує керування по осі Y, коли Лара оглядається навколо.",
        },
        "gameplay.enable_item_examining": {
            "title": "Огляд предметів",
            "description": "Для кастомних рівнів — дозволяє відображати описи предметів в інвентарі, якщо автор рівня додав відповідні дані.",
        },
        "gameplay.enable_jump_twists": {
            "title": "Розвороти у стрибку",
            "description": "Умикає розвороти в повітрі та сальто, тобто натискання кнопки «Перекат» під час звичайного стрибка або стрибка «ластівкою» (стиль TR2+). В оригінальній TR1 цього не було.",
        },
        "gameplay.enable_killer_pushblocks": {
            "title": "Смертельні блоки",
            "description": "Якщо увімкнено, рухомий блок, що падає з висоти на Лару, миттєво вб'є її. Інакше Лара просто опиниться на блоці та виживе.",
        },
        "gameplay.enable_laser_sight_toggle": {
            "title": "Фіксація лазерного прицілу",
            "description": "Змушує кнопку огляду вмикати вигляд через лазерний приціл і вимикати його при наступному натисканні. Якщо вимкнено, для утримання прицілу кнопку огляду потрібно затиснути, як в оригінальній грі.",
        },
        "gameplay.enable_lean_jumping": {
            "title": "Зміщення у стрибку на місці",
            "description": "Дозволяє Ларі сильніше зміщуватися вперед або назад під час вертикальних стрибків на місці, якщо утримується відповідна кнопка напрямку (стиль TR2+). В оригінальній TR1 вона завжди зміщувалася тільки вперед і значно повільніше.",
        },
        "gameplay.enable_ledge_jumps": {
            "title": "Стрибки від уступів",
            "description": "Дозволяє Ларі стрибати вгору або назад, коли вона висить на уступі, за умови, що перед нею є тверда поверхня, від якої можна відштовхнутися.",
        },
        "gameplay.enable_legal": {
            "title": "Заставки правової інформації",
            "description": "Умикає показ правової інформації та заставки «Core Design» під час запуску гри.",
        },
        "gameplay.enable_manual_camera": {
            "title": "Ручне керування камерою",
            "description": "Дозволяє кнопкам камери (\\{input camera_forward}\\{input camera_back}\\{input camera_left}\\{input camera_right}), які використовуються у фоторежимі, також обертати камеру безпосередньо під час геймплею.",
        },
        "gameplay.enable_monkey_bar_edge_deflect": {
            "title": "Відштовхування від країв рукоходу",
            "description": "Дозволяє Ларі плавно відштовхуватися від країв або меж рукоходу під час руху вперед.",
        },
        "gameplay.enable_monkey_bar_shimmy_turn": {
            "title": "Поворот у висі на рукоході",
            "description": "Дозволяє Ларі повертатися під час пересування на руках уздовж рукоходу, подібно до того, як вона може робити це під час кроків убік або плавання боком на поверхні води.",
        },
        "gameplay.enable_multiple_pickups": {
            "title": "Групове підбирання предметів",
            "description": "Дозволяє Ларі підбирати за одну анімацію всі предмети, які лежать в одній точці (стиль TR1-3). Якщо вимкнено, Ларі доведеться повторювати анімацію для кожного предмета окремо (стиль TR4+).",
        },
        "gameplay.enable_pickup_aids": {
            "title": "Підсвічування предметів",
            "description": "Умикає ефект періодичного мерехтіння біля предметів на локації, щоб підкреслити їхню наявність.",
        },
        "gameplay.enable_play_previous_levels": {
            "title": "Вибір пройдених рівнів",
            "description": "Умикає функції «Вибір пройденого рівня» та «Історія до цього моменту...» на екрані початку нової гри.",
        },
        "gameplay.enable_responsive_crawl": {
            "title": "Чуйне повзання",
            "description": "Покращує оригінальну механіку повзання.\n\n— Дозволяє швидше відновлювати рух повзком після зупинки.\n— Дозволяє переходити від бігу/спринту до повзання без попередньої зупинки.\n— Дозволяє переходити від повзання до перекату навприсядки (якщо увімкнено) без потреби сідати вручну.\n— Дозволяє повертатися, сидячи навприсядки.\n— Відновлює анімацію підбирання предметів повзком (крім фаєрів).",
        },
        "gameplay.enable_responsive_sprint": {
            "title": "Чуйний спринт",
            "description": "Покращує відгук рушія під час спринту Лари.\n\n— Дозволяє починати спринт щоразу, коли є витривалість, а не лише при повній шкалі енергії.\n— Дозволяє бігти спринтом угору сходами, замість того щоб перериватися на звичайний біг.",
        },
        "gameplay.enable_slide_to_run": {
            "title": "Біг одразу після ковзання",
            "description": "Дозволяє Ларі миттєво переходити на біг, коли вона досягає рівної землі після ковзання вперед по схилу. Для активації утримуйте кнопку руху вперед.",
        },
        "gameplay.enable_slow_ledge_swing": {
            "title": "Розгойдування на тонких уступах",
            "description": "Дозволяє Ларі повільно розгойдуватися, коли вона хапається за дуже тонкий край (стиль TR3). Якщо вимкнено, Лара хитнеться лише раз, після чого перейде у стан нерухомого вису (стиль TR1/2).",
        },
        "gameplay.enable_smooth_wall_deflect": {
            "title": "Плавне відштовхування від стін",
            "description": "Дозволяє Ларі швидше повертатися до нормального руху після зіткнення зі стіною, якщо кнопка напрямку затиснута разом із кнопкою «Вперед» (стиль TR2+). Якщо вимкнено, відновлення відбувається в оригінальному повільному темпі TR1.",
        },
        "gameplay.enable_snap_interactions": {
            "title": "Миттєва взаємодія з об'єктами",
            "description": "Дозволяє Ларі миттєво притягуватися («магнітитися») до цілей взаємодії, як-от предметів чи важелів (стиль TR1/2). Якщо вимкнено, Ларі потрібно буде спочатку повністю зупинитися перед початком дії (стиль TR3+).",
        },
        "gameplay.enable_soft_statics": {
            "title": "М'яка колізія зі статичними об'єктами",
            "description": "Дозволяє Ларі плавно ковзати вздовж статичних тривимірних моделей (подібно до TR4+), замість того щоб різко зупинятися перед ними.",
        },
        "gameplay.enable_sprint": {
            "title": "Спринт",
            "description": "Дозволяє Ларі бігати спринтом (подібно до TR3+).",
        },
        "gameplay.enable_step_roll_boost": {
            "title": "Прискорення перекатом зі сходинки",
            "description": "Дозволяє Ларі отримати імпульс прискорення під час зістрибування зі сходинки заввишки в один клік, якщо натиснути кнопку перекату біля самого краю. Ця особливість була лише в оригінальній TR1; у TR2+ її прибрали.",
        },
        "gameplay.enable_swamp_sidestepping": {
            "title": "Кроки вбік на болотах",
            "description": "Дозволяє Ларі робити кроки вбік, перебуваючи в кімнатах із болотом.",
        },
        "gameplay.enable_swing_cancel": {
            "title": "Переривання розгойдування",
            "description": "Дозволяє переривати анімацію розгойдування Лари на уступі, якщо відпустити кнопку і швидко вхопитися знову (стиль TR2+). Оригінальна TR1 цього не дозволяла.",
        },
        "gameplay.enable_timer_in_inventory": {
            "title": "Таймер в інвентарі",
            "description": "Змушує внутрішньоігровий таймер часу проходження працювати навіть тоді, коли відкрито екран інвентарю.",
        },
        "gameplay.enable_toggle_crouch": {
            "title": "Перемикання присідання",
            "description": "Дозволяє Ларі залишатися навприсядки після одноразового натискання кнопки присідання. Натисніть кнопку ще раз, щоб підвестися.",
        },
        "gameplay.enable_toggle_sprint": {
            "title": "Перемикання спринту",
            "description": "Дозволяє Ларі продовжувати біг спринтом після одноразового натискання кнопки спринту. Натисніть кнопку ще раз, щоб зупинитися.",
        },
        "gameplay.enable_total_stats": {
            "title": "Фінальний екран статистики",
            "description": "Умикає загальний екран статистики гри, який показується після фінальних титрів.",
        },
        "gameplay.enable_tr2_jumping": {
            "title": "Чуйні стрибки",
            "description": "Дозволяє Ларі стрибати в будь-який момент під час бігу (стиль TR2+). Якщо вимкнено, вона стрибатиме лише в чітко визначених точках анімації бігу, як в оригінальній TR1.",
        },
        "gameplay.enable_tr2_swim_cancel": {
            "title": "Чуйна зупинка під водою",
            "description": "Дозволяє Ларі швидше та чіткіше зупинятися під водою, коли гравець відпускає кнопку плавання (стиль TR2+). Якщо вимкнено, вона зупинятиметься за інерцією, як в оригінальній TR1.",
        },
        "gameplay.enable_tr2_swimming": {
            "title": "Плавне плавання",
            "description": "Додає криву прискорення для розворотів Лари під водою для плавнішого руху, як це було в оригінальній TR2+. Вимкнення цієї опції зробить розвороти різкішими, як в оригінальній TR1.",
        },
        "gameplay.enable_underwater_auto_draw": {
            "title": "Діставання зброї під водою",
            "description": "Змушує кнопку діставання зброї автоматично витягувати те озброєння, яке Лара може використовувати під водою (наприклад, гарпун), замість того щоб нічого не робити, якщо її остання екіпірована зброя там недоступна.",
        },
        "gameplay.enable_uw_roll": {
            "title": "Розворот під водою",
            "description": "Дозволяє Ларі робити швидкий розворот на 180 градусів під водою кнопкою перекату (стиль TR2+). В оригінальній TR1 розвороту під водою не було.",
        },
        "gameplay.enable_wading": {
            "title": "Бродіння по мілководдю",
            "description": "Дозволяє Ларі бродити по коліна у воді, а не «застрягати» на її поверхні під час бігу (стиль TR2+). В оригінальній TR1 бродіння не було.",
        },
        "gameplay.enable_walk_to_items": {
            "title": "Анімована взаємодія",
            "description": "Змушує Лару підходити до предметів, важелів, замкових щілин та квестових пазів, якщо вона стоїть поруч, замість миттєвої телепортації до них.",
        },
        "gameplay.enemy_health_scale": {
            "title": "Здоров'я ворогів",
            "description": "Масштабує кількість здоров'я, з якою вороги починають гру. Не впливає на союзників.",
        },
        "gameplay.fix_alligator_ai": {
            "title": "Виправлення ШІ алігаторів",
            "description": "Виправляє баг, через який алігатори не наносили урону, якщо Лара не рухалася у воді.",
        },
        "gameplay.fix_animated_spikes": {
            "title": "Виправлення анімованих шипів",
            "description": "Виправляє проблему, коли активовані анімовані шипи скидали свій стан до початкового після завантаження збереження.",
        },
        "gameplay.fix_bear_ai": {
            "title": "Виправлення ШІ ведмедів",
            "description": "Виправляє удар лапою у ведмедя так, щоб він більше не промахувався по Ларі.",
        },
        "gameplay.fix_bird_start_pos": {
            "title": "Виправити початкові позиції птахів",
            "description": "Виправляє помилку, через яку птахи завжди починають рух із підлоги під ними, навіть якщо спочатку були розміщені в повітрі.",
        },
        "gameplay.fix_breakable_wall_clip": {
            "title": "Виправлення кліпінгу крізь стіни",
            "description": "Виправляє баг, який дозволяв Ларі підтягуватися або пролізати повзком крізь руйнівні стіни, розташовані на краю сектору. Якщо увімкнено, вона зупинятиметься перед стіною, поки та не розіб'ється.",
        },
        "gameplay.fix_bridge_collision": {
            "title": "Виправлення колізії мостів",
            "description": "Виправляє проблему, коли Лара не могла вхопитися за краї деяких мостів або невидимі стіни на їхніх межах. Також усуває баги фізики підйомних мостів, люків та звичайних мостів, коли вони розташовані один над одним, над схилами або близько до землі.",
        },
        "gameplay.fix_descending_glitch": {
            "title": "Виправлення падінь крізь підлогу",
            "description": "Виправляє баг, коли кроки вбік або назад по руйнівних плитах змушували Лару миттєво провалюватися на блок під ними. В оригінальних TR2+ цього багу немає, але він є в TR1.",
        },
        "gameplay.fix_enemy_route_delay": {
            "title": "Виправити затримку маршруту ворогів",
            "description": "Виправляє помилку, через яку ворогам потрібно до кількох секунд, щоб знайти новий маршрут після того, як Лара змінює позицію.",
        },
        "gameplay.fix_falling_glitch": {
            "title": "Виправити падіння",
            "description": "Виправляє помилку, яка дозволяла Ларі відстрибувати від люків одразу після їх відкриття замість того, щоб падати, а також заважала їй упасти, якщо підлога під нею провалювалася під час розвороту повзком.",
        },
        "gameplay.fix_flare_throw_priority": {
            "title": "Пріоритет кидання фаєра",
            "description": "Виправляє проблему, коли Лара намагалася викинути використаний фаєр прямо в польоті, через що гравець не міг вхопитися за уступ.",
        },
        "gameplay.fix_floor_data_issues": {
            "title": "Виправлення тригерів підлоги",
            "description": "Виправляє оригінальні помилки, пов'язані з даними поверхонь та тригерами підлоги.",
        },
        "gameplay.fix_free_flare_glitch": {
            "title": "Виправлення багу з безкоштовним фаєром",
            "description": "Виправляє можливість створити безкоштовний фаєр, якщо натиснути кнопку фаєра під час підбирання будь-якого предмета або якщо дістати його через інвентар під час повзання.",
        },
        "gameplay.fix_item_duplication_glitch": {
            "title": "Виправлення дублювання предметів",
            "description": "Виправляє баг, який дозволяв двічі використовувати один і той самий квестовий предмет з інвентарю.",
        },
        "gameplay.fix_lara_pickup_embed": {
            "title": "Виправлення застрягання при підбиранні",
            "description": "Виправляє проблему, коли Лару іноді заносило в стіни під час підбирання предметів під водою, а також коли вона застрягала під крутими схилами стелі, піднімаючи річ на суші.",
        },
        "gameplay.fix_lift_collision": {
            "title": "Виправлення колізії ліфтів",
            "description": "Виправляє некоректну взаємодію Лари з рухомими ліфтами, через яку вона могла застрягти або пройти крізь них.",
        },
        "gameplay.fix_m16_accuracy": {
            "title": "Влучність M16 та MP5",
            "description": "Виправляє точність стрільби з гвинтівок M16 та MP5, коли Лара стріляє під час бігу.",
        },
        "gameplay.fix_monkey_pickup_priority": {
            "title": "Пріоритет поведінки мавп",
            "description": "Мавпи, які зазнали нападу, тепер надаватимуть пріоритет самозахисту та атаці у відповідь, замість того щоб підбирати аптечки чи ключі.",
        },
        "gameplay.fix_pipeman_aim": {
            "title": "Прицілювання тубільців із трубками",
            "description": "Виправляє проблему, коли тубільці з духовими трубками іноді не могли коректно цілитися дротиками в Лару.",
        },
        "gameplay.fix_qwop_glitch": {
            "title": "Виправлення QWOP-багу",
            "description": "Виправляє збій, коли застрибування Лари на невисокі сходинки іноді призводило до дивної анімації бігу, відомої у спільноті як QWOP-стан.",
        },
        "gameplay.fix_step_glitch": {
            "title": "Виправлення багу зі сходинками",
            "description": "Виправляє баг, через який Лару іноді виштовхувало всередину суміжних стін, коли вона забігала на сходинки певним чином. В оригінальній TR1 цього багу немає; він з'явився в TR2 та TR3.",
        },
        "gameplay.fix_underwater_crawl": {
            "title": "Повзання у воду під водою",
            "description": "Виправляє баг, який дозволяв Ларі заповзати з суші в затоплені або болотисті кімнати будь-якої глибини. Якщо увімкнено, Лара зможе заповзти лише у воду глибиною трохи більше ніж в один клік.",
        },
        "gameplay.fix_wade_sprint": {
            "title": "Виправити біг на мілководді",
            "description": "Виправляє помилку, яка дозволяла Ларі бігти спринтом по воді на глибині броду, якщо вона входила в неї під час звичайного бігу.",
        },
        "gameplay.fix_wade_wall_hit": {
            "title": "Зіткнення зі стінами на мілководді",
            "description": "Виправляє відсутність реакції та анімації Лари на зіткнення зі стіною під час бродіння по коліна у воді.",
        },
        "gameplay.fix_walk_run_jump": {
            "title": "Стрибок після кроку й бігу",
            "description": "Виправляє проблему, коли Лара іноді не могла миттєво підстрибнути відразу після швидкого переходу від кроку (клавіша Walk) до анімації звичайного бігу.",
        },
        "gameplay.fix_wall_geometry": {
            "title": "Виправлення геометрії стін",
            "description": "Виправляє помилки в оригінальній геометрії рівнів, де нахили всередині стін призводили до некоректного розрахунку висоти блоків. В оригінальних TR3+ цієї проблеми немає; вона присутня у TR1 та TR2.",
        },
        "gameplay.fix_water_exit": {
            "title": "Вихід із води",
            "description": "Виправляє баг, коли Лара могла переміститися безпосередньо із затопленої кімнати до суміжної сухої або до сухої кімнати знизу. Крім того, це заважає Ларі вилізати з води на схили, на яких не можна встояти.",
        },
        "gameplay.game_modes_policy": {
            "title": "Вибір режиму гри",
            "description": "Дозволяє вибирати опції «Нова гра плюс» у меню паспорта під час початку нової гри.\n\n— Нова гра+: відкриває всю зброю з нескінченними набоями, а вороги мають удвічі більше здоров'я.\n\nДоступні варіанти:\n\n— Завжди: вікно вибору режимів гри буде доступне завжди.\n— Ніколи: вікно вибору режимів гри не з'являтиметься, а кожна нова гра буде звичайною.\n— Після проходження: вікно вибору режимів гри з'явиться лише після того, як гру буде повністю пройдено.",
        },
        "gameplay.harpoon_recoil": {
            "title": "Перезарядка гарпуна",
            "description": "Визначає, як часто Лара мусить перезаряджати гарпунну рушницю, залежно від поточної кількості стріл. Наприклад, якщо встановлено значення 3, їй знадобиться перезарядка після кожного третього пострілу. Встановіть 0, щоб повністю вимкнути перезарядку.",
        },
        "gameplay.idle_pose_timeout": {
            "title": "Час до анімації спокою",
            "description": "Дозволяє Ларі увімкнути анімацію очікування, якщо вона залишається нерухомою протягом указаної кількості секунд. Встановіть 0, щоб вимкнути цю функцію.",
        },
        "gameplay.intro_fmv_mode": {
            "title": "Показ вступних роликів",
            "description": "Керує тим, коли саме відтворюється вступне сюжетне відео (FMV) кожної гри.\n\n— Нова гра: відтворювати ролик лише під час запуску нової гри.\n— Запуск: відтворювати його щоразу при запуску або перемиканні на гру, як це було в оригінальних іграх.",
        },
        "gameplay.jump_lock_mode": {
            "title": "Блокування стрибка на старті",
            "description": "Для режиму чуйних стрибків: дозволяє керувати тим, як скоро після початку бігу Ларі дозволено підстрибнути.\n\n— Оригінал: відповідає класичним таймінгам із TR2.\n— Оптимально: стрибати можна на 2 кадри раніше.\n— Вимкнено: стрибати можна миттєво, відразу після запуску анімації початку бігу.",
        },
        "gameplay.lara_damage_scale": {
            "title": "Шкода, яку отримує Лара",
            "description": "Масштабує шкоду, яку Лара отримує з усіх джерел, таких як вороги, пастки та падіння.",
        },
        "gameplay.loading_screens": {
            "title": "Екрани завантаження",
            "description": "Керує показом екранів завантаження перед початком рівня.\n\n— Вимкнено: ніколи не показувати екрани завантаження.\n— Завжди: показувати екрани завантаження.\n— Нова гра: пропускати екрани завантаження під час завантаження збережень.",
        },
        "gameplay.look_mode": {
            "title": "Режим огляду",
            "description": "Дозволяє налаштувати, коли саме Лара може використовувати огляд навколо.\n\n— Обмежений: огляд дозволено лише тоді, коли Лара стоїть на місці, і ніколи під водою (стиль TR1).\n— Покращений: огляд дозволено під час більшості анімацій, окрім таких як штовхання блоків (стиль TR2+).\n— Без обмежень: огляд дозволено в будь-який момент під час нормального керування Ларою.",
        },
        "gameplay.m16_aim_mode": {
            "title": "Варіанти прицілювання M16 та MP5",
            "description": "Керує тим, коли саме Лара цілиться з M16 чи MP5 від плеча, а не від стегна.\n\n— Оригінал: Лара підносить гвинтівку до плеча щоразу, коли припиняє рух.\n— Покращений: Лара продовжує стріляти від стегна, поки утримується кнопка дії, і підносить зброю до плеча лише тоді, коли починає стріляти стоячи на місці. Якщо увімкнено виправлення влучності, стрільба від стегна стає менш точною і наносить менше урону за постріл.",
        },
        "gameplay.maximum_quick_save_slots": {
            "title": "Кількість слотів швидкого збереження",
            "description": "Змінює кількість доступних слотів для швидкого збереження гри.",
        },
        "gameplay.maximum_save_slots": {
            "title": "Кількість слотів збереження",
            "description": "Змінює загальну кількість доступних слотів для збереження гри.",
        },
        "gameplay.pause_on_focus_lost": {
            "title": "Пауза у фоні",
            "description": "Зупиняє ігровий процес, коли вікно гри втрачає фокус (стає неактивним чи згортається).",
        },
        "gameplay.projectile_area_damage": {
            "title": "Урон снарядів по площі",
            "description": "Керує тим, як саме поширюється зона ураження для ракетниці та гранатомета.\n\n— Одноімпульсний: поведінка у стилі TR1 та TR2.\n— Багатоімпульсний: поведінка у стилі TR3.\n\nБагатоімпульсний варіант часто наносить подвійний урон окремим ворогам.",
        },
        "gameplay.remember_gun_status": {
            "title": "Запам'ятовувати зброю між рівнями",
            "description": "Змушує Лару запам'ятовувати, яку саме зброю вона використовувала наприкінці попереднього рівня, під час переходу на новий. Якщо вимкнено, на початку рівня Лара завжди буде зі схованою зброєю (пістолетами в кобурі).",
        },
        "gameplay.restore_ps1_enemies": {
            "title": "Відновлення ворогів із PS1",
            "description": "Додає мумію, яка з'являється виключно в PlayStation-версії TR1 на рівні «Місто Хамун» (кімната 25).\nЗміна цієї опції вимагатиме перезапуску гри.",
        },
        "gameplay.ring_memory_mode": {
            "title": "Пам'ять позиції інвентарю",
            "description": "Відкриває кільце меню на тому предметі, на якому ви зупинилися минулого разу, замість першого стандартного.\n\n— Вимкнено: кожне відкриття починається з першого предмета, як в оригінальній грі.\n— Головне кільце: гра запам'ятовує позицію лише для основного кільця предметів.\n— Усі кільця: гра запам'ятовує позицію як для кільця предметів, так і для кільця ключів.\n\nВибір скидається на перший предмет, якщо у Лари більше немає речі, яку гра запам'ятала, а також на початку кожного нового рівня.",
        },
        "gameplay.save_crystal_mode": {
            "title": "Режим кристалів",
            "description": "Визначає призначення кристалів, розкиданих по рівнях.\n\n— Вимкнено: кристали відсутні у грі.\n— Збереження: кристали є одноразовими й дозволяють Ларі зберегти гру там, де вони стоять (як у PS1-версії TR1). В іншому разі збереження обмежені початком рівнів.\n— Збереження (предмети): кристали можна підбирати й використовувати для збереження гри з інвентарю в будь-якому місці (як у PS1-версії TR3). В іншому разі збереження обмежені початком рівнів.\n— Лікування: кристали відновлюють половину здоров'я Лари та виліковують від отрути при дотику до них (як у PC-версії TR3).\n— Колекційні: кристали є предметами для збору, що враховуються у статистиці рівня, і більше нічого не роблять.\n\nЗміна цієї опції вимагатиме перезапуску рівня.",
        },
        "gameplay.start_lara_hitpoints": {
            "title": "Початкове здоров'я Лари",
            "description": "Встановлює кількість здоров'я Лари на початку кожного рівня.",
        },
        "gameplay.target_change_mode": {
            "title": "Зміна цілі",
            "description": "Змінює спосіб перемикання між цілями, коли Лара цілиться зі зброї.\n\n— Вимкнено: Лара утримує поточну ціль.\n— Покращено: натисніть кнопку «Змінити ціль» для перемикання.\n— TR4: торкніться кнопки «Огляд» для перемикання; утримування кнопки після короткої затримки все одно активує огляд навколо.",
        },
        "gameplay.target_mode": {
            "title": "Режим фіксації цілі",
            "description": "Змінює поведінку утримання ворогів на прицілі.\n\n— Повна фіксація: завжди утримувати приціл на ворогу, навіть якщо він зникає з поля зору або гине (оригінальні TR1-3).\n— Напівфіксація: утримувати приціл, якщо ворог зникає з поля зору, але втрачати його після смерті ворога.\n— Без фіксації: втрачати приціл, якщо ворог зникає з поля зору або гине (TR4+).",
        },
        "gameplay.wall_glitch_mode": {
            "title": "Режим багів зі стінами",
            "description": "Визначає, які класичні баги зі стінами може виконувати Лара.\n\n— TR1: як в оригінальній TR1, що дозволяє стрибнути вперед у стіну й телепортуватися на її вершину.\n— TR2: як в оригінальних TR2 та TR3, де цей стрибок більше не працює, але Лара все одно може телепортуватися, якщо одночасно торкнеться підлоги та стіни в певних місцях геометрії.\n— Виправлено: жоден баг не працює, і Лара більше не може проходити крізь заблокований сектор дверей.",
        },
        "input.enable_buffering_func_keys": {
            "title": "Буферизація (F-клавіші)",
            "description": "Умикає буферизацію функціональних клавіш (в 1 кадр) для досягнення надточного контролю над рухами Лари. Ця функція спочатку існувала лише в порту TombATI (TR1).",
        },
        "input.enable_buffering_inventory": {
            "title": "Буферизація (інвентар)",
            "description": "Умикає буферизацію інвентарю (у 2 кадри) для досягнення надточного контролю над рухами Лари.",
        },
        "input.enable_controller": {
            "title": "Підтримка геймпада",
            "description": "Дозволяє грі розпізнавати підключені геймпади. Вимкніть цю опцію, якщо ви використовуєте сторонній софт для перепризначення клавіш, який уже перекладає команди геймпада в натискання клавіатури.",
        },
        "input.enable_responsive_passport": {
            "title": "Чуйне меню паспорта",
            "description": "Вимикає блокування дій гравця під час гортання сторінок паспорта; замість цього анімація перегортання додається в чергу виконання.",
        },
        "input.enable_touch_controls": {
            "title": "Сенсорне керування",
            "description": "Відображає на екрані віртуальні кнопки для пристроїв із сенсорним дисплеєм.",
        },
        "input.enable_tr3_sidesteps": {
            "title": "Покращені кроки вбік",
            "description": "Умикає кроки вбік у стилі TR3+ (наприклад, Shift + стрілки напрямку). Окремі виділені кнопки для кроків вбік усе одно працюватимуть.",
        },
        "input.quick_guns_mode": {
            "title": "Кнопки швидкої зброї",
            "description": "Керує поведінкою клавіш швидкого екіпірування зброї.\n\n— Тільки діставання: натискання кнопки змусить Лару витягнути призначену зброю.\n— Дістати або сховати: те саме, що й вище, але Лара також заховає призначену зброю, якщо вона наразі тримає її в руках.",
        },
        "input.touch_button_scale": {
            "title": "Масштаб сенсорних кнопок",
            "description": "Регулює розмір віртуальних сенсорних кнопок керування на екрані.",
        },
        "input.touch_dpad_deadzone": {
            "title": "Мертва зона сенсорного D-pad",
            "description": "Регулює мертву зону віртуальної хрестовини (D-pad) на екрані. Більша мертва зона вимагає сильнішого зміщення пальця, перш ніж гра зареєструє натискання напрямку.",
        },
        "input.touch_dpad_scale": {
            "title": "Масштаб сенсорного D-pad",
            "description": "Регулює розмір віртуальної хрестовини (D-pad) на екрані.",
        },
        "input.touch_opacity": {
            "title": "Непрозорість сенсорних кнопок",
            "description": "Регулює рівень прозорості віртуальних кнопок керування на екрані.",
        },
        "language": {
            "title": "Мова",
            "description": "Змінює мову тексту інтерфейсу користувача.",
        },
        "rendering.anisotropy_filter": {
            "title": "Анізотропна фільтрація",
            "description": "Покращує якість фільтрації та чіткість текстур на великій відстані.",
        },
        "rendering.aspect_mode": {
            "title": "Співвідношення сторін",
            "description": "Примусово встановлює певне співвідношення сторін екрана за допомогою чорних смуг (Letterbox).",
        },
        "rendering.borders": {
            "title": "Рамки екрана",
            "description": "Додає чорні рамки навколо вікна гри.",
        },
        "rendering.dither_mode": {
            "title": "Дизеринг (розмивання палітри)",
            "description": "Вибирає оригінальне затінення палітри програмного рендерера ПК або класичний дизеринг RGB555 із PlayStation.",
        },
        "rendering.enable_affine_mapping": {
            "title": "Афінне текстурування",
            "description": "Прибирає корекцію перспективи під час накладання текстур (як це було на PlayStation), через що текстури викривляються та «пливуть» по великих поверхнях під час руху камери.",
        },
        "rendering.enable_hall_of_mirrors": {
            "title": "Зала дзеркал",
            "description": "Залишає попередній кадр на екрані там, де нічого не малюється, як це було в релізах для ПК. Деякі рівні використовують це для ефектів, наприклад, «Причал Темзи». Відкриті локації без скайбоксу все одно очищуються.",
        },
        "rendering.enable_palette_quantize": {
            "title": "Квантування палітри",
            "description": "Прив'язує кожен відрендерений колір до найближчого кольору в палітрі рівня. Увімкнене розмивання (дизеринг) згладжує відтінки між кольорами палітри.",
        },
        "rendering.enable_ps1_blending": {
            "title": "Змішування PlayStation",
            "description": "Змішує деякі ефекти та грані зі сценою так, як це було на PlayStation. Дим, тіні та сліди ніг віднімають свій колір від сцени, що затемнює кожен колірний канал на однакову величину і дає більш насичений результат. У TR1 та TR2 такі поверхні, як вода, скло та спалахи від пострілів, змішуються зі сценою наполовину. У TR3 кров також змішується зі сценою наполовину. Якщо вимкнено, усе це відображається так само, як на ПК.",
        },
        "rendering.enable_ps1_fog": {
            "title": "Туман у стилі PlayStation",
            "description": "Змішує колір віддаленої геометрії з кольором туману за принципом згасання глибини PS1: залежно від формули 1/відстань замість звичайної відстані. Ефект розраховується для кожної вершини окремо, створюючи ступінчасті смуги на великих поверхнях.",
        },
        "rendering.enable_trapezoid_filter": {
            "title": "Трапецієподібний фільтр",
            "description": "Коректує рендеринг чотирикутних полігонів.",
        },
        "rendering.enable_vsync": {
            "title": "Вертикальна синхронізація (VSync)",
            "description": "Вмикає або вимикає вертикальну синхронізацію кадрів.",
        },
        "rendering.fmv_filter": {
            "title": "Фільтр відеороликів",
            "description": "Перемикає вигляд відеороликів (FMV) між згладженим та піксельним.",
        },
        "rendering.fps": {
            "title": "Кадрова частота (FPS)",
            "description": "Встановлює кількість кадрів за секунду в грі.",
        },
        "rendering.lighting_contrast": {
            "title": "Контрастність освітлення",
            "description": "Підсилює контрастність для динамічних джерел світла, як-от фаєрів та спалахів від пострілів.",
        },
        "rendering.lighting_curve": {
            "title": "Модель освітлення",
            "description": "Визначає, наскільки сильно вершинне освітлення масштабує яскравість текстури.\n\n— Пласка (Flat): зупиняється на власній яскравості текстури, через що картинка стає тьмянішою (стиль TR3 PC).\n— Пересвітлена (Overbright): варіант оригінальних ПК-рендерерів — повністю освітлена вершина подвоює яскравість пікселя текстури (текселя), а надлишок додається згодом (стиль TR4 PC).\n— Насичена (Saturate): варіант для PlayStation — також подвоює яскравість текселя, але обрізає («кліпає») кожен колір на його межі, що зберігає власний колір яскравих поверхонь замість їхнього вицвітання (стиль TR3/TR4 PS1).",
        },
        "rendering.multisampling_factor": {
            "title": "Мультисемплінг (MSAA)",
            "description": "Згладжує краї стін та об'єктів, роблячи кілька вибірок (семплів) для кожного пікселя вздовж них. Цей метод значно менш вимогливий, ніж суперсемплінг, але він не зачіпає краї двовимірних спрайтів (наприклад, листя чи вогню).",
        },
        "rendering.screenshot_format": {
            "title": "Формат скріншотів",
            "description": "Формат файлу для збереження скріншотів.",
        },
        "rendering.sprite_lock_mode": {
            "title": "Фіксація осей спрайтів",
            "description": "Керує тим, по яких осях фіксувати двовимірні спрайти на екрані.\n\n— Немає: показувати спрайти як зазвичай.\n— Крен (Roll): фіксувати вісь крену — корисно лише у фоторежимі.\n— Крен та Тангаж (Roll & pitch): гарантує, що спрайти стоятимуть вертикально і не «лежатимуть» на землі, якщо дивитися на них згори.\n— Перспектива: фіксує осі крену та тангажу, а також додатково злегка повертає спрайти до центру екрана.",
        },
        "rendering.supersampling_factor": {
            "title": "Суперсемплінг (SSAA)",
            "description": "Рендерить гру в роздільності, яка в кілька разів перевищує поточну, а потім масштабує її назад, що згладжує «зубчасті» краї об'єктів. Вищі значення значно сильніше навантажують відеокарту.",
        },
        "rendering.texture_filter": {
            "title": "Фільтрація текстур",
            "description": "Перемикає вигляд ігрових текстур між згладженим та оригінальним піксельним.",
        },
        "rendering.ui_filter": {
            "title": "Фільтрація інтерфейсу",
            "description": "Перемикає вигляд елементів інтерфейсу користувача між згладженим та піксельним.",
        },
        "rendering.upscaling_factor": {
            "title": "Коефіцієнт масштабування",
            "description": "Масштабує гру на заданий коефіцієнт, зберігаючи при цьому чіткий піксельний вигляд.",
        },
        "rendering.upscaling_filter": {
            "title": "Фільтр масштабування",
