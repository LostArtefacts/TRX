        "visuals.enable_spherical_fog": {
            "title": "\\{review}Сферичний туман",
            "description": "\\{review}Туман залежить від відстані до камери, тож поворот камери не змінює дальність видимості. Якщо вимкнено, туман залежить від глибини вздовж напрямку погляду, як в оригінальних іграх, і по краях екрана видно далі, ніж у центрі.",
        },
        "visuals.enable_static_lighting": {
            "title": "Освітлення статичних об'єктів",
            "description": "Дозволяє полум'ю та іншим динамічним джерелам світла освітлювати статичні тривимірні об'єкти (декорації). В оригінальній TR4 світло падало лише на геометрію самої кімнати.",
        },
        "visuals.enable_weather": {
            "title": "Погода",
            "description": "Умикає відображення погодних ефектів на підтримуваних рівнях.",
        },
        "visuals.fix_animated_sprites": {
            "title": "Виправлення анімації спрайтів",
            "description": "Виправляє оригінальні спрайти підводних рослин, щоб вони коректно анімувалися в затоплених зонах.",
        },
        "visuals.fix_item_rots": {
            "title": "Виправлення розміщення предметів",
            "description": "Виправляє кілька оригінальних помилок гри, викликаних неправильним розташуванням або конфігурацією предметів, включаючи кути повороту, позиції та прив'язку до кімнат.",
        },
        "visuals.fix_projectile_brightness": {
            "title": "\\{review}Виправити яскравість снарядів",
            "description": "\\{review}Виправляє снаряди, як-от ножі, гарпуни та гранати, що відображаються з повною яскравістю замість освітлення навколишньої кімнати.",
        },
        "visuals.fix_smoke_emitters": {
            "title": "Виправити джерела диму",
            "description": "Виправляє помилку, через яку джерела диму, які мали бути чорними, відображалися білими.",
        },
        "visuals.fix_texture_issues": {
            "title": "Виправлення проблем із текстурами",
            "description": "Виправляє оригінальні баги з відсутніми або некоректними текстурами та тривимірними моделями (мешами).",
        },
        "visuals.fog_color": {
            "title": "Колір туману",
            "description": "Визначає колір туману.",
        },
        "visuals.fog_end": {
            "title": "Дальність повного туману",
            "description": "Встановлює відстань у блоках (тайлах), на якій туман повністю приховує все оточення. В оригінальних TR2 та TR3 ця точка досягається на відстані 20 блоків. Рівень може мати власне прописане значення, яке використовуватиметься замість цього.",
        },
        "visuals.fog_start": {
            "title": "Початок появи туману",
            "description": "Встановлює відстань у блоках (тайлах), на якій туман починає з'являтися. В оригінальних TR2 та TR3 він починається з 12 блоків. Рівень може мати власне прописане значення, яке використовуватиметься замість цього.",
        },
        "visuals.fog_transparency": {
            "title": "Прозорість туману",
            "description": "Визначає, чи вмикати плавне змішування віддаленої геометрії зі 100% прозорими гранями.",
        },
        "visuals.fov": {
            "title": "Поле зору (FOV)",
            "description": "Кут огляду камери у градусах. Більші значення розширюють поле зору, менші — звужують його.",
        },
        "visuals.game_brightness": {
            "title": "Яскравість гри",
            "description": "Змінює загальну яскравість зображення в грі.",
        },
        "visuals.gamma": {
            "title": "Гамма",
            "description": "Регулює криву гамми. Вищі значення роблять освітлення яскравішим. Значення 2.5 відповідає стандартним оригінальним кольорам.",
        },
        "visuals.golden_lara": {
            "title": "Золота Лара",
            "description": "Повністю покриває Лару золотом, незалежно від її поточного вбрання, повторюючи ефект дотику руки Мідаса.",
        },
        "visuals.lara_outfit": {
            "title": "Вбрання Лари",
            "description": "Змінює зовнішній вигляд Лари. Якщо вибрано варіант «За замовчуванням», гра враховуватиме стандартні зміни костюмів між рівнями, інакше вибраний одяг залишатиметься постійно до ручної зміни.",
        },
        "visuals.level_start_transition": {
            "description": "Як з'являється рівень на початку гри або під час завантаження збереження. «Плавний перехід» накладає екран завантаження на сам рівень. «Через чорний» затемнює екран завантаження до чорного, а потім виводить рівень із чорного екрана, як в оригінальній TR4. Якщо екрана завантаження немає, в обох випадках рівень з'являється з чорного тла. Опція «Вимкнено» показує рівень миттєво.",
            "title": "Перехід на початку рівня",
