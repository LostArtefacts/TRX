        "gameplay.enable_body_bags": {
            "title": "Зникнення тіл ворогів",
            "description": "Умикає очищення локації від убитих ворогів, коли Лара перетинає певні тригери на рівнях. Якщо вимкнено, тіла вбитих ворогів залишатимуться назавжди.",
        },
        "gameplay.enable_boulder_shake": {
            "title": "Трясіння камери від валунів",
            "description": "Якщо увімкнено, камера трястиметься, коли котиться гігантський валун.",
        },
        "gameplay.enable_bouncy_grenades": {
            "title": "Стрибучі гранати",
            "description": "Умикає поведінку гранат у стилі TR3: вони рикошетять від стін і схилів та мають більший радіус вибуху, але летять із меншою швидкістю.",
        },
        "gameplay.enable_cheats": {
            "title": "Чити",
            "description": "Умикає різноманітні чит-коди:\n\n— \\{input level_skip_cheat}: миттєво завершити поточний рівень.\n— \\{input item_cheat}: видати Ларі всю зброю, багато набоїв та аптечок, а також усі сюжетні предмети для поточного рівня.\n— \\{input fly_cheat}: увімкнути чит польоту (плавання в повітрі).\n  — \\{input slow}: вийти з режиму польоту.\n  — \\{input draw}: відкрити найближчі двері (працює не всюди).",
        },
        "gameplay.enable_cinematic_skips": {
