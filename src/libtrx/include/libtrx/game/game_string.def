// Setting descriptions
GS_DEFINE(SETTING_AIRBAR_COLOR_DESCRIPTION,                   "Color of the airbar.")
GS_DEFINE(SETTING_AIRBAR_LOCATION_DESCRIPTION,                "Location where the airbar is displayed.")
GS_DEFINE(SETTING_AIRBAR_SHOW_MODE_DESCRIPTION,               "Changes how the airbar is displayed.\n\n- Default: show the airbar only in the water and flash the airbar when Lara's oxygen is 20% or below.\n- Default, no flashing: same as default, but disable flashing.\n- Flashing only: show the airbar *only* when Lara's oxygen is 20% or below (for challenge runs).\n- Never: never display the airbar (for challenge runs).")
GS_DEFINE(SETTING_ALLY_HEALTHBAR_COLOR_DESCRIPTION,           "Color of the allies healthbar. Shown in the location of the enemy healthbars.")
GS_DEFINE(SETTING_AMBIENT_VOLUME_DESCRIPTION,                 "Adjusts ambient volume.")
GS_DEFINE(SETTING_ANISOTROPY_FILTER_DESCRIPTION,              "Enhances texture filtering at distances.")
GS_DEFINE(SETTING_ASPECT_MODE_DESCRIPTION,                    "Forces certain game aspect ratios with letterbox.")
GS_DEFINE(SETTING_BAR_LOOK_DESCRIPTION,                       "Controls the visual appearance of the UI bars.")
GS_DEFINE(SETTING_BORDERS_DESCRIPTION,                        "Adds black borders around the game window.")
GS_DEFINE(SETTING_BRIGHTNESS_DESCRIPTION,                     "Changes game brightness.")
GS_DEFINE(SETTING_CAMERA_MODE_DESCRIPTION,                    "Adjusts how camera behaves during actions like using keys.")
GS_DEFINE(SETTING_CAMERA_SPEED_DESCRIPTION,                   "Changes how fast the manual camera moves.")
GS_DEFINE(SETTING_CHANGE_PIERRE_SPAWN_DESCRIPTION,            "Makes a freshly triggered (runaway) Pierre replace an already existing (runaway) Pierre.")
GS_DEFINE(SETTING_CUTSCENE_VOLUME_DESCRIPTION,                "Adjusts the ingame cutscenes volume.")
GS_DEFINE(SETTING_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION, "Stops Lara from healing when starting a new level (for no Heal challenge runs).")
GS_DEFINE(SETTING_DISABLE_MAGNUMS_DESCRIPTION,                "Removes all magnum guns and magnum ammo pickups from the game.")
GS_DEFINE(SETTING_DISABLE_MEDPACKS_DESCRIPTION,               "Removes all medipacks from the game (for No Meds challenge runs).")
GS_DEFINE(SETTING_DISABLE_SHOTGUN_DESCRIPTION,                "Removes all shotgun and shotgun shell pickups from the game.")
GS_DEFINE(SETTING_DISABLE_TREX_COLLISION_DESCRIPTION,         "Removes all collision with T-Rex upon death. This helps when the T-Rex's body blocks the passage out.")
GS_DEFINE(SETTING_DISABLE_UZIS_DESCRIPTION,                   "Removes all uzi guns and uzi ammo pickups from the game.")
GS_DEFINE(SETTING_ENABLE_3D_PICKUPS_DESCRIPTION,              "Enables 3D models to be rendered in place of the sprites for pickup items.")
GS_DEFINE(SETTING_ENABLE_ALLY_TARGETING_DESCRIPTION,          "Allows Lara to target allies, such as monks. If disabled, allies will be immune to Lara's ammunition.")
GS_DEFINE(SETTING_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION,     "When Lara presses action against a keyhole or puzzle slot, and she has the corresponding item in the inventory, that item will be pre-selected.")
GS_DEFINE(SETTING_ENABLE_BAREFOOT_SFX_DESCRIPTION,            "Enables appropriate footstep sound effects in levels where Lara is barefoot.")
GS_DEFINE(SETTING_ENABLE_BRAID_DESCRIPTION,                   "Enables Lara's braid.")
GS_DEFINE(SETTING_ENABLE_BREEZE_DESCRIPTION,                  "Enables the breeze effect on Lara's braid in appropriate rooms.")
GS_DEFINE(SETTING_ENABLE_BUFFERING_DESCRIPTION,               "Enables F-key (1-frame) and inventory (2-frame) buffering to achieve precise control of Lara's movement.")
GS_DEFINE(SETTING_ENABLE_CHEATS_DESCRIPTION,                  "Enables various cheats:\n\n- L: immediately end the level.\n- I: give Lara all weapons; a boost of ammo and medipacks; and all plot items for the current level.\n- O: enable fly cheat (swimming midair).\n  - WALK key: exit fly mode.\n  - GUN key: open the closest door (doesn't work in some places).")
GS_DEFINE(SETTING_ENABLE_COMPASS_STATS_DESCRIPTION,           "Enables showing level statistics when the compass is selected.")
GS_DEFINE(SETTING_ENABLE_CONSOLE_DESCRIPTION,                 "Enables the developer console.")
GS_DEFINE(SETTING_ENABLE_CONTROLLED_DROPS_DESCRIPTION,        "Allows Lara to turn mid-air and grab the ledge she just stepped off, if the action input is held while falling.")
GS_DEFINE(SETTING_ENABLE_CREDITS_DESCRIPTION,                 "Enables credits screens shown after completing the game. Does not influence the final statistics screen.")
GS_DEFINE(SETTING_ENABLE_CUTSCENES_DESCRIPTION,               "Enables cutscenes playing.")
GS_DEFINE(SETTING_ENABLE_DEATHS_COUNTER_DESCRIPTION,          "Enables showing a deaths counter in the compass and in the level statistics. Death count is updated in the currently loaded save as soon as Lara dies.")
GS_DEFINE(SETTING_ENABLE_DEMO_DESCRIPTION,                    "Enables demos showing in the main menu.")
GS_DEFINE(SETTING_ENABLE_ENEMY_ROTATION_DESCRIPTION,          "Applies an additional random angle to some enemies when they are initialised.")
GS_DEFINE(SETTING_ENABLE_ENHANCED_SAVES_DESCRIPTION,          "Enhances savegames so that graphic effects, waterfall mist, flame emitters, and more are saved instead of disappearing on load.")
GS_DEFINE(SETTING_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION,       "Enables the fade effects when exiting the game to desktop.")
GS_DEFINE(SETTING_ENABLE_FADE_EFFECTS_DESCRIPTION,            "Enable fade transitions, for example between credit graphics or for inventory and pause screen transitions.")
GS_DEFINE(SETTING_ENABLE_FIRE_LIGHTING_DESCRIPTION,           "Enables dynamic lighting to be generated beside active flames.")
GS_DEFINE(SETTING_ENABLE_FMV_DESCRIPTION,                     "Enables FMVs playing.")
GS_DEFINE(SETTING_ENABLE_GAME_MODES_DESCRIPTION,              "Allows new game plus options to be selected from the new game passport menu.\n\n- New Game+: unlocks all weapons with infinite ammo; enemies have double the HP.\n- Japanese NG: weapons do double damage and flare pickups contain 8 rather than 6.\n- Japanese NG+: combination of New Game+ and Japanese NG.")
GS_DEFINE(SETTING_ENABLE_IDLE_POSE_CAMERA_DESCRIPTION,        "Adjusts the camera to face Lara during her idle pose animation. Pressing look will reset the camera.")
GS_DEFINE(SETTING_ENABLE_INVERTED_LOOK_DESCRIPTION,           "Inverts the Y axis controls when Lara looks.")
GS_DEFINE(SETTING_ENABLE_ITEM_EXAMINING_DESCRIPTION,          "For custom levels - allows item descriptions to be displayed in the inventory where the level author has provided suitable data.")
GS_DEFINE(SETTING_ENABLE_JUMP_TWISTS_DESCRIPTION,             "Enables jump twists and somersaults i.e. press roll during jump and swan dive animations.")
GS_DEFINE(SETTING_ENABLE_LARA_MIC_DESCRIPTION,                "Set the microphone to be at Lara's position. If disabled, the microphone will be at the camera's position.")
GS_DEFINE(SETTING_ENABLE_LEAN_JUMPING_DESCRIPTION,            "Allows Lara to creep forwards or backwards further when performing neutral jumps with the relevant input key pressed.")
GS_DEFINE(SETTING_ENABLE_LEDGE_JUMPS_DESCRIPTION,             "Allows Lara to jump upwards or backwards when hanging from a ledge, provided she has a solid surface in front of her to push against.")
GS_DEFINE(SETTING_ENABLE_LEGAL_DESCRIPTION,                   "Enables legal screen and Core Design FMV at the game start.")
GS_DEFINE(SETTING_ENABLE_LOADING_SCREENS_DESCRIPTION,         "Enables PS1 style loading screens before each level.")
GS_DEFINE(SETTING_ENABLE_MUSIC_IN_MENU_DESCRIPTION,           "Plays music in the main menu.")
GS_DEFINE(SETTING_ENABLE_NEUTRAL_TWISTS_DESCRIPTION,          "Allows Lara to twist in the air while performing a neutral jump. Press jump and roll inputs together while stationary.")
GS_DEFINE(SETTING_ENABLE_PICKUP_AIDS_DESCRIPTION,             "Enables an intermittent twinkling effect near pickup items to highlight their presence.")
GS_DEFINE(SETTING_ENABLE_PITCHED_SOUNDS_DESCRIPTION,          "Allows sound effects to be randomly, slightly pitched to vary the game sounds.")
GS_DEFINE(SETTING_ENABLE_PS1_CRYSTALS_DESCRIPTION,            "Save crystals will be drawn with a purple tint, more similar to the PS1 type.")
GS_DEFINE(SETTING_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION,     "Disables blocking user input when passport flips pages, scheduling the page flips instead.")
GS_DEFINE(SETTING_ENABLE_RESPONSIVE_SPRINT_DESCRIPTION,       "Enables a more responsive sprinting state for Lara.\n\n- allows sprinting whenever Lara has energy, rather than only when her stamina is full.\n- allows sprinting up stairs rather than being interrupted by Lara's regular run animation.")
GS_DEFINE(SETTING_ENABLE_ROUND_SHADOW_DESCRIPTION,            "Enables round shadows instead of the default octagonal ones.")
GS_DEFINE(SETTING_ENABLE_SAVE_CRYSTALS_DESCRIPTION,           "Limits saving to the beginning of levels and save crystals. Levels have limited, single use save crystals like the PS1 version. Changing this option will require restarting the level.")
GS_DEFINE(SETTING_ENABLE_SHOTGUN_FLASH_DESCRIPTION,           "Draws flames when firing the shotgun, like for other guns.")
GS_DEFINE(SETTING_ENABLE_SKYBOX_DESCRIPTION,                  "Enables the skybox in supported levels.")
GS_DEFINE(SETTING_ENABLE_SLIDE_TO_RUN_DESCRIPTION,            "Allows Lara to start running immediately when she reaches ground after sliding forwards on a slope. Hold the forward input to activate.")
GS_DEFINE(SETTING_ENABLE_SMOOTH_BARS_DESCRIPTION,             "Makes the UI bars use smooth color transitions.")
GS_DEFINE(SETTING_ENABLE_SMOOTH_WALL_DEFLECT_DESCRIPTION,     "Allows Lara to recover more quickly after hitting a wall and a direction key is held together with forward.")
GS_DEFINE(SETTING_ENABLE_SPRINT_DESCRIPTION,                  "Allows Lara to sprint, similar to TR3+.")
GS_DEFINE(SETTING_ENABLE_STEP_ROLL_BOOST_DESCRIPTION,         "Allows Lara to be boosted off a one-click high step if roll is pressed near the edge.")
GS_DEFINE(SETTING_ENABLE_SWING_CANCEL_DESCRIPTION,            "Allows Lara's ledge-swinging animation to be canceled by letting go and quickly grabbing again.")
GS_DEFINE(SETTING_ENABLE_TARGET_CHANGE_DESCRIPTION,           "Enables TR4+ target changing while aiming weapons. Press the Change Target button while aiming to change targets.")
GS_DEFINE(SETTING_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION,      "Makes the in-game timer work even while the game is showing the inventory.")
GS_DEFINE(SETTING_ENABLE_TOTAL_STATS_DESCRIPTION,             "Enables a total game statistics screen that plays after the credits.")
GS_DEFINE(SETTING_ENABLE_TR2_JUMPING_DESCRIPTION,             "Allows Lara to jump at any point while running, similar to TR2+.")
GS_DEFINE(SETTING_ENABLE_TR2_SWIMMING_DESCRIPTION,            "Gives Lara's underwater turn rate an acceleration curve for smoother movement, as per TR2+ originally. Disabling this option will give Lara a snappier turn rate, per original TR1.")
GS_DEFINE(SETTING_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION,         "Allows Lara to stop more responsively underwater when the swim key is released, similar to TR2+.")
GS_DEFINE(SETTING_ENABLE_TR3_SIDESTEPS_DESCRIPTION,           "Enables TR3+ style sidesteps, e.g. shift+directional arrows. Dedicated sidestep buttons will still work.")
GS_DEFINE(SETTING_ENABLE_UNDERWATER_ANIM_SFX_DESCRIPTION,     "Allows control over playing specific animation sound effects - for objects such as doors and trapdoors - when the camera is underwater.")
GS_DEFINE(SETTING_ENABLE_UW_ROLL_DESCRIPTION,                 "Allows Lara to roll while underwater.")
GS_DEFINE(SETTING_ENABLE_WADING_DESCRIPTION,                  "Allows Lara to wade through shallow water, similar to TR2+, rather than becoming stuck on the water surface.")
GS_DEFINE(SETTING_ENABLE_WALK_TO_ITEMS_DESCRIPTION,           "Makes Lara walk to pickups and switches when nearby instead of teleporting to them.")
GS_DEFINE(SETTING_ENEMY_HEALTHBAR_COLOR_DESCRIPTION,          "Color of the enemy healthbar.")
GS_DEFINE(SETTING_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION,       "Location where the enemy healthbar is displayed.")
GS_DEFINE(SETTING_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION,      "Enables showing a healthbar for the active enemy.")
GS_DEFINE(SETTING_EXPOSUREBAR_COLOR_DESCRIPTION,              "Color of the cold water exposure bar.")
GS_DEFINE(SETTING_EXPOSUREBAR_LOCATION_DESCRIPTION,           "Location where the cold water exposure bar is displayed.")
GS_DEFINE(SETTING_EXPOSUREBAR_SHOW_MODE_DESCRIPTION,          "Changes how the cold water exposure bar is displayed.\n\n- Default: show the bar in cold water or when Lara is recovering, and flash the bar at 20% or below.\n- Default, no flashing: same as default, but disable flashing.\n- Flashing only: show the bar *only* at 20% or below (for challenge runs).\n- Never: never display the bar (for challenge runs).")
GS_DEFINE(SETTING_FIX_ALLIGATOR_AI_DESCRIPTION,               "Fixes alligators dealing no damage if Lara remains still in the water.")
GS_DEFINE(SETTING_FIX_BRIDGE_COLLISION_DESCRIPTION,           "Fixes Lara not being able to grab parts of some bridges and invisible walls at the edge. Also fixes collision issues with drawbridges, trapdoors, and bridges when stacked over each other, over slopes, and near the ground.")
GS_DEFINE(SETTING_FIX_DESCENDING_GLITCH_DESCRIPTION,          "Fixes sidestepping and walking backwards on breakable tiles causing Lara to immediately descend to the tile underneath.")
GS_DEFINE(SETTING_FIX_FLARE_THROW_PRIORITY_DESCRIPTION,       "Fixes Lara prioritising throwing a spent flare while in mid-air, which can lead to being unable to grab ledges.")
GS_DEFINE(SETTING_FIX_FLOOR_DATA_ISSUES_DESCRIPTION,          "Fixes original issues with floor data/triggers.")
GS_DEFINE(SETTING_FIX_FREE_FLARE_GLITCH_DESCRIPTION,          "Fixes the ability to spawn a free flare when pressing the flare input while picking up any item.")
GS_DEFINE(SETTING_FIX_GLIDE_CAMERAS_DESCRIPTION,              "Fixes glide cameras to respect the timer set in level triggers rather than defaulting the speed after the first frame.")
GS_DEFINE(SETTING_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION,    "Fixes the ability to duplicate usage of key items in the inventory.")
GS_DEFINE(SETTING_FIX_ITEM_ROTS_DESCRIPTION,                  "Fixes original issues with some incorrectly rotated pickups when using the 3D pickups option.")
GS_DEFINE(SETTING_FIX_LARA_PICKUP_EMBED_DESCRIPTION,          "Fixes Lara sometimes drifting into walls when collecting underwater items, and fixes Lara embedding under steeply sloped ceilings when picking up an item above water.")
GS_DEFINE(SETTING_FIX_M16_ACCURACY_DESCRIPTION,               "Fixes the accuracy of the M16 while Lara is running.")
GS_DEFINE(SETTING_FIX_QWOP_GLITCH_DESCRIPTION,                "Fixes Lara jumping on small steps sometimes resulting in a weird running animation, known as a QWOP state.")
GS_DEFINE(SETTING_FIX_SECRETS_KILLING_MUSIC_DESCRIPTION,      "Fixes the sound of collecting a secret stopping the active music track.")
GS_DEFINE(SETTING_FIX_SPEECHES_KILLING_MUSIC_DESCRIPTION,     "Fixes enemies stopping the active music track when they speak.")
GS_DEFINE(SETTING_FIX_STEP_GLITCH_DESCRIPTION,                "Fixes Lara sometimes being pushed into walls adjacent to steps when running up them in a specific way.")
GS_DEFINE(SETTING_FIX_TEXTURE_ISSUES_DESCRIPTION,             "Fixes original issues with missing or incorrect textures/meshes.")
GS_DEFINE(SETTING_FIX_TIHOCAN_SECRET_SOUND_DESCRIPTION,       "Prevents the secret sound from incorrectly playing when using the golden key in Tomb of Tihocan.")
GS_DEFINE(SETTING_FIX_WADE_WALL_HIT_DESCRIPTION,              "Fixes Lara not responding to hitting a wall while wading.")
GS_DEFINE(SETTING_FIX_WALK_RUN_JUMP_DESCRIPTION,              "Fixes Lara at times not being able to jump immediately after going from her walking to running animation.")
GS_DEFINE(SETTING_FIX_WATER_EXIT_DESCRIPTION,                 "Fixes Lara being able to go directly from a water room to an adjacent dry room, or to a dry room below. Additionally, this will prevent Lara from being able to climb out of water onto non-standable slopes.")
GS_DEFINE(SETTING_FMV_VOLUME_DESCRIPTION,                     "Adjusts the movies volume.")
GS_DEFINE(SETTING_FOG_COLOR_B_DESCRIPTION,                    "Blue component of the fog color.")
GS_DEFINE(SETTING_FOG_COLOR_G_DESCRIPTION,                    "Green component of the fog color.")
GS_DEFINE(SETTING_FOG_COLOR_R_DESCRIPTION,                    "Red component of the fog color.")
GS_DEFINE(SETTING_FOG_END_DESCRIPTION,                        "Sets distance in tiles where fog makes everything fully obscured.")
GS_DEFINE(SETTING_FOG_START_DESCRIPTION,                      "Sets distance in tiles where fog begins to appear.")
GS_DEFINE(SETTING_FOG_TRANSPARENCY_DESCRIPTION,               "Whether to enable blending distant geometry into 100% transparent faces.")
GS_DEFINE(SETTING_FOV_DESCRIPTION,                            "The desired field of view in degrees, which overrides the hardcoded default. The default values are 80 (horizontal) and 65 (vertical).")
GS_DEFINE(SETTING_FOV_VERTICAL_DESCRIPTION,                   "Interprets the field of view as vertical instead of horizontal. May be advantageous for widescreen resolutions, especially for multi-screen setups, since it distorts the left and right side instead of cropping away the top and bottom part of the screen.")
GS_DEFINE(SETTING_FPS_DESCRIPTION,                            "Sets game frames per second.")
GS_DEFINE(SETTING_HARPOON_RECOIL_DESCRIPTION,                 "Sets how often Lara must reload the harpoon gun, based on her current ammo count. For example, if set to 3, she'll need to reload after every third shot. Set to 0 to disable reloading entirely.")
GS_DEFINE(SETTING_HEALTHBAR_COLOR_DESCRIPTION,                "Color of the healthbar.")
GS_DEFINE(SETTING_HEALTHBAR_LOCATION_DESCRIPTION,             "Location where the healthbar is displayed.")
GS_DEFINE(SETTING_HEALTHBAR_SHOW_MODE_DESCRIPTION,            "Changes how the healthbar is displayed.\n\n- Default: show the healthbar at the start of a level, when hit, or when weapons are equipped; flash if 20% or below.\n- Default, no flashing: same as default, but disable flashing.\n- Default or flashing: same as default, except show it even if it's flashing.\n- Flashing only: show the healthbar *only* when Lara's health is 20% or below (for challenge runs).\n- Always: always show the healthbar.\n- Never: never display the healthbar (for challenge runs).")
GS_DEFINE(SETTING_IDLE_POSE_TIMEOUT_DESCRIPTION,              "Allows Lara to enter a pose animation when she has been idle for the specified number of seconds. Set to 0 to disable.")
GS_DEFINE(SETTING_INVENTORY_AMBIENT_VOLUME_DESCRIPTION,       "Adjusts ambient volume in inventory screen.")
GS_DEFINE(SETTING_INVENTORY_BACKGROUND_STYLE_DESCRIPTION,     "Changes the way the background for the inventory ring is displayed.")
GS_DEFINE(SETTING_INVENTORY_MUSIC_VOLUME_DESCRIPTION,         "Adjusts music volume in inventory screen.")
GS_DEFINE(SETTING_JUMP_LOCK_MODE_DESCRIPTION,                 "For responsive jumping, allows controlling how soon after starting to run that Lara is permitted to jump.\n\n- Legacy: matches original TR2 timing.\n- Tuned: jumping is possible 2 frames earlier.\n- Disabled: jumping is possible immediately after the start-to-run animation.")
GS_DEFINE(SETTING_LIGHTING_CONTRAST_DESCRIPTION,              "Boosts contrast for dynamic light sources such as flares and gun flashes.")
GS_DEFINE(SETTING_LOAD_MUSIC_TRIGGERS_DESCRIPTION,            "Loads previously triggered, one shot music so one shot music tracks do not replay.")
GS_DEFINE(SETTING_LOOK_MODE_DESCRIPTION,                      "Allows controlling when Lara is able to use look.\n\n- Restricted: look is only permitted when Lara is stationary, and never when underwater.\n- Enhanced: look is permitted during most animations, aside from ones such as pushing a block.\n- Unrestricted: look is permitted at any time during normal Lara control.")
GS_DEFINE(SETTING_MASTER_VOLUME_DESCRIPTION,                  "Adjusts all ingame volume. The rest of the settings are relative to this volume.")
GS_DEFINE(SETTING_MAXIMUM_SAVE_SLOTS_DESCRIPTION,             "Changes the number of available save slots.")
GS_DEFINE(SETTING_MENU_STYLE_DESCRIPTION,                     "Changes how menus are displayed.\n\n - PC: UI style matches the PC version.\n - PS1: UI style matches the PS1 version.")
GS_DEFINE(SETTING_MUSIC_LOAD_CONDITION_DESCRIPTION,           "Loads the music track that was playing when the game was saved.\n\n- Never: do not restore music tracks on load.\n- Non-ambient: restore only non-ambient music tracks on load.\n- Always: restore any kind of music track on load.")
GS_DEFINE(SETTING_MUSIC_VOLUME_DESCRIPTION,                   "Adjusts music volume.")
GS_DEFINE(SETTING_MUTE_OUT_OF_FOCUS_DESCRIPTION,              "Mutes all music and sound effects when the game window is not focused.")
GS_DEFINE(SETTING_PAUSE_MUSIC_IN_INVENTORY_DESCRIPTION,       "Pauses game sounds, ambient and music in the inventory screen.")
GS_DEFINE(SETTING_PS_UZI_SFX_DESCRIPTION,                     "Changes the uzi sound effects to match the PlayStation version.")
GS_DEFINE(SETTING_QUICK_GUNS_MODE_DESCRIPTION,                "Controls the behavior of the quick gun equip keys.\n\n- Draw only: pressing a key will cause Lara to equip the assigned gun.\n- Draw or holster: same as above, plus Lara will undraw the assigned gun if she's currently carrying it.")
GS_DEFINE(SETTING_REFLECTIONS_DESCRIPTION,                    "Enables reflections on certain objects.")
GS_DEFINE(SETTING_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION,   "Makes Lara remember which gun she was using last in the previous level when starting a new level. If disabled, Lara will revert to pistols.")
GS_DEFINE(SETTING_RESTORE_PS1_ENEMIES_DESCRIPTION,            "Adds the mummy that appears in the PlayStation version of City of Khamoon, room 25.\nChanging this option will require restarting the level.")
GS_DEFINE(SETTING_SCREENSHOT_FORMAT_DESCRIPTION,              "Screenshot file format.")
GS_DEFINE(SETTING_SOUND_VOLUME_DESCRIPTION,                   "Adjusts sound effects volume.")
GS_DEFINE(SETTING_SPRINTBAR_COLOR_DESCRIPTION,                "Color of the sprintbar.")
GS_DEFINE(SETTING_SPRINTBAR_LOCATION_DESCRIPTION,             "Location where the sprintbar is displayed.")
GS_DEFINE(SETTING_SPRINTBAR_SHOW_MODE_DESCRIPTION,            "Changes how the sprintbar is displayed.\n\n- Default: show the sprintbar while Lara is sprinting, or recovering from having sprinted.\n- Never: never display the sprintbar.")
GS_DEFINE(SETTING_SPRITE_LOCK_MODE_DESCRIPTION,               "Controls which axes to lock when showing sprites on the screen.\n\n- None: show the sprites normally.\n- Roll: lock the roll axis – useful only in photo mode.\n- Roll & pitch: ensure the sprites stand upright and do not lie on the ground when looking at them from above.\n- Perspective: lock roll and pitch axes and addititonally, rotate the sprites slightly towards the center of the screen.")
GS_DEFINE(SETTING_START_LARA_HITPOINTS_DESCRIPTION,           "Sets Lara's health value for the beginning of each level.")
GS_DEFINE(SETTING_STATS_BACKGROUND_STYLE_DESCRIPTION,         "Changes the way the background for the end of level stats is displayed.")
GS_DEFINE(SETTING_STATS_LEVEL_HEADER_DESCRIPTION,             "Shows the current level number at the top of the level statistics.")
GS_DEFINE(SETTING_STAT_DETAIL_MODE_DESCRIPTION,               "Allows various levels of stat detail.\n\n- Minimal: shows kills, pickups, secrets, and time taken.\n- Detailed: shows all stats from minimal as well as the maximum pickup count and kill count of each level.\n- Full: shows all stats from detailed as well as ammo hits, ammo used, health packs used, and distance traveled.")
GS_DEFINE(SETTING_TARGET_MODE_DESCRIPTION,                    "Changes the behavior of how weapons lock onto targets.\n\n- Full lock: always keep target lock even if the enemy moves out of sight or dies (OG TR1-3).\n- Semi lock: keep target lock if the enemy moves out of sight but lose target lock if the enemy dies.\n- No lock: lose target lock if the enemy goes out of sight or dies (TR4+).")
GS_DEFINE(SETTING_TEXTURE_FILTER_DESCRIPTION,                 "Switches between smooth and pixel ingame textures.")
GS_DEFINE(SETTING_TRAPEZOID_FILTER_DESCRIPTION,               "Corrects rendering of quadrilaterals.")
GS_DEFINE(SETTING_UI_BAR_SCALE_DESCRIPTION,                   "Changes size of UI bars.")
GS_DEFINE(SETTING_UI_FILTER_DESCRIPTION,                      "Switches between smooth and pixel UI textures.")
GS_DEFINE(SETTING_UI_LANGUAGE_DESCRIPTION,                    "Changes the language of the UI text.")
GS_DEFINE(SETTING_UI_PICKUP_SCALE_DESCRIPTION,                "Changes size of items animated in the UI when Lara picks something up.")
GS_DEFINE(SETTING_UI_SCROLL_WRAPAROUND_DESCRIPTION,           "Lets directional navigation in menus loop around.")
GS_DEFINE(SETTING_UI_TEXT_SCALE_DESCRIPTION,                  "Changes the size of UI text.")
GS_DEFINE(SETTING_UNDERWATER_AMBIENT_VOLUME_DESCRIPTION,      "Adjusts ambient volume when underwater.")
GS_DEFINE(SETTING_UNDERWATER_MUSIC_VOLUME_DESCRIPTION,        "Adjusts music volume when underwater.")
GS_DEFINE(SETTING_UPSCALING_FACTOR_DESCRIPTION,               "Upscales game by a set factor, maintaining pixellated look.")
GS_DEFINE(SETTING_UPSCALING_FILTER_DESCRIPTION,               "Switches smooth or pixel look for the whole screen.")
GS_DEFINE(SETTING_USE_PS1_FOV_DESCRIPTION,                    "Uses field of view formula from the PS1 version.")
GS_DEFINE(SETTING_VSYNC_DESCRIPTION,                          "Turns V-Sync on or off.")
GS_DEFINE(SETTING_WALL_GLITCH_MODE_DESCRIPTION,               "Allows using TR1 wall glitch behavior in TR2 and vice-versa; equally allows fixing all types of wall glitch.")
GS_DEFINE(SETTING_WATER_COLOR_B_DESCRIPTION,                  "Blue component of the water color.")
GS_DEFINE(SETTING_WATER_COLOR_G_DESCRIPTION,                  "Green component of the water color.")
GS_DEFINE(SETTING_WATER_COLOR_R_DESCRIPTION,                  "Red component of the water color.")

