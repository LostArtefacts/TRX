// Settings option descriptions
GS_DEFINE(GAMEPLAY_SETTINGS_CAMERA_SPEED_DESCRIPTION,                   "Changes how fast the manual camera moves.")
GS_DEFINE(GAMEPLAY_SETTINGS_CHANGE_PIERRE_SPAWN_DESCRIPTION,            "Makes a freshly triggered (runaway) Pierre replace an already existing (runaway) Pierre.")
GS_DEFINE(GAMEPLAY_SETTINGS_DISABLE_HEALING_BETWEEN_LEVELS_DESCRIPTION, "Stops Lara from healing when starting a new level (for no Heal challenge runs).")
GS_DEFINE(GAMEPLAY_SETTINGS_DISABLE_MAGNUMS_DESCRIPTION,                "Removes all magnum guns and magnum ammo pickups from the game.")
GS_DEFINE(GAMEPLAY_SETTINGS_DISABLE_MEDPACKS_DESCRIPTION,               "Removes all medipacks from the game (for No Meds challenge runs).")
GS_DEFINE(GAMEPLAY_SETTINGS_DISABLE_SHOTGUN_DESCRIPTION,                "Removes all shotgun and shotgun shell pickups from the game.")
GS_DEFINE(GAMEPLAY_SETTINGS_DISABLE_TREX_COLLISION_DESCRIPTION,         "Removes all collision with T-Rex upon death. This helps when the T-Rex's body blocks the passage out.")
GS_DEFINE(GAMEPLAY_SETTINGS_DISABLE_UZIS_DESCRIPTION,                   "Removes all uzi guns and uzi ammo pickups from the game.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_AUTO_ITEM_SELECTION_DESCRIPTION,     "When Lara presses action against a keyhole or puzzle slot, and she has the corresponding item in the inventory, that item will be pre-selected.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_BUFFERING_DESCRIPTION,               "Enables F-key (1-frame) and inventory (2-frame) buffering to achieve precise control of Lara's movement.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_CHEATS_DESCRIPTION,                  "Enables various cheats:\n\n- L: immediately end the level.\n- I: give Lara all weapons; a boost of ammo and medipacks; and all plot items for the current level.\n- O: enable DOZY cheat (swimming midair).\n     - WALK key: exit DOZY.\n     - GUN key: open the closest door (doesn't work in certain places).")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_COMPASS_STATS_DESCRIPTION,           "Enables showing level statistics when the compass is selected.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_CONSOLE_DESCRIPTION,                 "Enables the developer console.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_CUTSCENES_DESCRIPTION,               "Enables cutscenes playing.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_DEATHS_COUNTER_DESCRIPTION,          "Enables showing a deaths counter in the compass and in the level statistics. Death count is updated in the currently loaded save as soon as Lara dies.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_DEMO_DESCRIPTION,                    "Enables demos showing in the main menu.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_ENHANCED_LOOK_DESCRIPTION,           "Allows Lara to look while running, jumping, hanging, etc. - similar to TR2 style.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_ENHANCED_SAVES_DESCRIPTION,          "Enhances savegames so that graphic effects, waterfall mist, flame emitters, and more are saved instead of disappearing on load.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_FMV_DESCRIPTION,                     "Enables FMVs playing.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_GAME_MODES_DESCRIPTION,              "Allows new game plus options to be selected from the new game passport menu.\n\n- New Game+: unlocks all weapons with infinite ammo; enemies have double the HP.\n- Japanese NG: weapons do double damage and flare pickups contain 8 rather than 6.\n- Japanese NG+: combination of New Game+ and Japanese NG.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_INVERTED_LOOK_DESCRIPTION,           "Inverts the Y axis controls when Lara looks.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_ITEM_EXAMINING_DESCRIPTION,          "For custom levels - allows item descriptions to be displayed in the inventory where the level author has provided suitable data.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_JUMP_TWISTS_DESCRIPTION,             "Enables TR2+ style jump twists and somersaults i.e. press roll during jump and swan dive animations.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_LEAN_JUMPING_DESCRIPTION,            "Allows Lara to creep forwards or backwards further when performing neutral jumps with the relevant input key pressed, similar to TR2+.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_LEGAL_DESCRIPTION,                   "Enables legal screen and Core Design FMV at the game start.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_LOADING_SCREENS_DESCRIPTION,         "Enables PS1 style loading screens before each level.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_NUMERIC_KEYS_DESCRIPTION,            "Enables quick weapon draws and medipack usage.\n\n- 1: Draw pistols\n- 2: Draw shotgun\n- 3: Draw magnums\n- 4: Draw uzis\n- 8: Use small medipack\n- 9: Use large medipack")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_RESPONSIVE_PASSPORT_DESCRIPTION,     "Disables blocking user input when passport flips pages, scheduling the page flips instead.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_SAVE_CRYSTALS_DESCRIPTION,           "Limits saving to the beginning of levels and save crystals. Levels have limited, single use save crystals like the PS1 version. Changing this option will require restarting the level.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_SWING_CANCEL_DESCRIPTION,            "Allows Lara's ledge-swinging animation to be cancelled by letting go and quickly grabbing again, similar to TR2+.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_TARGET_CHANGE_DESCRIPTION,           "Enables TR4+ target changing while aiming weapons. Press look while aiming to change targets.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_TIMER_IN_INVENTORY_DESCRIPTION,      "Makes the in-game timer work even while the game is showing the inventory.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_TOTAL_STATS_DESCRIPTION,             "Enables a total game statistics screen that plays after the credits.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_TR2_JUMPING_DESCRIPTION,             "Allows Lara to jump at any point while running, similar to TR2+.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_TR2_SWIMMING_DESCRIPTION,            "Gives Lara's underwater turn rate an acceleration curve for smoother movement, similar to TR2+.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_TR2_SWIM_CANCEL_DESCRIPTION,         "Allows Lara to stop more responsively underwater when the swim key is released, similar to TR2+.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_TR3_SIDESTEPS_DESCRIPTION,           "Enables TR3+ style sidesteps, e.g. shift+directional arrows. Dedicated sidestep buttons will still work.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_UW_ROLL_DESCRIPTION,                 "Allows Lara to roll while underwater, similar to TR2+.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_WADING_DESCRIPTION,                  "Allows Lara to wade through shallow water, similar to TR2+, rather than becoming stuck on the water surface.")
GS_DEFINE(GAMEPLAY_SETTINGS_ENABLE_WALK_TO_ITEMS_DESCRIPTION,           "Makes Lara walk to pickups and switches when nearby instead of teleporting to them.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_ALLIGATOR_AI_DESCRIPTION,               "Fixes alligators dealing no damage if Lara remains still in the water.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_ANIMATED_SPRITES_DESCRIPTION,           "Fixes original issues in The Cistern and Tomb of Tihocan where plant sprites in water areas do not animate.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_BRIDGE_COLLISION_DESCRIPTION,           "Fixes Lara not being able to grab parts of some bridges and invisible walls at the edge. Also fixes collision issues with drawbridges, trapdoors, and bridges when stacked over each other, over slopes, and near the ground.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_DESCENDING_GLITCH_DESCRIPTION,          "Fixes sidestepping and walking backwards on breakable tiles causing Lara to immediately descend to the tile underneath.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_FLOOR_DATA_ISSUES_DESCRIPTION,          "Fixes original issues with floor data/triggers.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_TEXTURE_ISSUES_DESCRIPTION,             "Fixes original issues with missing or incorrect textures/meshes.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_FREE_FLARE_GLITCH_DESCRIPTION,          "Fixes the ability to spawn a free flare when pressing the flare input while picking up any item.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_FLARE_THROW_PRIORITY_DESCRIPTION,       "Fixes Lara prioritising throwing a spent flare while in mid-air, which can lead to being unable to grab ledges.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_WALK_RUN_JUMP_DESCRIPTION,              "Fixes Lara at times not being able to jump immediately after going from her walking to running animation.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_GLIDE_CAMERAS_DESCRIPTION,              "Fixes glide cameras to respect the timer set in level triggers rather than defaulting the speed after the first frame.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_ITEM_DUPLICATION_GLITCH_DESCRIPTION,    "Fixes the ability to duplicate usage of key items in the inventory.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_ITEM_ROTS_DESCRIPTION,                  "Fixes original issues with some incorrectly rotated pickups when using the 3D pickups option.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_M16_ACCURACY_DESCRIPTION,               "Fixes the accuracy of the M16 while Lara is running.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_PICKUP_DRIFT_GLITCH_DESCRIPTION,        "Fixes Lara sometimes drifting when collecting underwater items, which can push her into walls.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_QWOP_GLITCH_DESCRIPTION,                "Fixes Lara jumping on small steps sometimes resulting in a weird running animation, known as a QWOP state.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_STEP_GLITCH_DESCRIPTION,                "Fixes Lara sometimes being pushed into walls adjacent to steps when running up them in a specific way.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_TIHOCAN_SECRET_SOUND_DESCRIPTION,       "Prevents the secret sound from incorrectly playing when using the golden key in Tomb of Tihocan.")
GS_DEFINE(GAMEPLAY_SETTINGS_FIX_WALL_JUMP_GLITCH_DESCRIPTION,           "Fixes Lara jumping through objects and moving up certain slopes.")
GS_DEFINE(GAMEPLAY_SETTINGS_LOAD_MUSIC_TRIGGERS_DESCRIPTION,            "Loads previously triggered, one shot music so one shot music tracks do not replay.")
GS_DEFINE(GAMEPLAY_SETTINGS_MAXIMUM_SAVE_SLOTS_DESCRIPTION,             "Changes the number of available save slots.")
GS_DEFINE(GAMEPLAY_SETTINGS_REMEMBER_GUNS_BETWEEN_LEVELS_DESCRIPTION,   "Makes Lara remember which gun she was using last in the previous level when starting a new level. If disabled, Lara will revert to pistols.")
GS_DEFINE(GAMEPLAY_SETTINGS_RESTORE_PS1_ENEMIES_DESCRIPTION,            "Adds the mummy that appears in the PlayStation version of City of Khamoon, room 25.\nChanging this option will require restarting the level.")
GS_DEFINE(GAMEPLAY_SETTINGS_START_LARA_HITPOINTS_DESCRIPTION,           "Sets Lara's health value for the beginning of each level.")
GS_DEFINE(GAMEPLAY_SETTINGS_STAT_DETAIL_MODE_DESCRIPTION,               "Allows various levels of stat detail.\n\n- Minimal: shows kills, pickups, secrets, and time taken.\n- Detailed: shows all stats from minimal as well as the maximum pickup count and kill count of each level.\n- Full: shows all stats from detailed as well as ammo hits, ammo used, health packs used, and distance travelled.")
GS_DEFINE(GAMEPLAY_SETTINGS_TARGET_MODE_DESCRIPTION,                    "Changes the behavior of how weapons lock onto targets.\n\n- Full lock: always keep target lock even if the enemy moves out of sight or dies (OG TR1).\n- Semi lock: keep target lock if the enemy moves out of sight but lose target lock if the enemy dies.\n- No lock: lose target lock if the enemy goes out of sight or dies (TR4+).")
GS_DEFINE(GRAPHIC_SETTINGS_AIRBAR_COLOR_DESCRIPTION,                    "Color of the airbar.")
GS_DEFINE(GRAPHIC_SETTINGS_AIRBAR_LOCATION_DESCRIPTION,                 "Location where the airbar is displayed.")
GS_DEFINE(GRAPHIC_SETTINGS_AIRBAR_SHOW_MODE_DESCRIPTION,                "Changes how the airbar is displayed.\n\n- Default: show the airbar only in the water and flash the airbar when Lara's oxygen is 20% or below.\n- Default, no flashing: same as default, but disable flashing.\n- Flashing only: show the airbar *only* when Lara's oxygen is 20% or below (for challenge runs).\n- Never: never display the airbar (for challenge runs).")
GS_DEFINE(GRAPHIC_SETTINGS_ANISOTROPY_FILTER_DESCRIPTION,               "Enhances texture filtering at distances.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_3D_PICKUPS_DESCRIPTION,               "Enables 3D models to be rendered in place of the sprites for pickup items.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_BRAID_DESCRIPTION,                    "Enables Lara's braid.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_BREEZE_DESCRIPTION,                   "Enables the breeze effect on Lara's braid in appropriate rooms.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_EXIT_FADE_EFFECTS_DESCRIPTION,        "Enables the fade effects when exiting the game to desktop.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_PICKUP_AIDS_DESCRIPTION,              "Enables an intermittent twinkling effect near pickup items to highlight their presence.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_PS1_CRYSTALS_DESCRIPTION,             "Save crystals will be drawn with a purple tint, more similar to the PS1 type.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_ROUND_SHADOW_DESCRIPTION,             "Enables round shadows instead of the default octagonal ones.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_SHOTGUN_FLASH_DESCRIPTION,            "Draws flames when firing the shotgun, like for other guns.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_SKYBOX_DESCRIPTION,                   "Enables the skybox in supported levels.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_SMOOTH_BARS_DESCRIPTION,              "Makes the health, air and enemy bars use smooth color transitions.")
GS_DEFINE(GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_COLOR_DESCRIPTION,           "Color of the enemy healthbar.")
GS_DEFINE(GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_LOCATION_DESCRIPTION,        "Location where the enemy healthbar is displayed.")
GS_DEFINE(GRAPHIC_SETTINGS_ENEMY_HEALTHBAR_SHOW_MODE_DESCRIPTION,       "Enables showing a healthbar for the active enemy.")
GS_DEFINE(GRAPHIC_SETTINGS_FOV_DESCRIPTION,                             "The desired field of view in degrees, which overrides the hardcoded default. The default values are 80 (horizontal) and 65 (vertical).")
GS_DEFINE(GRAPHIC_SETTINGS_FOV_VERTICAL_DESCRIPTION,                    "Interprets the field of view as vertical instead of horizontal. May be advantageous for widescreen resolutions, especially for multi-screen setups, since it distorts the left and right side instead of cropping away the top and bottom part of the screen.")
GS_DEFINE(GRAPHIC_SETTINGS_HEALTHBAR_COLOR_DESCRIPTION,                 "Color of the healthbar.")
GS_DEFINE(GRAPHIC_SETTINGS_HEALTHBAR_LOCATION_DESCRIPTION,              "Location where the healthbar is displayed.")
GS_DEFINE(GRAPHIC_SETTINGS_HEALTHBAR_SHOW_MODE_DESCRIPTION,             "Changes how the healthbar is displayed.\n\n- Default: show the healthbar at the start of a level, when hit, or when weapons are equipped; flash if 20% or below.\n- Default, no flashing: same as default, but disable flashing.\n- Default or flashing: same as default, except show it even if it's flashing.\n- Flashing only: show the healthbar *only* when Lara's health is 20% or below (for challenge runs).\n- Always: always show the healthbar.\n- Never: never display the healthbar (for challenge runs).")
GS_DEFINE(GRAPHIC_SETTINGS_MENU_STYLE_DESCRIPTION,                      "Changes how menus are displayed.\n\n - PC: UI style matches the PC version.\n - PS1: UI style matches the PS1 version.")
GS_DEFINE(GRAPHIC_SETTINGS_RESOLUTION_DESCRIPTION,                      "Overrides game resolution.")
GS_DEFINE(GRAPHIC_SETTINGS_SCREENSHOT_FORMAT_DESCRIPTION,               "Screenshot file format.")
GS_DEFINE(SOUND_SETTINGS_ENABLE_LARA_MIC_DESCRIPTION,                   "Set the microphone to be at Lara's position. If disabled, the microphone will be at the camera's position.")
GS_DEFINE(SOUND_SETTINGS_ENABLE_MUSIC_IN_MENU_DESCRIPTION,              "Plays music in the main menu.")
GS_DEFINE(SOUND_SETTINGS_ENABLE_PITCHED_SOUNDS_DESCRIPTION,             "Allows sound effects to be randomly, slightly pitched to vary the game sounds.")
GS_DEFINE(SOUND_SETTINGS_MUSIC_LOAD_CONDITION_DESCRIPTION,              "Loads the music track that was playing when the game was saved.\n\n- Never: do not restore music tracks on load.\n- Non-ambient: restore only non-ambient music tracks on load.\n- Always: restore any kind of music track on load.")
GS_DEFINE(SOUND_SETTINGS_PAUSE_MUSIC_IN_INVENTORY_DESCRIPTION,          "Pauses game sounds, ambient and music in the inventory screen.")
GS_DEFINE(SOUND_SETTINGS_FIX_SECRETS_KILLING_MUSIC_DESCRIPTION,         "Fixes the sound of collecting a secret stopping the active music track.")
GS_DEFINE(SOUND_SETTINGS_FIX_SPEECHES_KILLING_MUSIC_DESCRIPTION,        "Fixes enemies stopping the active music track when they speak.")
GS_DEFINE(SOUND_SETTINGS_PS_UZI_SFX_DESCRIPTION,                        "Changes the uzi sound effects to match the PlayStation version.")
GS_DEFINE(GRAPHIC_SETTINGS_FOG_START_DESCRIPTION,                       "Sets distance in tiles where fog begins to appear.")
GS_DEFINE(GRAPHIC_SETTINGS_FOG_END_DESCRIPTION,                         "Sets distance in tiles where fog makes everything fully obscured.")
GS_DEFINE(GRAPHIC_SETTINGS_CAMERA_MODE_DESCRIPTION,                     "Adjusts how camera behaves during actions like using keys.")
GS_DEFINE(GRAPHIC_SETTINGS_USE_PSX_FOV_DESCRIPTION,                     "Uses field of view formula from the PS1 version.")
GS_DEFINE(GRAPHIC_SETTINGS_REFLECTIONS_DESCRIPTION,                     "Enables reflections on certain objects.")
GS_DEFINE(GRAPHIC_SETTINGS_UI_TEXT_SCALE_DESCRIPTION,                   "Changes the size of UI text.")
GS_DEFINE(GRAPHIC_SETTINGS_UI_BAR_SCALE_DESCRIPTION,                    "Changes size of health, air and enemy bars.")
GS_DEFINE(GRAPHIC_SETTINGS_UI_SCROLL_WRAPAROUND_DESCRIPTION,            "Lets directional navigation in menus loop around.")
GS_DEFINE(GRAPHIC_SETTINGS_FPS_DESCRIPTION,                             "Sets game frames per second.")
GS_DEFINE(GRAPHIC_SETTINGS_TEXTURE_FILTER_DESCRIPTION,                  "Switches between smooth and pixel object textures.")
GS_DEFINE(GRAPHIC_SETTINGS_TRAPEZOID_FILTER_DESCRIPTION,                "Corrects rendering of quadrilaterals.")
GS_DEFINE(GRAPHIC_SETTINGS_FBO_FILTER_DESCRIPTION,                      "Switches smooth or pixel look for the whole screen.")
GS_DEFINE(GRAPHIC_SETTINGS_VSYNC_DESCRIPTION,                           "Turns V-Sync on or off.")
GS_DEFINE(GRAPHIC_SETTINGS_BRIGHTNESS_DESCRIPTION,                      "Changes game brightness.")
GS_DEFINE(GRAPHIC_SETTINGS_DEPTH_BUFFER_DESCRIPTION,                    "Turns the depth buffer on or off. Best kept on.")
GS_DEFINE(GRAPHIC_SETTINGS_LIGHTING_CONTRAST_DESCRIPTION,               "Boosts contrast for dynamic light sources such as flares and gun flashes.")
GS_DEFINE(GRAPHIC_SETTINGS_ASPECT_MODE_DESCRIPTION,                     "Forces certain game aspect ratios with letterbox.")
GS_DEFINE(GRAPHIC_SETTINGS_SCALER_DESCRIPTION,                          "Upscales game by a set factor, maintaining pixellated look.")
GS_DEFINE(GRAPHIC_SETTINGS_SIZER_DESCRIPTION,                           "Adds black borders around the game window.")
GS_DEFINE(SOUND_SETTINGS_SOUND_VOLUME_DESCRIPTION,                      "Adjusts sound effects volume.")
GS_DEFINE(SOUND_SETTINGS_MUSIC_VOLUME_DESCRIPTION,                      "Adjusts music and ambient volume.")
GS_DEFINE(SOUND_SETTINGS_INVENTORY_AMBIENT_VOLUME_DESCRIPTION,          "Adjust ambient volume in inventory screen.")
GS_DEFINE(SOUND_SETTINGS_INVENTORY_MUSIC_VOLUME_DESCRIPTION,            "Adjust music volume in inventory screen.")
GS_DEFINE(SOUND_SETTINGS_UNDERWATER_AMBIENT_VOLUME_DESCRIPTION,         "Adjust ambient volume when underwater.")
GS_DEFINE(SOUND_SETTINGS_UNDERWATER_MUSIC_VOLUME_DESCRIPTION,           "Adjust music volume when underwater.")
GS_DEFINE(GRAPHIC_SETTINGS_ENABLE_FADE_EFFECTS_DESCRIPTION,             "Enable fade transitions, for example between credit graphics or for inventory and pause screen transitions.")
