X_UI_CFG_BOOL(rendering.enable_vsync,            SETTING_VSYNC)
X_UI_CFG_FLOAT(visuals.brightness,               SETTING_BRIGHTNESS, .min_value = CONFIG_MIN_BRIGHTNESS * 100, .max_value = CONFIG_MAX_BRIGHTNESS * 100, .delta_slow = 1, .delta_fast = 5)

