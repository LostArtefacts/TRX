X_UI_CFG_ENUM(rendering.render_mode,             GRAPHIC_SETTINGS_RENDER_MODE, .misc = UI_Settings_RenderModeEnumEntries)
#endif
X_UI_CFG_ENUM(rendering.aspect_mode,             GRAPHIC_SETTINGS_ASPECT_MODE, .misc = UI_Settings_AspectModeEnumEntries)
X_UI_CFG_INT32(rendering.scaler,                 GRAPHIC_SETTINGS_SCALER, .min_value = 1, .max_value = 4, .delta_slow = 1, .delta_fast = 1)
X_UI_CFG_FLOAT(rendering.sizer,                  GRAPHIC_SETTINGS_SIZER, .min_value = 40, .max_value = 100, .delta_slow = 5, .delta_fast = 5)

