X_UI_CFG_BOOL(rendering.enable_trapezoid_filter, GRAPHIC_SETTINGS_TRAPEZOID_FILTER)

#if TR_VERSION == 1
X_UI_CFG_FLOAT(rendering.anisotropy_filter,      GRAPHIC_SETTINGS_ANISOTROPY_FILTER, .min_value = 1 * 100, .max_value = 32 * 100, .delta_slow = 10, .delta_fast = 100)
X_UI_CFG_ENUM(rendering.fbo_filter,              GRAPHIC_SETTINGS_FBO_FILTER, .misc = UI_Settings_TextureFilterEnumEntries)

X_UI_CFG_BOOL(rendering.enable_vsync,            GRAPHIC_SETTINGS_VSYNC)

X_UI_CFG_FLOAT(visuals.brightness,               GRAPHIC_SETTINGS_BRIGHTNESS, .min_value = CONFIG_MIN_BRIGHTNESS * 100, .max_value = CONFIG_MAX_BRIGHTNESS * 100, .delta_slow = 10, .delta_fast = 10)

#elif TR_VERSION == 2
X_UI_CFG_BOOL(rendering.enable_zbuffer,          GRAPHIC_SETTINGS_DEPTH_BUFFER)
