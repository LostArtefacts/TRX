// Slot-numbered pickups, described once and expanded wherever the per-slot
// symbols are needed: catalog ids, names, object registration and savegame
// keys. Which family a pickup belongs to and what it leads to are data, and
// this file says neither.
//
// Consumers define only the macros they care about before including this
// file; any family macro left undefined falls back to the generic
// X_PICKUP / X_RECEPTACLE / X_RECEPTACLE_DONE hooks, which default to
// nothing. Example - visiting every item/option pair:
//
//     #define X_PICKUP(item, option) { item, option },
//     #include <trx/game/objects/pickups.def>
//     #undef X_PICKUP
//
// Defaulted macros are #undef'd at the bottom of this file; consumers only
// clean up the macros they defined themselves.

#ifndef X_PICKUP
    #define X_PICKUP(item, option)
    #define X_PICKUP_DEFAULTED
#endif
#ifndef X_RECEPTACLE
    #define X_RECEPTACLE(option, receptacle)
    #define X_RECEPTACLE_DEFAULTED
#endif
#ifndef X_RECEPTACLE_DONE
    #define X_RECEPTACLE_DONE(receptacle, done)
    #define X_RECEPTACLE_DONE_DEFAULTED
#endif

#ifndef X_PICKUP_VARIANT
    #define X_PICKUP_VARIANT(item, option) X_PICKUP(item, option)
    #define X_PICKUP_VARIANT_DEFAULTED
#endif
#ifndef X_PICKUP_SUPPLY_VARIANT
    #define X_PICKUP_SUPPLY_VARIANT(item, option) X_PICKUP_VARIANT(item, option)
    #define X_PICKUP_SUPPLY_VARIANT_DEFAULTED
#endif
#ifndef X_PICKUP_SPECIAL
    #define X_PICKUP_SPECIAL(item, option) X_PICKUP(item, option)
    #define X_PICKUP_SPECIAL_DEFAULTED
#endif

#ifndef X_PICKUP_KEY
    #define X_PICKUP_KEY(n)                                                    \
        X_PICKUP(O_KEY_ITEM_##n, O_KEY_OPTION_##n)                    \
        X_RECEPTACLE(O_KEY_OPTION_##n, O_KEY_HOLE_##n)
    #define X_PICKUP_KEY_DEFAULTED
#endif
#ifndef X_PICKUP_PUZZLE
    #define X_PICKUP_PUZZLE(n)                                                 \
        X_PICKUP(O_PUZZLE_ITEM_##n, O_PUZZLE_OPTION_##n)              \
        X_RECEPTACLE(O_PUZZLE_OPTION_##n, O_PUZZLE_HOLE_##n)                   \
        X_RECEPTACLE_DONE(O_PUZZLE_HOLE_##n, O_PUZZLE_DONE_##n)
    #define X_PICKUP_PUZZLE_DEFAULTED
#endif
#ifndef X_PICKUP_PICKUP
    #define X_PICKUP_PICKUP(n)                                                 \
        X_PICKUP(O_PICKUP_ITEM_##n, O_PICKUP_OPTION_##n)
    #define X_PICKUP_PICKUP_DEFAULTED
#endif
#ifndef X_PICKUP_QUEST
    #define X_PICKUP_QUEST(n)                                                  \
        X_PICKUP(O_QUEST_ITEM_##n, O_QUEST_OPTION_##n)
    #define X_PICKUP_QUEST_DEFAULTED
#endif
#ifndef X_PICKUP_KEY_COMBO
    #define X_PICKUP_KEY_COMBO(n, c)                                           \
        X_PICKUP(                                                     \
            O_KEY_ITEM_##n##_COMBO_##c, O_KEY_OPTION_##n##_COMBO_##c)
    #define X_PICKUP_KEY_COMBO_DEFAULTED
#endif
#ifndef X_PICKUP_PUZZLE_COMBO
    #define X_PICKUP_PUZZLE_COMBO(n, c)                                        \
        X_PICKUP(                                                     \
            O_PUZZLE_ITEM_##n##_COMBO_##c, O_PUZZLE_OPTION_##n##_COMBO_##c)
    #define X_PICKUP_PUZZLE_COMBO_DEFAULTED
#endif
#ifndef X_PICKUP_PICKUP_COMBO
    #define X_PICKUP_PICKUP_COMBO(n, c)                                        \
        X_PICKUP(                                                     \
            O_PICKUP_ITEM_##n##_COMBO_##c, O_PICKUP_OPTION_##n##_COMBO_##c)
    #define X_PICKUP_PICKUP_COMBO_DEFAULTED
#endif
#ifndef X_PICKUP_EXAMINE
    #define X_PICKUP_EXAMINE(n)                                                \
        X_PICKUP(O_EXAMINE_ITEM_##n, O_EXAMINE_OPTION_##n)
    #define X_PICKUP_EXAMINE_DEFAULTED
#endif

