// Slot-numbered pickups: names and inventory ring aliases
#define X_PICKUP_KEY(n)                                                        \
    X_OBJ_NAME_DEFINE(O_KEY_ITEM_##n, X_OBJ_NAMES("Key " #n))
#define X_PICKUP_PUZZLE(n)                                                     \
    X_OBJ_NAME_DEFINE(                                                         \
        O_PUZZLE_ITEM_##n, X_OBJ_NAMES("Puzzle Item " #n))
#define X_PICKUP_PICKUP(n)                                                     \
    X_OBJ_NAME_DEFINE(                                                         \
        O_PICKUP_ITEM_##n, X_OBJ_NAMES("Pickup Item " #n))
#define X_PICKUP_QUEST(n)                                                      \
    X_OBJ_NAME_DEFINE(                                                         \
        O_QUEST_ITEM_##n, X_OBJ_NAMES("Quest Item " #n))
#define X_PICKUP_KEY_COMBO(n, c)                                               \
    X_OBJ_NAME_DEFINE(                                                         \
        O_KEY_ITEM_##n##_COMBO_##c,                    \
        X_OBJ_NAMES("Key " #n " (Combo " #c ")"))
#define X_PICKUP_PUZZLE_COMBO(n, c)                                            \
    X_OBJ_NAME_DEFINE(                                                         \
        O_PUZZLE_ITEM_##n##_COMBO_##c,              \
        X_OBJ_NAMES("Puzzle Item " #n " (Combo " #c ")"))
#define X_PICKUP_PICKUP_COMBO(n, c)                                            \
    X_OBJ_NAME_DEFINE(                                                         \
        O_PICKUP_ITEM_##n##_COMBO_##c,              \
        X_OBJ_NAMES("Pickup Item " #n " (Combo " #c ")"))
#define X_PICKUP_EXAMINE(n)                                                    \
    X_OBJ_NAME_DEFINE(                                                         \
        O_EXAMINE_ITEM_##n, X_OBJ_NAMES("Examine Item " #n))
#include <trx/game/objects/pickups.def>
#undef X_PICKUP_EXAMINE
#undef X_PICKUP_PICKUP_COMBO
#undef X_PICKUP_PUZZLE_COMBO
#undef X_PICKUP_KEY_COMBO
#undef X_PICKUP_QUEST
#undef X_PICKUP_PICKUP
#undef X_PICKUP_PUZZLE
#undef X_PICKUP_KEY
