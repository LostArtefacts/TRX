    X_OBJ_NAME_DEFINE(                                                         \
        O_QUEST_ITEM_##n, "Quest Item " #n)
#define X_PICKUP_KEY_COMBO(n, c)                                               \
    X_OBJ_NAME_DEFINE(                                                         \
        O_KEY_ITEM_##n##_COMBO_##c,                    \
        "Key " #n " (Combo " #c ")")
