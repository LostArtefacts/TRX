X_UI_CFG_STRING(language,                       SETTING_UI_LANGUAGE, .custom_handler = { .format_value = UI_Settings_Language_FormatValue, .can_change_value = UI_Settings_Language_CanChangeValue, .request_change_value = UI_Settings_Language_RequestChangeValue })

X_UI_CFG_FLOAT_PERCENT(ui.text_scale,           SETTING_UI_TEXT_SCALE, .min_value = 50, .max_value = 200, .delta_slow = 1, .delta_fast = 5)
X_UI_CFG_FLOAT_PERCENT(ui.pickup_scale,         SETTING_UI_PICKUP_SCALE, .min_value = 50, .max_value = 200, .delta_slow = 1, .delta_fast = 5)
X_UI_CFG_BOOL(ui.show_pickups_overlay,          SETTING_UI_PICKUPS_OVERLAY)
X_UI_CFG_BOOL(ui.enable_wraparound,             SETTING_UI_SCROLL_WRAPAROUND)

X_UI_CFG_ENUM(ui.menu_style,                    SETTING_MENU_STYLE, .misc = UI_Settings_MenuStyleEnumEntries)
X_UI_CFG_ENUM(ui.stat_detail_mode,              SETTING_STAT_DETAIL_MODE, .misc = UI_Settings_StatDetailModeEnumEntries)
X_UI_CFG_BOOL(ui.enable_stats_level_header,     SETTING_STATS_LEVEL_HEADER)

X_UI_CFG_ENUM(ui.inventory_background_style,    SETTING_INVENTORY_BACKGROUND_STYLE, .misc = UI_Settings_BackgroundStyleEnumEntries, .custom_handler = { .is_enum_value_available = UI_Settings_BackgroundStyle_IsEnumValueAvailable })
X_UI_CFG_BOOL(ui.inventory_fade_effects,        SETTING_INVENTORY_FADE_EFFECTS, .custom_handler = { .is_available = UI_Settings_EnableFadeEffects_IsAvailable })
X_UI_CFG_ENUM(ui.pause_background_style,        SETTING_PAUSE_BACKGROUND_STYLE, .misc = UI_Settings_BackgroundStyleEnumEntries, .custom_handler = { .is_enum_value_available = UI_Settings_BackgroundStyle_IsEnumValueAvailable })
X_UI_CFG_BOOL(ui.pause_fade_effects,            SETTING_PAUSE_FADE_EFFECTS, .custom_handler = { .is_available = UI_Settings_EnableFadeEffects_IsAvailable })
X_UI_CFG_ENUM(ui.stats_background_style,        SETTING_STATS_BACKGROUND_STYLE, .misc = UI_Settings_BackgroundStyleEnumEntries, .custom_handler = { .is_enum_value_available = UI_Settings_BackgroundStyle_IsEnumValueAvailable })
X_UI_CFG_BOOL(ui.stats_fade_effects,            SETTING_STATS_FADE_EFFECTS, .custom_handler = { .is_available = UI_Settings_EnableFadeEffects_IsAvailable })

X_UI_CFG_BOOL(visuals.enable_fade_effects,      SETTING_ENABLE_FADE_EFFECTS)
X_UI_CFG_BOOL(visuals.enable_exit_fade_effects, SETTING_ENABLE_EXIT_FADE_EFFECTS, .custom_handler = { .is_available = UI_Settings_EnableFadeEffects_IsAvailable })
