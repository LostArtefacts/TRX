X_GLYPH_DEFINE("\n", GLYPH_NEW_LINE, -1)
X_GLYPH_DEFINE("\f", GLYPH_NEW_PAGE, -1)
X_GLYPH_DEFINE(" ", GLYPH_SPACE, -1)
X_GLYPH_DEFINE(" ", GLYPH_NORMAL, -1)
X_GLYPH_DEFINE("\\{i}", GLYPH_VISIBILITY_MARKER, 0)
X_GLYPH_DEFINE("\\{/i}", GLYPH_VISIBILITY_MARKER, 1)
X_GLYPH_DEFINE("\\{dim}", GLYPH_DIM_MARKER, 1)
X_GLYPH_DEFINE("\\{/dim}", GLYPH_DIM_MARKER, 0)
X_GLYPH_DEFINE("\\{secret 1}", GLYPH_SECRET, 0)
X_GLYPH_DEFINE("\\{secret 2}", GLYPH_SECRET, 1)
X_GLYPH_DEFINE("\\{secret 3}", GLYPH_SECRET, 2)

#include <trx/game/ui/text_autogen.def>
