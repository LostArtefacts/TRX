{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "Lua5.4",
    "requirePattern": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "workspaceRoots": [
      "src/lua",
      "data/trx/ship"
    ],
    "library": [
      "tools/lint/emmylua"
    ],
    "moduleMap": [
      {
        "pattern": "^common\\.(.*)$",
        "replace": "modules.$1"
      },
      {
        "pattern": "^(tr[0-9a-z-]*)\\.(.*)$",
        "replace": "games.$1.modules.$2"
      }
    ]
  },
  "diagnostics": {
    "disable": [
      "annotation-usage-error"
    ],
    "severity": {
      "assign-type-mismatch": "error",
      "call-non-callable": "error",
      "duplicate-type": "error",
      "inject-field": "error",
      "missing-fields": "error",
      "missing-parameter": "error",
      "missing-return": "error",
      "param-type-mismatch": "error",
      "redundant-parameter": "error",
      "redundant-return-value": "error",
      "return-type-mismatch": "error",
      "undefined-doc-param": "error",
      "undefined-field": "error",
      "unresolved-require": "error"
    }
  }
}
